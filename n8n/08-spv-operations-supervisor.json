{
  "name": "INKAMBILLING - SPV Operations Supervisor",
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Jakarta"
  },
  "nodes": [
    {
      "parameters": {
        "triggerTimes": {
          "item": [
            {
              "mode": "everyX",
              "value": 15,
              "unit": "minutes"
            }
          ]
        }
      },
      "id": "cron-cycle",
      "name": "Supervisor Cycle 15m",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [
        0,
        120
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config SPV Cycle').first().json.inkambillingUrl.replace(/\\/+$/, '') }}/api/n8n/operations/spv-cycle",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Idempotency-Key",
              "value": "=spv-cycle:{{$now.toFormat('yyyyMMddHHmm')}}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { run_at: $now.toISO() } }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "id": "api-cycle",
      "name": "Cek Tiket Belum Close",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        120
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "inkambilling-n8n-token",
          "name": "INKAMBILLING n8n Token"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const out=[]; for (const item of $input.all()) { for (const m of (item.json.messages||[])) { for (const chatId of (m.chat_ids||[])) if(chatId&&m.text) out.push({json:{chatId,text:m.text}}); } } return out;"
      },
      "id": "split-cycle",
      "name": "Pisah Reminder",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        120
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config SPV Cycle').first().json.wahaUrl.replace(/\\/+$/, '') }}/api/sendText",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { session: $('Config SPV Cycle').first().json.wahaSession || 'default', chatId: $json.chatId, text: $json.text } }}",
        "options": {
          "timeout": 20000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "id": "send-cycle",
      "name": "Kirim Reminder Grup",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        120
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "waha-api-key",
          "name": "WAHA API Key"
        }
      }
    },
    {
      "parameters": {
        "triggerTimes": {
          "item": [
            {
              "mode": "everyDay",
              "hour": 8,
              "minute": 0
            }
          ]
        }
      },
      "id": "cron-morning",
      "name": "Morning 08:00",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [
        0,
        330
      ]
    },
    {
      "parameters": {
        "triggerTimes": {
          "item": [
            {
              "mode": "everyDay",
              "hour": 13,
              "minute": 0
            }
          ]
        }
      },
      "id": "cron-midday",
      "name": "Midday 13:00",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [
        0,
        470
      ]
    },
    {
      "parameters": {
        "triggerTimes": {
          "item": [
            {
              "mode": "everyDay",
              "hour": 18,
              "minute": 0
            }
          ]
        }
      },
      "id": "cron-evening",
      "name": "Evening 18:00",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [
        0,
        610
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config SPV Summary').first().json.inkambillingUrl.replace(/\\/+$/, '') }}/api/n8n/operations/daily-summary",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Idempotency-Key",
              "value": "=spv-daily:{{$json.period}}:{{$now.toFormat('yyyy-MM-dd')}}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { period: $json.period } }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "id": "api-summary",
      "name": "Ambil Daily Summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        470
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "inkambilling-n8n-token",
          "name": "INKAMBILLING n8n Token"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const out=[]; for (const item of $input.all()) for(const m of (item.json.messages||[])) if(m.chatId&&m.text) out.push({json:m}); return out;"
      },
      "id": "split-summary",
      "name": "Pisah Daily Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        920,
        470
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config SPV Summary').first().json.wahaUrl.replace(/\\/+$/, '') }}/api/sendText",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { session: $('Config SPV Summary').first().json.wahaSession || 'default', chatId: $json.chatId, text: $json.text } }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "id": "send-summary",
      "name": "Kirim Daily Summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1160,
        470
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "waha-api-key",
          "name": "WAHA API Key"
        }
      }
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "p",
              "name": "period",
              "value": "morning",
              "type": "string"
            }
          ]
        }
      },
      "id": "set-morning",
      "name": "Set Morning",
      "type": "n8n-nodes-base.set",
