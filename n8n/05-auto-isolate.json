{
  "name": "INKAMBILLING - Auto Isolir Billing",
  "active": false,
  "settings": { "executionOrder": "v1" },
  "nodes": [
    { "parameters": { "triggerTimes": { "item": [ { "mode": "everyDay", "hour": 0, "minute": 10 } ] } }, "id": "isolate-cron", "name": "Setiap Hari 00:10", "type": "n8n-nodes-base.cron", "typeVersion": 1, "position": [260, 300] },
    { "parameters": { "method": "POST", "url": "={{$env.INKAMBILLING_URL}}/api/n8n/auto-isolate", "sendHeaders": true, "headerParameters": { "parameters": [ { "name": "X-N8N-TOKEN", "value": "={{$env.INKAMBILLING_N8N_TOKEN}}" }, { "name": "X-Idempotency-Key", "value": "=auto-isolate:{{$now.toFormat('yyyy-MM-dd')}}" } ] }, "sendBody": true, "specifyBody": "json", "jsonBody": "={{ { event_key: 'auto-isolate:' + $now.toFormat('yyyy-MM-dd'), apply: true } }}" }, "id": "isolate-http", "name": "Jalankan Auto-Isolir", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [540, 300] }
  ],
  "connections": { "Setiap Hari 00:10": { "main": [ [ { "node": "Jalankan Auto-Isolir", "type": "main", "index": 0 } ] ] } }
}
