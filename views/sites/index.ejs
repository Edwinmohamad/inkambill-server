<section><div class="module-head"><div><div class="module-kicker">MULTI-SITE CORE</div><h1>Lokasi Server / POP</h1><p>Kelola struktur KRW, CLM, KBG atau site baru. Jatuh tempo &amp; grace period diatur per pelanggan di menu Pelanggan.</p></div><div class="module-actions"><button class="btn-tech primary" data-bs-toggle="modal" data-bs-target="#siteModal"><i class="bi bi-plus-lg"></i>Tambah Site</button></div></div>
<div class="data-card"><div class="data-card-head"><div><h3>Site Registry</h3><small>Company → Site → Router → Pelanggan</small></div></div><div class="table-responsive"><table class="app-table" data-bulk-scope="sitesBulkBar"><thead><tr><% if(isAdmin){ %><th class="app-check-col"><input type="checkbox" class="form-check-input" data-select-all aria-label="Pilih semua site"></th><% } %><th class="app-seq-col">No.</th><th>Code</th><th>Nama</th><th>Pelanggan</th><th>Router</th><th>Status</th><% if(isAdmin){ %><th>Aksi</th><% } %></tr></thead><tbody><% sites.forEach((s,index)=>{ const inUse=Number(s.customers||0)+Number(s.routers||0)>0; %><tr><% if(isAdmin){ %><td class="app-check-col"><input type="checkbox" class="form-check-input" data-row-check value="<%= s.id %>" aria-label="Pilih site <%= s.name %>"></td><% } %><td><span class="cell-main"><%= index+1 %></span></td><td><span class="status-badge purple"><%= s.code %></span></td><td><span class="cell-main"><%= s.name %></span><span class="cell-sub"><%= s.address||'-' %></span></td><td><%= s.customers %></td><td><%= s.routers %></td><td><span class="status-badge <%= s.is_active?'green':'gray' %>"><%= s.is_active?'aktif':'nonaktif' %></span></td>
  <% if(isAdmin){ %><td><div class="d-flex gap-1"><button class="action-pill" type="button" title="Edit Site" data-bs-toggle="modal" data-bs-target="#editSite<%= s.id %>"><i class="bi bi-pencil-square"></i></button><form method="post" action="/sites/<%= s.id %>/toggle"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="action-pill" type="submit" title="Aktif/Nonaktif"><i class="bi bi-power"></i></button></form><button class="action-pill danger" type="button" title="Hapus Site" data-simple-delete="/sites/<%= s.id %>/delete" data-entity-label="Site <%= s.code %> - <%= s.name %>" data-simple-delete-title="Hapus site ini?" data-simple-delete-warning="<%= inUse?`Site ini masih memiliki ${s.customers} pelanggan dan ${s.routers} router — sistem akan menolak penghapusan permanen dan menyarankan Nonaktifkan.`:'Site akan dihapus permanen dari sistem.' %>"><i class="bi bi-trash3-fill"></i></button></div></td><% } %>
</tr><% }) %></tbody></table></div>
<% if(isAdmin){ %><div class="customer-bulk-bar" id="sitesBulkBar" hidden><span><b data-bulk-count>0</b> site terpilih</span><div class="customer-bulk-buttons"><button type="button" data-bulk-clear class="ghost"><i class="bi bi-x-lg"></i>Batal</button><button type="button" class="danger" data-simple-delete-bulk data-bulk-scope-id="sitesBulkBar" data-bulk-url="/sites/bulk" data-bulk-action-field="action" data-bulk-action-value="delete" data-bulk-id-field="site_ids[]" data-entity-label-plural="site" data-simple-delete-title="Hapus site terpilih?" data-simple-delete-warning="Site yang masih memiliki pelanggan/router/cluster/paket akan otomatis dilewati dan dilaporkan jumlahnya."><i class="bi bi-trash3-fill"></i>Hapus Massal</button></div></div><% } %>
</div></section>
<div class="modal fade" id="siteModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><form class="modal-content" method="post" action="/sites"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="modal-header"><h5 class="modal-title">Tambah Lokasi Server</h5><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="row g-3"><div class="col-4"><label class="form-label">Code</label><input class="form-control" name="code" maxlength="20" required placeholder="KBG"></div><div class="col-8"><label class="form-label">Nama</label><input class="form-control" name="name" required></div><div class="col-12"><label class="form-label">Alamat</label><textarea class="form-control" name="address"></textarea></div></div></div><div class="modal-footer"><button class="btn-tech primary">Simpan Site</button></div></form></div></div>

<% sites.forEach(s=>{ %><div class="modal fade" id="editSite<%= s.id %>" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><form class="modal-content" method="post" action="/sites/<%= s.id %>/edit"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="modal-header"><h5 class="modal-title">Edit Lokasi Server <%= s.code %></h5><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="row g-3"><div class="col-4"><label class="form-label">Code</label><input class="form-control text-uppercase" name="code" maxlength="20" required value="<%= s.code %>"></div><div class="col-8"><label class="form-label">Nama</label><input class="form-control" name="name" required value="<%= s.name %>"></div><div class="col-12"><label class="form-label">Alamat</label><textarea class="form-control" name="address"><%= s.address||'' %></textarea></div></div></div><div class="modal-footer"><button type="button" class="btn-tech" data-bs-dismiss="modal">Batal</button><button class="btn-tech primary"><i class="bi bi-check2"></i>Simpan Perubahan</button></div></form></div></div><% }) %>
