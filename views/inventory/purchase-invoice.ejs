<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= purchase.document_no %></title><style>
:root{font-family:-apple-system,BlinkMacSystemFont,"SF Pro Display","Segoe UI",sans-serif;color:#15171d;background:#eef0f4}*{box-sizing:border-box}body{margin:0;padding:34px}.sheet{width:min(900px,100%);margin:auto;background:#fff;border-radius:24px;box-shadow:0 20px 70px #1920331a;overflow:hidden}.top{padding:35px 42px;background:linear-gradient(125deg,#171923,#27213c 55%,#12365d);color:white;display:flex;justify-content:space-between;gap:30px}.brand small{font-size:10px;font-weight:800;letter-spacing:.18em;color:#c4b5fd}.brand h1{font-size:31px;letter-spacing:-.04em;margin:8px 0 5px}.brand p{margin:0;color:#ffffffa8;font-size:12px}.doc{text-align:right}.doc b{display:block;font-size:17px}.doc span{display:inline-block;margin-top:8px;padding:5px 10px;border-radius:999px;background:#ffffff18;font-size:10px;font-weight:800;letter-spacing:.08em}.content{padding:32px 42px}.parties{display:grid;grid-template-columns:1fr 1fr 1fr;gap:24px;padding-bottom:25px;border-bottom:1px solid #e7e8ec}.party small{display:block;font-size:9px;font-weight:800;letter-spacing:.12em;color:#8a8e99;margin-bottom:7px}.party b{display:block;font-size:13px}.party span{display:block;font-size:11px;color:#696d78;margin-top:3px;line-height:1.45}.meta{display:grid;grid-template-columns:repeat(4,1fr);gap:9px;margin:20px 0}.meta div{background:#f5f6f8;border-radius:12px;padding:10px 12px}.meta small{display:block;color:#8a8e99;font-size:9px;text-transform:uppercase;font-weight:800;letter-spacing:.05em}.meta b{display:block;font-size:11.5px;margin-top:4px}table{width:100%;border-collapse:collapse;font-size:11.5px}th{text-align:left;padding:9px 10px;background:#f5f6f8;color:#7a7e88;font-size:9px;text-transform:uppercase;letter-spacing:.07em}th:first-child{border-radius:9px 0 0 9px}th:last-child{border-radius:0 9px 9px 0}td{padding:11px 10px;border-bottom:1px solid #eceef1}td.num,th.num{text-align:right}.item b{display:block}.item small{color:#8a8e99}.bottom{display:grid;grid-template-columns:1fr 300px;gap:30px;margin-top:22px}.notes{font-size:11px;color:#696d78;line-height:1.5}.notes b{display:block;color:#333842;margin-bottom:5px}.totals>div{display:flex;justify-content:space-between;padding:6px 2px;font-size:11.5px}.totals .grand{border-top:1px solid #dfe1e6;margin-top:5px;padding-top:11px;font-size:16px;font-weight:800}.due{margin-top:9px;border-radius:12px;background:#fff7ed;color:#9a4b00;padding:10px 12px;font-size:10.5px;display:flex;justify-content:space-between}.signatures{display:grid;grid-template-columns:1fr 1fr;gap:70px;margin-top:55px;text-align:center;font-size:10px;color:#7d818b}.signatures div:before{content:"";display:block;border-top:1px solid #cfd2d8;margin-bottom:7px}.foot{padding:18px 42px;background:#f7f8fa;color:#9296a0;font-size:9.5px;display:flex;justify-content:space-between}.actions{width:min(900px,100%);margin:14px auto;display:flex;justify-content:flex-end;gap:8px}.actions a,.actions button{border:0;border-radius:11px;padding:10px 14px;background:#fff;color:#242730;font-weight:700;cursor:pointer;text-decoration:none;box-shadow:0 4px 16px #19203310}.actions button{background:#007aff;color:#fff}@media(max-width:700px){body{padding:10px}.top,.content{padding:24px 20px}.parties{grid-template-columns:1fr}.meta{grid-template-columns:1fr 1fr}.bottom{grid-template-columns:1fr}.sheet{border-radius:17px}.top{flex-direction:column}.doc{text-align:left}.foot{padding:15px 20px}}@media print{body{padding:0;background:#fff}.sheet{width:100%;box-shadow:none;border-radius:0}.actions{display:none}@page{size:A4;margin:10mm}}
</style></head><body>
<div class="actions"><a href="/inventory/procurement">← Kembali</a><% if(purchase.status==='draft'){ %><form method="post" action="/inventory/procurement/purchases/<%= purchase.id %>/receive" onsubmit="return confirm('Konfirmasi barang sudah diterima? Stok dan pengajuan Data Kas akan dibuat.')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit">Terima Barang</button></form><% } %><button onclick="window.print()">Cetak / Simpan PDF</button></div>
<main class="sheet"><header class="top"><div class="brand"><small>INKAMNET · WAREHOUSE</small><h1>Faktur Penerimaan</h1><p>Dokumen pembelian dan penerimaan barang gudang</p></div><div class="doc"><b><%= purchase.document_no %></b><span><%= purchase.status==='received'?'BARANG DITERIMA':'DRAFT' %></span></div></header>
<div class="content"><section class="parties"><div class="party"><small>SUPPLIER / TOKO</small><b><%= purchase.supplier_name||purchase.shop_name||'Supplier lainnya' %></b><span><%= purchase.supplier_phone||'' %><% if(purchase.supplier_phone&&purchase.supplier_address){ %><br><% } %><%= purchase.supplier_address||'' %></span></div><div class="party"><small>DITERIMA DI</small><b>Gudang <%= purchase.destination_code %></b><span><%= purchase.destination_name %></span></div><div class="party"><small>DATA KAS</small><b>Kas <%= purchase.payer_code||purchase.destination_code %></b><span><%= purchase.cash_transaction_id?'Pengajuan kas #'+purchase.cash_transaction_id:'Belum membuat transaksi kas' %></span></div></section>
<section class="meta"><div><small>Tanggal</small><b><%= formatDate(purchase.purchase_date) %></b></div><div><small>Nota supplier</small><b><%= purchase.external_invoice_no||'-' %></b></div><div><small>Pembayaran</small><b><%= ({cash:'Cash',transfer:'Transfer',credit:'Tempo',partial:'Sebagian'})[purchase.payment_type] %></b></div><div><small>Jatuh tempo</small><b><%= purchase.due_date?formatDate(purchase.due_date):'-' %></b></div></section>
<table><thead><tr><th style="width:40px">No</th><th>Barang</th><th class="num">Qty</th><th class="num">Harga</th><th class="num">Diskon</th><th class="num">Subtotal</th></tr></thead><tbody><% lines.forEach((line,i)=>{ %><tr><td><%= i+1 %></td><td class="item"><b><%= line.item_name %></b><small><%= line.item_code||'NO-SKU' %></small></td><td class="num"><%= Number(line.qty).toLocaleString('id-ID',{maximumFractionDigits:2}) %> <%= line.unit %></td><td class="num"><%= formatRupiah(line.unit_price) %></td><td class="num"><%= formatRupiah(line.discount_amount) %></td><td class="num"><b><%= formatRupiah(line.subtotal) %></b></td></tr><% }) %></tbody></table>
<section class="bottom"><div class="notes"><b>Catatan</b><%= purchase.notes||'Tidak ada catatan tambahan.' %></div><div class="totals"><div><span>Subtotal</span><b><%= formatRupiah(purchase.subtotal) %></b></div><div><span>Diskon</span><b>− <%= formatRupiah(purchase.discount_amount) %></b></div><div><span>Ongkir</span><b><%= formatRupiah(purchase.shipping_amount) %></b></div><div><span>Pajak</span><b><%= formatRupiah(purchase.tax_amount) %></b></div><div class="grand"><span>Grand Total</span><span><%= formatRupiah(purchase.grand_total) %></span></div><div><span>Sudah dibayar</span><b><%= formatRupiah(purchase.paid_amount) %></b></div><% if(Number(purchase.grand_total)>Number(purchase.paid_amount)){ %><div class="due"><span>Sisa utang</span><b><%= formatRupiah(Number(purchase.grand_total)-Number(purchase.paid_amount)) %></b></div><% } %></div></section>
<section class="signatures"><div>Supplier / Pengirim</div><div><%= purchase.receiver_name||purchase.creator_name||'Petugas Gudang' %></div></section></div>
<footer class="foot"><span>Dibuat otomatis oleh INKAMNET Control Center</span><span><%= purchase.created_at?new Date(purchase.created_at).toLocaleString('id-ID'):'' %></span></footer></main></body></html>
