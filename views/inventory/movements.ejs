<section><div class="module-head"><div><div class="module-kicker">WAREHOUSE MOVEMENT</div><h1>Pergerakan Stock</h1><p>Audit trail semua barang masuk dan keluar dari gudang.</p></div><div class="module-actions"><a href="/inventory" class="btn-tech"><i class="bi bi-box-seam"></i>Stock Barang</a><a href="/inventory/usage" class="btn-tech"><i class="bi bi-tools"></i>Pemakaian Material</a></div></div>
<div class="metric-grid"><article class="metric-card green"><div class="metric-top"><span class="metric-label">Stock Masuk Hari Ini</span><span class="metric-icon"><i class="bi bi-box-arrow-in-down"></i></span></div><strong><%= Number(today.stock_in||0) %></strong><small>Unit / qty masuk</small></article><article class="metric-card red"><div class="metric-top"><span class="metric-label">Stock Keluar Hari Ini</span><span class="metric-icon"><i class="bi bi-box-arrow-up"></i></span></div><strong><%= Number(today.stock_out||0) %></strong><small>Unit / qty keluar</small></article><article class="metric-card"><div class="metric-top"><span class="metric-label">Movement Hari Ini</span><span class="metric-icon"><i class="bi bi-arrow-left-right"></i></span></div><strong><%= Number(today.movements||0) %></strong><small>Transaksi stock</small></article><article class="metric-card"><div class="metric-top"><span class="metric-label">Audit Trail</span><span class="metric-icon"><i class="bi bi-clock-history"></i></span></div><strong>ACTIVE</strong><small>Semua movement tercatat</small></article></div>
<div class="data-card"><div class="data-card-head"><div><h3>Stock Movement History</h3><small>Riwayat terbaru dari seluruh gudang.</small></div><div class="warehouse-tabs"><a href="/inventory">Stock</a><a class="active" href="/inventory/movements">Movement</a><a href="/inventory/usage">Usage</a><a href="/inventory/suppliers">Supplier</a></div></div><div class="table-responsive"><table class="app-table" data-bulk-scope="movementsDeleteBulkBar"><thead><tr><% if(isAdmin){ %><th class="app-check-col"><input type="checkbox" class="form-check-input" data-select-all aria-label="Pilih semua entri movement"></th><% } %><th class="app-seq-col">No.</th><th>Waktu</th><th>Barang</th><th>Type</th><th>Qty</th><th>Referensi</th><th>Petugas</th><th>Catatan</th><% if(isAdmin){ %><th class="invoice-action-head">Tindakan</th><% } %></tr></thead><tbody><% movements.forEach((m,index)=>{ %><tr><% if(isAdmin){ %><td class="app-check-col"><input type="checkbox" class="form-check-input" data-row-check value="<%= m.id %>" aria-label="Pilih movement <%= m.id %>"></td><% } %><td><span class="cell-main"><%= index+1 %></span></td><td><%= new Date(m.created_at).toLocaleString('id-ID',{timeZone:'Asia/Jakarta'}) %></td><td><span class="cell-main"><%= m.item_name %></span><span class="cell-sub"><%= m.item_code||'-' %></span></td><td><span class="status-badge <%= m.movement_type==='in'?'green':m.movement_type==='out'?'red':'purple' %>"><%= m.movement_type %></span></td><td><b><%= m.qty %></b> <%= m.unit %></td><td><%= m.reference||'-' %></td><td><%= m.user_name||'-' %></td><td><%= m.notes||'-' %></td><% if(isAdmin){ %><td class="invoice-action-cell"><div class="invoice-inline-actions"><button class="action-menu" type="button" data-action-popover-target="moveAction<%= m.id %>" aria-label="Buka tindakan movement <%= m.id %>"><i class="bi bi-three-dots-vertical"></i></button></div><div class="ink-action-popover" id="moveAction<%= m.id %>" hidden><div class="ink-action-popover-head"><div><small>MOVEMENT</small><strong><%= m.item_name %></strong><span><%= m.reference||'-' %></span></div></div><div class="ink-action-popover-body"><form method="post" action="/inventory/movements/<%= m.id %>/delete" onsubmit="return confirm('Hapus entri movement <%= m.item_name %> ini? Saldo stock akan dikoreksi balik otomatis (<%= m.movement_type==='out'?'qty ditambahkan kembali':'qty dikurangi' %> sebesar <%= m.qty %> <%= m.unit %>).')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="ink-action-item compact danger" type="submit"><i class="bi bi-trash3"></i><span><b>Hapus & Koreksi Stock</b><small>Saldo stock otomatis disesuaikan balik</small></span></button></form></div></div></td><% } %></tr><% }) %><% if(!movements.length){ %><tr><td colspan="<%= isAdmin?10:8 %>"><div class="empty-state"><i class="bi bi-arrow-left-right"></i><strong>Belum ada movement</strong><small>Pergerakan barang akan muncul otomatis di sini.</small></div></td></tr><% } %></tbody></table></div>
</div>
<% if(isAdmin){ %><div class="customer-bulk-bar" id="movementsDeleteBulkBar" hidden><span><b data-bulk-count>0</b> movement terpilih</span><div class="customer-bulk-buttons"><button type="button" data-bulk-clear class="ghost"><i class="bi bi-x-lg"></i>Batal</button><button type="button" class="danger" data-simple-delete-bulk data-bulk-scope-id="movementsDeleteBulkBar" data-bulk-url="/inventory/movements/bulk" data-bulk-action-field="action" data-bulk-action-value="delete" data-bulk-id-field="movement_ids[]" data-entity-label-plural="movement" data-simple-delete-title="Hapus entri movement terpilih?" data-simple-delete-warning="Saldo stock setiap item akan dikoreksi balik otomatis sesuai tipe movement (in/out/adjustment) sebelum entri dihapus permanen."><i class="bi bi-trash3-fill"></i>Hapus Massal</button></div></div><% } %>
</section>
