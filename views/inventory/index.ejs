<link rel="stylesheet" href="/css/inventory.css?v=<%= typeof assetVersion!=='undefined'?assetVersion:'1' %>">
<%
  const F=filters||{};
  const qs=(over={})=>{const p=new URLSearchParams();const m={site,q:F.q,category:F.category,supplier:F.supplier,status:F.status,sort:F.sort,...over};Object.entries(m).forEach(([k,v])=>{if(v)p.set(k,v)});const s=p.toString();return `/inventory${s?`?${s}`:''}`;};
  const C=summary.counts, T=tabCounts;
  const gaugeLen=2*Math.PI*50, gaugeTone=summary.health>=80?'var(--success)':summary.health>=55?'var(--warning)':'var(--danger)';
  const toneOf=i=>i.status==='critical'?'var(--danger)':i.status==='low'?'var(--warning)':i.soon?'#ffd60a':'var(--brand)';
  const dayCls=i=>i.qty<=0||(i.daysLeft!=null&&i.daysLeft<=7)?'bad':i.soon?'warn':i.daysLeft==null?'none':'';
  const fmtTime=d=>new Intl.DateTimeFormat('id-ID',{hour:'2-digit',minute:'2-digit',timeZone:'Asia/Jakarta'}).format(new Date(d));
  const fmtDay=d=>new Intl.DateTimeFormat('id-ID',{day:'2-digit',month:'short',timeZone:'Asia/Jakarta'}).format(new Date(d));
  const num=v=>Number(v||0).toLocaleString('id-ID',{maximumFractionDigits:2});
%>
<section class="inventory-page">
  <div class="module-head">
    <div><div class="module-kicker">WAREHOUSE CONTROL</div><h1>Stock Barang</h1><p>Pantau kesehatan stock, estimasi habis, dan aktivitas gudang dalam satu layar.</p></div>
    <div class="module-actions">
      <a class="btn-tech" href="/inventory/insights<%= site?`?site=${encodeURIComponent(site)}`:'' %>"><i class="bi bi-graph-up-arrow"></i>Analitik</a>
      <a class="btn-tech" href="/inventory/movements"><i class="bi bi-arrow-left-right"></i>Pergerakan</a>
      <a class="btn-tech" href="/inventory/usage"><i class="bi bi-tools"></i>Pemakaian</a>
      <div class="dropdown"><button class="btn-tech dropdown-toggle" type="button" data-bs-toggle="dropdown"><i class="bi bi-grid-3x3-gap"></i>Alat</button><ul class="dropdown-menu dropdown-menu-end">
        <li><a class="dropdown-item" href="/inventory/opname<%= site?`?site=${encodeURIComponent(site)}`:'' %>"><i class="bi bi-upc-scan me-2"></i>Stock Opname</a></li>
        <li><a class="dropdown-item" href="/inventory/reorder<%= site?`?site=${encodeURIComponent(site)}`:'' %>"><i class="bi bi-cart-plus me-2"></i>Saran Pembelian</a></li>
        <li><a class="dropdown-item" href="/inventory/wall<%= site?`?site=${encodeURIComponent(site)}`:'' %>" target="_blank"><i class="bi bi-tv me-2"></i>Layar Gudang (TV)</a></li>
        <li><hr class="dropdown-divider"></li>
        <li><form method="post" action="/inventory/wa-digest" onsubmit="return confirm('Kirim ringkasan stock ke WhatsApp tim gudang sekarang?')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="dropdown-item" type="submit"><i class="bi bi-whatsapp me-2"></i>Kirim Ringkasan WA</button></form></li>
        <li><button class="dropdown-item" type="button" data-bs-toggle="modal" data-bs-target="#categoryModal"><i class="bi bi-tags me-2"></i>Kelola Kategori</button></li>
      </ul></div>
      <div class="dropdown"><button class="btn-tech dropdown-toggle" type="button" data-bs-toggle="dropdown"><i class="bi bi-file-earmark-spreadsheet"></i>Excel</button><ul class="dropdown-menu dropdown-menu-end">
        <li><a class="dropdown-item" href="/inventory/template.xlsx"><i class="bi bi-file-earmark-arrow-down me-2"></i>Template XLSX</a></li>
        <li><a class="dropdown-item" href="/inventory/export.xlsx<%= site?'?site='+encodeURIComponent(site):'' %>"><i class="bi bi-download me-2"></i>Export XLSX</a></li>
        <li><button class="dropdown-item" type="button" data-bs-toggle="modal" data-bs-target="#inventoryImportModal"><i class="bi bi-upload me-2"></i>Import XLSX</button></li>
      </ul></div>
      <button class="btn-tech primary" data-bs-toggle="modal" data-bs-target="#inventoryModal"><i class="bi bi-plus-lg"></i>Tambah Barang</button>
    </div>
  </div>

  <div class="inv-overview">
    <article class="inv-panel">
      <div class="inv-panel-head"><div><span>Stock Health</span><h3>Kesehatan Gudang</h3></div><i class="bi bi-heart-pulse"></i></div>
      <div class="inv-gauge">
        <div class="inv-gauge-ring"><svg viewBox="0 0 120 120"><circle class="track" cx="60" cy="60" r="50" fill="none" stroke-width="11"/><circle class="val" cx="60" cy="60" r="50" fill="none" stroke="<%= gaugeTone %>" stroke-width="11" stroke-linecap="round" stroke-dasharray="<%= gaugeLen.toFixed(1) %>" stroke-dashoffset="<%= (gaugeLen*(1-summary.health/100)).toFixed(1) %>"/></svg><div><strong><%= summary.health %>%</strong><small>SEHAT</small></div></div>
        <div class="inv-gauge-legend">
          <a href="<%= qs({status:'ready'}) %>"><i class="tone-ready"></i>Aman<b><%= C.ready %></b></a>
          <a href="<%= qs({status:'low'}) %>"><i class="tone-low"></i>Low<b><%= C.low %></b></a>
          <a href="<%= qs({status:'critical'}) %>"><i class="tone-critical"></i>Critical<b><%= C.critical %></b></a>
          <a href="<%= qs({status:'soon'}) %>"><i class="tone-soon"></i>Habis ≤<%= soonDays %> hari<b><%= C.soon %></b></a>
          <a href="<%= qs({status:'dead'}) %>"><i class="tone-dead"></i>Dead stock<b><%= C.dead %></b></a>
        </div>
      </div>
    </article>

    <article class="inv-panel">
      <div class="inv-panel-head"><div><span>Prioritas</span><h3>Perlu Tindakan Hari Ini</h3></div><a href="<%= qs({status:'action'}) %>">Lihat semua (<%= summary.actionList.length %>) →</a></div>
      <% if(summary.actionList.length){ %><div class="inv-action-list"><% summary.actionList.slice(0,5).forEach(i=>{ %>
        <div class="inv-action-row"><i style="background:<%= toneOf(i) %>"></i><div class="name"><a href="/inventory/<%= i.id %>"><%= i.name %></a><small>Sisa <b><%= num(i.qty) %> <%= i.unit %></b><%= i.min_stock?` / min ${num(i.min_stock)}`:'' %> · <%= daysLeftLabel(i) %><%= i.site_code?` · ${i.site_code}`:'' %></small></div><div class="acts"><button class="inv-mini-btn" type="button" data-bs-toggle="modal" data-bs-target="#adjust<%= i.id %>" data-movement="in"><i class="bi bi-box-arrow-in-down"></i>Stock Masuk</button><a class="inv-mini-btn primary" href="/inventory/reorder?item=<%= i.id %><%= site?`&site=${encodeURIComponent(site)}`:'' %>"><i class="bi bi-cart-plus"></i>PO</a></div></div>
      <% }) %></div><% }else{ %><div class="inv-empty-ok"><i class="bi bi-check-circle-fill"></i><b>Semua stock aman</b><small>Tidak ada barang low, critical, atau akan habis.</small></div><% } %>
    </article>

    <article class="inv-panel">
      <div class="inv-panel-head"><div><span>Live</span><h3>Aktivitas Gudang</h3></div><a href="/inventory/movements">Riwayat →</a></div>
      <% if(activity.length){ %><ul class="inv-timeline"><% activity.forEach(m=>{ %><li><time title="<%= formatDateTime(m.created_at) %>"><%= new Date(m.created_at).toDateString()===new Date().toDateString()?fmtTime(m.created_at):fmtDay(m.created_at) %></time><span class="dot <%= m.movement_type %>"><i class="bi <%= m.movement_type==='out'?'bi-arrow-up':m.movement_type==='in'?'bi-arrow-down':'bi-sliders' %>"></i></span><div><b><%= m.user_name||'Sistem' %></b> · <%= m.movement_type==='out'?'keluar':m.movement_type==='in'?'masuk':'penyesuaian' %> <b><%= num(m.qty) %> <%= m.unit %></b> <a href="/inventory/<%= m.item_id %>" class="text-decoration-none"><%= m.item_name %></a><small><%= m.reference||m.notes||'-' %></small></div></li><% }) %></ul><% }else{ %><div class="inv-empty-ok"><i class="bi bi-clock-history" style="color:var(--muted)"></i><small>Belum ada aktivitas.</small></div><% } %>
    </article>
  </div>

  <div class="inv-metric-grid">
    <a class="metric-card <%= !F.status?'is-active':'' %>" href="<%= qs({status:''}) %>"><div class="metric-top"><span class="metric-label">SKU Aktif</span><span class="metric-icon"><i class="bi bi-box-seam-fill"></i></span></div><strong><%= C.all %></strong><small><%= num(summary.units) %> unit total</small></a>
    <a class="metric-card green" href="/inventory/insights<%= site?`?site=${encodeURIComponent(site)}`:'' %>"><div class="metric-top"><span class="metric-label">Nilai Stock</span><span class="metric-icon"><i class="bi bi-cash-coin"></i></span></div><strong><%= formatRupiah(summary.value) %></strong><small>Lihat per kategori →</small></a>
    <a class="metric-card red <%= F.status==='critical'?'is-active':'' %>" href="<%= qs({status:'critical'}) %>"><div class="metric-top"><span class="metric-label">Critical</span><span class="metric-icon"><i class="bi bi-exclamation-octagon-fill"></i></span></div><strong><%= C.critical %></strong><small>≤ 50% minimum stock</small></a>
    <a class="metric-card <%= F.status==='low'?'is-active':'' %>" href="<%= qs({status:'low'}) %>" style="--metric-accent:var(--warning)"><div class="metric-top"><span class="metric-label">Low Stock</span><span class="metric-icon" style="color:var(--warning)"><i class="bi bi-exclamation-triangle-fill"></i></span></div><strong><%= C.low %></strong><small>Di bawah minimum</small></a>
    <a class="metric-card yellow <%= F.status==='soon'?'is-active':'' %>" href="<%= qs({status:'soon'}) %>"><div class="metric-top"><span class="metric-label">Akan Habis</span><span class="metric-icon"><i class="bi bi-hourglass-split"></i></span></div><strong><%= C.soon %></strong><small>Estimasi ≤ <%= soonDays %> hari</small></a>
    <a class="metric-card gray <%= F.status==='dead'?'is-active':'' %>" href="<%= qs({status:'dead'}) %>"><div class="metric-top"><span class="metric-label">Dead Stock</span><span class="metric-icon"><i class="bi bi-moon-stars-fill"></i></span></div><strong><%= C.dead %></strong><small><%= formatRupiah(summary.deadValue) %> mengendap</small></a>
  </div>

  <div class="data-card inv-list" id="invList" data-view="table">
    <div class="data-card-head"><div class="inv-tabs">
      <% [['','Semua',T.all],['action','Perlu Tindakan',T.action],['critical','Critical',T.critical],['low','Low',T.low],['soon','Akan Habis',T.soon],['dead','Dead',T.dead],['empty','Habis',T.empty]].forEach(([k,label,count])=>{ %><a class="<%= F.status===k?'active':'' %> t-<%= k||'all' %>" href="<%= qs({status:k}) %>"><%= label %><b><%= count %></b></a><% }) %>
    </div><div class="warehouse-tabs"><a class="active" href="/inventory">Stock</a><a href="/inventory/movements">Movement</a><a href="/inventory/usage">Usage</a><a href="/inventory/suppliers">Supplier</a></div></div>
    <div class="inv-toolbar">
      <form method="get" data-inv-filter>
        <% if(F.status){ %><input type="hidden" name="status" value="<%= F.status %>"><% } %>
        <div class="inv-search"><i class="bi bi-search"></i><input class="form-control form-control-sm" type="search" name="q" value="<%= F.q %>" placeholder="Cari nama, kode, barcode, lokasi…" autocomplete="off"></div>
        <select class="form-select form-select-sm" name="site"><option value="">Semua Site</option><% sites.forEach(s=>{ %><option value="<%= s.code %>" <%= site===s.code?'selected':'' %>><%= s.code %></option><% }) %></select>
        <select class="form-select form-select-sm" name="category"><option value="">Semua Kategori</option><% categories.forEach(c=>{ %><option value="<%= c.id %>" <%= String(F.category)===String(c.id)?'selected':'' %>><%= c.name %></option><% }) %></select>
        <select class="form-select form-select-sm" name="supplier"><option value="">Semua Supplier</option><% suppliers.forEach(s=>{ %><option value="<%= s.id %>" <%= String(F.supplier)===String(s.id)?'selected':'' %>><%= s.name %></option><% }) %></select>
        <select class="form-select form-select-sm" name="sort"><option value="">Urut: Prioritas</option><option value="days" <%= F.sort==='days'?'selected':'' %>>Estimasi habis</option><option value="qty" <%= F.sort==='qty'?'selected':'' %>>Stock terkecil</option><option value="value" <%= F.sort==='value'?'selected':'' %>>Nilai terbesar</option><option value="moved" <%= F.sort==='moved'?'selected':'' %>>Baru bergerak</option><option value="name" <%= F.sort==='name'?'selected':'' %>>Nama A–Z</option></select>
        <% if(F.q||F.category||F.supplier||F.status||F.sort||site){ %><a class="btn-tech" style="height:31px" href="/inventory"><i class="bi bi-x-lg"></i>Reset</a><% } %>
      </form>
      <small class="text-muted"><%= items.length %> barang</small>
      <div class="inv-view-toggle" role="group" aria-label="Tampilan"><button type="button" data-view-btn="table" title="Tabel"><i class="bi bi-list-ul"></i></button><button type="button" data-view-btn="card" title="Kartu"><i class="bi bi-grid-3x2-gap"></i></button></div>
    </div>
    <div class="inv-bulkbar" data-bulkbar><i class="bi bi-check2-square"></i><span><b data-bulk-count>0</b> barang dipilih</span><button class="inv-mini-btn primary" type="button" data-bulk-labels><i class="bi bi-qr-code"></i>Cetak Label QR</button><button class="inv-mini-btn" type="button" data-bulk-clear>Batal</button></div>

    <div class="table-responsive inv-table-wrap"><table class="app-table inv-table"><thead><tr><th style="width:28px"><input class="inv-check" type="checkbox" data-check-all title="Pilih semua"></th><th>No.</th><th>Barang</th><th>Kategori</th><th>Site</th><th>Stock</th><th>Tren 30 hari</th><th>Estimasi Habis</th><th>Terakhir Gerak</th><th>Nilai</th><th>Status</th><th>Cepat</th><th>Tindakan</th></tr></thead><tbody>
      <% items.forEach((i,index)=>{ %>
      <tr class="inv-<%= i.status %>"><td><input class="inv-check" type="checkbox" value="<%= i.id %>" data-item-check></td><td><span class="cell-main"><%= index+1 %></span></td><td><a class="cell-main" href="/inventory/<%= i.id %>"><%= i.name %></a><span class="cell-sub"><%= i.item_code||'NO-SKU' %> · <%= i.location||i.barcode||'tanpa lokasi' %></span></td><td><%= i.category_name||'-' %></td><td><span class="status-badge purple"><%= i.site_code||'GLOBAL' %></span></td>
        <td class="inv-stock"><div class="inv-stock-top"><b><%= num(i.qty) %></b><small><%= i.unit %><%= i.min_stock?` · min ${num(i.min_stock)}`:'' %></small></div><div class="inv-bar <%= i.status %> <%= i.min_stock?'':'nomin' %>" title="Garis tengah = minimum stock"><i style="width:<%= i.barPct %>%"></i></div></td>
        <td><%- sparkSvg(i.spark,{tone:toneOf(i)}) %></td>
        <td><span class="inv-days <%= dayCls(i) %>"><%= daysLeftLabel(i) %></span><% if(i.avgDaily>0){ %><small class="d-block text-muted" style="font-size:11px"><%= num(i.avgDaily) %>/hari</small><% } %></td>
        <td class="inv-moved"><%= i.lastMoveLabel %><% if(i.lastMoveAt){ %><small><%= formatDate(i.lastMoveAt) %></small><% } %></td>
        <td class="money"><%= formatRupiah(i.value) %><small class="d-block text-muted" style="font-size:11px">@ <%= formatRupiah(i.purchase_price) %></small></td>
        <td><span class="status-badge <%= i.status==='critical'?'red':i.status==='low'?'orange':'green' %>"><%= i.status==='critical'?'critical':i.status==='low'?'low stock':'ready' %></span><%- i.soon&&i.status==='ready'?'<span class="inv-tag soon">SEGERA</span>':'' %><%- i.dead?'<span class="inv-tag dead">DEAD</span>':'' %></td>
        <td><div class="inv-quick"><button class="plus" type="button" title="Stock masuk" data-bs-toggle="modal" data-bs-target="#adjust<%= i.id %>" data-movement="in">+</button><button class="minus" type="button" title="Stock keluar" data-bs-toggle="modal" data-bs-target="#adjust<%= i.id %>" data-movement="out">−</button></div></td>
        <td><div class="invoice-inline-actions"><button class="action-menu" type="button" data-action-popover-target="stockAction<%= i.id %>"><i class="bi bi-three-dots-vertical"></i></button></div><div class="ink-action-popover" id="stockAction<%= i.id %>" hidden><div class="ink-action-popover-body"><a class="ink-action-item compact" href="/inventory/<%= i.id %>"><i class="bi bi-graph-up"></i><span><b>Detail & Grafik</b><small>Riwayat 90 hari</small></span></a><button type="button" class="ink-action-item compact" data-action-close data-bs-toggle="modal" data-bs-target="#editItem<%= i.id %>"><i class="bi bi-pencil-square"></i><span><b>Edit Barang</b><small>Identitas, kategori, barcode</small></span></button><button type="button" class="ink-action-item compact" data-action-close data-bs-toggle="modal" data-bs-target="#adjust<%= i.id %>"><i class="bi bi-arrow-left-right"></i><span><b>Sesuaikan Stock</b><small>Semua perubahan masuk audit trail</small></span></button><a class="ink-action-item compact" href="/inventory/reorder?item=<%= i.id %>"><i class="bi bi-cart-plus"></i><span><b>Saran Pembelian</b><small>Hitung kebutuhan beli</small></span></a><a class="ink-action-item compact" href="/inventory/<%= i.id %>/qr" target="_blank"><i class="bi bi-qr-code"></i><span><b>Buka QR Code</b><small>Cetak label item</small></span></a><form method="post" action="/inventory/<%= i.id %>/delete" onsubmit="return confirm('Arsipkan item ini? Stock harus sudah 0.');"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="ink-action-item compact danger" type="submit"><i class="bi bi-archive"></i><span><b>Arsipkan</b><small>Soft delete, riwayat tetap aman</small></span></button></form></div></div></td></tr>
      <% }) %>
      <% if(!items.length){ %><tr><td colspan="13"><div class="empty-state"><i class="bi bi-box-seam"></i><strong><%= C.all?'Tidak ada barang yang cocok dengan filter':'Gudang masih kosong' %></strong><small><%= C.all?'Ubah atau reset filter di atas.':'Tambahkan barang pertama atau import dari Excel.' %></small></div></td></tr><% } %>
    </tbody></table></div>

    <div class="inv-cards"><% items.forEach(i=>{ %>
      <div class="inv-card inv-<%= i.status %>"><div class="inv-card-top"><div><a href="/inventory/<%= i.id %>"><%= i.name %></a><small><%= i.item_code||'NO-SKU' %> · <%= i.site_code||'GLOBAL' %> · <%= i.category_name||'-' %></small></div><span class="status-badge <%= i.status==='critical'?'red':i.status==='low'?'orange':'green' %>"><%= i.status==='critical'?'critical':i.status==='low'?'low':'ready' %></span></div>
        <div class="inv-stock"><div class="inv-stock-top"><b><%= num(i.qty) %></b><small><%= i.unit %><%= i.min_stock?` · min ${num(i.min_stock)}`:'' %></small></div><div class="inv-bar <%= i.status %> <%= i.min_stock?'':'nomin' %>"><i style="width:<%= i.barPct %>%"></i></div></div>
        <%- sparkSvg(i.spark,{width:200,height:30,tone:toneOf(i)}) %>
        <div class="inv-card-meta"><span class="inv-days <%= dayCls(i) %>"><%= daysLeftLabel(i) %></span><span><%= i.lastMoveLabel %></span></div>
        <div class="inv-card-foot"><div class="inv-quick"><button class="plus" type="button" data-bs-toggle="modal" data-bs-target="#adjust<%= i.id %>" data-movement="in">+</button><button class="minus" type="button" data-bs-toggle="modal" data-bs-target="#adjust<%= i.id %>" data-movement="out">−</button></div><a class="inv-mini-btn" href="/inventory/<%= i.id %>">Detail</a><%- i.dead?'<span class="inv-tag dead">DEAD</span>':'' %></div>
        <input class="inv-check" type="checkbox" value="<%= i.id %>" data-item-check>
      </div>
    <% }) %><% if(!items.length){ %><div class="empty-state" style="grid-column:1/-1"><i class="bi bi-box-seam"></i><strong>Tidak ada barang</strong></div><% } %></div>
  </div>
</section>
<script>
(()=>{
  const list=document.getElementById('invList');if(!list)return;
  // Tampilan tabel/kartu — disimpan per browser; default kartu di layar kecil.
  let view='table';try{view=localStorage.getItem('inkamnet-inv-view')||(matchMedia('(max-width:767px)').matches?'card':'table');}catch(_){}
  const setView=v=>{list.dataset.view=v;list.querySelectorAll('[data-view-btn]').forEach(b=>b.classList.toggle('active',b.dataset.viewBtn===v));try{localStorage.setItem('inkamnet-inv-view',v)}catch(_){}};
  setView(view);list.querySelectorAll('[data-view-btn]').forEach(b=>b.addEventListener('click',()=>setView(b.dataset.viewBtn)));
  // Filter otomatis submit (select langsung, pencarian setelah jeda ketik).
  const form=list.querySelector('[data-inv-filter]');
  if(form){form.querySelectorAll('select').forEach(s=>s.addEventListener('change',()=>form.submit()));const q=form.querySelector('input[name=q]');let t;q&&q.addEventListener('input',()=>{clearTimeout(t);t=setTimeout(()=>form.submit(),550)});if(q&&q.value){q.focus();q.setSelectionRange(q.value.length,q.value.length);}}
  // Pilih banyak → cetak label QR. Checkbox tabel & kartu disinkronkan per id.
  const bar=list.querySelector('[data-bulkbar]'),count=list.querySelector('[data-bulk-count]');
  const selected=()=>[...new Set([...list.querySelectorAll('[data-item-check]:checked')].map(c=>c.value))];
  const refresh=()=>{const s=selected();count.textContent=s.length;bar.classList.toggle('show',s.length>0);};
  list.addEventListener('change',e=>{const c=e.target;if(c.matches('[data-item-check]')){list.querySelectorAll(`[data-item-check][value="${c.value}"]`).forEach(x=>x.checked=c.checked);refresh();}if(c.matches('[data-check-all]')){list.querySelectorAll('[data-item-check]').forEach(x=>x.checked=c.checked);refresh();}});
  list.querySelector('[data-bulk-clear]').addEventListener('click',()=>{list.querySelectorAll('[data-item-check],[data-check-all]').forEach(x=>x.checked=false);refresh();});
  list.querySelector('[data-bulk-labels]').addEventListener('click',()=>{const s=selected();if(s.length)window.open(`/inventory/labels?ids=${s.join(',')}`,'_blank');});
  // Quick adjust: tombol +/− membuka modal dengan jenis pergerakan terpilih & fokus ke Qty.
  document.addEventListener('show.bs.modal',e=>{const trg=e.relatedTarget;const sel=e.target.querySelector('select[name=movement_type]');if(sel&&trg&&trg.dataset.movement)sel.value=trg.dataset.movement;});
  document.addEventListener('shown.bs.modal',e=>{const q=e.target.querySelector('input[name=qty]');if(q&&e.target.id.startsWith('adjust'))q.focus();});
})();
</script>


<div class="modal fade" id="inventoryModal" tabindex="-1"><div class="modal-dialog modal-lg modal-dialog-centered"><form class="modal-content" method="post" action="/inventory"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="modal-header"><div><div class="module-kicker">NEW WAREHOUSE ITEM</div><h5 class="modal-title">Tambah Barang Gudang</h5></div><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="row g-3"><div class="col-md-4"><label class="form-label">Kode Item</label><input class="form-control" name="item_code" placeholder="ONT-HSGQ"></div><div class="col-md-8"><label class="form-label">Nama Item</label><input class="form-control" name="name" required></div><div class="col-md-4"><label class="form-label">Kategori</label><select class="form-select" name="category_id"><option value="">Pilih kategori</option><% categories.forEach(c=>{ %><option value="<%= c.id %>"><%= c.name %></option><% }) %></select><input class="form-control mt-2" name="category" placeholder="atau nama kategori baru"></div><div class="col-md-4"><label class="form-label">Barcode</label><input class="form-control" name="barcode" placeholder="Scan / isi barcode"></div><div class="col-md-4"><label class="form-label">Site</label><select class="form-select" name="site_id"><option value="">Global</option><% sites.forEach(s=>{ %><option value="<%= s.id %>"><%= s.code %></option><% }) %></select></div><div class="col-md-4"><label class="form-label">Supplier</label><select class="form-select" name="supplier_id"><option value="">Tanpa supplier</option><% suppliers.forEach(s=>{ %><option value="<%= s.id %>"><%= s.name %></option><% }) %></select></div><div class="col-md-4"><label class="form-label">Lokasi Gudang</label><input class="form-control" name="location" placeholder="Rak A1"></div><div class="col-md-2"><label class="form-label">Qty Awal</label><input class="form-control" type="number" step="0.01" min="0" name="qty" value="0"></div><div class="col-md-2"><label class="form-label">Unit</label><input class="form-control" name="unit" value="pcs"></div><div class="col-md-2"><label class="form-label">Min Stock</label><input class="form-control" type="number" step="0.01" min="0" name="min_stock" value="0"></div><div class="col-md-3"><label class="form-label">Harga Beli</label><input class="form-control" type="number" min="0" name="purchase_price" value="0"></div><div class="col-12"><label class="form-label">Catatan</label><textarea class="form-control" name="notes" rows="2"></textarea></div></div></div><div class="modal-footer"><button type="button" class="btn-tech" data-bs-dismiss="modal">Batal</button><button class="btn-tech primary">Simpan Barang</button></div></form></div></div>

<% (allItems||items).forEach(i=>{ %><div class="modal fade" id="editItem<%= i.id %>" tabindex="-1"><div class="modal-dialog modal-lg modal-dialog-centered"><form class="modal-content" method="post" action="/inventory/<%= i.id %>/edit"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="return_to" value="<%= typeof currentUrl!=='undefined'?currentUrl:'/inventory' %>"><div class="modal-header"><div><div class="module-kicker">EDIT WAREHOUSE ITEM</div><h5 class="modal-title">Edit · <%= i.name %></h5></div><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="row g-3"><div class="col-md-4"><label class="form-label">Kode Item</label><input class="form-control" name="item_code" value="<%= i.item_code||'' %>"></div><div class="col-md-8"><label class="form-label">Nama Item</label><input class="form-control" name="name" value="<%= i.name %>" required></div><div class="col-md-4"><label class="form-label">Kategori</label><select class="form-select" name="category_id"><option value="">Kategori lama / bebas</option><% categories.forEach(c=>{ %><option value="<%= c.id %>" <%= String(i.category_id||'')===String(c.id)?'selected':'' %>><%= c.name %></option><% }) %></select><input class="form-control mt-2" name="category" value="<%= i.category||'' %>"></div><div class="col-md-4"><label class="form-label">Barcode</label><input class="form-control" name="barcode" value="<%= i.barcode||'' %>"></div><div class="col-md-4"><label class="form-label">Site</label><select class="form-select" name="site_id"><option value="">Global</option><% sites.forEach(s=>{ %><option value="<%= s.id %>" <%= String(i.site_id||'')===String(s.id)?'selected':'' %>><%= s.code %></option><% }) %></select></div><div class="col-md-4"><label class="form-label">Supplier</label><select class="form-select" name="supplier_id"><option value="">Tanpa supplier</option><% suppliers.forEach(s=>{ %><option value="<%= s.id %>" <%= String(i.supplier_id||'')===String(s.id)?'selected':'' %>><%= s.name %></option><% }) %></select></div><div class="col-md-4"><label class="form-label">Lokasi Gudang</label><input class="form-control" name="location" value="<%= i.location||'' %>"></div><div class="col-md-4"><label class="form-label">Unit</label><input class="form-control" name="unit" value="<%= i.unit||'pcs' %>"></div><div class="col-md-4"><label class="form-label">Min Stock</label><input class="form-control" type="number" step="0.01" name="min_stock" value="<%= i.min_stock||0 %>"></div><div class="col-md-6"><label class="form-label">Harga Beli</label><input class="form-control" type="number" name="purchase_price" value="<%= i.purchase_price||0 %>"></div><div class="col-12"><label class="form-label">Catatan</label><textarea class="form-control" name="notes" rows="2"><%= i.notes||'' %></textarea></div></div><div class="form-help mt-2"><i class="bi bi-info-circle"></i> Qty saat ini (<%= i.qty %> <%= i.unit %>) diubah hanya melalui Sesuaikan Stock.</div></div><div class="modal-footer"><button type="button" class="btn-tech" data-bs-dismiss="modal">Batal</button><button class="btn-tech primary">Simpan Perubahan</button></div></form></div></div><% }) %>
<% (allItems||items).forEach(i=>{ %><div class="modal fade" id="adjust<%= i.id %>" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><form class="modal-content" method="post" action="/inventory/<%= i.id %>/adjust"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="return_to" value="<%= typeof currentUrl!=='undefined'?currentUrl:'/inventory' %>"><div class="modal-header"><div><div class="module-kicker">STOCK MOVEMENT</div><h5 class="modal-title"><%= i.name %></h5></div><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="row g-3"><div class="col-6"><label class="form-label">Pergerakan</label><select class="form-select" name="movement_type"><option value="in">Stock Masuk</option><option value="out">Stock Keluar</option><option value="adjustment">Penyesuaian</option></select></div><div class="col-6"><label class="form-label">Qty</label><input class="form-control" type="number" step="0.01" min="0.01" name="qty" required></div><div class="col-12"><label class="form-label">Referensi</label><input class="form-control" name="reference" placeholder="PO / Ticket / PSB"></div><div class="col-12"><label class="form-label">Catatan</label><textarea class="form-control" name="notes"></textarea></div></div></div><div class="modal-footer"><button class="btn-tech primary">Update Stock</button></div></form></div></div><% }) %>

<div class="modal fade" id="categoryModal" tabindex="-1"><div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content"><div class="modal-header"><div><div class="module-kicker">INVENTORY TAXONOMY</div><h5 class="modal-title">Kategori Barang</h5></div><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><form class="d-flex gap-2 mb-3" method="post" action="/inventory/categories"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input class="form-control" name="name" placeholder="Nama kategori baru" required><button class="btn-tech primary">Tambah</button></form><div class="table-responsive"><table class="app-table"><thead><tr><th>Kategori</th><th>Status</th><th></th></tr></thead><tbody><% (allCategories||[]).forEach(c=>{ %><tr><td><form class="d-flex gap-2" method="post" action="/inventory/categories/<%= c.id %>/edit"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input class="form-control form-control-sm" name="name" value="<%= c.name %>"><button class="btn-tech">Simpan</button></form></td><td><span class="status-badge <%= c.is_active?'green':'gray' %>"><%= c.is_active?'AKTIF':'NONAKTIF' %></span></td><td><form method="post" action="/inventory/categories/<%= c.id %>/toggle"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn-tech warning" type="submit"><%= c.is_active?'Nonaktifkan':'Aktifkan' %></button></form></td></tr><% }) %></tbody></table></div></div></div></div>

<div class="modal fade" id="inventoryImportModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><form class="modal-content" method="post" action="/inventory/import" enctype="multipart/form-data"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="modal-header"><div><div class="module-kicker">XLSX BULK DATA</div><h5 class="modal-title">Import Stock Barang</h5></div><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><label class="form-label">File XLSX</label><input class="form-control" type="file" name="inventory_file" accept=".xlsx" required><div class="form-help mt-2"><i class="bi bi-info-circle"></i> Gunakan Template XLSX atau hasil Export XLSX. Barang dicocokkan lewat <b>item_code</b> (atau <b>name + site_code</b> jika kode kosong): yang cocok diperbarui, sisanya jadi barang baru. Kolom <b>qty</b> = stock akhir; selisihnya otomatis tercatat di Pergerakan Stock (IMPORT-XLSX). Kosongkan qty jika stock tidak ingin diubah. Jika ada 1 baris error, seluruh import dibatalkan.</div></div><div class="modal-footer"><a class="btn-tech" href="/inventory/template.xlsx"><i class="bi bi-file-earmark-arrow-down"></i>Template</a><button class="btn-tech" type="button" data-bs-dismiss="modal">Batal</button><button class="btn-tech primary"><i class="bi bi-upload"></i>Import</button></div></form></div></div>
