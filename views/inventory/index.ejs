<section>
  <div class="module-head">
    <div><div class="module-kicker">WAREHOUSE CONTROL</div><h1>Stock Barang</h1><p>Gudang dipisahkan dari network agar stock, supplier, dan pemakaian material lebih mudah diaudit.</p></div>
    <div class="module-actions"><a class="btn-tech" href="/inventory/movements"><i class="bi bi-arrow-left-right"></i>Pergerakan Stock</a><a class="btn-tech" href="/inventory/usage"><i class="bi bi-tools"></i>Pemakaian</a><button class="btn-tech primary" data-bs-toggle="modal" data-bs-target="#inventoryModal"><i class="bi bi-plus-lg"></i>Tambah Barang</button></div>
  </div>
  <div class="metric-grid">
    <article class="metric-card"><div class="metric-top"><span class="metric-label">SKU Aktif</span><span class="metric-icon"><i class="bi bi-box-seam-fill"></i></span></div><strong><%= Number(summary.items||0) %></strong><small>Jenis barang tercatat</small></article>
    <article class="metric-card green"><div class="metric-top"><span class="metric-label">Nilai Stock</span><span class="metric-icon"><i class="bi bi-cash-coin"></i></span></div><strong><%= formatRupiah(summary.stock_value||0) %></strong><small>Qty × harga pembelian</small></article>
    <article class="metric-card red"><div class="metric-top"><span class="metric-label">Low Stock</span><span class="metric-icon"><i class="bi bi-exclamation-triangle-fill"></i></span></div><strong><%= Number(summary.low_stock||0) %></strong><small>Perlu restock segera</small></article>
    <article class="metric-card"><div class="metric-top"><span class="metric-label">Total Unit</span><span class="metric-icon"><i class="bi bi-boxes"></i></span></div><strong><%= Number(summary.total_qty||0) %></strong><small>Gabungan seluruh unit</small></article>
  </div>
  <div class="data-card">
    <div class="data-card-head"><div><h3>Warehouse Inventory</h3><small>ONT, kabel, connector, router, adaptor, tools, dan material lainnya.</small></div><div class="warehouse-tabs"><a class="active" href="/inventory">Stock</a><a href="/inventory/movements">Movement</a><a href="/inventory/usage">Usage</a><a href="/inventory/suppliers">Supplier</a></div></div>
    <div class="table-responsive"><table class="app-table"><thead><tr><th class="app-seq-col">No.</th><th>Barang</th><th>Kategori</th><th>Site</th><th>Supplier</th><th>Stock</th><th>Minimum</th><th>Harga Beli</th><th>Status</th><th class="invoice-action-head">Tindakan</th></tr></thead><tbody>
      <% items.forEach((i,index)=>{const low=Number(i.qty)<=Number(i.min_stock); const critical=Number(i.qty)<=Math.max(1,Number(i.min_stock)*.5);%><tr><td><span class="cell-main"><%= index+1 %></span></td><td><span class="cell-main"><%= i.name %></span><span class="cell-sub"><%= i.item_code||'NO-SKU' %> · <%= i.location||'Gudang' %></span></td><td><%= i.category||'-' %></td><td><span class="status-badge purple"><%= i.site_code||'GLOBAL' %></span></td><td><%= i.supplier_name||'-' %></td><td><span class="stock-number"><%= i.qty %></span> <%= i.unit %></td><td><%= i.min_stock %> <%= i.unit %></td><td class="money"><%= formatRupiah(i.purchase_price) %></td><td><span class="status-badge <%= critical?'red':low?'orange':'green' %>"><%= critical?'critical':low?'low stock':'ready' %></span></td><td class="invoice-action-cell"><div class="invoice-inline-actions"><button class="action-menu" type="button" data-action-popover-target="stockAction<%= i.id %>" aria-label="Buka tindakan barang <%= i.name %>"><i class="bi bi-three-dots-vertical"></i></button></div><div class="ink-action-popover" id="stockAction<%= i.id %>" hidden><div class="ink-action-popover-head"><div><small>BARANG</small><strong><%= i.name %></strong><span><%= i.item_code||'NO-SKU' %></span></div></div><div class="ink-action-popover-body"><button type="button" class="ink-action-item compact" data-action-close data-bs-toggle="modal" data-bs-target="#editItem<%= i.id %>"><i class="bi bi-pencil-square"></i><span><b>Edit Barang</b><small>Kategori, site, supplier, harga</small></span></button><button type="button" class="ink-action-item compact" data-action-close data-bs-toggle="modal" data-bs-target="#adjust<%= i.id %>"><i class="bi bi-arrow-left-right"></i><span><b>Sesuaikan Stock</b><small>Stock masuk / keluar tercatat di Movement</small></span></button></div></div></td></tr><% }) %>
      <% if(!items.length){ %><tr><td colspan="10"><div class="empty-state"><i class="bi bi-box-seam"></i><strong>Gudang masih kosong</strong><small>Tambahkan barang pertama untuk mulai stock control.</small></div></td></tr><% } %>
    </tbody></table></div>
  </div>
</section>
<div class="modal fade" id="inventoryModal" tabindex="-1"><div class="modal-dialog modal-lg modal-dialog-centered"><form class="modal-content" method="post" action="/inventory"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="modal-header"><div><div class="module-kicker">NEW WAREHOUSE ITEM</div><h5 class="modal-title">Tambah Barang Gudang</h5></div><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="row g-3"><div class="col-md-4"><label class="form-label">Kode Item</label><input class="form-control" name="item_code" placeholder="ONT-HSGQ"></div><div class="col-md-8"><label class="form-label">Nama Item</label><input class="form-control" name="name" required></div><div class="col-md-4"><label class="form-label">Kategori</label><select class="form-select" name="category"><option>ONT</option><option>Router</option><option>Kabel</option><option>Connector</option><option>Patchcord</option><option>Adaptor</option><option>Passive</option><option>Tools</option><option>Lainnya</option></select></div><div class="col-md-4"><label class="form-label">Site</label><select class="form-select" name="site_id"><option value="">Global</option><% sites.forEach(s=>{ %><option value="<%= s.id %>"><%= s.code %></option><% }) %></select></div><div class="col-md-4"><label class="form-label">Supplier</label><select class="form-select" name="supplier_id"><option value="">Tanpa supplier</option><% suppliers.forEach(s=>{ %><option value="<%= s.id %>"><%= s.name %></option><% }) %></select></div><div class="col-md-4"><label class="form-label">Lokasi Gudang</label><input class="form-control" name="location" placeholder="Rak A1"></div><div class="col-md-2"><label class="form-label">Qty Awal</label><input class="form-control" type="number" step="0.01" name="qty" value="0"></div><div class="col-md-2"><label class="form-label">Unit</label><input class="form-control" name="unit" value="pcs"></div><div class="col-md-2"><label class="form-label">Min Stock</label><input class="form-control" type="number" step="0.01" name="min_stock" value="0"></div><div class="col-md-2"><label class="form-label">Harga Beli</label><input class="form-control" type="number" name="purchase_price" value="0"></div><div class="col-12"><label class="form-label">Catatan</label><textarea class="form-control" name="notes" rows="2"></textarea></div></div></div><div class="modal-footer"><button type="button" class="btn-tech" data-bs-dismiss="modal">Batal</button><button class="btn-tech primary">Simpan Barang</button></div></form></div></div>
<% items.forEach(i=>{ %><div class="modal fade" id="editItem<%= i.id %>" tabindex="-1"><div class="modal-dialog modal-lg modal-dialog-centered"><form class="modal-content" method="post" action="/inventory/<%= i.id %>/edit"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="modal-header"><div><div class="module-kicker">EDIT WAREHOUSE ITEM</div><h5 class="modal-title">Edit · <%= i.name %></h5></div><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="row g-3"><div class="col-md-4"><label class="form-label">Kode Item</label><input class="form-control" name="item_code" value="<%= i.item_code||'' %>" placeholder="ONT-HSGQ"></div><div class="col-md-8"><label class="form-label">Nama Item</label><input class="form-control" name="name" value="<%= i.name %>" required></div><div class="col-md-4"><label class="form-label">Kategori</label><select class="form-select" name="category"><% ['ONT','Router','Kabel','Connector','Patchcord','Adaptor','Passive','Tools','Lainnya'].forEach(cat=>{ %><option <%= i.category===cat?'selected':'' %>><%= cat %></option><% }) %></select></div><div class="col-md-4"><label class="form-label">Site</label><select class="form-select" name="site_id"><option value="">Global</option><% sites.forEach(s=>{ %><option value="<%= s.id %>" <%= String(i.site_id||'')===String(s.id)?'selected':'' %>><%= s.code %></option><% }) %></select></div><div class="col-md-4"><label class="form-label">Supplier</label><select class="form-select" name="supplier_id"><option value="">Tanpa supplier</option><% suppliers.forEach(s=>{ %><option value="<%= s.id %>" <%= String(i.supplier_id||'')===String(s.id)?'selected':'' %>><%= s.name %></option><% }) %></select></div><div class="col-md-4"><label class="form-label">Lokasi Gudang</label><input class="form-control" name="location" value="<%= i.location||'' %>" placeholder="Rak A1"></div><div class="col-md-4"><label class="form-label">Unit</label><input class="form-control" name="unit" value="<%= i.unit %>"></div><div class="col-md-4"><label class="form-label">Min Stock</label><input class="form-control" type="number" step="0.01" name="min_stock" value="<%= i.min_stock %>"></div><div class="col-md-6"><label class="form-label">Harga Beli</label><input class="form-control" type="number" name="purchase_price" value="<%= i.purchase_price %>"></div><div class="col-12"><label class="form-label">Catatan</label><textarea class="form-control" name="notes" rows="2"><%= i.notes||'' %></textarea></div></div><div class="form-help mt-2"><i class="bi bi-info-circle"></i> Qty saat ini (<%= i.qty %> <%= i.unit %>) tidak diubah dari sini — gunakan tombol Sesuaikan Stock agar riwayat pergerakan tetap tercatat.</div></div><div class="modal-footer"><button type="button" class="btn-tech" data-bs-dismiss="modal">Batal</button><button class="btn-tech primary">Simpan Perubahan</button></div></form></div></div><% }) %>
<% items.forEach(i=>{ %><div class="modal fade" id="adjust<%= i.id %>" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><form class="modal-content" method="post" action="/inventory/<%= i.id %>/adjust"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="modal-header"><div><div class="module-kicker">STOCK MOVEMENT</div><h5 class="modal-title"><%= i.name %></h5></div><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="row g-3"><div class="col-6"><label class="form-label">Pergerakan</label><select class="form-select" name="movement_type"><option value="in">Stock Masuk</option><option value="out">Stock Keluar</option></select></div><div class="col-6"><label class="form-label">Qty</label><input class="form-control" type="number" step="0.01" min="0.01" name="qty" required></div><div class="col-12"><label class="form-label">Referensi</label><input class="form-control" name="reference" placeholder="PO / Ticket / PSB"></div><div class="col-12"><label class="form-label">Catatan</label><textarea class="form-control" name="notes"></textarea></div></div></div><div class="modal-footer"><button class="btn-tech primary">Update Stock</button></div></form></div></div><% }) %>
