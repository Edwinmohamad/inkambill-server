<section><div class="module-head"><div><div class="module-kicker">MATERIAL USAGE</div><h1>Pemakaian Material</h1><p>Material untuk PSB, ticket, migrasi, dan maintenance langsung mengurangi stock.</p></div><div class="module-actions"><a href="/inventory" class="btn-tech"><i class="bi bi-box-seam"></i>Stock</a><button class="btn-tech primary" data-bs-toggle="modal" data-bs-target="#usageModal"><i class="bi bi-plus-lg"></i>Catat Pemakaian</button></div></div>
<form class="filter-card" method="get" action="/inventory/usage">
  <div class="filter-grid">
    <div class="filter-group"><label>BARANG</label><select class="form-select" name="item"><option value="">Semua Barang</option><% items.forEach(i=>{ %><option value="<%= i.id %>" <%= String(filters.item)===String(i.id)?'selected':'' %>><%= i.name %></option><% }) %></select></div>
    <div class="filter-group"><label>SITE</label><select class="form-select" name="site"><option value="">Semua Site</option><% sites.forEach(s=>{ %><option value="<%= s.code %>" <%= filters.site===s.code?'selected':'' %>><%= s.code %> · <%= s.name %></option><% }) %></select></div>
    <div class="filter-group"><label>PURPOSE</label><select class="form-select" name="purpose"><option value="">Semua Purpose</option><option value="PSB" <%= filters.purpose==='PSB'?'selected':'' %>>PSB</option><option value="maintenance" <%= filters.purpose==='maintenance'?'selected':'' %>>Maintenance</option><option value="migrasi" <%= filters.purpose==='migrasi'?'selected':'' %>>Migrasi</option><option value="ticket" <%= filters.purpose==='ticket'?'selected':'' %>>Ticket</option><option value="operasional" <%= filters.purpose==='operasional'?'selected':'' %>>Operasional</option></select></div>
    <div class="filter-group"><label>DARI TANGGAL</label><input class="form-control" type="date" name="date_from" value="<%= filters.date_from %>"></div>
    <div class="filter-group"><label>SAMPAI TANGGAL</label><input class="form-control" type="date" name="date_to" value="<%= filters.date_to %>"></div>
    <div class="filter-group"><label>PENCARIAN</label><input class="form-control" name="q" value="<%= filters.q %>" placeholder="Pelanggan / ticket / referensi / catatan..."></div>
    <div class="filter-group d-flex align-items-end gap-2"><button class="btn-tech primary flex-fill"><i class="bi bi-funnel-fill"></i>Terapkan Filter</button><a class="btn-tech" href="/inventory/usage"><i class="bi bi-arrow-counterclockwise"></i></a></div>
  </div>
</form>
<div class="data-card"><div class="data-card-head"><div><h3>Material Usage History</h3><small>Traceable ke pelanggan, ticket, site, dan petugas.</small></div><div class="warehouse-tabs"><a href="/inventory">Stock</a><a href="/inventory/movements">Movement</a><a class="active" href="/inventory/usage">Usage</a><a href="/inventory/suppliers">Supplier</a></div></div><div class="table-responsive"><table class="app-table" data-bulk-scope="usageDeleteBulkBar"><thead><tr><% if(isAdmin){ %><th class="app-check-col"><input type="checkbox" class="form-check-input" data-select-all aria-label="Pilih semua entri pemakaian"></th><% } %><th class="app-seq-col">No.</th><th>Waktu</th><th>Barang</th><th>Qty</th><th>Purpose</th><th>Pelanggan</th><th>Ticket</th><th>Site</th><th>Petugas</th><th>Referensi</th><% if(isAdmin){ %><th class="invoice-action-head">Tindakan</th><% } %></tr></thead><tbody><% usages.forEach((u,index)=>{ %><tr><% if(isAdmin){ %><td class="app-check-col"><input type="checkbox" class="form-check-input" data-row-check value="<%= u.id %>" aria-label="Pilih pemakaian <%= u.id %>"></td><% } %><td><span class="cell-main"><%= index+1 %></span></td><td><%= new Date(u.used_at).toLocaleString('id-ID',{timeZone:'Asia/Jakarta'}) %></td><td><span class="cell-main"><%= u.item_name %></span></td><td><b><%= u.qty %></b> <%= u.unit %></td><td><span class="status-badge purple"><%= u.purpose %></span></td><td><%= u.customer_name||'-' %></td><td><%= u.ticket_code||'-' %></td><td><%= u.site_code||'-' %></td><td><%= u.used_by_name||'-' %></td><td><%= u.reference||'-' %></td><% if(isAdmin){ %><td class="invoice-action-cell"><div class="invoice-inline-actions"><button class="action-menu" type="button" data-action-popover-target="usageAction<%= u.id %>" aria-label="Buka tindakan pemakaian <%= u.id %>"><i class="bi bi-three-dots-vertical"></i></button></div><div class="ink-action-popover" id="usageAction<%= u.id %>" hidden><div class="ink-action-popover-head"><div><small>PEMAKAIAN</small><strong><%= u.item_name %></strong><span><%= u.reference||'-' %></span></div></div><div class="ink-action-popover-body"><form method="post" action="/inventory/usage/<%= u.id %>/delete" onsubmit="return confirm('Hapus entri pemakaian <%= u.item_name %> ini? Qty <%= u.qty %> <%= u.unit %> akan dikembalikan ke stock. Catatan: entri Pergerakan Stock terkait (jika ada) tidak ikut terhapus otomatis dan perlu dihapus terpisah bila diperlukan.')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="return_item" value="<%= filters.item %>"><input type="hidden" name="return_site" value="<%= filters.site %>"><input type="hidden" name="return_purpose" value="<%= filters.purpose %>"><input type="hidden" name="return_date_from" value="<%= filters.date_from %>"><input type="hidden" name="return_date_to" value="<%= filters.date_to %>"><input type="hidden" name="return_q" value="<%= filters.q %>"><button class="ink-action-item compact danger" type="submit"><i class="bi bi-trash3"></i><span><b>Hapus & Kembalikan Stock</b><small>Qty otomatis ditambahkan kembali</small></span></button></form></div></div></td><% } %></tr><% }) %><% if(!usages.length){ %><tr><td colspan="<%= isAdmin?12:10 %>"><div class="empty-state"><i class="bi bi-tools"></i><strong>Belum ada pemakaian material</strong><small>Catat material PSB atau ticket agar stock berkurang otomatis.</small></div></td></tr><% } %></tbody></table></div>
</div>
<% if(isAdmin){ %><div class="customer-bulk-bar" id="usageDeleteBulkBar" hidden><span><b data-bulk-count>0</b> pemakaian terpilih</span><div class="customer-bulk-buttons"><button type="button" data-bulk-clear class="ghost"><i class="bi bi-x-lg"></i>Batal</button><button type="button" class="danger" data-simple-delete-bulk data-bulk-scope-id="usageDeleteBulkBar" data-bulk-url="/inventory/usage/bulk?return_item=<%= encodeURIComponent(filters.item) %>&return_site=<%= encodeURIComponent(filters.site) %>&return_purpose=<%= encodeURIComponent(filters.purpose) %>&return_date_from=<%= encodeURIComponent(filters.date_from) %>&return_date_to=<%= encodeURIComponent(filters.date_to) %>&return_q=<%= encodeURIComponent(filters.q) %>" data-bulk-action-field="action" data-bulk-action-value="delete" data-bulk-id-field="usage_ids[]" data-entity-label-plural="pemakaian" data-simple-delete-title="Hapus entri pemakaian terpilih?" data-simple-delete-warning="Qty setiap item akan dikembalikan ke stock secara otomatis sebelum entri dihapus permanen. Entri Pergerakan Stock terkait tidak ikut terhapus otomatis."><i class="bi bi-trash3-fill"></i>Hapus Massal</button></div></div><% } %>
</section>
<div class="modal fade" id="usageModal" tabindex="-1"><div class="modal-dialog modal-lg modal-dialog-centered"><form method="post" action="/inventory/usage" class="modal-content"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="return_item" value="<%= filters.item %>"><input type="hidden" name="return_site" value="<%= filters.site %>"><input type="hidden" name="return_purpose" value="<%= filters.purpose %>"><input type="hidden" name="return_date_from" value="<%= filters.date_from %>"><input type="hidden" name="return_date_to" value="<%= filters.date_to %>"><input type="hidden" name="return_q" value="<%= filters.q %>"><div class="modal-header"><div><div class="module-kicker">MATERIAL OUT</div><h5 class="modal-title">Catat Pemakaian Material</h5></div><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="row g-3"><div class="col-md-8"><label class="form-label">Barang</label><select class="form-select" name="item_id" required><option value="">Pilih barang...</option><% items.forEach(i=>{ %><option value="<%= i.id %>"><%= i.name %> · stock <%= i.qty %> <%= i.unit %></option><% }) %></select></div><div class="col-md-4"><label class="form-label">Qty</label><input type="number" step="0.01" min="0.01" class="form-control" name="qty" required></div><div class="col-md-4"><label class="form-label">Purpose</label><select class="form-select" name="purpose"><option value="PSB">PSB</option><option value="maintenance">Maintenance</option><option value="migrasi">Migrasi</option><option value="ticket">Ticket</option><option value="operasional">Operasional</option></select></div><div class="col-md-4"><label class="form-label">Site</label><select class="form-select" name="site_id"><option value="">-</option><% sites.forEach(s=>{ %><option value="<%= s.id %>"><%= s.code %></option><% }) %></select></div><div class="col-md-4"><label class="form-label">Referensi</label><input class="form-control" name="reference" placeholder="PSB-001 / TT-001"></div><div class="col-md-6"><label class="form-label">Pelanggan</label><select class="form-select" name="customer_id"><option value="">Tidak terkait pelanggan</option><% customers.forEach(c=>{ %><option value="<%= c.id %>"><%= c.customer_code %> · <%= c.name %></option><% }) %></select></div><div class="col-md-6"><label class="form-label">Ticket</label><select class="form-select" name="ticket_id"><option value="">Tidak terkait ticket</option><% tickets.forEach(t=>{ %><option value="<%= t.id %>"><%= t.ticket_code %> · <%= t.subject %></option><% }) %></select></div><div class="col-12"><label class="form-label">Catatan</label><textarea class="form-control" name="notes" rows="3"></textarea></div></div></div><div class="modal-footer"><button class="btn-tech" type="button" data-bs-dismiss="modal">Batal</button><button class="btn-tech primary">Catat & Kurangi Stock</button></div></form></div></div>
