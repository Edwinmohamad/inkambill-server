<link rel="stylesheet" href="/css/inventory.css?v=<%= typeof assetVersion!=='undefined'?assetVersion:'1' %>">
<% const i=item; const num=v=>Number(v||0).toLocaleString('id-ID',{maximumFractionDigits:2}); const typeLabel={in:'Masuk',out:'Keluar',adjustment:'Penyesuaian'}; %>
<section class="inventory-page">
  <div class="module-head">
    <div><div class="module-kicker"><a href="/inventory" class="text-decoration-none">STOCK BARANG</a> / DETAIL</div><h1><%= i.name %></h1><p><%= i.item_code||'NO-SKU' %> · <%= i.category_name||'Tanpa kategori' %> · <%= i.site_code||'GLOBAL' %> · <%= i.supplier_name||'Tanpa supplier' %><%= i.location?` · ${i.location}`:'' %></p></div>
    <div class="module-actions"><a class="btn-tech" href="/inventory"><i class="bi bi-arrow-left"></i>Kembali</a><a class="btn-tech" href="/inventory/<%= i.id %>/qr" target="_blank"><i class="bi bi-qr-code"></i>QR</a><a class="btn-tech" href="/inventory/movements?item=<%= i.id %>"><i class="bi bi-arrow-left-right"></i>Semua Pergerakan</a><a class="btn-tech" href="/inventory/reorder?item=<%= i.id %>"><i class="bi bi-cart-plus"></i>Saran Beli</a><button class="btn-tech primary" data-bs-toggle="modal" data-bs-target="#adjustDetail"><i class="bi bi-arrow-left-right"></i>Sesuaikan Stock</button></div>
  </div>
  <div class="inv-kv mb-3">
    <div><span>Stock sekarang</span><strong><%= num(i.qty) %> <small><%= i.unit %></small></strong></div>
    <div><span>Minimum</span><strong><%= num(i.min_stock) %></strong></div>
    <div><span>Status</span><strong><span class="status-badge <%= i.status==='critical'?'red':i.status==='low'?'orange':'green' %>"><%= i.status %></span><%- i.dead?'<span class="inv-tag dead">DEAD</span>':'' %></strong></div>
    <div><span>Pemakaian / hari</span><strong><%= num(i.avgDaily) %></strong></div>
    <div><span>Estimasi habis</span><strong><%= daysLeftLabel(i) %></strong></div>
    <div><span>Keluar 30 hari</span><strong><%= num(i.usage30) %></strong></div>
    <div><span>Masuk 30 hari</span><strong><%= num(i.in30) %></strong></div>
    <div><span>Terakhir bergerak</span><strong><%= i.lastMoveLabel %></strong></div>
    <div><span>Nilai stock</span><strong><%= formatRupiah(i.value) %></strong></div>
  </div>
  <article class="inv-panel mb-3"><div class="inv-panel-head"><div><span>90 Hari</span><h3>Saldo Stock & Pergerakan Harian</h3></div></div><div class="inv-chart" style="height:290px"><canvas id="itemChart"></canvas></div></article>
  <div class="inv-grid-2">
    <div class="data-card"><div class="data-card-head"><div><h3>Riwayat Pergerakan</h3><small>100 terakhir</small></div></div><div class="table-responsive" style="max-height:460px"><table class="app-table"><thead><tr><th>Waktu</th><th>Jenis</th><th>Qty</th><th>Referensi</th><th>Oleh</th></tr></thead><tbody>
      <% movements.forEach(m=>{ %><tr><td><%= formatDateTime(m.created_at) %></td><td><span class="status-badge <%= m.movement_type==='out'?'red':m.movement_type==='in'?'green':'blue' %>"><%= typeLabel[m.movement_type]||m.movement_type %></span></td><td><b><%= m.movement_type==='out'?'−':'+' %><%= num(m.qty) %></b></td><td><%= m.reference||'-' %><span class="cell-sub"><%= m.notes||'' %></span></td><td><%= m.user_name||'-' %></td></tr><% }) %>
      <% if(!movements.length){ %><tr><td colspan="5"><div class="empty-state"><strong>Belum ada pergerakan</strong></div></td></tr><% } %></tbody></table></div></div>
    <div class="data-card"><div class="data-card-head"><div><h3>Pemakaian Material</h3><small>50 terakhir</small></div></div><div class="table-responsive" style="max-height:460px"><table class="app-table"><thead><tr><th>Tanggal</th><th>Qty</th><th>Tujuan</th><th>Pelanggan / Ticket</th><th>Oleh</th></tr></thead><tbody>
      <% usages.forEach(u=>{ %><tr><td><%= formatDate(u.used_at) %></td><td><b><%= num(u.qty) %></b></td><td><%= u.purpose %><span class="cell-sub"><%= u.site_code||'' %></span></td><td><%= u.customer_name||'-' %><span class="cell-sub"><%= u.ticket_code||u.reference||'' %></span></td><td><%= u.used_by_name||'-' %></td></tr><% }) %>
      <% if(!usages.length){ %><tr><td colspan="5"><div class="empty-state"><strong>Belum ada pemakaian</strong></div></td></tr><% } %></tbody></table></div></div>
  </div>
</section>
<div class="modal fade" id="adjustDetail" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><form class="modal-content" method="post" action="/inventory/<%= i.id %>/adjust"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="return_to" value="/inventory/<%= i.id %>"><div class="modal-header"><div><div class="module-kicker">STOCK MOVEMENT</div><h5 class="modal-title"><%= i.name %></h5></div><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="row g-3"><div class="col-6"><label class="form-label">Pergerakan</label><select class="form-select" name="movement_type"><option value="in">Stock Masuk</option><option value="out">Stock Keluar</option><option value="adjustment">Penyesuaian</option></select></div><div class="col-6"><label class="form-label">Qty</label><input class="form-control" type="number" step="0.01" min="0.01" name="qty" required></div><div class="col-12"><label class="form-label">Referensi</label><input class="form-control" name="reference" placeholder="PO / Ticket / PSB"></div><div class="col-12"><label class="form-label">Catatan</label><textarea class="form-control" name="notes"></textarea></div></div></div><div class="modal-footer"><button class="btn-tech primary">Update Stock</button></div></form></div></div>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
<script>
(()=>{if(typeof Chart==='undefined')return;const D=<%- JSON.stringify(chart).replace(/</g,'\\u003c') %>;const muted=getComputedStyle(document.documentElement).getPropertyValue('--muted').trim()||'#8893a8';const min=<%= Number(i.min_stock||0) %>;
new Chart(document.getElementById('itemChart'),{data:{labels:D.labels,datasets:[{type:'line',label:'Saldo stock',data:D.balance,borderColor:'#6C4FE0',backgroundColor:'rgba(108,79,224,.12)',fill:true,tension:.3,pointRadius:0,borderWidth:2.2,yAxisID:'y'},...(min?[{type:'line',label:'Minimum',data:D.labels.map(()=>min),borderColor:'#ff9f0a',borderDash:[5,4],pointRadius:0,borderWidth:1.4,yAxisID:'y'}]:[]),{type:'bar',label:'Masuk',data:D.ins,backgroundColor:'rgba(46,214,161,.55)',borderRadius:3,yAxisID:'y2'},{type:'bar',label:'Keluar',data:D.outs,backgroundColor:'rgba(255,105,105,.55)',borderRadius:3,yAxisID:'y2'}]},options:{responsive:true,maintainAspectRatio:false,interaction:{mode:'index',intersect:false},plugins:{legend:{labels:{color:muted,boxWidth:10,font:{size:11}}}},scales:{x:{grid:{display:false},ticks:{color:muted,maxTicksLimit:15}},y:{beginAtZero:true,position:'left',grid:{color:'rgba(148,163,184,.12)'},ticks:{color:muted},title:{display:true,text:'Saldo',color:muted}},y2:{beginAtZero:true,position:'right',grid:{display:false},ticks:{color:muted},title:{display:true,text:'Masuk/Keluar',color:muted}}}}});})();
</script>
