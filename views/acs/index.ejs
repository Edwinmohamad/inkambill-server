<section class="acs-page">
  <div class="module-head"><div><div class="module-kicker">LIVE MONITORING · GENIEACS TR-069</div><h1>Monitoring ONT</h1><p>Status pelanggan, redaman optik, dan jalur akses dalam satu layar.</p></div><div class="module-actions"><a class="btn-tech" href="/acs/reconcile"><i class="bi bi-link-45deg"></i>Rekonsiliasi</a><a class="btn-tech" href="/acs/map"><i class="bi bi-diagram-3-fill"></i>Network Map</a><% if(isAdmin){ %><form method="post" action="/acs/test"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn-tech"><i class="bi bi-plug-fill"></i>Test ACS</button></form><form method="post" action="/acs/sync" data-loading-message="Mengambil status ONT dari GenieACS..."><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="return_to" value="/acs"><button class="btn-tech primary"><i class="bi bi-arrow-repeat"></i>Sinkron Sekarang</button></form><% } %></div></div>
  <% if(!acsConfigured){ %><div class="alert alert-warning alert-modern"><i class="bi bi-exclamation-triangle-fill"></i> Koneksi belum dikonfigurasi. Isi <code>GENIEACS_NBI_URL</code> pada environment server.</div><% } %>
  <div class="acs-sync-strip <%= lastSync?.status||'none' %>"><i class="bi bi-cloud-check"></i><span><strong>Status sinkronisasi: <%= lastSync?.status||'belum pernah' %></strong><small><%= lastSync?.started_at?new Date(lastSync.started_at).toLocaleString('id-ID',{timeZone:'Asia/Jakarta'}):'Belum ada data' %><%= lastSync?.message?' · '+lastSync.message:'' %></small></span></div>
  <div class="metric-grid acs-metrics"><article class="metric-card"><span>Total ONT</span><strong><%= Number(summary.total||0) %></strong></article><article class="metric-card green"><span>Online</span><strong><%= Number(summary.online||0) %></strong></article><article class="metric-card red"><span>Offline</span><strong><%= Number(summary.offline||0) %></strong></article><article class="metric-card orange"><span>Sinyal Lemah</span><strong><%= Number(summary.warning||0) %></strong></article><article class="metric-card red"><span>Kritis</span><strong><%= Number(summary.critical||0) %></strong></article><article class="metric-card purple"><span>Belum Dipetakan</span><strong><%= Number(summary.unlinked||0) %></strong></article></div>
  <form class="filter-card" method="get"><div class="acs-filter-grid"><div class="search-box"><i class="bi bi-search"></i><input name="q" value="<%= filters.q %>" placeholder="Nama, ID, PPPoE, serial, SSID..."></div><select class="form-select" name="site"><option value="">Semua Site</option><% sites.forEach(s=>{ %><option value="<%= s.code %>" <%= filters.site===s.code?'selected':'' %>><%= s.code %></option><% }) %></select><select class="form-select" name="status"><option value="">Semua Status</option><option value="online" <%= filters.status==='online'?'selected':'' %>>Online</option><option value="offline" <%= filters.status==='offline'?'selected':'' %>>Offline</option><option value="unknown" <%= filters.status==='unknown'?'selected':'' %>>Unknown</option></select><select class="form-select" name="signal"><option value="">Semua Redaman</option><option value="normal" <%= filters.signal==='normal'?'selected':'' %>>Normal</option><option value="warning" <%= filters.signal==='warning'?'selected':'' %>>Lemah</option><option value="critical" <%= filters.signal==='critical'?'selected':'' %>>Kritis</option><option value="unknown" <%= filters.signal==='unknown'?'selected':'' %>>Belum Terbaca</option></select><select class="form-select" name="mapping"><option value="">Semua Mapping</option><option value="linked" <%= filters.mapping==='linked'?'selected':'' %>>Terhubung</option><option value="unlinked" <%= filters.mapping==='unlinked'?'selected':'' %>>Belum Terhubung</option></select><button class="btn-tech primary"><i class="bi bi-funnel"></i>Filter</button></div></form>
  <div class="data-card"><div class="data-card-head"><div><h3>Daftar ONT Pelanggan</h3><small><%= devices.length %> perangkat · data cache, halaman tetap cepat saat ACS tidak tersedia</small></div><div class="acs-legend"><span class="online">● Online</span><span class="warning">● Lemah</span><span class="offline">● Offline/Kritis</span></div></div><div class="table-responsive"><table class="app-table acs-table"><thead><tr><th>Status</th><th>Pelanggan</th><th>Site / ODP</th><th>ONT</th><th>PPPoE / WAN</th><th>RX Power</th><th>Last Inform</th><th>Wi-Fi</th></tr></thead><tbody><% devices.forEach(d=>{ %><tr><td><span class="acs-status <%= d.online_status %>"><i></i><%= d.online_status.toUpperCase() %></span></td><td><strong><%= d.customer_name||'Belum dipetakan' %></strong><small><%= d.customer_code||'Hubungkan melalui Rekonsiliasi' %></small></td><td><strong><%= d.site_code||'-' %></strong><small><%= d.cluster_name||d.odp_name||'ODP belum diisi' %></small></td><td><strong><%= d.manufacturer||d.oui||'-' %> <%= d.product_class||'' %></strong><small><%= d.serial_number||d.device_id %></small></td><td><strong><%= d.pppoe_username||'-' %></strong><small><%= d.wan_ip||'WAN IP belum terbaca' %></small></td><td><span class="acs-signal <%= d.signal_status %>"><%= d.rx_power==null?'N/A':Number(d.rx_power).toFixed(2)+' dBm' %></span><small><%= d.temperature==null?'':Number(d.temperature).toFixed(1)+' °C' %></small></td><td><strong><%= d.last_inform?new Date(d.last_inform).toLocaleString('id-ID',{timeZone:'Asia/Jakarta'}):'-' %></strong><small>Sinkron <%= d.last_synced_at?new Date(d.last_synced_at).toLocaleString('id-ID',{timeZone:'Asia/Jakarta'}):'-' %></small></td><td><strong><%= d.ssid||'-' %></strong><small><%= d.active_clients==null?'Client N/A':d.active_clients+' client aktif' %></small></td></tr><% }) %><% if(!devices.length){ %><tr><td colspan="8"><div class="empty-state"><i class="bi bi-router"></i><strong>Belum ada data ONT</strong><small>Konfigurasi GenieACS kemudian jalankan Sinkron Sekarang.</small></div></td></tr><% } %></tbody></table></div></div>
  <% if(isAdmin&&devices.length){ %><div class="data-card acs-safe-actions"><div class="data-card-head"><div><h3>Aksi ONT Terkendali</h3><small>Refresh aman; reboot memerlukan pengetikan serial sebagai konfirmasi dan selalu masuk audit log.</small></div></div><div class="acs-action-grid"><form method="post" action="/acs/devices/<%= devices[0].id %>/refresh" data-acs-device-form data-action-template="/acs/devices/{id}/refresh"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><select class="form-select" data-acs-device-select><% devices.forEach(d=>{ %><option value="<%= d.id %>" data-serial="<%= d.serial_number||d.device_id %>"><%= d.customer_name||'Belum dipetakan' %> · <%= d.serial_number||d.device_id %></option><% }) %></select><button class="btn-tech primary"><i class="bi bi-arrow-clockwise"></i>Refresh Parameter</button></form><form method="post" action="/acs/devices/<%= devices[0].id %>/reboot" data-acs-device-form data-action-template="/acs/devices/{id}/reboot" onsubmit="return confirm('ONT pelanggan akan reboot dan koneksi terputus sementara. Lanjutkan?')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><select class="form-select" data-acs-device-select><% devices.forEach(d=>{ %><option value="<%= d.id %>" data-serial="<%= d.serial_number||d.device_id %>"><%= d.customer_name||'Belum dipetakan' %> · <%= d.serial_number||d.device_id %></option><% }) %></select><input class="form-control" name="confirm" data-acs-confirm placeholder="Ketik serial ONT untuk reboot" required><button class="btn-tech danger"><i class="bi bi-power"></i>Reboot ONT</button></form></div></div><script>document.querySelectorAll('[data-acs-device-form]').forEach(form=>{const select=form.querySelector('[data-acs-device-select]'),confirmInput=form.querySelector('[data-acs-confirm]');const sync=()=>{form.action=form.dataset.actionTemplate.replace('{id}',encodeURIComponent(select.value));if(confirmInput){confirmInput.value='';confirmInput.placeholder='Ketik '+select.selectedOptions[0].dataset.serial;}};select.addEventListener('change',sync);sync();});</script><% } %>
</section>
