<section class="acs-page"><div class="module-head"><div><div class="module-kicker">DATA RECONCILIATION</div><h1>Hubungkan ONT & Pelanggan</h1><p>Mapping otomatis memakai PPPoE; pasangan manual akan dikunci dan tidak ditimpa.</p></div><div class="module-actions"><a class="btn-tech" href="/acs"><i class="bi bi-arrow-left"></i>Monitoring</a><a class="btn-tech" href="/acs/map"><i class="bi bi-diagram-3-fill"></i>Network Map</a></div></div><div class="acs-reconcile-grid"><div class="data-card"><div class="data-card-head"><div><h3>ONT Belum Terhubung</h3><small><%= devices.length %> perangkat</small></div></div><div class="acs-unlinked-list"><% devices.forEach(d=>{ %><article><span class="acs-status <%= d.online_status %>"><i></i><%= d.online_status %></span><div><strong><%= d.manufacturer||'-' %> <%= d.product_class||'' %></strong><small><%= d.serial_number||d.device_id %> · PPPoE <%= d.pppoe_username||'-' %></small></div><form method="post" action="/acs/link"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="acs_device_id" value="<%= d.id %>"><select class="form-select form-select-sm" name="customer_id" required><option value="">Pilih pelanggan...</option><% customers.forEach(c=>{ %><option value="<%= c.id %>"><%= c.site_code %> · <%= c.customer_code %> · <%= c.name %> · <%= c.pppoe_username||'-' %></option><% }) %></select><button class="btn-tech primary compact"><i class="bi bi-link-45deg"></i>Hubungkan</button></form></article><% }) %><% if(!devices.length){ %><div class="empty-state"><i class="bi bi-check-circle"></i><strong>Semua ONT sudah dipetakan</strong></div><% } %></div></div><div class="data-card"><div class="data-card-head"><div><h3>Pelanggan Tanpa ONT</h3><small><%= customers.length %> pelanggan aktif</small></div></div><div class="acs-customer-missing"><% customers.slice(0,300).forEach(c=>{ %><div><strong><%= c.name %></strong><small><%= c.customer_code %> · <%= c.site_code %>/<%= c.cluster_name||'-' %> · PPPoE <%= c.pppoe_username||'-' %></small></div><% }) %></div></div></div></section>
