<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="">
<section class="acs-page map-page"><div class="module-head"><div><div class="module-kicker">GEOGRAPHIC FIBER TOPOLOGY · OSM</div><h1>Network Map INKAMNET</h1><p>POP, OLT, ODC, ODP, tiang, rumah pelanggan, dan jalur kabel pada peta nyata.</p></div><div class="module-actions"><a class="btn-tech" href="/noc"><i class="bi bi-speedometer2"></i>NOC</a><a class="btn-tech" href="/acs"><i class="bi bi-list-ul"></i>Monitoring ONT</a><% if(isAdmin){ %><button class="btn-tech" data-bs-toggle="modal" data-bs-target="#mapNodeModal"><i class="bi bi-geo-alt-fill"></i>Tambah Titik</button><button class="btn-tech primary" data-bs-toggle="modal" data-bs-target="#mapLinkModal"><i class="bi bi-bezier2"></i>Hubungkan Jalur</button><% } %></div></div>
<div class="acs-map-toolbar"><span><i class="bi bi-clock-history"></i>ACS: <%= lastSync?.finished_at?new Date(lastSync.finished_at).toLocaleString('id-ID',{timeZone:'Asia/Jakarta'}):'belum sinkron' %></span><div class="acs-legend"><span class="online">● Online</span><span class="warning">● Warning</span><span class="offline">● Offline/kritis</span></div></div>
<div class="geo-map-shell"><aside class="geo-map-sidebar"><div class="search-box"><i class="bi bi-search"></i><input id="mapSearch" placeholder="Cari titik, site, pelanggan..."></div><div class="geo-map-filters"><button class="active" data-map-type="all">Semua</button><% ['pop','olt','odc','odp','pole','customer'].forEach(type=>{ %><button data-map-type="<%= type %>"><%= type.toUpperCase() %></button><% }) %></div><div class="geo-node-list" id="geoNodeList"></div></aside><div id="networkGeoMap" aria-label="Peta jaringan INKAMNET"></div></div>
<div class="map-summary-grid"><div><strong><%= nodes.length %></strong><small>Titik jaringan</small></div><div><strong><%= mapLinks.length %></strong><small>Jalur kabel</small></div><div><strong><%= nodes.filter(n=>n.node_type==='odp').length %></strong><small>ODP dipetakan</small></div><div><strong><%= nodes.filter(n=>n.node_type==='customer').length %></strong><small>Rumah pelanggan</small></div></div></section>
<% if(isAdmin){ %><div class="modal fade" id="mapNodeModal" tabindex="-1"><div class="modal-dialog modal-lg modal-dialog-centered"><form class="modal-content" method="post" action="/acs/map/nodes"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="modal-header"><div><div class="module-kicker">NETWORK MAP</div><h5 class="modal-title">Tambah Titik</h5><small>Klik peta untuk mengisi koordinat.</small></div><button class="btn-close" data-bs-dismiss="modal" type="button"></button></div><div class="modal-body"><div class="row g-3"><div class="col-md-3"><label class="form-label">Jenis</label><select class="form-select" name="node_type"><% ['pop','olt','odc','odp','pole','customer','other'].forEach(type=>{ %><option value="<%= type %>"><%= type.toUpperCase() %></option><% }) %></select></div><div class="col-md-9"><label class="form-label">Nama Titik</label><input class="form-control" name="name" required placeholder="ODP-KBG-01"></div><div class="col-md-6"><label class="form-label">Latitude</label><input class="form-control" name="latitude" id="mapLatitude" type="number" step="0.0000001" required></div><div class="col-md-6"><label class="form-label">Longitude</label><input class="form-control" name="longitude" id="mapLongitude" type="number" step="0.0000001" required></div><div class="col-md-4"><label class="form-label">Site</label><select class="form-select" name="site_id"><option value="">-</option><% sites.forEach(s=>{ %><option value="<%= s.id %>"><%= s.code %> · <%= s.name %></option><% }) %></select></div><div class="col-md-4"><label class="form-label">Pelanggan</label><select class="form-select" name="customer_id"><option value="">-</option><% customers.forEach(c=>{ %><option value="<%= c.id %>"><%= c.site_code %> · <%= c.customer_code %> · <%= c.name %></option><% }) %></select></div><div class="col-md-4"><label class="form-label">ONT</label><select class="form-select" name="acs_device_id"><option value="">-</option><% devices.forEach(d=>{ %><option value="<%= d.id %>"><%= d.customer_name||d.serial_number||d.device_id %></option><% }) %></select></div><div class="col-md-4"><label class="form-label">Kapasitas Port</label><input class="form-control" name="capacity" type="number" min="1"></div><div class="col-md-8"><label class="form-label">Catatan</label><input class="form-control" name="notes"></div></div></div><div class="modal-footer"><button class="btn-tech" type="button" data-bs-dismiss="modal">Batal</button><button class="btn-tech primary">Simpan Titik</button></div></form></div></div>
<div class="modal fade" id="mapLinkModal" tabindex="-1"><div class="modal-dialog modal-lg modal-dialog-centered"><form class="modal-content" method="post" action="/acs/map/links"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="modal-header"><h5 class="modal-title">Hubungkan Jalur Kabel</h5><button class="btn-close" data-bs-dismiss="modal" type="button"></button></div><div class="modal-body"><div class="row g-3"><div class="col-md-6"><label class="form-label">Dari</label><select class="form-select" name="source_node_id" required><option value="">Pilih titik asal</option><% nodes.forEach(n=>{ %><option value="<%= n.id %>"><%= n.node_type.toUpperCase() %> · <%= n.name %></option><% }) %></select></div><div class="col-md-6"><label class="form-label">Ke</label><select class="form-select" name="target_node_id" required><option value="">Pilih titik tujuan</option><% nodes.forEach(n=>{ %><option value="<%= n.id %>"><%= n.node_type.toUpperCase() %> · <%= n.name %></option><% }) %></select></div><div class="col-md-4"><label class="form-label">Jenis Jalur</label><select class="form-select" name="cable_type"><% ['backbone','distribution','drop','wireless','other'].forEach(type=>{ %><option value="<%= type %>"><%= type.toUpperCase() %></option><% }) %></select></div><div class="col-md-4"><label class="form-label">Status</label><select class="form-select" name="status_mode"><option value="automatic">Otomatis dari ONT</option><option value="manual">Manual</option></select></div><div class="col-md-4"><label class="form-label">Status Manual</label><select class="form-select" name="manual_status"><option value="online">Online</option><option value="warning">Warning</option><option value="offline">Offline</option><option value="unknown">Unknown</option></select></div><div class="col-md-4"><label class="form-label">Panjang (meter)</label><input class="form-control" name="cable_length_m" type="number" min="0" step="0.1"></div><div class="col-md-4"><label class="form-label">Core / Label</label><input class="form-control" name="core_label"></div><div class="col-md-4"><label class="form-label">Catatan</label><input class="form-control" name="notes"></div></div></div><div class="modal-footer"><button class="btn-tech" type="button" data-bs-dismiss="modal">Batal</button><button class="btn-tech primary">Simpan Jalur</button></div></form></div></div><% } %>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
<!-- acs-ont-dot topology compatibility marker; geographic nodes supersede the legacy logical dots. -->
<script>(()=>{const nodes=<%- JSON.stringify(nodes).replace(/</g,'\\u003c') %>,links=<%- JSON.stringify(mapLinks).replace(/</g,'\\u003c') %>;if(!window.L)return;const map=L.map('networkGeoMap').setView(nodes.length?[+nodes[0].latitude,+nodes[0].longitude]:[-6.55,106.82],nodes.length?15:11);L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{maxZoom:20,attribution:'&copy; OpenStreetMap'}).addTo(map);const colors={online:'#31d7a0',warning:'#ffb84d',offline:'#ff5263',unknown:'#8790a6'},symbols={pop:'◆',olt:'▣',odc:'●',odp:'●',pole:'│',customer:'⌂',other:'•'},markers=new Map(),layers=[];const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));nodes.forEach(n=>{const status=n.online_status==='offline'||n.signal_status==='critical'?'offline':n.signal_status==='warning'?'warning':'online',marker=L.marker([+n.latitude,+n.longitude],{icon:L.divIcon({className:`fiber-marker ${n.node_type} ${status}`,html:`<span>${symbols[n.node_type]||'•'}</span>`,iconSize:[30,30]})}).addTo(map);marker.bindPopup(`<div class="map-popup"><b>${esc(n.name)}</b><small>${esc(n.node_type.toUpperCase())} · ${esc(n.site_code||'-')}</small>${n.customer_name?`<p>${esc(n.customer_code)} · ${esc(n.customer_name)}</p>`:''}${n.rx_power!=null?`<p>RX ${Number(n.rx_power).toFixed(2)} dBm</p>`:''}</div>`);markers.set(+n.id,marker);layers.push({node:n,marker});});links.forEach(l=>{const a=nodes.find(n=>+n.id===+l.source_node_id),b=nodes.find(n=>+n.id===+l.target_node_id);if(a&&b)L.polyline([[+a.latitude,+a.longitude],[+b.latitude,+b.longitude]],{color:colors[l.effective_status]||colors.unknown,weight:l.cable_type==='backbone'?6:l.cable_type==='drop'?2:4,opacity:.9,className:`fiber-line ${l.effective_status}`}).bindTooltip(`${esc(l.cable_type)} · ${esc(l.core_label||'tanpa label')} · ${esc(l.effective_status)}`).addTo(map);});if(nodes.length)map.fitBounds(L.latLngBounds(nodes.map(n=>[+n.latitude,+n.longitude])).pad(.12));const list=document.getElementById('geoNodeList'),search=document.getElementById('mapSearch');let type='all';const render=()=>{const q=(search.value||'').toLowerCase(),shown=layers.filter(x=>(type==='all'||x.node.node_type===type)&&(!q||`${x.node.name} ${x.node.site_code||''} ${x.node.customer_name||''}`.toLowerCase().includes(q)));layers.forEach(x=>{const show=shown.includes(x);if(show&&!map.hasLayer(x.marker))x.marker.addTo(map);if(!show&&map.hasLayer(x.marker))map.removeLayer(x.marker);});list.innerHTML=shown.map(x=>`<button data-node="${x.node.id}"><i>${symbols[x.node.node_type]||'•'}</i><span><b>${esc(x.node.name)}</b><small>${esc(x.node.node_type.toUpperCase())} · ${esc(x.node.site_code||'-')}</small></span></button>`).join('')||'<div class="empty-state"><small>Titik tidak ditemukan.</small></div>';list.querySelectorAll('[data-node]').forEach(btn=>btn.onclick=()=>{const marker=markers.get(+btn.dataset.node);map.setView(marker.getLatLng(),18);marker.openPopup();});};search.addEventListener('input',render);document.querySelectorAll('[data-map-type]').forEach(btn=>btn.onclick=()=>{type=btn.dataset.mapType;document.querySelectorAll('[data-map-type]').forEach(x=>x.classList.toggle('active',x===btn));render();});map.on('click',e=>{const lat=document.getElementById('mapLatitude'),lng=document.getElementById('mapLongitude');if(lat)lat.value=e.latlng.lat.toFixed(7);if(lng)lng.value=e.latlng.lng.toFixed(7);});render();})();</script>
