<section class="acs-page"><div class="module-head"><div><div class="module-kicker">LIVE LOGICAL TOPOLOGY</div><h1>Network Map ONT</h1><p>Jalur menyala berdasarkan kondisi terbaru ONT pada setiap Site dan ODP.</p></div><div class="module-actions"><a class="btn-tech" href="/acs"><i class="bi bi-list-ul"></i>Monitoring ONT</a><a class="btn-tech" href="/acs/reconcile"><i class="bi bi-link-45deg"></i>Rekonsiliasi</a></div></div>
<div class="acs-map-toolbar"><span><i class="bi bi-clock-history"></i>Data terakhir: <%= lastSync?.finished_at?new Date(lastSync.finished_at).toLocaleString('id-ID',{timeZone:'Asia/Jakarta'}):'belum disinkronkan' %></span><div class="acs-legend"><span class="online">● Normal</span><span class="warning">● Redaman lemah</span><span class="offline">● Offline/kritis</span></div></div>
<div class="acs-topology"><div class="acs-core-node"><i class="bi bi-cloud-fill"></i><strong>GENIEACS</strong><small>TR-069 NBI</small></div><% sites.forEach(site=>{ const siteBad=site.odps.some(o=>o.status==='offline'),siteWarn=site.odps.some(o=>['warning','critical'].includes(o.status)); %><section class="acs-site-lane <%= siteBad?'offline':siteWarn?'warning':'online' %>"><div class="acs-beam"></div><header><i class="bi bi-hdd-rack-fill"></i><span><strong>SITE <%= site.name %></strong><small><%= site.odps.length %> ODP</small></span></header><div class="acs-odp-grid"><% site.odps.forEach(odp=>{ %><article class="acs-odp-node <%= odp.status %>"><div class="acs-pulse"></div><div class="acs-odp-head"><i class="bi bi-diagram-3-fill"></i><span><strong><%= odp.name %></strong><small><%= odp.devices.length %> ONT · <%= odp.offline %> offline</small></span></div><div class="acs-ont-dots"><% odp.devices.forEach(d=>{ %><a class="acs-ont-dot <%= d.online_status==='offline'?'offline':d.signal_status %>" href="/acs?q=<%= encodeURIComponent(d.serial_number||d.device_id) %>" title="<%= d.customer_name||d.serial_number||d.device_id %> · RX <%= d.rx_power??'N/A' %>"><i></i><span><%= d.customer_name||d.serial_number||'ONT' %></span></a><% }) %></div></article><% }) %></div></section><% }) %><% if(!sites.length){ %><div class="empty-state"><i class="bi bi-diagram-3"></i><strong>Peta belum memiliki perangkat</strong><small>Jalankan sinkronisasi ACS terlebih dahulu.</small></div><% } %></div></section>
