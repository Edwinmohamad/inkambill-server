<link rel="stylesheet" href="/css/performance-center.css?v=<%= assetVersion %>">
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
<% const monthNames=['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember'];
   const statusText=s=>s==='on_target'?'On Target':s==='watch'?'Watch':'Needs Attention';
   const diff=(v,suffix='')=>`${Number(v)>0?'+':''}${Number(v||0)}${suffix}`;
   const siteQ=site?site.code:'';
%>
<section class="opc" id="performanceCenter">
  <header class="opc-head">
    <div><span class="opc-kicker"><i class="bi bi-activity"></i> OPERATIONAL INTELLIGENCE · NON-AI</span><h1>Performance Center</h1><p>Target → progres → masalah → PIC → tindak lanjut. Semua analisis berbasis SQL, formula, dan rule deterministik.</p></div>
    <form class="opc-period" method="get" action="/performance" data-opc-auto>
      <select name="site"><option value="">Semua Site</option><% sites.forEach(s=>{ %><option value="<%= s.code %>" <%= siteQ===s.code?'selected':'' %>><%= s.code %> · <%= s.name %></option><% }) %></select>
      <select name="month"><% monthNames.forEach((m,i)=>{ %><option value="<%= i+1 %>" <%= range.month===i+1?'selected':'' %>><%= m %></option><% }) %></select>
      <select name="year"><% for(let y=range.year-2;y<=range.year+1;y++){ %><option value="<%= y %>" <%= range.year===y?'selected':'' %>><%= y %></option><% } %></select>
    </form>
  </header>

  <nav class="opc-tabs"><a href="#overview">Overview</a><a href="#actions">Action Queue</a><a href="#work">Work</a><a href="#team">KPI Tim</a><a href="#ticket">Ticket & SLA</a><a href="#billing">Billing</a><a href="#customerGrowth">Customer Growth</a><a href="#retention">Retention</a><a href="#network">Network</a><a href="#finance">Finance</a><a href="#warehouse">Warehouse</a><a href="#goals">Goals</a><a href="#execution">Execution</a><a href="#blocked">Blocked</a><a href="#sites">Sites</a><a href="#review">Monthly Review</a></nav>

  <section class="opc-hero" id="overview">
    <div class="opc-health"><div class="opc-health-ring" style="--score:<%= health %>"><span><b><%= health %></b><small>/100</small></span></div><div><small>OPERATIONAL HEALTH</small><h2><%= health>=90?'Healthy':health>=75?'Watch':'Needs Attention' %></h2><p><%= monthNames[range.month-1] %> <%= range.year %> · <%= site?site.code:'Semua Site' %></p></div></div>
    <div class="opc-hero-metrics">
      <a href="#billing"><small>Collection</small><b><%= billing.collection_rate %>%</b><em class="<%= variance.collection>=0?'up':'down' %>"><%= diff(variance.collection,'%') %> vs lalu</em></a>
      <a href="#growth"><small>PSB</small><b><%= growth.psb %></b><em class="<%= variance.psb>=0?'up':'down' %>"><%= diff(variance.psb) %> vs lalu</em></a>
      <a href="#ticket"><small>SLA</small><b><%= tickets.sla_rate %>%</b><em class="<%= variance.sla>=0?'up':'down' %>"><%= diff(variance.sla,'%') %></em></a>
      <a href="#work"><small>Work Progress</small><b><%= work.completion_rate %>%</b><em><%= work.overdue %> overdue</em></a>
      <a href="#network"><small>Network</small><b><%= network.health %>%</b><em><%= network.open_incidents %> incident open</em></a>
      <a href="#actions"><small>Action Queue</small><b><%= actionQueue.length %></b><em><%= actionQueue.filter(x=>x.priority==='P1').length %> P1</em></a>
    </div>
  </section>

  <section class="opc-target-strip"><% [['collection_rate',billing.collection_rate],['sla_rate',tickets.sla_rate],['psb_active',growth.psb],['work_completion',work.completion_rate],['network_health',network.health],['backlog',tickets.backlog]].forEach(([key,actual])=>{ const t=targets[key]; const state=(t.comparator==='max'?(actual<=t.value?'on_target':actual<=t.value*1.25?'watch':'attention'):(actual>=t.value?'on_target':actual>=t.value*.9?'watch':'attention')); %><div class="opc-target <%= state %>"><span><small><%= t.label %></small><b><%= actual %><%= t.unit.includes('%')?'%':'' %></b></span><em>Target <%= t.comparator==='min'?'≥':'≤' %> <%= t.value %><%= t.unit.includes('%')?'%':'' %></em></div><% }) %></section>

  <section class="opc-grid two" id="actions">
    <article class="opc-card"><div class="opc-card-head"><div><small>MANAGEMENT BY EXCEPTION</small><h3>Action Queue</h3></div><span class="opc-count"><%= actionQueue.length %></span></div><div class="opc-actions"><% actionQueue.forEach(f=>{ %><a href="<%= f.href %>" class="<%= f.priority.toLowerCase() %>"><b><%= f.priority %></b><span><strong><%= f.title %></strong><small><%= f.area %> · <%= f.detail %></small></span><i class="bi bi-chevron-right"></i></a><% }) %><% if(!actionQueue.length){ %><div class="opc-empty"><i class="bi bi-check2-circle"></i><b>Tidak ada exception kritis</b><span>Semua rule operasional berada dalam batas normal.</span></div><% } %></div></article>
    <article class="opc-card"><div class="opc-card-head"><div><small>TARGET PACE</small><h3>Target vs Actual</h3></div></div><div class="opc-pace"><div><span><b>PSB</b><small>Hari berjalan vs target bulan</small></span><strong><%= pace.psbActual %> / <%= targets.psb_active.value %></strong></div><div class="opc-progress"><i style="width:<%= Math.min(100,pace.psbPace) %>%"></i></div><p>Expected sampai hari ini <b><%= pace.psbExpected %></b> · Pace <b><%= pace.psbPace %>%</b></p></div><div class="opc-freshness"><small>DATA FRESHNESS</small><span>Billing <b><%= freshness.billing?new Date(freshness.billing).toLocaleString('id-ID'):'-' %></b></span><span>Ticket <b><%= freshness.ticket?new Date(freshness.ticket).toLocaleString('id-ID'):'-' %></b></span><span>Network <b><%= freshness.network?new Date(freshness.network).toLocaleString('id-ID'):'-' %></b></span><span>Warehouse <b><%= freshness.warehouse?new Date(freshness.warehouse).toLocaleString('id-ID'):'-' %></b></span></div></article>
  </section>

  <section class="opc-grid three">
    <article class="opc-card" id="work"><div class="opc-card-head"><div><small>WORK PROGRESS</small><h3>Pekerjaan Teknisi</h3></div><a href="/schedules">Buka</a></div><div class="opc-stat-row"><span><small>Total</small><b><%= work.total %></b></span><span><small>Done</small><b><%= work.done %></b></span><span><small>Overdue</small><b><%= work.overdue %></b></span></div><div class="opc-funnel"><% [['scheduled','Scheduled'],['on_the_way','OTW'],['working','Working'],['done','Done']].forEach(([k,l])=>{ %><div><span><%= l %></span><b><%= work.counts[k]||0 %></b></div><% }) %></div></article>
    <article class="opc-card" id="ticket"><div class="opc-card-head"><div><small>TICKET & SLA</small><h3>Service Delivery</h3></div><a href="/tickets">Buka</a></div><div class="opc-stat-row"><span><small>Created</small><b><%= tickets.created %></b></span><span><small>Closed</small><b><%= tickets.closed %></b></span><span><small>Backlog</small><b><%= tickets.backlog %></b></span></div><div class="opc-inline-kpi"><span>SLA <b><%= tickets.sla_rate %>%</b></span><span>MTTR <b><%= tickets.mttr_hours %>j</b></span><span>Breach <b><%= tickets.sla_breached %></b></span></div></article>
    <article class="opc-card" id="billing"><div class="opc-card-head"><div><small>BILLING</small><h3>Collection</h3></div><a href="/collection-analysis?month=<%= range.month %>&year=<%= range.year %>&site=<%= siteQ %>">Analisa</a></div><div class="opc-stat-row"><span><small>Tertagih</small><b><%= formatRupiah(billing.billed) %></b></span><span><small>Terkumpul</small><b><%= formatRupiah(billing.collected) %></b></span></div><div class="opc-inline-kpi"><span>Collection <b><%= billing.collection_rate %>%</b></span><span>Outstanding <b><%= formatRupiah(billing.outstanding) %></b></span><span>Overdue <b><%= billing.overdue_customers %></b></span></div></article>
  </section>

  <section class="opc-grid three">
    <article class="opc-card" id="growthQuick"><div class="opc-card-head"><div><small>PSB & CUSTOMER GROWTH</small><h3>Growth</h3></div><a href="/customers">Pelanggan</a></div><div class="opc-stat-row"><span><small>PSB</small><b>+<%= growth.psb %></b></span><span><small>Churn</small><b>-<%= growth.churn %></b></span><span><small>Net Growth</small><b><%= growth.net_growth>=0?'+':'' %><%= growth.net_growth %></b></span></div><div class="opc-inline-kpi"><span>Active <b><%= growth.active %></b></span><span>Churn Rate <b><%= growth.churn_rate %>%</b></span></div></article>
    <article class="opc-card" id="network"><div class="opc-card-head"><div><small>NETWORK</small><h3>Infrastructure Health</h3></div><a href="/nms">NOC</a></div><div class="opc-stat-row"><span><small>Router</small><b><%= network.routers_online %>/<%= network.routers_total %></b></span><span><small>OLT</small><b><%= network.olts_online %>/<%= network.olts_total %></b></span><span><small>Incident</small><b><%= network.incidents %></b></span></div><div class="opc-inline-kpi"><span>Health <b><%= network.health %>%</b></span><span>Open Incident <b><%= network.open_incidents %></b></span></div></article>
    <article class="opc-card" id="finance"><div class="opc-card-head"><div><small>FINANCE</small><h3>Cash & Reconciliation</h3></div><a href="/payments/reconciliation">Rekon</a></div><div class="opc-stat-row"><span><small>Revenue</small><b><%= formatRupiah(finance.revenue) %></b></span><span><small>Cash Held</small><b><%= formatRupiah(finance.cash_held) %></b></span></div><div class="opc-inline-kpi"><span>Selisih Rekon <b><%= formatRupiah(finance.recon_diff) %></b></span><span>Debt Overdue <b><%= finance.overdue_debts %></b></span></div></article>
  </section>

  <section class="opc-grid two"><article class="opc-card" id="warehouse"><div class="opc-card-head"><div><small>WAREHOUSE</small><h3>Material Readiness</h3></div><a href="/inventory">Gudang</a></div><div class="opc-stat-row"><span><small>Items</small><b><%= inventory.items %></b></span><span><small>Low Stock</small><b><%= inventory.low %></b></span><span><small>Empty</small><b><%= inventory.empty %></b></span><span><small>Stock Value</small><b><%= formatRupiah(inventory.stock_value) %></b></span></div></article><article class="opc-card"><div class="opc-card-head"><div><small>REPEAT PROBLEM DETECTOR</small><h3>Pelanggan Gangguan Berulang</h3></div></div><div class="opc-mini-list"><% repeatProblems.forEach(r=>{ %><a href="/tickets?q=<%= encodeURIComponent(r.name) %>"><span><b><%= r.name %></b><small><%= r.site_code||'-' %></small></span><strong><%= r.total %> tiket</strong></a><% }) %><% if(!repeatProblems.length){ %><div class="opc-empty compact">Tidak ada repeat issue signifikan periode ini.</div><% } %></div></article></section>

  <section class="opc-card wide" id="team"><div class="opc-card-head"><div><small>TEAM KPI · ROLE-AWARE</small><h3>Progress Tim</h3></div><a href="/team-kpi?month=<%= range.month %>&year=<%= range.year %>">KPI Tim lengkap</a></div><div class="opc-table-wrap"><table class="opc-table"><thead><tr><th>Nama</th><th>Role</th><th>Tiket</th><th>Job</th><th>PSB</th><th>Completion</th><th>SLA</th><th>Overdue</th><th>Status</th></tr></thead><tbody><% team.forEach(p=>{ %><tr><td><b><%= p.name %></b><small><%= p.employee_code||'' %></small></td><td><%= p.position_name %></td><td><%= p.closed_tickets %>/<%= p.assigned_tickets %></td><td><%= p.done_jobs %>/<%= p.assigned_jobs %></td><td><%= p.psb %></td><td><%= p.completion_rate %>%</td><td><%= p.sla_rate %>%</td><td><%= p.overdue %></td><td><span class="opc-state <%= p.status %>"><%= statusText(p.status) %></span></td></tr><% }) %><% if(!team.length){ %><tr><td colspan="9">Belum ada data tim aktif.</td></tr><% } %></tbody></table></div></section>

  <section class="opc-card wide" id="sites"><div class="opc-card-head"><div><small>SITE COMPARISON</small><h3>KRW · CLM · KBG</h3></div></div><div class="opc-site-grid"><% siteComparison.forEach(s=>{ %><a href="/performance?year=<%= range.year %>&month=<%= range.month %>&site=<%= encodeURIComponent(s.code) %>"><header><b><%= s.code %></b><small><%= s.name %></small></header><div><span>Collection <b><%= s.collection %>%</b></span><span>PSB <b>+<%= s.psb %></b></span><span>Churn <b><%= s.churn %></b></span><span>SLA <b><%= s.sla %>%</b></span><span>Backlog <b><%= s.backlog %></b></span><span>Network <b><%= s.network %>%</b></span></div></a><% }) %></div></section>



  <% const cg=growthAnalysis, cgs=cg.selected; %>
  <section class="opc-growth-shell" id="customerGrowth">
    <div class="opc-growth-head">
      <div><small>CUSTOMER GROWTH ANALYSIS</small><h2><%= cgs.siteCode==='ALL'?'All Site':cgs.siteCode %> · <%= monthNames[range.month-1] %> <%= range.year %></h2><p>PSB, pelanggan off, churn, reactivation, net growth, dan kualitas pertumbuhan dalam satu rekonsiliasi pelanggan.</p></div>
      <div class="opc-growth-confidence <%= cgs.dataConfidence %>"><i class="bi <%= cgs.dataConfidence==='tracked'?'bi-check-circle-fill':'bi-info-circle-fill' %>"></i><span><b><%= cgs.dataConfidence==='tracked'?'Lifecycle tracked':'Historical estimate' %></b><small><%= cgs.dataConfidence==='tracked'?'Status history tersedia untuk periode ini.':'Sebagian histori sebelum patch memakai status_changed_at.' %></small></span></div>
    </div>

    <div class="opc-growth-tabs">
      <a class="<%= !siteQ?'active':'' %>" href="/performance?year=<%= range.year %>&month=<%= range.month %>#customerGrowth">ALL SITE</a>
      <% cg.sites.forEach(s=>{ %><a class="<%= siteQ===s.siteCode?'active':'' %>" href="/performance?year=<%= range.year %>&month=<%= range.month %>&site=<%= encodeURIComponent(s.siteCode) %>#customerGrowth"><%= s.siteCode %></a><% }) %>
    </div>

    <div class="opc-movement-strip">
      <div><small>OPENING</small><b><%= cgs.opening %></b><em>awal periode</em></div>
      <div class="positive"><small>PSB</small><b>+<%= cgs.psb %></b><em>pelanggan baru</em></div>
      <div class="positive"><small>REACTIVATION</small><b>+<%= cgs.reactivated %></b><em>aktif kembali</em></div>
      <div class="negative"><small>OFF</small><b>-<%= cgs.off %></b><em>inactive/suspended</em></div>
      <div class="negative"><small>TERMINATED</small><b>-<%= cgs.terminated %></b><em>churn permanen</em></div>
      <div class="<%= cgs.net>=0?'positive':'negative' %> hero"><small>NET GROWTH</small><b><%= cgs.net>=0?'+':'' %><%= cgs.net %></b><em><%= cgs.netGrowthRate %>% dari opening</em></div>
      <div><small>CLOSING</small><b><%= cgs.closing %></b><em>pelanggan aktif</em></div>
    </div>

    <div class="opc-growth-kpis">
      <article><small>Gross Growth</small><b>+<%= cgs.grossGrowth %></b><span>PSB + reactivation</span></article>
      <article class="<%= cgs.growthEfficiency>=50?'good':cgs.growthEfficiency>=25?'watch':'bad' %>"><small>Growth Efficiency</small><b><%= cgs.growthEfficiency %>%</b><span>net growth ÷ gross growth</span></article>
      <article class="<%= cgs.churnToPsb<50?'good':cgs.churnToPsb<75?'watch':'bad' %>"><small>Churn vs PSB</small><b><%= cgs.churnToPsb %>%</b><span>berapa PSB ter-offset churn</span></article>
      <article class="<%= cgs.net>=0?'good':'bad' %>"><small>Growth Quality</small><b><%= cgs.quality==='healthy'?'Healthy':cgs.quality==='watch'?'Watch':'Needs Attention' %></b><span>berdasarkan net & churn ratio</span></article>
    </div>

    <div class="opc-growth-grid">
      <article class="opc-card opc-growth-chart-card"><div class="opc-card-head"><div><small>6-MONTH CUSTOMER MOVEMENT</small><h3>PSB vs Churn vs Net Growth</h3></div></div><div class="opc-growth-chart"><canvas id="customerGrowthTrendChart"></canvas></div></article>
      <article class="opc-card"><div class="opc-card-head"><div><small>RULE-BASED FINDINGS</small><h3>Growth Insights</h3></div><span class="opc-count"><%= cg.insights.length %></span></div><div class="opc-growth-insights"><% cg.insights.forEach(x=>{ %><div class="<%= x.tone %>"><i class="bi <%= x.tone==='danger'?'bi-exclamation-octagon-fill':x.tone==='warning'?'bi-exclamation-triangle-fill':x.tone==='success'?'bi-check-circle-fill':'bi-info-circle-fill' %>"></i><span><b><%= x.title %></b><small><%= x.detail %></small></span></div><% }) %><% if(!cg.insights.length){ %><div class="opc-empty compact">Belum ada finding growth yang perlu perhatian.</div><% } %></div></article>
    </div>

    <article class="opc-card wide opc-growth-sites">
      <div class="opc-card-head"><div><small>ALL SITE BREAKDOWN</small><h3>Kontribusi pertumbuhan per site</h3></div><small>All Site selalu dijumlahkan dari data site yang sama</small></div>
      <div class="opc-table-wrap"><table class="opc-table"><thead><tr><th>Site</th><th>Opening</th><th>PSB</th><th>Reactivation</th><th>Off</th><th>Terminated</th><th>Net Growth</th><th>Churn/PSB</th><th>Closing</th><th>Kualitas</th></tr></thead><tbody>
        <% cg.sites.forEach(s=>{ %><tr><td><a href="/performance?year=<%= range.year %>&month=<%= range.month %>&site=<%= encodeURIComponent(s.siteCode) %>#customerGrowth"><b><%= s.siteCode %></b><small><%= s.siteName %></small></a></td><td><%= s.opening %></td><td class="opc-positive">+<%= s.psb %></td><td class="opc-positive">+<%= s.reactivated %></td><td class="opc-negative">-<%= s.off %></td><td class="opc-negative">-<%= s.terminated %></td><td class="<%= s.net>=0?'opc-positive':'opc-negative' %>"><b><%= s.net>=0?'+':'' %><%= s.net %></b></td><td><%= s.churnToPsb %>%</td><td><%= s.closing %></td><td><span class="opc-state <%= s.quality==='healthy'?'on_target':s.quality==='watch'?'watch':'attention' %>"><%= s.quality==='healthy'?'Healthy':s.quality==='watch'?'Watch':'Needs Attention' %></span></td></tr><% }) %>
        <tr class="opc-growth-total"><td><b>ALL SITE</b></td><td><%= cg.all.opening %></td><td class="opc-positive">+<%= cg.all.psb %></td><td class="opc-positive">+<%= cg.all.reactivated %></td><td class="opc-negative">-<%= cg.all.off %></td><td class="opc-negative">-<%= cg.all.terminated %></td><td class="<%= cg.all.net>=0?'opc-positive':'opc-negative' %>"><b><%= cg.all.net>=0?'+':'' %><%= cg.all.net %></b></td><td><%= cg.all.churnToPsb %>%</td><td><%= cg.all.closing %></td><td>—</td></tr>
      </tbody></table></div>
    </article>

    <script type="application/json" id="customerGrowthBoot"><%- JSON.stringify({trend:cg.trend}).replace(/</g,'\\u003c') %></script>
  </section>


  <% const rt=retentionAnalysis; %>
  <section class="opc-retention-shell" id="retention">
    <div class="opc-growth-head">
      <div><small>RETENTION & CHURN INTELLIGENCE</small><h2>Kualitas Pertumbuhan & Risiko Churn</h2><p>Melihat bukan hanya berapa pelanggan keluar, tetapi dampak MRR, penyebab, cohort retention, dan pelanggan yang perlu dipertahankan.</p></div>
      <div class="opc-retention-summary"><span><small>Classification</small><b><%= rt.classificationRate %>%</b></span><span><small>Risk Queue</small><b><%= rt.risk.length %></b></span><span><small>Net MRR</small><b class="<%= rt.mrr.net>=0?'up':'down' %>"><%= formatRupiah(rt.mrr.net) %></b></span></div>
    </div>

    <div class="opc-mrr-strip">
      <article><small>MRR GAIN · PSB</small><b class="opc-positive">+<%= formatRupiah(rt.mrr.gained) %></b><span>Paket pelanggan baru</span></article>
      <article><small>MRR REACTIVATED</small><b class="opc-positive">+<%= formatRupiah(rt.mrr.reactivated) %></b><span>Pelanggan aktif kembali</span></article>
      <article><small>MRR LOST</small><b class="opc-negative">-<%= formatRupiah(rt.mrr.lost) %></b><span>Off / terminated</span></article>
      <article class="hero"><small>NET MRR GROWTH</small><b class="<%= rt.mrr.net>=0?'opc-positive':'opc-negative' %>"><%= rt.mrr.net>=0?'+':'' %><%= formatRupiah(rt.mrr.net) %></b><span>Gain + reactivated − lost</span></article>
    </div>

    <div class="opc-grid two">
      <article class="opc-card">
        <div class="opc-card-head"><div><small>CHURN REASON ANALYSIS</small><h3>Penyebab pelanggan off / terminated</h3></div><span class="opc-count"><%= rt.totalChurn %></span></div>
        <div class="opc-reason-list"><% rt.reasons.forEach(r=>{ const max=Math.max(1,...rt.reasons.map(x=>x.total)); %><div><span><b><%= r.label %></b><small><%= r.total %> pelanggan · <%= formatRupiah(r.mrrLost) %> MRR</small></span><div class="opc-reason-bar"><i style="width:<%= Math.round(r.total/max*100) %>%"></i></div><strong><%= r.total %></strong></div><% }) %></div>
      </article>
      <article class="opc-card">
        <div class="opc-card-head"><div><small>COHORT RETENTION</small><h3>PSB masih bertahan setelah 30 / 60 / 90 hari</h3></div></div>
        <div class="opc-table-wrap"><table class="opc-table opc-cohort-table"><thead><tr><th>Cohort</th><th>PSB</th><th>30d</th><th>60d</th><th>90d</th></tr></thead><tbody><% rt.cohorts.forEach(c=>{ %><tr><td><b><%= c.label %></b></td><td><%= c.total %></td><td><%= c.r30==null?'—':c.r30+'%' %></td><td><%= c.r60==null?'—':c.r60+'%' %></td><td><%= c.r90==null?'—':c.r90+'%' %></td></tr><% }) %></tbody></table></div>
      </article>
    </div>

    <article class="opc-card wide">
      <div class="opc-card-head"><div><small>CUSTOMER RETENTION RISK · RULE-BASED</small><h3>Pelanggan yang perlu dipertahankan</h3></div><span class="opc-count"><%= rt.risk.length %></span></div>
      <div class="opc-table-wrap"><table class="opc-table"><thead><tr><th>Pelanggan</th><th>Site</th><th>MRR</th><th>Risk</th><th>Faktor</th><th>PIC</th><th>Action</th></tr></thead><tbody>
        <% rt.risk.forEach(r=>{ %><tr><td><b><%= r.name %></b><small><%= r.customer_code %></small></td><td><%= r.site_code %></td><td><%= formatRupiah(r.mrr) %></td><td><span class="opc-risk <%= r.level.toLowerCase() %>"><%= r.level %> · <%= r.score %></span></td><td><%= r.factors.join(' · ') %></td><td><%= r.retention_owner||'-' %></td><td><button type="button" class="opc-icon-btn" data-lifecycle="<%= r.id %>" title="Lihat lifecycle"><i class="bi bi-clock-history"></i></button><button type="button" class="opc-icon-btn" data-retention-action="<%= r.id %>" data-customer-name="<%= r.name %>" title="Buat retention action"><i class="bi bi-person-heart"></i></button></td></tr><% }) %>
        <% if(!rt.risk.length){ %><tr><td colspan="7">Tidak ada pelanggan pada Watch / Retention Priority saat ini.</td></tr><% } %>
      </tbody></table></div>
    </article>

    <article class="opc-card wide">
      <div class="opc-card-head"><div><small>CHURN CLASSIFICATION</small><h3>Klasifikasikan pelanggan yang off bulan ini</h3></div><small>Supaya root-cause per site dan MRR loss akurat</small></div>
      <div class="opc-table-wrap"><table class="opc-table"><thead><tr><th>Pelanggan</th><th>Site</th><th>Status</th><th>Tanggal</th><th>MRR</th><th>Reason</th><th>Lifecycle</th></tr></thead><tbody>
        <% rt.recentLoss.forEach(r=>{ %><tr><td><b><%= r.name %></b></td><td><%= r.site_code %></td><td><%= r.from_status %> → <%= r.to_status %></td><td><%= new Date(r.changed_at).toLocaleDateString('id-ID') %></td><td><%= formatRupiah(r.mrr) %></td><td><form method="post" action="/performance/retention/reason" class="opc-reason-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="year" value="<%= range.year %>"><input type="hidden" name="month" value="<%= range.month %>"><input type="hidden" name="site" value="<%= siteQ %>"><input type="hidden" name="customer_id" value="<%= r.customer_id %>"><input type="hidden" name="event_type" value="<%= r.to_status==='terminated'?'TERMINATED':'OFF' %>"><input type="hidden" name="event_at" value="<%= new Date(r.changed_at).toISOString().slice(0,16) %>"><select name="reason_code"><% retentionReasons.forEach(([key,label])=>{ if(key!=='unclassified'){ %><option value="<%= key %>" <%= r.reason_code===key?'selected':'' %>><%= label %></option><% }}); %></select><button class="opc-icon-btn" title="Simpan reason"><i class="bi bi-check2"></i></button></form></td><td><button type="button" class="opc-icon-btn" data-lifecycle="<%= r.customer_id %>"><i class="bi bi-clock-history"></i></button></td></tr><% }) %>
        <% if(!rt.recentLoss.length){ %><tr><td colspan="7">Belum ada event off/terminated yang tercatat pada periode ini.</td></tr><% } %>
      </tbody></table></div>
    </article>
  </section>

  <div class="opc-drawer-backdrop" id="opcLifecycleBackdrop" hidden></div>
  <aside class="opc-drawer" id="opcLifecycleDrawer" aria-hidden="true"><header><div><small>CUSTOMER LIFECYCLE</small><h3 id="opcLifecycleTitle">Memuat…</h3></div><button type="button" id="opcLifecycleClose"><i class="bi bi-x-lg"></i></button></header><div id="opcLifecycleBody" class="opc-timeline"></div></aside>

  <div class="modal fade" id="opcRetentionActionModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><form method="post" action="/performance/retention/action" class="modal-content"><div class="modal-header"><div><div class="module-kicker">RETENTION ACTION</div><h5 class="modal-title" id="opcRetentionActionTitle">Follow-up pelanggan</h5></div><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="year" value="<%= range.year %>"><input type="hidden" name="month" value="<%= range.month %>"><input type="hidden" name="site" value="<%= siteQ %>"><input type="hidden" name="customer_id" id="opcRetentionCustomerId"><div class="row g-2"><div class="col-12"><label class="form-label">PIC</label><select class="form-select" name="owner_user_id"><option value="">Belum ditentukan</option><% people.forEach(u=>{ %><option value="<%= u.id %>"><%= u.name %></option><% }) %></select></div><div class="col-12"><label class="form-label">Due</label><input class="form-control" type="datetime-local" name="due_at"></div><div class="col-12"><label class="form-label">Catatan</label><textarea class="form-control" name="note" rows="3" placeholder="Contoh: hubungi pelanggan, cek gangguan berulang, tawarkan kunjungan teknisi"></textarea></div></div></div><div class="modal-footer"><button type="button" class="btn-tech" data-bs-dismiss="modal">Batal</button><button class="btn-tech primary">Masukkan Queue</button></div></form></div></div>

  <section class="opc-grid two opc-v2-top">
    <article class="opc-card" id="goals">
      <div class="opc-card-head"><div><small>GOALS & OKR</small><h3>Target yang sedang dikejar</h3></div><span class="opc-count"><%= goals.filter(g=>g.status==='ACTIVE').length %></span></div>
      <div class="opc-goals"><% goals.forEach(g=>{ %><div class="opc-goal"><div><span><b><%= g.title %></b><small><%= g.owner_name||'Belum ada PIC' %> · <%= g.site_code||'ALL' %></small></span><em><%= g.progress %>%</em></div><div class="opc-progress"><i style="width:<%= g.progress %>%"></i></div><footer><span><%= Number(g.current_value||0) %> / <%= Number(g.target_value||0) %> <%= g.unit||'' %></span><span class="opc-state <%= g.status==='ACHIEVED'?'on_target':g.status==='ACTIVE'?'watch':'attention' %>"><%= g.status %></span></footer></div><% }) %><% if(!goals.length){ %><div class="opc-empty compact">Belum ada goal periode ini.</div><% } %></div>
      <% if(isMasterAdmin){ %><details class="opc-inline-form"><summary><i class="bi bi-plus-circle"></i> Tambah goal</summary><form method="post" action="/performance/goals"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="year" value="<%= range.year %>"><input type="hidden" name="month" value="<%= range.month %>"><input type="hidden" name="site" value="<%= siteQ %>"><input name="title" placeholder="Contoh: 500 pelanggan aktif" required><input type="number" step="0.1" name="target_value" placeholder="Target" required><input type="number" step="0.1" name="current_value" placeholder="Current"><input name="unit" placeholder="Unit"><select name="owner_user_id"><option value="">PIC</option><% people.forEach(u=>{ %><option value="<%= u.id %>"><%= u.name %></option><% }) %></select><input type="hidden" name="site_code" value="<%= siteQ %>"><button class="btn-tech primary">Tambah</button></form></details><% } %>
    </article>
    <article class="opc-card">
      <div class="opc-card-head"><div><small>FORECAST · DETERMINISTIC</small><h3><%= forecast.label %></h3></div><span class="opc-count"><%= forecast.day %>/<%= forecast.days %></span></div>
      <div class="opc-forecast"><span><small>PSB</small><b><%= forecast.psb %></b></span><span><small>Collection</small><b><%= forecast.collection %>%</b></span><span><small>Ticket masuk</small><b><%= forecast.ticketCreated %></b></span><span><small>Work done</small><b><%= forecast.workDone %></b></span><span><small>Revenue</small><b><%= formatRupiah(forecast.revenue) %></b></span></div>
      <div class="opc-card-head mini"><div><small>WHAT CHANGED</small><h3>vs bulan lalu</h3></div></div>
      <div class="opc-change-grid"><% whatChanged.forEach(x=>{ %><span><small><%= x.label %></small><b class="<%= x.good?'up':'down' %>"><%= Number(x.value)>0?'+':'' %><%= x.value %><%= x.unit==='pp'?'pp':'' %></b></span><% }) %></div>
    </article>
  </section>

  <section class="opc-card wide" id="execution">
    <div class="opc-card-head"><div><small>ISSUE → ACTION → RESULT</small><h3>Execution Queue</h3></div><div class="opc-exec-counts"><span>Open <b><%= executionSummary.open %></b></span><span>Progress <b><%= executionSummary.progress %></b></span><span>Blocked <b><%= executionSummary.blocked %></b></span><span>Overdue <b><%= executionSummary.overdue %></b></span><span>Done <b><%= executionSummary.done %></b></span></div></div>
    <div class="opc-table-wrap"><table class="opc-table"><thead><tr><th>Priority</th><th>Action</th><th>PIC</th><th>Site</th><th>Due</th><th>Status</th><th>Result</th></tr></thead><tbody><% executionActions.forEach(a=>{ %><tr class="<%= a.overdue?'opc-row-overdue':'' %>"><td><span class="opc-priority <%= a.priority.toLowerCase() %>"><%= a.priority %></span></td><td><b><%= a.title %></b><small><%= a.description||a.source_type %></small></td><td><%= a.owner_name||'-' %></td><td><%= a.site_code||'-' %></td><td><%= a.due_at?new Date(a.due_at).toLocaleString('id-ID'):'-' %></td><td><span class="opc-state <%= a.status==='DONE'?'on_target':a.status==='BLOCKED'?'attention':'watch' %>"><%= a.status %></span></td><td><%= a.result_note||a.block_reason||'-' %></td></tr><% }) %><% if(!executionActions.length){ %><tr><td colspan="7">Belum ada execution action pada periode ini.</td></tr><% } %></tbody></table></div>
    <details class="opc-inline-form"><summary><i class="bi bi-plus-circle"></i> Tambah action</summary><form method="post" action="/performance/actions"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="year" value="<%= range.year %>"><input type="hidden" name="month" value="<%= range.month %>"><input type="hidden" name="site" value="<%= siteQ %>"><input name="title" placeholder="Action yang harus dilakukan" required><select name="priority"><option>P1</option><option selected>P2</option><option>P3</option></select><select name="owner_user_id"><option value="">PIC</option><% people.forEach(u=>{ %><option value="<%= u.id %>"><%= u.name %></option><% }) %></select><input type="datetime-local" name="due_at"><input type="hidden" name="site_code" value="<%= siteQ %>"><input name="description" placeholder="Konteks / expected result"><button class="btn-tech primary">Tambah</button></form></details>
  </section>

  <section class="opc-grid two" id="blocked">
    <article class="opc-card"><div class="opc-card-head"><div><small>BLOCKED WORK</small><h3>Pekerjaan yang tertahan</h3></div><span class="opc-count"><%= blocks.length %></span></div><div class="opc-block-list"><% blocks.forEach(b=>{ %><div><span><b><%= b.title %></b><small><%= b.entity_type %> · <%= b.owner_name||'Belum ada PIC' %> · <%= b.site_code||'-' %></small><em><%= b.reason_text %></em></span><strong><%= b.age_bucket %></strong></div><% }) %><% if(!blocks.length){ %><div class="opc-empty compact">Tidak ada blocked work.</div><% } %></div><details class="opc-inline-form"><summary><i class="bi bi-pause-circle"></i> Catat blocked work</summary><form method="post" action="/performance/blocks"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="year" value="<%= range.year %>"><input type="hidden" name="month" value="<%= range.month %>"><input type="hidden" name="site" value="<%= siteQ %>"><select name="entity_type"><option>TICKET</option><option>SCHEDULE</option><option>PSB</option><option>BILLING</option><option>NETWORK</option><option>OTHER</option></select><input name="title" placeholder="Pekerjaan / issue" required><input name="reason_text" placeholder="Alasan ter-block" required><select name="owner_user_id"><option value="">PIC</option><% people.forEach(u=>{ %><option value="<%= u.id %>"><%= u.name %></option><% }) %></select><input type="hidden" name="site_code" value="<%= siteQ %>"><button class="btn-tech primary">Simpan</button></form></details></article>
    <article class="opc-card"><div class="opc-card-head"><div><small>WORK AGING</small><h3>Umur pekerjaan terbuka</h3></div></div><div class="opc-aging"><% Object.entries(aging).forEach(([k,v])=>{ %><span><small><%= k %></small><b><%= v %></b></span><% }) %></div><div class="opc-card-head mini" id="decisions"><div><small>DECISION LOG</small><h3>Keputusan bulan ini</h3></div></div><div class="opc-mini-list"><% decisions.slice(0,6).forEach(d=>{ %><div class="opc-decision"><span><b><%= d.title %></b><small><%= new Date(d.decision_date).toLocaleDateString('id-ID') %> · <%= d.owner_name||'-' %></small></span><strong><%= d.status %></strong></div><% }) %><% if(!decisions.length){ %><div class="opc-empty compact">Belum ada decision log.</div><% } %></div><% if(isMasterAdmin){ %><details class="opc-inline-form"><summary><i class="bi bi-journal-plus"></i> Tambah decision</summary><form method="post" action="/performance/decisions"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="year" value="<%= range.year %>"><input type="hidden" name="month" value="<%= range.month %>"><input type="hidden" name="site" value="<%= siteQ %>"><input type="date" name="decision_date" value="<%= range.end %>"><input name="title" placeholder="Judul keputusan" required><input name="decision_text" placeholder="Keputusan" required><select name="owner_user_id"><option value="">PIC</option><% people.forEach(u=>{ %><option value="<%= u.id %>"><%= u.name %></option><% }) %></select><button class="btn-tech primary">Simpan</button></form></details><% } %></article>
  </section>

  <section class="opc-grid two" id="review"><article class="opc-card"><div class="opc-card-head"><div><small>6-MONTH TREND</small><h3>Progress Bulanan</h3></div></div><div class="opc-chart"><canvas id="opcTrendChart"></canvas></div></article><article class="opc-card"><div class="opc-card-head"><div><small>MONTHLY REVIEW</small><h3>Variance vs Bulan Lalu</h3></div></div><div class="opc-variance"><span>Collection <b class="<%= variance.collection>=0?'up':'down' %>"><%= diff(variance.collection,'%') %></b></span><span>PSB <b class="<%= variance.psb>=0?'up':'down' %>"><%= diff(variance.psb) %></b></span><span>SLA <b class="<%= variance.sla>=0?'up':'down' %>"><%= diff(variance.sla,'%') %></b></span><span>Work Completion <b class="<%= variance.work>=0?'up':'down' %>"><%= diff(variance.work,'%') %></b></span><span>Backlog <b class="<%= variance.backlog<=0?'up':'down' %>"><%= diff(variance.backlog) %></b></span></div><% if(isMasterAdmin){ %><form method="post" action="/performance/snapshot" class="opc-snapshot"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="year" value="<%= range.year %>"><input type="hidden" name="month" value="<%= range.month %>"><input type="hidden" name="site" value="<%= siteQ %>"><button class="btn-tech primary"><i class="bi bi-lock-fill"></i>Simpan Snapshot Bulanan</button><small>Menyimpan review historis tanpa mengubah data operasional.</small></form><% } %><details class="opc-history"><summary>Snapshot tersimpan (<%= snapshots.length %>)</summary><div><% snapshots.forEach(s=>{ %><span><b><%= String(s.period_month).padStart(2,'0') %>/<%= s.period_year %></b><small><%= s.site_code||'ALL' %> · <%= new Date(s.created_at).toLocaleString('id-ID') %></small></span><% }) %></div></details></article></section>

  <% if(isMasterAdmin){ %><details class="opc-card wide opc-settings"><summary><span><small>KPI SETTINGS</small><b>Target Performance Center</b></span><i class="bi bi-chevron-down"></i></summary><form method="post" action="/performance/targets"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="year" value="<%= range.year %>"><input type="hidden" name="month" value="<%= range.month %>"><label>Scope<select name="scope_type"><option value="GLOBAL">Global</option><option value="SITE" <%= site?'selected':'' %>>Site</option></select></label><label>Site<select name="scope_value"><option value="">-</option><% sites.forEach(s=>{ %><option value="<%= s.code %>" <%= siteQ===s.code?'selected':'' %>><%= s.code %></option><% }) %></select></label><% Object.entries(targets).forEach(([key,t])=>{ %><label><%= t.label %><input type="number" step="0.1" min="0" name="<%= key %>" value="<%= t.value %>"><small><%= t.comparator==='min'?'Minimum':'Maximum' %></small></label><% }) %><button class="btn-tech primary">Simpan Target</button></form></details><% } %>

  <script type="application/json" id="opcBoot"><%- JSON.stringify({trend}).replace(/</g,'\\u003c') %></script>
</section>
<script src="/js/performance-center.js?v=<%= assetVersion %>" defer></script>
