<div class="closing-page closing-manual-only">
  <header class="closing-head page-header" id="closing-step-periode">
    <div>
      <div class="closing-eyebrow"><%= closing.mode === 'AUTO' ? 'INKAMNET CONTROL CENTER \u00b7 KALKULATOR OTOMATIS' : 'INKAMNET CONTROL CENTER \u00b7 KALKULATOR MANUAL' %></div>
      <h1><i class="bi bi-calculator-fill me-2"></i>Closing</h1>
      <p class="text-muted mb-0">Isi angka untuk periode <strong><%= start %> s/d <%= end %></strong>. Status: <strong><%= closing.status==='LOCKED'?'TERKUNCI':'DRAFT' %></strong>.</p>
    </div>
    <form class="closing-period-form" method="get" action="/closing">
      <div class="closing-period-range">
        <a class="btn btn-outline-secondary btn-sm closing-period-arrow" href="/closing?from=<%= prevPeriod.start %>&to=<%= prevPeriod.end %><%= hideEdwin ? '&hide_edwin=1' : '' %>" title="Periode sebelumnya: <%= prevPeriod.start %> s/d <%= prevPeriod.end %>"><i class="bi bi-chevron-left"></i></a>
        <label class="closing-field"><span>Mulai</span><input class="form-control form-control-sm" type="date" name="from" value="<%= start %>" required></label>
        <label class="closing-field"><span>Sampai</span><input class="form-control form-control-sm" type="date" name="to" value="<%= end %>" required></label>
        <a class="btn btn-outline-secondary btn-sm closing-period-arrow" href="/closing?from=<%= nextPeriod.start %>&to=<%= nextPeriod.end %><%= hideEdwin ? '&hide_edwin=1' : '' %>" title="Periode berikutnya: <%= nextPeriod.start %> s/d <%= nextPeriod.end %>"><i class="bi bi-chevron-right"></i></a>
      </div>
      <button class="btn btn-primary btn-sm closing-period-submit" type="submit"><i class="bi bi-arrow-repeat me-1"></i>Hitung</button>
    </form>
  </header>

  <section class="card closing-card closing-control-panel <%= closing.status==='LOCKED' ? 'is-locked-status' : 'is-draft-status' %>" aria-label="Kontrol periode & mode">
    <div class="card-body closing-control-body">

      <div class="closing-control-row">
        <div class="closing-control-row-label"><i class="bi bi-sliders2"></i><span>Mode input</span></div>
        <div class="closing-control-row-body">
          <div class="closing-mode-switch" role="group" aria-label="Mode closing">
            <% if (closing.status==='LOCKED') { %>
              <span class="closing-mode-pill is-locked"><i class="bi <%= closing.mode==='AUTO' ? 'bi-arrow-repeat' : 'bi-pencil-square' %>"></i>Mode <%= closing.mode==='AUTO' ? 'Otomatis' : 'Manual' %> (terkunci bersama periode)</span>
              <small class="closing-mode-locked-hint"><i class="bi bi-info-circle"></i>Periode ini terkunci, jadi mode tidak bisa diganti. Klik <strong>Buka Kembali</strong> di bagian "Status periode" di bawah kalau memang perlu ganti mode.</small>
            <% } else { %>
              <form method="post" action="/closing/mode" data-loading-message="Mengganti mode...">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="from" value="<%= start %>"><input type="hidden" name="to" value="<%= end %>"><input type="hidden" name="mode" value="MANUAL">
                <button class="closing-mode-pill <%= closing.mode!=='AUTO' ? 'is-active' : '' %>" type="submit" <%= closing.mode!=='AUTO' ? 'disabled' : '' %>><i class="bi bi-pencil-square"></i>Manual</button>
              </form>
              <form method="post" action="/closing/mode" data-loading-message="Mengganti mode...">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="from" value="<%= start %>"><input type="hidden" name="to" value="<%= end %>"><input type="hidden" name="mode" value="AUTO">
                <button class="closing-mode-pill <%= closing.mode==='AUTO' ? 'is-active' : '' %>" type="submit" <%= closing.mode==='AUTO' ? 'disabled' : '' %>><i class="bi bi-arrow-repeat"></i>Otomatis · Sinkron Data Kas</button>
              </form>
            <% } %>
          </div>

          <% if (closing.mode === 'AUTO') { %>
          <div class="closing-mode-banner is-auto">
            <i class="bi bi-arrow-repeat"></i>
            <div>
              <strong>Sinkron Data Kas · <%= closing.status==='LOCKED'?'periode terkunci':'masih dapat diedit' %></strong>
              <span>Transaksi Data Kas yang sudah <b>APPROVED</b> Master Admin pada rentang tanggal ini bisa ditarik ke bawah dengan tombol Sync. Baris hasil sync tetap boleh diedit/dihapus/ditambah manual seperti baris biasa.<%= typeof lastSyncedText !== 'undefined' && lastSyncedText ? ` Terakhir sync: ${lastSyncedText}.` : ' Belum pernah disinkron.' %><% if (typeof pending !== 'undefined' && pending) { %><% if (pending.unsyncedApproved > 0) { %> <b><%= pending.unsyncedApproved %> transaksi APPROVED</b> siap ditarik sekarang.<% } %><% if (pending.pendingApproval > 0) { %> <%= pending.pendingApproval %> transaksi lain masih menunggu approval di Data Kas (belum bisa ditarik sampai di-approve).<% } %><% } %></span>
              <% if (typeof estimate !== 'undefined' && estimate) { %>
              <div class="closing-estimate-row">
                <span class="closing-estimate-label">Estimasi pendapatan bersih tim<%= estimate.pendingCount > 0 ? ` (sudah termasuk ${estimate.pendingCount} transaksi yang belum di-sync)` : ' (data saat ini)' %></span>
                <div class="closing-estimate-people">
                  <% estimate.people.forEach(function(p){ %>
                    <span class="closing-estimate-chip"><b><%= p.name %></b>Rp <%= money(p.amount).toLocaleString('id-ID') %></span>
                  <% }) %>
                </div>
              </div>
              <% } %>
            </div>
            <% if (closing.status!=='LOCKED') { %>
            <form method="post" action="/closing/sync" data-loading-message="Menarik transaksi Data Kas..." class="closing-sync-form">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="from" value="<%= start %>"><input type="hidden" name="to" value="<%= end %>">
              <button class="btn btn-primary btn-sm" type="submit"><i class="bi bi-cloud-download me-1"></i>Sync dari Data Kas<% if (typeof pending !== 'undefined' && pending && pending.unsyncedApproved > 0) { %> <span class="closing-sync-badge"><%= pending.unsyncedApproved %></span><% } %></button>
            </form>
            <% } %>
          </div>
          <% } else { %>
          <div class="closing-mode-banner is-manual">
            <i class="bi bi-pencil-square"></i>
            <div><strong>Input manual · <%= closing.status==='LOCKED'?'periode terkunci':'masih dapat diedit' %></strong><span>Semua angka diketik sendiri di bawah. Pindah ke mode Otomatis kalau mau menarik pemasukan/pengeluaran dari Data Kas sebagai titik awal (tetap bisa ditambah/diedit manual).</span></div>
          </div>
          <% } %>
        </div>
      </div>

      <div class="closing-control-divider" role="separator"></div>

      <div class="closing-control-row">
        <div class="closing-control-row-label"><i class="bi bi-file-earmark-bar-graph"></i><span>Laporan</span></div>
        <div class="closing-control-row-body">
          <div class="closing-pdf-actions">
            <div class="dropdown closing-pdf-dropdown">
              <button type="button" class="btn btn-primary btn-sm dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false"><i class="bi bi-file-earmark-pdf me-1"></i>Unduh PDF</button>
              <ul class="dropdown-menu closing-pdf-menu">
                <li class="dropdown-header">PDF per penerima</li>
                <% [['edwin','Edwin'],['jon','Jon'],['bopung','Bopung'],['mang-ali','Mang Ali']].forEach(([key,label]) => { %>
                  <li><a class="dropdown-item closing-pdf-report-link" href="/closing/pdf?from=<%= start %>&to=<%= end %>&report=<%= key %><%= hideEdwin ? '&hide_edwin=1' : '' %>" target="_blank" rel="noopener"><i class="bi bi-file-earmark-pdf me-2"></i><%= label %></a></li>
                <% }) %>
                <li><hr class="dropdown-divider"></li>
                <li><button type="button" id="closingDownloadAllPdf" class="dropdown-item" title="Membuka 4 PDF (Edwin, Jon, Bopung, Mang Ali) berurutan"><i class="bi bi-collection me-2"></i>Unduh Semua PDF</button></li>
              </ul>
            </div>
            <a class="btn btn-outline-secondary btn-sm" href="/closing/history"><i class="bi bi-clock-history me-1"></i>Rekap Bulanan</a>
            <a class="btn btn-outline-secondary btn-sm" href="/closing/export.xlsx?from=<%= start %>&to=<%= end %>"><i class="bi bi-file-earmark-spreadsheet me-1"></i>Export Excel</a>
            <form class="closing-hide-edwin-form" method="get" action="/closing">
              <input type="hidden" name="from" value="<%= start %>"><input type="hidden" name="to" value="<%= end %>">
              <label class="closing-toggle closing-hide-edwin" title="Berlaku untuk PDF penerima selain Edwin">
                <input class="form-check-input" type="checkbox" name="hide_edwin" value="1" onchange="this.form.submit()" <%= hideEdwin ? 'checked' : '' %>>
                <span><i class="bi bi-eye-slash"></i>Sembunyikan bagian Edwin</span>
              </label>
            </form>
          </div>
        </div>
      </div>

      <div class="closing-control-divider" role="separator"></div>

      <div class="closing-control-row">
        <div class="closing-control-row-label"><i class="bi bi-shield-lock"></i><span>Status periode</span></div>
        <div class="closing-control-row-body">
          <% if(closing.status==='LOCKED'){ %>
          <div class="closing-toolbar-locked-actions">
            <form method="post" action="/closing/period-reopen" data-loading-message="Membuka kembali periode..."><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="from" value="<%= start %>"><input type="hidden" name="to" value="<%= end %>"><input class="form-control form-control-sm" name="reason" minlength="5" placeholder="Alasan buka kembali" required><button class="btn btn-outline-warning btn-sm"><i class="bi bi-unlock"></i> Buka Kembali</button></form>
            <a class="btn btn-outline-success btn-sm" href="/closing?from=<%= nextPeriod.start %>&to=<%= nextPeriod.end %>"><i class="bi bi-arrow-right-circle me-1"></i>Buat Periode Berikutnya (<%= nextPeriod.start %> s/d <%= nextPeriod.end %>)</a>
          </div>
          <% }else{ %>
            <% if (closing.mode==='AUTO' && typeof pending !== 'undefined' && pending && pending.unsyncedApproved > 0) { %>
            <div class="closing-lock-warning">
              <i class="bi bi-exclamation-triangle-fill"></i>
              <span><%= pending.unsyncedApproved %> transaksi Data Kas APPROVED belum disinkron ke periode ini.</span>
              <form method="post" action="/closing/period-lock" id="closingForceLockForm" data-loading-message="Memvalidasi dan mengunci periode...">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="from" value="<%= start %>"><input type="hidden" name="to" value="<%= end %>"><input type="hidden" name="reason" value="Closing periode selesai"><input type="hidden" name="force_lock" value="1">
                <button type="button" class="btn btn-outline-danger btn-sm" onclick="openLockPreview('closingForceLockForm', true)"><i class="bi bi-lock"></i> Kunci Walau Belum Sync Semua</button>
              </form>
            </div>
            <% } else { %>
            <div class="closing-lock-actions">
              <form method="post" action="/closing/period-lock" id="closingLockForm" data-loading-message="Memvalidasi dan mengunci periode..."><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="from" value="<%= start %>"><input type="hidden" name="to" value="<%= end %>"><input type="hidden" name="reason" value="Closing periode selesai"><button type="button" class="btn btn-danger btn-sm" onclick="openLockPreview('closingLockForm', false)"><i class="bi bi-lock"></i> Kunci Periode</button></form>
              <form method="post" action="/closing/period-lock" id="closingLockNextForm" data-loading-message="Mengunci &amp; pindah ke periode berikutnya..."><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="from" value="<%= start %>"><input type="hidden" name="to" value="<%= end %>"><input type="hidden" name="reason" value="Closing periode selesai"><input type="hidden" name="go_next" value="1"><button type="button" class="btn btn-outline-success btn-sm" onclick="openLockPreview('closingLockNextForm', false)"><i class="bi bi-check2-circle"></i> Kunci &amp; Lanjut ke Bulan Berikutnya</button></form>
            </div>
            <% } %>
          <% } %>
        </div>
      </div>

    </div>
  </section>

  <% if (typeof unpaidSummary !== 'undefined' && unpaidSummary && unpaidSummary.count > 0) { %>
  <div class="closing-unmapped-alert closing-unpaid-note">
    <i class="bi bi-info-circle-fill"></i>
    <div>
      <strong><%= unpaidSummary.count %> pelanggan belum lunas periode ini (Rp <%= money(unpaidSummary.outstanding).toLocaleString('id-ID') %>)</strong>
      <span>Informasi saja — tidak memengaruhi Pendapatan/Bersih di atas. Rincian per lokasi ada di bagian bawah halaman.</span>
    </div>
  </div>
  <% } %>

  <nav class="closing-steps" aria-label="Tahapan closing">
    <a href="#closing-step-periode"><b>1</b><small>Periode</small></a><a href="#closing-step-input"><b>2</b><small>Pendapatan &amp; pengeluaran</small></a><a href="#closing-step-adjustments"><b>3</b><small>Potongan tim</small></a><a href="#closing-step-hasil"><b>4</b><small>Hasil &amp; PDF</small></a>
  </nav>

  <section class="closing-result-grid" aria-label="Ringkasan hasil closing">
    <% [blocks.krwclm, blocks.kbg].forEach((block, blockIdx) => {
         var trendKey = blockIdx === 0 ? 'krwclm' : 'kbg';
         var trendPct = (typeof trend !== 'undefined' && trend) ? trend[trendKey] : null;
         var expenseCategories = Object.entries(block.expenseByCategory || {}).sort(function(a, b){ return b[1] - a[1]; });
    %>
      <article class="card closing-card closing-result-card">
        <div class="card-body">
          <div class="closing-result-head"><div><span class="closing-card-kicker"><%= block.label === 'CDS' ? 'SITE · KRW + CLM' : 'SITE · KUBANG' %></span><h2><%= block.label %></h2></div><i class="bi <%= block.label === 'CDS' ? 'bi-diagram-3-fill' : 'bi-hdd-rack-fill' %>"></i></div>
          <div class="closing-result-lines">
            <div><span>Pendapatan</span><strong>Rp <%= money(block.revenue).toLocaleString('id-ID') %></strong></div>
            <% if (block.label === 'CDS') { %><small>KRW <%= money(block.clusterRevenue?.KRW || 0).toLocaleString('id-ID') %> · CLM <%= money(block.clusterRevenue?.CLM || 0).toLocaleString('id-ID') %></small><% } %>
            <% if (money(block.psbRevenue) > 0) { %><small>Langganan Rp <%= money(block.subscriptionRevenue).toLocaleString('id-ID') %> · PSB Rp <%= money(block.psbRevenue).toLocaleString('id-ID') %> (<%= block.psbCount %> pelanggan)</small><% } %>
            <div><span>Pengeluaran</span><strong>Rp <%= money(block.expense).toLocaleString('id-ID') %></strong></div>
            <% if (expenseCategories.length) { %><small class="closing-expense-breakdown"><% expenseCategories.forEach(function(pair, i){ %><%= i > 0 ? ' · ' : '' %><%= pair[0] %> Rp <%= money(pair[1]).toLocaleString('id-ID') %><% }) %></small><% } %>
            <div class="closing-result-profit"><span>Laba bersih</span><strong>Rp <%= money(block.profit).toLocaleString('id-ID') %></strong><% if (trendPct !== null && trendPct !== undefined) { %> <span class="closing-trend-badge <%= trendPct > 0 ? 'is-up' : (trendPct < 0 ? 'is-down' : 'is-flat') %>" title="Dibanding periode <%= trend.prevLabel %>"><i class="bi <%= trendPct > 0 ? 'bi-arrow-up-short' : (trendPct < 0 ? 'bi-arrow-down-short' : 'bi-dash') %>"></i><%= Math.abs(trendPct).toFixed(1) %>%</span><% } %></div>
          </div>
        </div>
      </article>
    <% }) %>
  </section>

  <section class="closing-cluster-grid" aria-label="Ringkasan pendapatan per cluster" style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin-bottom:14px">
    <article class="metric-card"><div class="metric-top"><span class="metric-label">Pendapatan KRW</span><span class="metric-icon"><i class="bi bi-signpost-split-fill"></i></span></div><strong>Rp <%= money(blocks.krwclm.clusterRevenue?.KRW || 0).toLocaleString('id-ID') %></strong><small>Cluster CDS</small></article>
    <article class="metric-card"><div class="metric-top"><span class="metric-label">Pendapatan CLM</span><span class="metric-icon"><i class="bi bi-signpost-split-fill"></i></span></div><strong>Rp <%= money(blocks.krwclm.clusterRevenue?.CLM || 0).toLocaleString('id-ID') %></strong><small>Cluster CDS</small></article>
    <article class="metric-card"><div class="metric-top"><span class="metric-label">Pendapatan KBG</span><span class="metric-icon"><i class="bi bi-hdd-rack-fill"></i></span></div><strong>Rp <%= money(blocks.kbg.revenue).toLocaleString('id-ID') %></strong><small>Site Kubang</small></article>
  </section>

  <% if (typeof customerActivity !== 'undefined' && customerActivity) { %>
  <section class="card closing-card" aria-label="Ringkasan pelanggan bulan ini">
    <div class="card-body">
      <div class="closing-section-head"><div><span class="closing-card-kicker">DATA PELANGGAN & TAGIHAN</span><h2>Ringkasan Pelanggan Periode Ini</h2><small class="text-muted">PSB, pelanggan off, dan status bayar tagihan — diambil langsung dari data pelanggan/tagihan, bukan input manual. Informasi saja, tidak memengaruhi Pendapatan/Bersih di atas.</small></div></div>
    <div class="metric-grid mt-3">
      <article class="metric-card green"><div class="metric-top"><span class="metric-label">PSB (Pasang Baru)</span><span class="metric-icon"><i class="bi bi-person-plus-fill"></i></span></div><strong><%= customerActivity.psb.total %></strong><small>CDS <%= customerActivity.psb.krwclm %> · KBG <%= customerActivity.psb.kbg %></small></article>
      <article class="metric-card red"><div class="metric-top"><span class="metric-label">Pelanggan Off</span><span class="metric-icon"><i class="bi bi-person-dash-fill"></i></span></div><strong><%= customerActivity.off.total %></strong><small>CDS <%= customerActivity.off.krwclm %> · KBG <%= customerActivity.off.kbg %></small></article>
      <article class="metric-card green"><div class="metric-top"><span class="metric-label">Sudah Bayar</span><span class="metric-icon"><i class="bi bi-check-circle-fill"></i></span></div><strong><%= customerActivity.billing.paid %></strong><small>Dari <%= customerActivity.billing.total %> tagihan periode ini</small></article>
      <article class="metric-card orange"><div class="metric-top"><span class="metric-label">Belum Bayar</span><span class="metric-icon"><i class="bi bi-exclamation-circle-fill"></i></span></div><strong><%= customerActivity.billing.unpaid %></strong><small>CDS <%= customerActivity.billing.krwclm.unpaid %> · KBG <%= customerActivity.billing.kbg.unpaid %></small></article>
    </div>
    </div>
  </section>
  <% } %>

  <% if (blocks.other && (money(blocks.other.revenue) !== 0 || money(blocks.other.expense) !== 0)) { %>
    <div class="closing-unmapped-alert"><i class="bi bi-exclamation-triangle-fill"></i><div><strong>Lokasi belum dipetakan</strong><span>Gunakan lokasi CDS atau KBG. Data ini tidak masuk pembagian.</span><small>Pendapatan Rp <%= money(blocks.other.revenue).toLocaleString('id-ID') %> · Pengeluaran Rp <%= money(blocks.other.expense).toLocaleString('id-ID') %></small></div></div>
  <% } %>

  <section class="card closing-card closing-input-card" id="closing-step-input">
    <div class="card-body">
      <div class="closing-section-head"><div><span class="closing-card-kicker">LANGKAH 2 · INPUT UTAMA</span><h2>Pendapatan dan pengeluaran</h2><small class="text-muted">Isi nominal per lokasi. Pengeluaran CDS boleh diberi cluster hanya sebagai keterangan.</small></div><span class="closing-count"><%= lineItems.length %> baris</span></div>
        <div class="closing-entry-grid">
          <form class="closing-entry-box closing-entry-form" method="post" action="/closing/entries">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="entry_type" value="INCOME"><input type="hidden" name="from" value="<%= start %>"><input type="hidden" name="to" value="<%= end %>">
            <div class="closing-entry-title"><i class="bi bi-plus-circle"></i><span>Pendapatan</span></div>
            <div class="closing-form-grid">
              <label><span>Lokasi</span><select class="form-select form-select-sm" name="site_code"><option value="CDS">CDS</option><option value="KBG">KBG</option></select></label>
              <label><span>Cluster CDS</span><select class="form-select form-select-sm" name="cluster_name"><option value="">Tidak ada</option><option value="KRW">KRW</option><option value="CLM">CLM</option></select></label>
              <label><span>Tanggal</span><input class="form-control form-control-sm" type="date" name="entry_date" value="<%= start %>" required></label>
              <label class="span-2"><span>Kategori</span><input class="form-control form-control-sm" name="category" value="Pendapatan pelanggan" maxlength="120" required></label>
              <label><span>Nominal</span><input class="form-control form-control-sm" type="number" min="1" step="1" name="amount" placeholder="24000000" required></label>
              <label class="span-3"><span>Keterangan</span><input class="form-control form-control-sm" name="description" maxlength="255" placeholder="Contoh: total pelanggan KRW September"></label>
            </div>
            <button class="btn btn-primary btn-sm" type="submit"><i class="bi bi-plus-lg me-1"></i>Tambah pendapatan</button>
          </form>

          <form class="closing-entry-box closing-entry-form" method="post" action="/closing/entries">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="entry_type" value="EXPENSE"><input type="hidden" name="from" value="<%= start %>"><input type="hidden" name="to" value="<%= end %>">
            <div class="closing-entry-title"><i class="bi bi-dash-circle"></i><span>Pengeluaran</span></div>
            <div class="closing-form-grid">
              <label><span>Lokasi</span><select class="form-select form-select-sm" name="site_code"><option value="CDS">CDS</option><option value="KBG">KBG</option></select></label>
              <label><span>Cluster opsional</span><select class="form-select form-select-sm" name="cluster_name"><option value="">Gabungan</option><option value="KRW">KRW</option><option value="CLM">CLM</option></select></label>
              <label><span>Tanggal</span><input class="form-control form-control-sm" type="date" name="entry_date" value="<%= start %>" required></label>
              <label class="span-2"><span>Kategori</span><input class="form-control form-control-sm" list="closingExpenseCategories" name="category" placeholder="Petty cash / ISP / gaji" maxlength="120" required></label>
              <label><span>Nominal</span><input class="form-control form-control-sm" type="number" min="1" step="1" name="amount" placeholder="10000000" required></label>
              <label class="span-3"><span>Keterangan</span><input class="form-control form-control-sm" name="description" maxlength="255" placeholder="Detail pengeluaran"></label>
            </div>
            <button class="btn btn-outline-primary btn-sm" type="submit"><i class="bi bi-plus-lg me-1"></i>Tambah pengeluaran</button>
          </form>
        </div>
        <datalist id="closingExpenseCategories"><option value="Petty cash"><option value="Maintenance"><option value="Operasional"><option value="Internet / ISP"><option value="Transportasi"><option value="Material jaringan"><option value="Gaji / Honor"><option value="Lain-lain"></datalist>
        <form class="closing-settings-grid" method="post" action="/closing/save">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="from" value="<%= start %>"><input type="hidden" name="to" value="<%= end %>">
          <label><span>Carry-over</span><input class="form-control form-control-sm" type="number" step="1" name="manual_carry" value="<%= closing.manual_carry || 0 %>"></label>
          <label><span>Gaji Agung</span><input class="form-control form-control-sm" type="number" min="0" step="1" name="manual_salary_agung" value="<%= closing.manual_salary_agung ?? 500000 %>"></label>
          <label><span>Gaji Padilah</span><input class="form-control form-control-sm" type="number" min="0" step="1" name="manual_salary_padilah" value="<%= closing.manual_salary_padilah ?? 1000000 %>"></label>
          <label class="closing-notes-field"><span>Catatan closing</span><input class="form-control form-control-sm" name="notes" maxlength="2000" value="<%= closing.notes || '' %>" placeholder="Catatan untuk arsip/PDF"></label>
          <button class="btn btn-outline-primary btn-sm" type="submit"><i class="bi bi-save2 me-1"></i>Simpan pengaturan</button>
        </form>
        <small class="text-muted closing-help">Gaji Agung dan Padilah menjadi potongan CDS: Edwin 50%, Jon 25%, Bopung 25%. Mang Ali tidak dibebani.</small>
    </div>
  </section>

  <div class="modal fade" id="editEntryModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-centered"><form class="modal-content" method="post" id="editEntryForm">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="from" value="<%= start %>"><input type="hidden" name="to" value="<%= end %>">
    <div class="modal-header"><h5 class="modal-title">Edit Baris Manual</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
    <div class="modal-body closing-form-grid">
      <label><span>Lokasi</span><select class="form-select form-select-sm" name="site_code" id="editEntrySite"><option value="CDS">CDS</option><option value="KBG">KBG</option></select></label>
      <label><span>Cluster</span><select class="form-select form-select-sm" name="cluster_name" id="editEntryCluster"><option value="">Tidak ada</option><option value="KRW">KRW</option><option value="CLM">CLM</option></select></label>
      <label><span>Tanggal</span><input class="form-control form-control-sm" type="date" name="entry_date" id="editEntryDate" required></label>
      <label class="span-2"><span>Kategori</span><input class="form-control form-control-sm" name="category" id="editEntryCategory" maxlength="120" required></label>
      <label><span>Nominal</span><input class="form-control form-control-sm" type="number" min="1" step="1" name="amount" id="editEntryAmount" required></label>
      <label class="span-3"><span>Keterangan</span><input class="form-control form-control-sm" name="description" id="editEntryDescription" maxlength="255"></label>
    </div>
    <div class="modal-footer"><button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-save2 me-1"></i>Simpan perubahan</button></div>
  </form></div></div>

  <section class="card closing-card">
    <div class="card-body">
      <div class="closing-section-head"><div><span class="closing-card-kicker">RIWAYAT INPUT</span><h2>Rincian angka manual</h2></div><span class="closing-count"><%= lineItems.length %> baris</span></div>
      <% if (lineItems.length) { %>
      <div class="closing-table-filter">
        <div class="closing-inline-search"><i class="bi bi-search"></i><input type="search" id="closingEntrySearch" class="form-control form-control-sm" placeholder="Cari kategori atau keterangan..."></div>
        <select id="closingEntryTypeFilter" class="form-select form-select-sm">
          <option value="">Semua jenis</option>
          <option value="INCOME">Pendapatan</option>
          <option value="EXPENSE">Pengeluaran</option>
        </select>
        <select id="closingEntrySiteFilter" class="form-select form-select-sm">
          <option value="">Semua lokasi</option>
          <option value="CDS">CDS</option>
          <option value="KBG">KBG</option>
        </select>
      </div>
      <% } %>
      <div class="table-responsive mt-3"><table class="table table-sm align-middle closing-table" id="closingEntryTable"><thead><tr><th>Tanggal</th><th>Jenis</th><th>Lokasi</th><th>Kategori</th><th>Keterangan</th><th class="text-end">Nominal</th><th>Aksi</th></tr></thead><tbody>
        <% if (!lineItems.length) { %><tr><td colspan="7" class="text-muted text-center py-3">Belum ada angka manual. Isi form pendapatan atau pengeluaran di atas.</td></tr><% } %>
        <tr data-empty-filter-row style="display:none"><td colspan="7" class="text-muted text-center py-3">Tidak ada baris yang cocok dengan pencarian/filter ini.</td></tr>
        <% lineItems.forEach(row => { %><tr data-entry-row data-entry-type="<%= row.entry_type %>" data-site="<%= row.site_code %>"><td><%= row.entry_date %></td><td><span class="badge text-bg-<%= row.entry_type === 'INCOME' ? 'success' : 'warning' %>"><%= row.entry_type === 'INCOME' ? 'PENDAPATAN' : 'PENGELUARAN' %></span> <% if (row.source_type === 'cash_sync') { %><span class="badge closing-source-badge" title="Ditarik dari Data Kas"><i class="bi bi-cloud-download"></i> Data Kas</span><% } %></td><td><%= row.site_code %><%= row.cluster_name ? ` / ${row.cluster_name}` : '' %></td><td><%= row.category %></td><td><%= row.description || '-' %></td><td class="text-end">Rp <%= money(row.amount).toLocaleString('id-ID') %></td><td class="closing-row-actions">
          <button type="button" class="btn btn-outline-secondary btn-sm" title="Edit" onclick='openEditEntry(<%- safeJson({id:row.id,site_code:row.site_code,cluster_name:row.cluster_name||"",entry_date:String(row.entry_date).slice(0,10),category:row.category,amount:row.amount,description:row.description||""}) %>)'><i class="bi bi-pencil"></i></button>
          <% if (row.source_type === 'cash_sync') { %>
          <form method="post" action="/closing/entries/<%= row.id %>/delete" onsubmit="return confirm('Kecualikan baris ini dari perhitungan? Baris tetap tersimpan dan bisa dipulihkan lagi nanti.')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="from" value="<%= start %>"><input type="hidden" name="to" value="<%= end %>"><button class="btn btn-outline-danger btn-sm" type="submit" title="Kecualikan dari perhitungan (bukan hapus permanen)"><i class="bi bi-eye-slash"></i></button></form>
          <% } else { %>
          <form method="post" action="/closing/entries/<%= row.id %>/delete" onsubmit="return confirm('Hapus baris ini?')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="from" value="<%= start %>"><input type="hidden" name="to" value="<%= end %>"><button class="btn btn-outline-danger btn-sm" type="submit" title="Hapus"><i class="bi bi-trash"></i></button></form>
          <% } %>
        </td></tr><% }) %>
      </tbody></table></div>
      <% if (typeof excludedItems !== 'undefined' && excludedItems.length) { %>
      <details class="closing-excluded-details mt-3">
        <summary>Baris dikecualikan (<%= excludedItems.length %>) — hasil sinkron yang tidak ikut dihitung</summary>
        <div class="table-responsive mt-2"><table class="table table-sm align-middle closing-table"><thead><tr><th>Tanggal</th><th>Jenis</th><th>Lokasi</th><th>Kategori</th><th>Keterangan</th><th class="text-end">Nominal</th><th>Aksi</th></tr></thead><tbody>
          <% excludedItems.forEach(row => { %><tr class="closing-excluded-row"><td><%= row.entry_date %></td><td><span class="badge text-bg-<%= row.entry_type === 'INCOME' ? 'success' : 'warning' %>"><%= row.entry_type === 'INCOME' ? 'PENDAPATAN' : 'PENGELUARAN' %></span></td><td><%= row.site_code %><%= row.cluster_name ? ` / ${row.cluster_name}` : '' %></td><td><%= row.category %></td><td><%= row.description || '-' %></td><td class="text-end">Rp <%= money(row.amount).toLocaleString('id-ID') %></td><td class="closing-row-actions">
            <form method="post" action="/closing/entries/<%= row.id %>/restore"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="from" value="<%= start %>"><input type="hidden" name="to" value="<%= end %>"><button class="btn btn-outline-success btn-sm" type="submit" title="Pulihkan, ikut dihitung lagi"><i class="bi bi-arrow-counterclockwise"></i> Pulihkan</button></form>
          </td></tr><% }) %>
        </tbody></table></div>
      </details>
      <% } %>
    </div>
  </section>

  <section class="card closing-card" id="closing-step-adjustments">
    <div class="card-body">
      <div class="closing-section-head"><div><span class="closing-card-kicker">LANGKAH 3 · PENYESUAIAN</span><h2>Potongan dan tambahan per orang</h2><small class="text-muted">Cash belum setor otomatis mengurangi hak penerima.</small></div><span class="closing-count"><%= adjustments.length %> baris</span></div>
        <form class="closing-adjustment-grid mt-3" method="post" action="/closing/adjustments">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="from" value="<%= start %>"><input type="hidden" name="to" value="<%= end %>">
          <label><span>Penerima</span><select class="form-select form-select-sm" name="recipient_name"><option>Edwin</option><option>Jon</option><option>Bopung</option><option>Mang Ali</option></select></label>
          <label><span>Lokasi</span><select class="form-select form-select-sm" name="site_code"><option value="CDS">CDS</option><option value="KBG">KBG</option></select></label>
          <label><span>Jenis</span><select class="form-select form-select-sm" name="adjustment_type"><option value="CASH_HOLD">Cash belum setor</option><option value="MANUAL">Potongan / tambahan lain</option></select></label>
          <label><span>Arah</span><select class="form-select form-select-sm" name="direction"><option value="DEDUCT">Potongan (-)</option><option value="ADD">Tambahan (+)</option></select></label>
          <label><span>Nominal</span><input class="form-control form-control-sm" type="number" min="1" step="1" name="amount" required></label>
          <label class="closing-adjustment-description"><span>Keterangan</span><input class="form-control form-control-sm" name="description" maxlength="255" placeholder="Contoh: cash pelanggan belum disetor"></label>
          <button class="btn btn-outline-primary btn-sm" type="submit"><i class="bi bi-plus-lg me-1"></i>Tambah</button>
        </form>
      <div class="table-responsive mt-3"><table class="table table-sm align-middle closing-table"><thead><tr><th>Penerima</th><th>Lokasi</th><th>Jenis</th><th>Keterangan</th><th class="text-end">Nominal</th><th>Aksi</th></tr></thead><tbody>
        <% if (!adjustments.length) { %><tr><td colspan="6" class="text-muted text-center py-3">Belum ada potongan atau tambahan manual.</td></tr><% } %>
        <% adjustments.forEach(item => { %><tr><td><strong><%= item.recipient_name %></strong></td><td><%= item.site_code || 'CDS' %></td><td><%= item.adjustment_type === 'CASH_HOLD' ? 'Cash belum setor' : (item.direction === 'DEDUCT' ? 'Potongan manual' : 'Tambahan manual') %></td><td><%= item.description || '-' %></td><td class="text-end <%= item.direction === 'DEDUCT' ? 'text-danger' : 'text-success' %>"><%= item.direction === 'DEDUCT' ? '- ' : '+ ' %>Rp <%= money(item.amount).toLocaleString('id-ID') %></td><td class="closing-row-actions">
          <button type="button" class="btn btn-outline-secondary btn-sm" title="Edit" onclick='openEditAdjustment(<%- safeJson({id:item.id,recipient_name:item.recipient_name,site_code:item.site_code||"CDS",adjustment_type:item.adjustment_type||"MANUAL",direction:item.direction,amount:item.amount,description:item.description||""}) %>)'><i class="bi bi-pencil"></i></button>
          <form method="post" action="/closing/adjustments/<%= item.id %>/delete" onsubmit="return confirm('Hapus penyesuaian ini?')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="from" value="<%= start %>"><input type="hidden" name="to" value="<%= end %>"><button class="btn btn-outline-danger btn-sm" type="submit" title="Hapus"><i class="bi bi-trash"></i></button></form>
        </td></tr><% }) %>
      </tbody></table></div>
    </div>
  </section>

  <div class="modal fade" id="editAdjustmentModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-centered"><form class="modal-content" method="post" id="editAdjustmentForm">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="from" value="<%= start %>"><input type="hidden" name="to" value="<%= end %>">
    <div class="modal-header"><h5 class="modal-title">Edit Penyesuaian</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
    <div class="modal-body closing-adjustment-grid closing-modal-grid">
      <label><span>Penerima</span><select class="form-select form-select-sm" name="recipient_name" id="editAdjRecipient"><option>Edwin</option><option>Jon</option><option>Bopung</option><option>Mang Ali</option></select></label>
      <label><span>Lokasi</span><select class="form-select form-select-sm" name="site_code" id="editAdjSite"><option value="CDS">CDS</option><option value="KBG">KBG</option></select></label>
      <label><span>Jenis</span><select class="form-select form-select-sm" name="adjustment_type" id="editAdjType"><option value="CASH_HOLD">Cash belum setor</option><option value="MANUAL">Potongan / tambahan lain</option></select></label>
      <label><span>Arah</span><select class="form-select form-select-sm" name="direction" id="editAdjDirection"><option value="DEDUCT">Potongan (-)</option><option value="ADD">Tambahan (+)</option></select></label>
      <label><span>Nominal</span><input class="form-control form-control-sm" type="number" min="1" step="1" name="amount" id="editAdjAmount" required></label>
      <label class="closing-adjustment-description"><span>Keterangan</span><input class="form-control form-control-sm" name="description" id="editAdjDescription" maxlength="255"></label>
    </div>
    <div class="modal-footer"><button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-save2 me-1"></i>Simpan perubahan</button></div>
  </form></div></div>

  <section class="card closing-card" id="closing-step-hasil">
    <div class="card-body">
      <div class="closing-section-head"><div><span class="closing-card-kicker">LANGKAH 4 · HASIL PEMBAGIAN</span><h2>Pembagian hasil per lokasi</h2><small class="text-muted">Persentase berikut digunakan untuk menghitung laba bersih setelah pengeluaran lokasi.</small></div><span class="closing-count">Kalkulator</span></div>
      <div class="closing-share-rules mt-3">
        <article class="closing-share-rule">
          <div class="closing-share-rule-head"><div><span class="closing-share-site">CDS</span><h3>Gabungan KRW dan CLM</h3></div><strong class="closing-total-pill">Total 100%</strong></div>
          <div class="closing-share-lines">
            <div><span>Edwin</span><strong>50%</strong></div>
            <div><span>Jon</span><strong>25%</strong></div>
            <div><span>Bopung</span><strong>25%</strong></div>
          </div>
        </article>
        <article class="closing-share-rule closing-share-rule-kbg">
          <div class="closing-share-rule-head"><div><span class="closing-share-site">KBG</span><h3>Pembagian dua tahap</h3></div><strong class="closing-total-pill">Total 100%</strong></div>
          <p class="closing-share-caption">Tahap 1 — laba bersih KBG</p>
          <div class="closing-share-lines compact">
            <div><span>Mang Ali</span><strong>35%</strong></div>
            <div><span>Pool INKAMNET</span><strong>65%</strong></div>
          </div>
          <p class="closing-share-caption">Tahap 2 — pembagian pool INKAMNET 65%</p>
          <div class="closing-share-lines closing-pool-lines">
            <div><span>Edwin <small>63,72% dari pool</small></span><strong>41,418% <small>dari laba KBG</small></strong></div>
            <div><span>Jon <small>18,14% dari pool</small></span><strong>11,791% <small>dari laba KBG</small></strong></div>
            <div><span>Bopung <small>18,14% dari pool</small></span><strong>11,791% <small>dari laba KBG</small></strong></div>
          </div>
        </article>
      </div>
      <div class="table-responsive mt-3"><table class="table table-sm align-middle closing-table"><thead><tr><th>Lokasi</th><th>Penerima</th><th>%</th><th class="text-end">Kotor</th><th class="text-end">Bersih</th></tr></thead><tbody><% [blocks.krwclm, blocks.kbg].forEach(block => (block.shares || []).forEach(share => { %><tr><td><%= block.label %></td><td><strong><%= share.name %></strong></td><td><%= (share.displayPercent!=null?share.displayPercent:share.percent) %>%</td><td class="text-end">Rp <%= money(share.gross).toLocaleString('id-ID') %></td><td class="text-end"><strong>Rp <%= money(share.amount).toLocaleString('id-ID') %></strong></td></tr><% })) %></tbody></table></div>
    </div>
  </section>

  <div class="closing-lower-grid">
    <section class="card closing-card"><div class="card-body"><div class="closing-section-head"><div><span class="closing-card-kicker">POTONGAN DARI INPUT</span><h2>Gaji</h2></div><span class="closing-count">Total Rp <%= money(salaryTotal).toLocaleString('id-ID') %></span></div>
      <p class="text-muted mb-2" style="font-size:.6rem;font-weight:700;letter-spacing:.03em;text-transform:uppercase;margin-top:10px">Sumber gaji</p>
      <div class="closing-salary-list"><% salaryRows.forEach(row => { %><div><span><%= row.name %></span><strong>Rp <%= money(row.amount).toLocaleString('id-ID') %></strong></div><% }) %></div>
      <p class="text-muted mb-2" style="font-size:.6rem;font-weight:700;letter-spacing:.03em;text-transform:uppercase;margin-top:14px">Dipotong dari bagian (CDS)</p>
      <div class="closing-salary-list">
        <div><span>Edwin <small class="text-muted">50%</small></span><strong>Rp <%= money(salaryByOwner.edwin).toLocaleString('id-ID') %></strong></div>
        <div><span>Jon <small class="text-muted">25%</small></span><strong>Rp <%= money(salaryByOwner.jon).toLocaleString('id-ID') %></strong></div>
        <div><span>Bopung <small class="text-muted">25%</small></span><strong>Rp <%= money(salaryByOwner.bopung).toLocaleString('id-ID') %></strong></div>
      </div>
      <small class="text-muted">Mang Ali tidak dibebani gaji Agung/Padilah.</small>
    </div></section>

    <section class="card closing-card"><div class="card-body"><div class="closing-section-head"><div><span class="closing-card-kicker">INFORMASI · TIDAK MEMENGARUHI PERHITUNGAN</span><h2>Pelanggan belum lunas</h2><small class="text-muted">Sekadar pengingat penagihan untuk periode ini — tidak dihitung ke Pendapatan/Bersih di atas.</small></div><% if (typeof unpaidSummary !== 'undefined' && unpaidSummary) { %><span class="closing-count"><%= unpaidSummary.count %> pelanggan</span><% } %></div>
      <% if (typeof unpaidCustomers === 'undefined' || !unpaidCustomers.length) { %>
        <div class="closing-locked-note"><i class="bi bi-check-circle"></i>Tidak ada pelanggan belum lunas untuk periode ini (atau data tagihan belum tersedia).</div>
      <% } else { %>
      <div class="table-responsive mt-3"><table class="table table-sm align-middle closing-table"><thead><tr><th>Pelanggan</th><th>Lokasi</th><th>Tagihan</th><th class="text-end">Outstanding</th></tr></thead><tbody>
        <% unpaidCustomers.forEach(row => { %><tr><td><%= row.name %><br><small class="text-muted"><%= row.customer_code %></small></td><td><%= row.site_code %><%= row.cluster_name ? ` / ${row.cluster_name}` : '' %></td><td><%= row.invoice_count %> tagihan</td><td class="text-end text-danger">Rp <%= money(row.outstanding).toLocaleString('id-ID') %></td></tr><% }) %>
      </tbody></table></div>
      <% } %>
    </div></section>
  </div>

  <div class="modal fade" id="closingLockPreviewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header"><h5 class="modal-title"><i class="bi bi-clipboard-check me-2"></i>Konfirmasi Kunci Periode</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Tutup"></button></div>
        <div class="modal-body">
          <p class="text-muted mb-3">Periode <strong><%= start %> s/d <%= end %></strong> akan dikunci. Ini ringkasan pembagian bersih yang akan tercatat sebagai snapshot final — cek dulu sebelum lanjut:</p>
          <div class="table-responsive"><table class="table table-sm align-middle closing-table">
            <thead><tr><th>Lokasi</th><th>Penerima</th><th class="text-end">Bersih</th></tr></thead>
            <tbody>
              <% [blocks.krwclm, blocks.kbg].forEach(block => (block.shares || []).forEach(share => { %>
                <tr><td><%= block.label %></td><td><strong><%= share.name %></strong></td><td class="text-end">Rp <%= money(share.amount).toLocaleString('id-ID') %></td></tr>
              <% })) %>
            </tbody>
            <tfoot><tr><td colspan="2"><strong>Total laba bersih</strong></td><td class="text-end"><strong>Rp <%= money(money(blocks.krwclm.profit) + money(blocks.kbg.profit)).toLocaleString('id-ID') %></strong></td></tr></tfoot>
          </table></div>
          <div id="closingLockPreviewWarning" class="closing-lock-warning mt-3" style="display:none">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <span>Masih ada transaksi Data Kas APPROVED yang belum disinkron. Setelah dikunci, transaksi itu tidak akan ikut terhitung di periode ini.</span>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Batal</button>
          <button type="button" class="btn btn-danger btn-sm" id="closingLockPreviewConfirm"><i class="bi bi-lock me-1"></i>Ya, Kunci Periode</button>
        </div>
      </div>
    </div>
  </div>

  <div class="closing-sticky-bar" id="closingStickyBar">
    <div class="closing-sticky-bar-summary">
      <span class="closing-sticky-bar-label">Laba bersih periode ini</span>
      <strong>Rp <%= money(money(blocks.krwclm.profit) + money(blocks.kbg.profit)).toLocaleString('id-ID') %></strong>
    </div>
    <div class="closing-sticky-bar-actions">
      <% if (closing.status==='LOCKED') { %>
        <span class="closing-sticky-bar-status"><i class="bi bi-lock-fill"></i> Periode terkunci</span>
        <a class="btn btn-outline-warning btn-sm" href="#closing-step-periode"><i class="bi bi-arrow-up-circle me-1"></i>Buka Kembali</a>
      <% } else if (closing.mode==='AUTO' && typeof pending !== 'undefined' && pending && pending.unsyncedApproved > 0) { %>
        <form method="post" action="/closing/sync" data-loading-message="Menarik transaksi Data Kas...">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="from" value="<%= start %>"><input type="hidden" name="to" value="<%= end %>">
          <button class="btn btn-primary btn-sm" type="submit"><i class="bi bi-cloud-download me-1"></i>Sync dari Data Kas <span class="closing-sync-badge"><%= pending.unsyncedApproved %></span></button>
        </form>
      <% } else { %>
        <form method="post" action="/closing/period-lock" id="closingStickyLockForm" data-loading-message="Memvalidasi dan mengunci periode...">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="from" value="<%= start %>"><input type="hidden" name="to" value="<%= end %>"><input type="hidden" name="reason" value="Closing periode selesai">
          <button class="btn btn-danger btn-sm" type="button" onclick="openLockPreview('closingStickyLockForm', false)"><i class="bi bi-lock"></i> Kunci Periode</button>
        </form>
      <% } %>
    </div>
  </div>
</div>

<script>
(function(){
  function modalFor(id){var el=document.getElementById(id);return window.bootstrap?bootstrap.Modal.getOrCreateInstance(el):null;}
  window.openEditEntry=function(row){
    document.getElementById('editEntryForm').action='/closing/entries/'+row.id+'/update';
    document.getElementById('editEntrySite').value=row.site_code||'CDS';
    document.getElementById('editEntryCluster').value=row.cluster_name||'';
    document.getElementById('editEntryDate').value=row.entry_date||'';
    document.getElementById('editEntryCategory').value=row.category||'';
    document.getElementById('editEntryAmount').value=row.amount||'';
    document.getElementById('editEntryDescription').value=row.description||'';
    var m=modalFor('editEntryModal');if(m)m.show();
  };
  window.openEditAdjustment=function(row){
    document.getElementById('editAdjustmentForm').action='/closing/adjustments/'+row.id+'/update';
    document.getElementById('editAdjRecipient').value=row.recipient_name||'Edwin';
    document.getElementById('editAdjSite').value=row.site_code||'CDS';
    document.getElementById('editAdjType').value=row.adjustment_type||'MANUAL';
    document.getElementById('editAdjDirection').value=row.direction||'DEDUCT';
    document.getElementById('editAdjAmount').value=row.amount||'';
    document.getElementById('editAdjDescription').value=row.description||'';
    var m=modalFor('editAdjustmentModal');if(m)m.show();
  };

  // v2.2 — tampilkan sticky bar ringkasan (laba bersih + aksi cepat) begitu kartu
  // Kontrol periode & mode sudah discroll lewat, supaya aksi utama tetap terjangkau
  // tanpa harus scroll balik ke atas.
  var stickyBar=document.getElementById('closingStickyBar');
  var stickyTarget=document.querySelector('.closing-control-panel');
  if(stickyBar&&stickyTarget&&'IntersectionObserver' in window){
    var stickyObserver=new IntersectionObserver(function(entries){
      entries.forEach(function(entry){stickyBar.classList.toggle('is-visible',!entry.isIntersecting);});
    },{threshold:0});
    stickyObserver.observe(stickyTarget);
  }

  // v2.3 — Preview pembagian sebelum periode benar-benar dikunci: tombol kunci
  // (di kartu kontrol maupun di sticky bar) tidak langsung submit, tapi buka
  // modal ringkasan dulu supaya angka final sempat dicek sebelum dikunci.
  var pendingLockFormId=null;
  window.openLockPreview=function(formId,isForce){
    pendingLockFormId=formId;
    var warn=document.getElementById('closingLockPreviewWarning');
    if(warn)warn.style.display=isForce?'flex':'none';
    var m=modalFor('closingLockPreviewModal');
    if(m)m.show();
  };
  var lockPreviewConfirmBtn=document.getElementById('closingLockPreviewConfirm');
  if(lockPreviewConfirmBtn){
    lockPreviewConfirmBtn.addEventListener('click',function(){
      if(!pendingLockFormId)return;
      var form=document.getElementById(pendingLockFormId);
      var m=modalFor('closingLockPreviewModal');
      if(m)m.hide();
      if(form)form.submit();
    });
  }

  // v2.3 — cari/filter cepat untuk tabel Riwayat Input (client-side saja, tanpa
  // panggilan server, supaya tetap responsif walau barisnya banyak).
  (function(){
    var search=document.getElementById('closingEntrySearch');
    var typeFilter=document.getElementById('closingEntryTypeFilter');
    var siteFilter=document.getElementById('closingEntrySiteFilter');
    var table=document.getElementById('closingEntryTable');
    if(!search||!table)return;
    function applyEntryFilter(){
      var q=search.value.trim().toLowerCase();
      var type=typeFilter?typeFilter.value:'';
      var site=siteFilter?siteFilter.value:'';
      var rows=table.querySelectorAll('tbody tr[data-entry-row]');
      var visibleCount=0;
      rows.forEach(function(tr){
        var text=tr.textContent.toLowerCase();
        var matchesText=!q||text.indexOf(q)!==-1;
        var matchesType=!type||tr.getAttribute('data-entry-type')===type;
        var matchesSite=!site||tr.getAttribute('data-site')===site;
        var visible=matchesText&&matchesType&&matchesSite;
        tr.style.display=visible?'':'none';
        if(visible)visibleCount++;
      });
      var emptyRow=table.querySelector('tbody tr[data-empty-filter-row]');
      if(emptyRow)emptyRow.style.display=(visibleCount===0&&rows.length>0)?'':'none';
    }
    search.addEventListener('input',applyEntryFilter);
    if(typeFilter)typeFilter.addEventListener('change',applyEntryFilter);
    if(siteFilter)siteFilter.addEventListener('change',applyEntryFilter);
  })();

  // v2.3 — "Download Semua PDF": satu klik memicu ke-4 unduhan PDF (Edwin, Jon,
  // Bopung, Mang Ali) berurutan dengan jeda kecil. Ini tetap 4 file/tab terpisah,
  // BUKAN satu file ZIP gabungan — menggabungkan jadi satu file butuh library zip
  // tambahan di server yang belum terpasang di proyek ini.
  var downloadAllBtn=document.getElementById('closingDownloadAllPdf');
  if(downloadAllBtn){
    downloadAllBtn.addEventListener('click',function(){
      var links=document.querySelectorAll('.closing-pdf-report-link');
      links.forEach(function(link,idx){
        setTimeout(function(){link.click();},idx*350);
      });
    });
  }
})();
</script>
