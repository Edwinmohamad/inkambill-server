<div class="closing-page closing-manual-only">
  <header class="closing-head page-header">
    <div>
      <div class="closing-eyebrow">INKAMNET CONTROL CENTER · KALKULATOR MANUAL</div>
      <h1><i class="bi bi-calculator-fill me-2"></i>Closing</h1>
      <p class="text-muted mb-0">Isi semua angka secara manual untuk periode <strong><%= start %> s/d <%= end %></strong><% if (lockedSnapshot) { %> · snapshot terkunci<% } %>.</p>
    </div>
    <form class="closing-period-form" method="get" action="/closing">
      <label class="closing-field"><span>Mulai</span><input class="form-control form-control-sm" type="date" name="from" value="<%= start %>" required></label>
      <label class="closing-field"><span>Sampai</span><input class="form-control form-control-sm" type="date" name="to" value="<%= end %>" required></label>
      <input type="hidden" name="mode" value="manual">
      <button class="btn btn-primary btn-sm closing-period-submit" type="submit"><i class="bi bi-arrow-repeat me-1"></i>Hitung</button>
      <label class="closing-toggle"><input class="form-check-input" type="checkbox" name="hide_edwin" value="1" <%= hideEdwin ? 'checked' : '' %>><span><i class="bi bi-eye-slash"></i>Sembunyikan bagian Edwin pada PDF pihak lain</span></label>
    </form>
  </header>

  <div class="closing-toolbar">
    <span class="badge <%= closing.status === 'LOCKED' ? 'text-bg-success' : 'text-bg-warning' %>"><i class="bi <%= closing.status === 'LOCKED' ? 'bi-lock-fill' : 'bi-pencil-square' %> me-1"></i><%= closing.status === 'LOCKED' ? 'TERKUNCI' : 'DRAFT' %></span>
    <div class="closing-pdf-actions">
      <% [['edwin','Edwin'],['jon','Jon'],['bopung','Bopung'],['mang-ali','Mang Ali']].forEach(([key,label]) => { %>
        <a class="btn btn-outline-secondary btn-sm" href="/closing/pdf?from=<%= start %>&to=<%= end %>&mode=manual&report=<%= key %><%= hideEdwin ? '&hide_edwin=1' : '' %>" target="_blank" rel="noopener"><i class="bi bi-file-earmark-pdf me-1"></i><%= label %></a>
      <% }) %>
    </div>
  </div>

  <div class="closing-mode-banner is-manual">
    <i class="bi bi-pencil-square"></i>
    <div><strong>Mode manual penuh</strong><span>Closing tidak mengambil data billing, pembayaran, kas, atau cash tim. Semua pendapatan, pengeluaran, potongan, gaji, cash belum setor, dan router diisi dari kolom di bawah.</span></div>
  </div>

  <section class="closing-result-grid" aria-label="Ringkasan hasil closing">
    <% [blocks.krwclm, blocks.kbg].forEach(block => { %>
      <article class="card closing-card closing-result-card">
        <div class="card-body">
          <div class="closing-result-head"><div><span class="closing-card-kicker"><%= block.label === 'CDS' ? 'SITE · KRW + CLM' : 'SITE · KUBANG' %></span><h2><%= block.label %></h2></div><i class="bi <%= block.label === 'CDS' ? 'bi-diagram-3-fill' : 'bi-hdd-rack-fill' %>"></i></div>
          <div class="closing-result-lines">
            <div><span>Pendapatan</span><strong>Rp <%= money(block.revenue).toLocaleString('id-ID') %></strong></div>
            <% if (block.label === 'CDS') { %><small>KRW <%= money(block.clusterRevenue?.KRW || 0).toLocaleString('id-ID') %> · CLM <%= money(block.clusterRevenue?.CLM || 0).toLocaleString('id-ID') %></small><% } %>
            <div><span>Pengeluaran</span><strong>Rp <%= money(block.expense).toLocaleString('id-ID') %></strong></div>
            <div class="closing-result-profit"><span>Laba bersih</span><strong>Rp <%= money(block.profit).toLocaleString('id-ID') %></strong></div>
          </div>
        </div>
      </article>
    <% }) %>
  </section>

  <% if (blocks.other && (money(blocks.other.revenue) !== 0 || money(blocks.other.expense) !== 0)) { %>
    <div class="closing-unmapped-alert"><i class="bi bi-exclamation-triangle-fill"></i><div><strong>Lokasi belum dipetakan</strong><span>Gunakan lokasi CDS atau KBG. Data ini tidak masuk pembagian.</span><small>Pendapatan Rp <%= money(blocks.other.revenue).toLocaleString('id-ID') %> · Pengeluaran Rp <%= money(blocks.other.expense).toLocaleString('id-ID') %></small></div></div>
  <% } %>

  <section class="card closing-card closing-input-card">
    <div class="card-body">
      <div class="closing-section-head"><div><span class="closing-card-kicker">INPUT UTAMA</span><h2>Angka pendapatan dan pengeluaran</h2><small class="text-muted">Satu baris = satu angka yang ingin dibagi. Pengeluaran CDS boleh diberi cluster hanya sebagai keterangan.</small></div><span class="closing-count"><%= lineItems.length %> baris</span></div>
      <% if (closing.status !== 'LOCKED') { %>
        <div class="closing-entry-grid">
          <form class="closing-entry-box closing-entry-form" method="post" action="/closing/entries">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="entry_type" value="INCOME"><input type="hidden" name="from" value="<%= start %>"><input type="hidden" name="to" value="<%= end %>"><input type="hidden" name="mode" value="manual">
            <div class="closing-entry-title"><i class="bi bi-plus-circle"></i><span>Pendapatan</span></div>
            <div class="closing-form-grid">
              <label><span>Lokasi</span><select class="form-select form-select-sm" name="site_code"><option value="CDS">CDS</option><option value="KBG">KBG</option></select></label>
              <label><span>Cluster CDS</span><select class="form-select form-select-sm" name="cluster_name"><option value="">Tidak ada</option><option value="KRW">KRW</option><option value="CLM">CLM</option></select></label>
              <label><span>Tanggal</span><input class="form-control form-control-sm" type="date" name="entry_date" value="<%= start %>" required></label>
              <label class="span-2"><span>Kategori</span><input class="form-control form-control-sm" name="category" value="Pendapatan pelanggan" maxlength="120" required></label>
              <label><span>Nominal</span><input class="form-control form-control-sm" type="number" min="1" step="1" name="amount" placeholder="24000000" required></label>
              <label class="span-3"><span>Keterangan</span><input class="form-control form-control-sm" name="description" maxlength="255" placeholder="Contoh: total pelanggan KRW September"></label>
            </div>
            <button class="btn btn-primary btn-sm" type="submit"><i class="bi bi-plus-lg me-1"></i>Tambah pendapatan</button>
          </form>

          <form class="closing-entry-box closing-entry-form" method="post" action="/closing/entries">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="entry_type" value="EXPENSE"><input type="hidden" name="from" value="<%= start %>"><input type="hidden" name="to" value="<%= end %>"><input type="hidden" name="mode" value="manual">
            <div class="closing-entry-title"><i class="bi bi-dash-circle"></i><span>Pengeluaran</span></div>
            <div class="closing-form-grid">
              <label><span>Lokasi</span><select class="form-select form-select-sm" name="site_code"><option value="CDS">CDS</option><option value="KBG">KBG</option></select></label>
              <label><span>Cluster opsional</span><select class="form-select form-select-sm" name="cluster_name"><option value="">Gabungan</option><option value="KRW">KRW</option><option value="CLM">CLM</option></select></label>
              <label><span>Tanggal</span><input class="form-control form-control-sm" type="date" name="entry_date" value="<%= start %>" required></label>
              <label class="span-2"><span>Kategori</span><input class="form-control form-control-sm" list="closingExpenseCategories" name="category" placeholder="Petty cash / ISP / gaji" maxlength="120" required></label>
              <label><span>Nominal</span><input class="form-control form-control-sm" type="number" min="1" step="1" name="amount" placeholder="10000000" required></label>
              <label class="span-3"><span>Keterangan</span><input class="form-control form-control-sm" name="description" maxlength="255" placeholder="Detail pengeluaran"></label>
            </div>
            <button class="btn btn-outline-primary btn-sm" type="submit"><i class="bi bi-plus-lg me-1"></i>Tambah pengeluaran</button>
          </form>
        </div>
        <datalist id="closingExpenseCategories"><option value="Petty cash"><option value="Maintenance"><option value="Operasional"><option value="Internet / ISP"><option value="Transportasi"><option value="Material jaringan"><option value="Gaji / Honor"><option value="Lain-lain"></datalist>
        <form class="closing-settings-grid" method="post" action="/closing/save">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="from" value="<%= start %>"><input type="hidden" name="to" value="<%= end %>"><input type="hidden" name="mode" value="manual">
          <label><span>Carry-over</span><input class="form-control form-control-sm" type="number" step="1" name="manual_carry" value="<%= closing.manual_carry || 0 %>"></label>
          <label><span>Gaji Agung</span><input class="form-control form-control-sm" type="number" min="0" step="1" name="manual_salary_agung" value="<%= closing.manual_salary_agung ?? 500000 %>"></label>
          <label><span>Gaji Padilah</span><input class="form-control form-control-sm" type="number" min="0" step="1" name="manual_salary_padilah" value="<%= closing.manual_salary_padilah ?? 1000000 %>"></label>
          <label class="closing-notes-field"><span>Catatan closing</span><input class="form-control form-control-sm" name="notes" maxlength="2000" value="<%= closing.notes || '' %>" placeholder="Catatan untuk arsip/PDF"></label>
          <button class="btn btn-outline-primary btn-sm" type="submit"><i class="bi bi-save2 me-1"></i>Simpan pengaturan</button>
        </form>
        <small class="text-muted closing-help">Gaji Agung dan Padilah menjadi potongan CDS: Edwin 50%, Jon 25%, Bopung 25%. Mang Ali tidak dibebani.</small>
      <% } else { %>
        <div class="closing-locked-note"><i class="bi bi-lock-fill"></i>Periode sudah dikunci. Semua input menjadi snapshot tetap.</div>
      <% } %>
    </div>
  </section>

  <section class="card closing-card">
    <div class="card-body">
      <div class="closing-section-head"><div><span class="closing-card-kicker">RIWAYAT INPUT</span><h2>Rincian angka manual</h2></div><span class="closing-count"><%= lineItems.length %> baris</span></div>
      <div class="table-responsive mt-3"><table class="table table-sm align-middle closing-table"><thead><tr><th>Tanggal</th><th>Jenis</th><th>Lokasi</th><th>Kategori</th><th>Keterangan</th><th class="text-end">Nominal</th><th>Aksi</th></tr></thead><tbody>
        <% if (!lineItems.length) { %><tr><td colspan="7" class="text-muted text-center py-3">Belum ada angka manual. Isi form pendapatan atau pengeluaran di atas.</td></tr><% } %>
        <% lineItems.forEach(row => { %><tr><td><%= row.entry_date %></td><td><span class="badge text-bg-<%= row.entry_type === 'INCOME' ? 'success' : 'warning' %>"><%= row.entry_type === 'INCOME' ? 'PENDAPATAN' : 'PENGELUARAN' %></span></td><td><%= row.site_code %><%= row.cluster_name ? ` / ${row.cluster_name}` : '' %></td><td><%= row.category %></td><td><%= row.description || '-' %></td><td class="text-end">Rp <%= money(row.amount).toLocaleString('id-ID') %></td><td><% if (closing.status !== 'LOCKED') { %><form method="post" action="/closing/entries/<%= row.id %>/delete" onsubmit="return confirm('Hapus baris ini?')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="from" value="<%= start %>"><input type="hidden" name="to" value="<%= end %>"><button class="btn btn-outline-danger btn-sm" type="submit" title="Hapus"><i class="bi bi-trash"></i></button></form><% } else { %><span class="text-muted">Terkunci</span><% } %></td></tr><% }) %>
      </tbody></table></div>
    </div>
  </section>

  <section class="card closing-card">
    <div class="card-body">
      <div class="closing-section-head"><div><span class="closing-card-kicker">PENYESUAIAN</span><h2>Potongan, cash belum setor, dan tambahan</h2><small class="text-muted">Semua diisi manual per orang dan lokasi. Cash belum setor otomatis menjadi potongan penerima.</small></div><span class="closing-count"><%= adjustments.length %> baris</span></div>
      <% if (closing.status !== 'LOCKED') { %>
        <form class="closing-adjustment-grid mt-3" method="post" action="/closing/adjustments">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="from" value="<%= start %>"><input type="hidden" name="to" value="<%= end %>"><input type="hidden" name="mode" value="manual">
          <label><span>Penerima</span><select class="form-select form-select-sm" name="recipient_name"><option>Edwin</option><option>Jon</option><option>Bopung</option><option>Mang Ali</option></select></label>
          <label><span>Lokasi</span><select class="form-select form-select-sm" name="site_code"><option value="CDS">CDS</option><option value="KBG">KBG</option></select></label>
          <label><span>Jenis</span><select class="form-select form-select-sm" name="adjustment_type"><option value="CASH_HOLD">Cash belum setor</option><option value="MANUAL">Potongan / tambahan lain</option></select></label>
          <label><span>Arah</span><select class="form-select form-select-sm" name="direction"><option value="DEDUCT">Potongan (-)</option><option value="ADD">Tambahan (+)</option></select></label>
          <label><span>Nominal</span><input class="form-control form-control-sm" type="number" min="1" step="1" name="amount" required></label>
          <label class="closing-adjustment-description"><span>Keterangan</span><input class="form-control form-control-sm" name="description" maxlength="255" placeholder="Contoh: cash pelanggan belum disetor"></label>
          <button class="btn btn-outline-primary btn-sm" type="submit"><i class="bi bi-plus-lg me-1"></i>Tambah</button>
        </form>
      <% } %>
      <div class="table-responsive mt-3"><table class="table table-sm align-middle closing-table"><thead><tr><th>Penerima</th><th>Lokasi</th><th>Jenis</th><th>Keterangan</th><th class="text-end">Nominal</th><th>Aksi</th></tr></thead><tbody>
        <% if (!adjustments.length) { %><tr><td colspan="6" class="text-muted text-center py-3">Belum ada potongan atau tambahan manual.</td></tr><% } %>
        <% adjustments.forEach(item => { %><tr><td><strong><%= item.recipient_name %></strong></td><td><%= item.site_code || 'CDS' %></td><td><%= item.adjustment_type === 'CASH_HOLD' ? 'Cash belum setor' : (item.direction === 'DEDUCT' ? 'Potongan manual' : 'Tambahan manual') %></td><td><%= item.description || '-' %></td><td class="text-end <%= item.direction === 'DEDUCT' ? 'text-danger' : 'text-success' %>"><%= item.direction === 'DEDUCT' ? '- ' : '+ ' %>Rp <%= money(item.amount).toLocaleString('id-ID') %></td><td><% if (closing.status !== 'LOCKED') { %><form method="post" action="/closing/adjustments/<%= item.id %>/delete" onsubmit="return confirm('Hapus penyesuaian ini?')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="from" value="<%= start %>"><input type="hidden" name="to" value="<%= end %>"><button class="btn btn-outline-danger btn-sm" type="submit" title="Hapus"><i class="bi bi-trash"></i></button></form><% } else { %><span class="text-muted">Terkunci</span><% } %></td></tr><% }) %>
      </tbody></table></div>
    </div>
  </section>

  <section class="card closing-card">
    <div class="card-body">
      <div class="closing-section-head"><div><span class="closing-card-kicker">HASIL PEMBAGIAN</span><h2>Pembagian hasil per lokasi</h2><small class="text-muted">CDS 50% / 25% / 25% · KBG Mang Ali 35% dan pool internal 65%.</small></div><span class="closing-count">Kalkulator</span></div>
      <div class="table-responsive mt-3"><table class="table table-sm align-middle closing-table"><thead><tr><th>Lokasi</th><th>Penerima</th><th>%</th><th class="text-end">Kotor</th><th class="text-end">Bersih</th></tr></thead><tbody><% [blocks.krwclm, blocks.kbg].forEach(block => (block.shares || []).forEach(share => { %><tr><td><%= block.label %></td><td><strong><%= share.name %></strong></td><td><%= share.percent %>%</td><td class="text-end">Rp <%= money(share.gross).toLocaleString('id-ID') %></td><td class="text-end"><strong>Rp <%= money(share.amount).toLocaleString('id-ID') %></strong></td></tr><% })) %></tbody></table></div>
    </div>
  </section>

  <div class="closing-lower-grid">
    <section class="card closing-card"><div class="card-body"><div class="closing-section-head"><div><span class="closing-card-kicker">POTONGAN DARI INPUT</span><h2>Gaji</h2></div></div><div class="closing-salary-list"><% salaryRows.forEach(row => { %><div><span><%= row.name %></span><strong>Rp <%= money(row.amount).toLocaleString('id-ID') %></strong></div><% }) %></div><small class="text-muted">Total gaji dibebankan ke CDS: Edwin 50%, Jon 25%, Bopung 25%. Mang Ali tidak dibebani.</small></div></section>

    <section class="card closing-card"><div class="card-body"><div class="closing-section-head"><div><span class="closing-card-kicker">INVEST ROUTER</span><h2>Router milik tim</h2><small class="text-muted">Rp20.000 per unit aktif. Data diisi manual dan status rusak/diganti tidak dihitung.</small></div><span class="closing-count"><%= routerAssets.length %> data</span></div>
      <% if (closing.status !== 'LOCKED') { %><form class="closing-router-grid mt-3" method="post" action="/closing/router-assets"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="from" value="<%= start %>"><input type="hidden" name="to" value="<%= end %>"><input type="hidden" name="mode" value="manual"><label><span>Nama pelanggan</span><input class="form-control form-control-sm" name="customer_name" placeholder="Pelanggan A" required></label><label><span>Lokasi</span><select class="form-select form-select-sm" name="site_code"><option value="CDS">CDS</option><option value="KBG">KBG</option></select></label><label><span>Cluster</span><select class="form-select form-select-sm" name="cluster_name"><option value="">Gabungan</option><option value="KRW">KRW</option><option value="CLM">CLM</option></select></label><label><span>Pemilik</span><input class="form-control form-control-sm" name="owner_name" placeholder="Jon / Bopung" required></label><label><span>Unit</span><input class="form-control form-control-sm" type="number" name="units" min="1" max="100" value="1" required></label><label><span>Aktif mulai</span><input class="form-control form-control-sm" type="date" name="active_from" value="<%= start %>" required></label><button class="btn btn-outline-primary btn-sm" type="submit"><i class="bi bi-plus-lg me-1"></i>Tambah router</button></form><% } %>
      <div class="table-responsive mt-3"><table class="table table-sm align-middle closing-table"><thead><tr><th>Pelanggan</th><th>Lokasi</th><th>Pemilik</th><th>Unit</th><th>Status</th><th>Aksi</th></tr></thead><tbody><% if (!routerAssets.length) { %><tr><td colspan="6" class="text-muted text-center py-3">Belum ada router manual.</td></tr><% } %><% routerAssets.forEach(row => { %><tr><td><%= row.customer_name %></td><td><%= row.site_code %><%= row.cluster_name ? ` / ${row.cluster_name}` : '' %></td><td><%= row.owner_name %></td><td><%= row.units %></td><td><span class="badge text-bg-<%= row.status === 'ACTIVE' ? 'success' : 'secondary' %>"><%= row.status %></span></td><td><% if (closing.status !== 'LOCKED') { %><form class="closing-router-status-form" method="post" action="/closing/router-assets/<%= row.id %>/status"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="from" value="<%= start %>"><input type="hidden" name="to" value="<%= end %>"><select class="form-select form-select-sm" name="status" aria-label="Status router"><option value="ACTIVE" <%= row.status === 'ACTIVE' ? 'selected' : '' %>>Aktif</option><option value="BROKEN" <%= row.status === 'BROKEN' ? 'selected' : '' %>>Rusak</option><option value="REPLACED" <%= row.status === 'REPLACED' ? 'selected' : '' %>>Diganti</option><option value="INACTIVE" <%= row.status === 'INACTIVE' ? 'selected' : '' %>>Tidak aktif</option></select><input class="form-control form-control-sm" type="date" name="active_until" value="<%= row.active_until || '' %>" aria-label="Tanggal berakhir"><button class="btn btn-outline-secondary btn-sm" type="submit">Simpan</button></form><% } else { %><span class="text-muted">Terkunci</span><% } %></td></tr><% }) %></tbody></table></div>
    </div></section>
  </div>

  <section class="card closing-card closing-lock-card"><div class="card-body"><div class="closing-section-head"><div><span class="closing-card-kicker">FINALISASI</span><h2>Kunci closing</h2><small class="text-muted">Setelah dikunci, input dan PDF periode ini menjadi snapshot tetap.</small></div><% if (closing.status !== 'LOCKED') { %><form method="post" action="/closing/lock" onsubmit="return confirm('Kunci periode ini? Setelah dikunci, data tidak dapat diubah.')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="from" value="<%= start %>"><input type="hidden" name="to" value="<%= end %>"><input type="hidden" name="mode" value="manual"><button class="btn btn-outline-danger btn-sm" type="submit"><i class="bi bi-lock-fill me-1"></i>Kunci Closing</button></form><% } else { %><span class="badge text-bg-success">SNAPSHOT TERKUNCI</span><% } %></div></div></section>
</div>
