<div class="closing-page">
  <div class="page-header d-flex justify-content-between align-items-end flex-wrap gap-3">
    <div>
      <div class="closing-eyebrow">INKAMNET CONTROL CENTER · KALKULATOR CLOSING</div>
      <h1><i class="bi bi-calculator-fill me-2"></i>Closing</h1>
      <p class="text-muted mb-0">Periode transaksi: <%= start %> s/d <%= end %> <% if (lockedSnapshot) { %>· snapshot terkunci<% } %></p>
    </div>
    <div class="d-flex gap-2 flex-wrap align-items-center">
      <form class="d-flex gap-2 flex-wrap" method="get" action="/closing">
        <input class="form-control form-control-sm" type="date" name="from" value="<%= start %>" aria-label="Tanggal mulai">
        <input class="form-control form-control-sm" type="date" name="to" value="<%= end %>" aria-label="Tanggal akhir">
        <select class="form-select form-select-sm closing-mode-select" name="mode" aria-label="Mode perhitungan">
          <option value="auto" <%= mode === 'auto' ? 'selected' : '' %>>Otomatis dari billing</option>
          <option value="manual" <%= mode === 'manual' ? 'selected' : '' %>>Kalkulator manual + billing</option>
        </select>
        <label class="closing-recipient-note closing-hide-edwin"><input class="form-check-input me-1" type="checkbox" name="hide_edwin" value="1" <%= hideEdwin ? 'checked' : '' %>> <i class="bi bi-eye-slash me-1"></i>Sembunyikan bagian Edwin pada PDF pihak lain</label>
        <button class="btn btn-primary btn-sm" type="submit"><i class="bi bi-arrow-repeat me-1"></i>Tampilkan</button>
        <div class="closing-pdf-actions">
          <button class="btn btn-outline-secondary btn-sm" type="submit" formaction="/closing/pdf" formmethod="get" formtarget="_blank" name="report" value="edwin"><i class="bi bi-file-earmark-pdf me-1"></i>Edwin</button>
          <button class="btn btn-outline-secondary btn-sm" type="submit" formaction="/closing/pdf" formmethod="get" formtarget="_blank" name="report" value="jon"><i class="bi bi-file-earmark-pdf me-1"></i>Jon</button>
          <button class="btn btn-outline-secondary btn-sm" type="submit" formaction="/closing/pdf" formmethod="get" formtarget="_blank" name="report" value="bopung"><i class="bi bi-file-earmark-pdf me-1"></i>Bopung</button>
          <button class="btn btn-outline-secondary btn-sm" type="submit" formaction="/closing/pdf" formmethod="get" formtarget="_blank" name="report" value="mang-ali"><i class="bi bi-file-earmark-pdf me-1"></i>Mang Ali</button>
        </div>
      </form>
    </div>
  </div>

  <div class="closing-mode-banner <%= mode === 'auto' ? 'is-auto' : 'is-manual' %> mt-3">
    <i class="bi <%= mode === 'auto' ? 'bi-lightning-charge-fill' : 'bi-calculator-fill' %>"></i>
    <div>
      <strong><%= mode === 'auto' ? 'Mode otomatis aktif' : 'Mode kalkulator manual + billing aktif' %></strong>
      <span><%= mode === 'auto' ? 'Pembayaran confirmed, pemasukan kas non-billing, dan kas approved dibaca sesuai tanggal periode. Baris kalkulator tersimpan, tetapi baru ikut dihitung saat mode manual dipilih.' : 'Data billing/kas menjadi dasar. Tambahkan pendapatan per cluster, pengeluaran per lokasi/kategori, dan penyesuaian penerima untuk melihat hasil secara langsung.' %></span>
    </div>
  </div>

  <div class="row g-3 mt-3">
    <% [blocks.krwclm, blocks.kbg].forEach(block => { %>
      <div class="col-lg-6"><div class="card closing-card h-100"><div class="card-body">
        <div class="closing-card-kicker"><%= block.label %></div>
        <h4 class="mb-3">Kalkulator profit</h4>
        <div class="d-flex justify-content-between"><span>Pendapatan</span><strong>Rp <%= money(block.revenue).toLocaleString('id-ID') %></strong></div>
        <% if (block.label === 'CDS') { %>
          <div class="closing-breakdown-list mt-2"><small class="text-muted d-block mb-1">Rincian pendapatan cluster</small>
            <% Object.entries(block.clusterRevenue || {}).forEach(([cluster, amount]) => { %><div><span><%= cluster === 'LAINNYA' ? 'Tanpa cluster' : cluster %></span><strong>Rp <%= money(amount).toLocaleString('id-ID') %></strong></div><% }) %>
          </div>
        <% } %>
        <div class="d-flex justify-content-between mt-2"><span>Pengeluaran gabungan</span><strong>Rp <%= money(block.expense).toLocaleString('id-ID') %></strong></div>
        <div class="closing-breakdown-list mt-2"><small class="text-muted d-block mb-1">Kategori pengeluaran</small>
          <% if (!Object.keys(block.expenseByCategory || {}).length) { %><small class="text-muted">Belum ada pengeluaran.</small><% } %>
          <% Object.entries(block.expenseByCategory || {}).forEach(([category, amount]) => { %><div><span><%= category %></span><strong>Rp <%= money(amount).toLocaleString('id-ID') %></strong></div><% }) %>
        </div>
        <hr><div class="d-flex justify-content-between"><span>Laba bersih</span><strong class="closing-profit">Rp <%= money(block.profit).toLocaleString('id-ID') %></strong></div>
      </div></div></div>
    <% }) %>
  </div>

  <% if (blocks.other && (money(blocks.other.revenue) !== 0 || money(blocks.other.expense) !== 0)) { %>
    <div class="closing-unmapped-alert mt-3"><i class="bi bi-exclamation-triangle-fill"></i><div><strong>Lokasi belum dipetakan</strong><span>Ada data yang belum masuk CDS atau KBG. Sistem tidak memindahkannya otomatis dan tombol kunci akan menolak closing sampai lokasi diperbaiki.</span><small>Pendapatan Rp <%= money(blocks.other.revenue).toLocaleString('id-ID') %> · Pengeluaran Rp <%= money(blocks.other.expense).toLocaleString('id-ID') %></small></div></div>
  <% } %>

  <div class="card closing-card mt-3"><div class="card-body">
    <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap"><div><h5 class="mb-1">Input kalkulator manual</h5><small class="text-muted">Pendapatan CDS dapat dicatat per cluster KRW/CLM. Pengeluaran dicatat satu kali berdasarkan lokasi CDS/KBG dan kategori.</small></div><span class="badge <%= closing.status === 'LOCKED' ? 'text-bg-success' : 'text-bg-warning' %>"><%= closing.status === 'LOCKED' ? 'TERKUNCI' : 'DRAFT' %></span></div>
    <% if (closing.status !== 'LOCKED') { %>
      <div class="row g-3 mt-2">
        <div class="col-lg-6"><div class="closing-entry-box"><div class="closing-entry-title"><i class="bi bi-plus-circle me-1"></i>Tambah pendapatan</div><form class="row g-2" method="post" action="/closing/entries"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="entry_type" value="INCOME"><input type="hidden" name="from" value="<%= start %>"><input type="hidden" name="to" value="<%= end %>"><input type="hidden" name="mode" value="manual"><div class="col-md-4"><label class="form-label">Lokasi</label><select class="form-select form-select-sm" name="site_code"><option value="CDS">CDS</option><option value="KBG">KBG</option></select></div><div class="col-md-4"><label class="form-label">Cluster CDS</label><select class="form-select form-select-sm" name="cluster_name"><option value="">- Tidak ada -</option><option value="KRW">KRW</option><option value="CLM">CLM</option></select></div><div class="col-md-4"><label class="form-label">Tanggal</label><input class="form-control form-control-sm" type="date" name="entry_date" value="<%= start %>" required></div><div class="col-md-5"><label class="form-label">Kategori</label><input class="form-control form-control-sm" name="category" value="Pendapatan pelanggan" maxlength="120" required></div><div class="col-md-3"><label class="form-label">Nominal</label><input class="form-control form-control-sm" type="number" min="1" step="1" name="amount" required></div><div class="col-md-4"><label class="form-label">Keterangan</label><input class="form-control form-control-sm" name="description" maxlength="255" placeholder="Contoh: total KRW September"></div><div class="col-12"><button class="btn btn-primary btn-sm" type="submit"><i class="bi bi-plus-lg me-1"></i>Tambahkan pendapatan</button></div></form></div></div>
        <div class="col-lg-6"><div class="closing-entry-box"><div class="closing-entry-title"><i class="bi bi-dash-circle me-1"></i>Tambah pengeluaran</div><form class="row g-2" method="post" action="/closing/entries"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="entry_type" value="EXPENSE"><input type="hidden" name="from" value="<%= start %>"><input type="hidden" name="to" value="<%= end %>"><input type="hidden" name="mode" value="manual"><div class="col-md-4"><label class="form-label">Lokasi</label><select class="form-select form-select-sm" name="site_code"><option value="CDS">CDS</option><option value="KBG">KBG</option></select></div><div class="col-md-4"><label class="form-label">Cluster opsional</label><select class="form-select form-select-sm" name="cluster_name"><option value="">Pengeluaran gabungan</option><option value="KRW">KRW</option><option value="CLM">CLM</option></select></div><div class="col-md-4"><label class="form-label">Tanggal</label><input class="form-control form-control-sm" type="date" name="entry_date" value="<%= start %>" required></div><div class="col-md-5"><label class="form-label">Kategori</label><input class="form-control form-control-sm" list="closingExpenseCategories" name="category" placeholder="Petty cash, maintenance..." maxlength="120" required></div><div class="col-md-3"><label class="form-label">Nominal</label><input class="form-control form-control-sm" type="number" min="1" step="1" name="amount" required></div><div class="col-md-4"><label class="form-label">Keterangan</label><input class="form-control form-control-sm" name="description" maxlength="255" placeholder="Detail pengeluaran"></div><div class="col-12"><button class="btn btn-outline-primary btn-sm" type="submit"><i class="bi bi-plus-lg me-1"></i>Tambahkan pengeluaran</button></div></form></div></div>
      </div>
      <datalist id="closingExpenseCategories"><option value="Petty cash"><option value="Maintenance"><option value="Operasional"><option value="Internet / ISP"><option value="Transportasi"><option value="Material jaringan"><option value="Lain-lain"></datalist>
      <div class="closing-legacy-box mt-3"><form class="row g-2" method="post" action="/closing/save"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="from" value="<%= start %>"><input type="hidden" name="to" value="<%= end %>"><input type="hidden" name="mode" value="manual"><div class="col-md-2"><label class="form-label">Carry-over</label><input class="form-control form-control-sm" type="number" step="1" name="manual_carry" value="<%= closing.manual_carry || 0 %>"></div><div class="col-md-2"><label class="form-label">Gaji Agung</label><input class="form-control form-control-sm" type="number" min="0" step="1" name="manual_salary_agung" value="<%= closing.manual_salary_agung || 500000 %>"></div><div class="col-md-2"><label class="form-label">Gaji Padilah</label><input class="form-control form-control-sm" type="number" min="0" step="1" name="manual_salary_padilah" value="<%= closing.manual_salary_padilah || 1000000 %>"></div><div class="col-md-4"><label class="form-label">Catatan closing</label><input class="form-control form-control-sm" name="notes" maxlength="2000" value="<%= closing.notes || '' %>"></div><div class="col-md-2 d-flex align-items-end"><button class="btn btn-outline-primary btn-sm w-100" type="submit"><i class="bi bi-save2 me-1"></i>Simpan</button></div><input type="hidden" name="manual_revenue" value="<%= closing.manual_revenue || 0 %>"><input type="hidden" name="manual_expense" value="<%= closing.manual_expense || 0 %>"></form><small class="text-muted d-block mt-2">Gaji otomatis menjadi potongan Edwin 50%, Jon 25%, dan Bopung 25%. Mang Ali tidak dibebani gaji.</small></div>
    <% } else { %><small class="text-muted d-block mt-3">Periode sudah dikunci. Baris kalkulator dan penyesuaian menjadi snapshot tetap.</small><% } %>
  </div></div>

  <div class="card closing-card mt-3"><div class="card-body"><div class="d-flex justify-content-between align-items-start gap-3 flex-wrap"><div><h5 class="mb-1">Rincian baris kalkulator</h5><small class="text-muted">Pengeluaran CDS tetap dihitung satu total, walaupun keterangan cluster KRW/CLM dicatat.</small></div><span class="badge text-bg-info"><%= lineItems.length %> baris</span></div><div class="table-responsive mt-3"><table class="table table-sm align-middle"><thead><tr><th>Tanggal</th><th>Jenis</th><th>Lokasi</th><th>Kategori</th><th>Keterangan</th><th class="text-end">Nominal</th><th>Aksi</th></tr></thead><tbody>
    <% if (!lineItems.length) { %><tr><td colspan="7" class="text-muted text-center py-3">Belum ada baris manual. Mode otomatis tetap membaca billing/kas.</td></tr><% } %>
    <% lineItems.forEach(row => { %><tr><td><%= row.entry_date %></td><td><span class="badge text-bg-<%= row.entry_type === 'INCOME' ? 'success' : 'warning' %>"><%= row.entry_type === 'INCOME' ? 'PENDAPATAN' : 'PENGELUARAN' %></span></td><td><%= row.site_code %><%= row.cluster_name ? ` / ${row.cluster_name}` : '' %></td><td><%= row.category %></td><td><%= row.description || '-' %></td><td class="text-end">Rp <%= money(row.amount).toLocaleString('id-ID') %></td><td><% if (closing.status !== 'LOCKED') { %><form method="post" action="/closing/entries/<%= row.id %>/delete" onsubmit="return confirm('Hapus baris ini?')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="from" value="<%= start %>"><input type="hidden" name="to" value="<%= end %>"><button class="btn btn-outline-danger btn-sm" type="submit"><i class="bi bi-trash"></i></button></form><% } else { %><span class="text-muted">Terkunci</span><% } %></td></tr><% }) %>
  </tbody></table></div></div></div>

  <div class="card closing-card mt-3"><div class="card-body"><div class="d-flex justify-content-between align-items-start gap-3 flex-wrap"><div><h5 class="mb-1">Potongan / penyesuaian per orang</h5><small class="text-muted">Masukkan cash lain, koreksi, atau tambahan khusus penerima. Gaji dan INVEST ROUTER dihitung otomatis.</small></div></div>
    <% if (closing.status !== 'LOCKED') { %><form class="row g-2 mt-2" method="post" action="/closing/adjustments"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="from" value="<%= start %>"><input type="hidden" name="to" value="<%= end %>"><input type="hidden" name="mode" value="manual"><div class="col-md-2"><label class="form-label">Penerima</label><select class="form-select form-select-sm" name="recipient_name"><option>Edwin</option><option>Jon</option><option>Bopung</option><option>Mang Ali</option></select></div><div class="col-md-2"><label class="form-label">Lokasi</label><select class="form-select form-select-sm" name="site_code"><option value="CDS">CDS</option><option value="KBG">KBG</option></select></div><div class="col-md-2"><label class="form-label">Jenis</label><select class="form-select form-select-sm" name="direction"><option value="DEDUCT">Potongan (-)</option><option value="ADD">Tambahan (+)</option></select></div><div class="col-md-2"><label class="form-label">Nominal</label><input class="form-control form-control-sm" type="number" min="1" step="1" name="amount" required></div><div class="col-md-3"><label class="form-label">Keterangan</label><input class="form-control form-control-sm" name="description" maxlength="255" placeholder="Contoh: cash belum disetor manual"></div><div class="col-md-1 d-flex align-items-end"><button class="btn btn-outline-primary btn-sm w-100" type="submit"><i class="bi bi-plus-lg"></i></button></div></form><% } %>
    <div class="table-responsive mt-3"><table class="table table-sm align-middle"><thead><tr><th>Penerima</th><th>Lokasi</th><th>Jenis</th><th>Keterangan</th><th class="text-end">Nominal</th><th>Aksi</th></tr></thead><tbody><% if (!adjustments.length) { %><tr><td colspan="6" class="text-muted text-center py-3">Belum ada penyesuaian manual.</td></tr><% } %><% adjustments.forEach(item => { %><tr><td><%= item.recipient_name %></td><td><%= item.site_code || 'CDS' %></td><td><%= item.direction === 'DEDUCT' ? 'Potongan' : 'Tambahan' %></td><td><%= item.description || '-' %></td><td class="text-end"><%= item.direction === 'DEDUCT' ? '- ' : '' %>Rp <%= money(item.amount).toLocaleString('id-ID') %></td><td><% if (closing.status !== 'LOCKED') { %><form method="post" action="/closing/adjustments/<%= item.id %>/delete" onsubmit="return confirm('Hapus penyesuaian ini?')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="from" value="<%= start %>"><input type="hidden" name="to" value="<%= end %>"><button class="btn btn-outline-danger btn-sm" type="submit"><i class="bi bi-trash"></i></button></form><% } else { %><span class="text-muted">Terkunci</span><% } %></td></tr><% }) %></tbody></table></div>
  </div></div>

  <div class="card closing-card mt-3"><div class="card-body"><div class="d-flex justify-content-between align-items-center gap-3 flex-wrap"><div><h5 class="mb-1">Pembagian hasil per lokasi</h5><small class="text-muted">CDS: Edwin 50%, Jon 25%, Bopung 25%. KBG: Mang Ali 35%, pool internal 65% dengan Edwin 41,418%, Jon 11,791%, Bopung 11,791%.</small></div><span class="badge text-bg-info">Hasil kalkulator</span></div><div class="table-responsive mt-3"><table class="table table-sm align-middle"><thead><tr><th>Lokasi</th><th>Penerima</th><th>%</th><th class="text-end">Kotor</th><th class="text-end">Bersih</th></tr></thead><tbody><% [blocks.krwclm, blocks.kbg].forEach(block => (block.shares || []).forEach(share => { %><tr><td><%= block.label %></td><td><strong><%= share.name %></strong></td><td><%= share.percent %>%</td><td class="text-end">Rp <%= money(share.gross).toLocaleString('id-ID') %></td><td class="text-end"><strong>Rp <%= money(share.amount).toLocaleString('id-ID') %></strong></td></tr><% })) %></tbody></table></div></div></div>

  <div class="row g-3 mt-3"><div class="col-lg-7"><div class="card closing-card h-100"><div class="card-body"><h5>Cash belum disetor</h5><small class="text-muted">Nominal ini otomatis mengurangi bagian pemegang pada lokasi yang sama.</small><div class="table-responsive mt-2"><table class="table table-sm align-middle"><thead><tr><th>Tanggal</th><th>Pelanggan</th><th>Pemegang</th><th>Lokasi</th><th class="text-end">Nominal</th></tr></thead><tbody><% if (!heldCash.length) { %><tr><td colspan="5" class="text-muted text-center py-3">Tidak ada cash tertahan pada periode ini.</td></tr><% } %><% heldCash.forEach(row => { %><tr><td><%= row.paid_date %></td><td><%= row.customer_name %></td><td><%= row.holder_name %></td><td><%= locationText(row) %></td><td class="text-end text-danger">Rp <%= money(row.amount).toLocaleString('id-ID') %></td></tr><% }) %></tbody></table></div></div></div></div><div class="col-lg-5"><div class="card closing-card h-100"><div class="card-body"><h5>Gaji otomatis</h5><% salaryRows.forEach(row => { %><div class="d-flex justify-content-between"><span><%= row.name %></span><strong>Rp <%= money(row.amount).toLocaleString('id-ID') %></strong></div><% }) %><hr><small class="text-muted">Dibebankan Edwin 50%, Jon 25%, Bopung 25%. Mang Ali tidak dibebani.</small></div></div></div></div>

  <div class="card closing-card mt-3"><div class="card-body"><div class="d-flex justify-content-between align-items-start gap-3 flex-wrap"><div><h5 class="mb-1">INVEST ROUTER</h5><p class="small text-muted mb-0">Rp20.000 per router aktif per bulan. Router rusak/diganti tidak dihitung.</p></div><span class="badge text-bg-secondary">Manual register</span></div><% if (closing.status !== 'LOCKED') { %><form class="row g-2 mt-3" method="post" action="/closing/router-assets"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="from" value="<%= start %>"><input type="hidden" name="to" value="<%= end %>"><input type="hidden" name="mode" value="manual"><div class="col-md-3"><input class="form-control form-control-sm" name="customer_name" placeholder="Nama pelanggan" required></div><div class="col-md-2"><select class="form-select form-select-sm" name="site_code"><option value="CDS">CDS</option><option value="KBG">KBG</option></select></div><div class="col-md-2"><select class="form-select form-select-sm" name="cluster_name"><option value="">Pengeluaran gabungan</option><option value="KRW">KRW</option><option value="CLM">CLM</option></select></div><div class="col-md-2"><input class="form-control form-control-sm" name="owner_name" placeholder="Jon/Bopung" required></div><div class="col-md-1"><input class="form-control form-control-sm" type="number" name="units" min="1" max="100" value="1" required></div><div class="col-md-1"><input class="form-control form-control-sm" type="date" name="active_from" value="<%= start %>" required></div><div class="col-md-1"><button class="btn btn-outline-primary btn-sm w-100" type="submit" title="Tambah"><i class="bi bi-plus-lg"></i></button></div></form><% } %><div class="table-responsive mt-3"><table class="table table-sm align-middle"><thead><tr><th>Pelanggan</th><th>Site / Cluster</th><th>Pemilik</th><th>Unit</th><th>Status</th><th>Aktif mulai</th><th>Aksi</th></tr></thead><tbody><% if (!routerAssets.length) { %><tr><td colspan="7" class="text-muted text-center py-3">Belum ada data router pribadi.</td></tr><% } %><% routerAssets.forEach(row => { %><tr><td><%= row.customer_name %></td><td><%= row.site_code %><%= row.cluster_name ? ` / ${row.cluster_name}` : '' %></td><td><%= row.owner_name %></td><td><%= row.units %></td><td><span class="badge text-bg-<%= row.status === 'ACTIVE' ? 'success' : 'secondary' %>"><%= row.status %></span></td><td><%= row.active_from %></td><td><% if (closing.status !== 'LOCKED') { %><form class="closing-router-status-form" method="post" action="/closing/router-assets/<%= row.id %>/status"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="from" value="<%= start %>"><input type="hidden" name="to" value="<%= end %>"><select class="form-select form-select-sm" name="status" aria-label="Status router"><option value="ACTIVE" <%= row.status === 'ACTIVE' ? 'selected' : '' %>>Aktif</option><option value="BROKEN" <%= row.status === 'BROKEN' ? 'selected' : '' %>>Rusak</option><option value="REPLACED" <%= row.status === 'REPLACED' ? 'selected' : '' %>>Diganti</option><option value="INACTIVE" <%= row.status === 'INACTIVE' ? 'selected' : '' %>>Tidak aktif</option></select><input class="form-control form-control-sm" type="date" name="active_until" value="<%= row.active_until || '' %>" aria-label="Tanggal berakhir"><button class="btn btn-outline-secondary btn-sm" type="submit">Update</button></form><% } else { %><span class="text-muted">Terkunci</span><% } %></td></tr><% }) %></tbody></table></div></div></div>

  <div class="card closing-card mt-3"><div class="card-body"><div class="d-flex justify-content-between align-items-center gap-3 flex-wrap"><div><h5 class="mb-1">Kunci periode</h5><small class="text-muted">Setelah dikunci, semua baris kalkulator, pembagian, dan PDF memakai snapshot yang tidak berubah. Lokasi belum dipetakan akan memblokir penguncian.</small></div><% if (closing.status !== 'LOCKED') { %><form method="post" action="/closing/lock" onsubmit="return confirm('Kunci periode ini? Setelah dikunci, data tidak dapat diubah.')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="from" value="<%= start %>"><input type="hidden" name="to" value="<%= end %>"><input type="hidden" name="mode" value="<%= mode %>"><button class="btn btn-outline-danger btn-sm" type="submit"><i class="bi bi-lock-fill me-1"></i>Kunci Closing</button></form><% } else { %><span class="badge text-bg-success">SNAPSHOT TERKUNCI</span><% } %></div></div></div>
</div>
