<div class="closing-page closing-unlock-page">
  <div class="closing-unlock-shell">
    <div class="closing-unlock-icon"><i class="bi bi-shield-lock-fill"></i></div>
    <div class="closing-eyebrow">INKAMNET CONTROL CENTER · EDWIN ONLY</div>
    <h1>Buka Menu Closing</h1>
    <p class="text-muted">Masukkan PIN Closing untuk melihat pembagian hasil dan PDF periode.</p>
    <form method="post" action="/closing/unlock" class="closing-unlock-form" autocomplete="off">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="next" value="<%= next %>">
      <label for="closingPin" class="form-label">PIN Closing</label>
      <input id="closingPin" class="form-control form-control-lg text-center closing-pin-input" type="password" name="pin" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" minlength="6" placeholder="••••••" required autofocus>
      <button class="btn btn-primary w-100 mt-3" type="submit"><i class="bi bi-unlock-fill me-2"></i>Buka Closing</button>
    </form>
    <small class="text-muted d-block mt-3">Sesi terbuka otomatis berakhir setelah <%= process.env.CLOSING_PIN_TTL_MINUTES || 30 %> menit.</small>
  </div>
</div>
