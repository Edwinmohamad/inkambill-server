<section class="noc-page">
  <div class="module-head"><div><div class="module-kicker">LIVE MONITORING · NETWORK OPERATIONS CENTER</div><h1>NOC Terpadu</h1><p>Router, pelanggan PPPoE, ONT GenieACS, redaman, dan tiket aktif dari cache lokal.</p></div><div class="module-actions"><a class="btn-tech" href="/network/monitor"><i class="bi bi-router-fill"></i>MikroTik NMS</a><a class="btn-tech" href="/acs"><i class="bi bi-bezier2"></i>Monitoring ONT</a><a class="btn-tech primary" href="/acs/map"><i class="bi bi-map-fill"></i>Network Map</a></div></div>
  <div class="noc-health-strip"><span class="pulse-dot"></span><div><strong>Monitoring aktif</strong><small>ACS terakhir: <%= lastSync?.finished_at?new Date(lastSync.finished_at).toLocaleString('id-ID',{timeZone:'Asia/Jakarta'}):'belum pernah sinkron' %></small></div><time data-live-clock>--:--:-- WIB</time></div>
  <div class="noc-kpi-grid">
    <a href="/network/monitor" class="noc-kpi <%= Number(routers.offline||0)?'danger':'success' %>"><i class="bi bi-router-fill"></i><span><small>ROUTER ONLINE</small><strong><%= Number(routers.online||0) %>/<%= Number(routers.total||0) %></strong><em><%= Number(routers.offline||0) %> offline</em></span></a>
    <a href="/acs?status=online" class="noc-kpi <%= Number(onts.offline||0)?'danger':'success' %>"><i class="bi bi-broadcast-pin"></i><span><small>ONT ONLINE</small><strong><%= Number(onts.online||0) %>/<%= Number(onts.total||0) %></strong><em><%= Number(onts.offline||0) %> offline</em></span></a>
    <a href="/acs?signal=critical" class="noc-kpi <%= Number(onts.critical||0)?'danger':'warning' %>"><i class="bi bi-reception-2"></i><span><small>REDAMAN KRITIS</small><strong><%= Number(onts.critical||0) %></strong><em><%= Number(onts.warning||0) %> warning</em></span></a>
    <a href="/network/monitor" class="noc-kpi <%= Number(customers.unreachable||0)?'danger':'success' %>"><i class="bi bi-people-fill"></i><span><small>PELANGGAN ONLINE</small><strong><%= Number(customers.online||0) %>/<%= Number(customers.total||0) %></strong><em><%= Number(customers.isolated||0) %> isolir</em></span></a>
    <a href="/tickets?status=active" class="noc-kpi <%= Number(tickets.critical||0)?'danger':'warning' %>"><i class="bi bi-ticket-detailed-fill"></i><span><small>TIKET AKTIF</small><strong><%= Number(tickets.total||0) %></strong><em><%= Number(tickets.critical||0) %> critical</em></span></a>
  </div>
  <div class="noc-grid">
    <article class="data-card"><div class="data-card-head"><div><h3>Kesehatan Per Site</h3><small>Prioritas berdasarkan router dan ONT.</small></div></div><div class="table-responsive"><table class="app-table"><thead><tr><th>Site</th><th>Pelanggan</th><th>Router</th><th>ONT Offline</th><th>Redaman Kritis</th><th>Kondisi</th></tr></thead><tbody><% sites.forEach(s=>{ const bad=Number(s.routers_offline)+Number(s.ont_offline)+Number(s.ont_critical); %><tr><td><strong><%= s.code %></strong><small><%= s.name %></small></td><td><%= s.customers %></td><td><%= s.routers %></td><td><%= s.ont_offline %></td><td><%= s.ont_critical %></td><td><span class="status-badge <%= bad?'red':'green' %>"><%= bad?'PERLU CEK':'NORMAL' %></span></td></tr><% }) %></tbody></table></div></article>
    <article class="data-card"><div class="data-card-head"><div><h3>Alarm Prioritas</h3><small>Router offline, ONT offline, dan redaman bermasalah.</small></div><a href="/acs">Lihat ONT</a></div><div class="noc-alarm-list"><% alarms.forEach(a=>{ %><a href="<%= a.kind==='router'?'/network/monitor':'/acs?q='+encodeURIComponent(a.title) %>" class="noc-alarm <%= a.tone %>"><i class="bi <%= a.kind==='router'?'bi-router-fill':'bi-broadcast-pin' %>"></i><span><strong><%= a.title %></strong><small><%= a.detail %></small></span><time><%= a.event_at?new Date(a.event_at).toLocaleString('id-ID',{timeZone:'Asia/Jakarta'}):'-' %></time></a><% }) %><% if(!alarms.length){ %><div class="empty-state"><i class="bi bi-shield-check"></i><strong>Semua jaringan normal</strong><small>Tidak ada alarm aktif.</small></div><% } %></div></article>
  </div>
</section>
