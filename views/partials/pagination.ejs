<% if(typeof pagination!=='undefined'&&pagination&&pagination.pages>1){ const makePage=n=>{const p=new URLSearchParams(queryParams||{});p.set('page',n);p.set('per_page',pagination.perPage);return '?'+p.toString();}; %><nav class="app-pagination" aria-label="Navigasi halaman"><span><%= pagination.from %>–<%= pagination.to %> dari <%= pagination.total %></span><div><a class="btn-tech <%= pagination.page<=1?'disabled':'' %>" href="<%= pagination.page<=1?'#':makePage(pagination.page-1) %>"><i class="bi bi-chevron-left"></i></a><strong>Halaman <%= pagination.page %> / <%= pagination.pages %></strong><a class="btn-tech <%= pagination.page>=pagination.pages?'disabled':'' %>" href="<%= pagination.page>=pagination.pages?'#':makePage(pagination.page+1) %>"><i class="bi bi-chevron-right"></i></a></div></nav><% } %>
