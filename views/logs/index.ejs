<section class="logs-page">
  <div class="module-head"><div><div class="module-kicker">SYSTEM OBSERVABILITY</div><h1>Log Aktivitas</h1><p>Jejak perubahan pengguna dan hasil proses otomatis dalam satu tampilan.</p></div><a class="btn-tech" href="/logs"><i class="bi bi-arrow-repeat"></i>Refresh</a></div>

  <div class="log-summary-grid">
    <article><i class="bi bi-person-lines-fill"></i><span><small>AKTIVITAS USER</small><strong><%= summary.audit %></strong></span></article>
    <article><i class="bi bi-cpu-fill"></i><span><small>AUTOMATION</small><strong><%= summary.automation %></strong></span></article>
    <article class="success"><i class="bi bi-check-circle-fill"></i><span><small>BERHASIL</small><strong><%= summary.success %></strong></span></article>
    <article class="danger"><i class="bi bi-x-octagon-fill"></i><span><small>GAGAL</small><strong><%= summary.failed %></strong></span></article>
    <article class="danger"><i class="bi bi-phone-fill"></i><span><small>CRASH ANDROID</small><strong><%= summary.mobileCrashes %></strong></span></article>
  </div>

  <form class="filter-card" method="get" action="/logs">
    <div class="filter-grid">
      <div class="filter-group"><label>PENCARIAN</label><input class="form-control" name="q" value="<%= q %>" placeholder="User, aksi, modul, IP, job, pesan error..."></div>
      <div class="filter-group"><label>DARI TANGGAL</label><input class="form-control" type="date" name="date_from" value="<%= filters.date_from %>"></div>
      <div class="filter-group"><label>SAMPAI TANGGAL</label><input class="form-control" type="date" name="date_to" value="<%= filters.date_to %>"></div>
      <div class="filter-group"><label>AKSI (USER)</label><select class="form-select" name="action"><option value="">Semua Aksi</option><% actions.forEach(a=>{ %><option value="<%= a %>" <%= filters.action===a?'selected':'' %>><%= a %></option><% }) %></select></div>
      <div class="filter-group"><label>STATUS (AUTOMATION)</label><select class="form-select" name="status"><option value="">Semua Status</option><option value="success" <%= filters.status==='success'?'selected':'' %>>Berhasil</option><option value="failed" <%= filters.status==='failed'?'selected':'' %>>Gagal</option></select></div>
      <div class="filter-group d-flex align-items-end gap-2"><button class="btn-tech primary flex-fill"><i class="bi bi-funnel-fill"></i>Cari Log</button><a class="btn-tech" href="/logs"><i class="bi bi-arrow-counterclockwise"></i></a></div>
    </div>
  </form>

  <div class="log-tab-shell">
    <div class="log-tabs" role="tablist"><button class="active" type="button" data-log-tab="audit"><i class="bi bi-person-check"></i>Aktivitas Pengguna <b><%= audit.length %></b></button><button type="button" data-log-tab="automation"><i class="bi bi-robot"></i>Automation <b><%= automation.length %></b></button><button type="button" data-log-tab="mobile"><i class="bi bi-phone"></i>INKAMNET GO <b><%= mobileCrashes.length %></b></button></div>
    <div class="log-panel active" data-log-panel="audit"><div class="table-responsive"><table class="app-table log-table"><thead><tr><th class="app-seq-col">No.</th><th>Waktu</th><th>User</th><th>Aksi</th><th>Entitas</th><th>Deskripsi</th><th>IP</th></tr></thead><tbody><% audit.forEach((row,index)=>{ %><tr><td><span class="cell-main"><%= index+1 %></span></td><td><span class="cell-main"><%= row.created_at?new Date(row.created_at).toLocaleDateString('id-ID',{timeZone:'Asia/Jakarta'}):'-' %></span><span class="cell-sub"><%= row.created_at?new Date(row.created_at).toLocaleTimeString('id-ID',{timeZone:'Asia/Jakarta'}):'' %></span></td><td><span class="log-user"><i class="bi bi-person"></i><%= row.user_name||'Sistem' %></span></td><td><span class="status-badge purple"><%= row.action %></span></td><td><span class="cell-main"><%= row.entity_type||'-' %></span><span class="cell-sub">ID <%= row.entity_id||'-' %></span></td><td class="log-message"><%= row.description||'-' %></td><td><code><%= row.ip_address||'-' %></code></td></tr><% }) %><% if(!audit.length){ %><tr><td colspan="7"><div class="empty-state"><i class="bi bi-search"></i><strong>Aktivitas tidak ditemukan</strong><small>Coba kata pencarian lain.</small></div></td></tr><% } %></tbody></table></div></div>
    <div class="log-panel" data-log-panel="automation"><div class="table-responsive"><table class="app-table log-table"><thead><tr><th class="app-seq-col">No.</th><th>Waktu</th><th>Job</th><th>Status</th><th>Pesan</th></tr></thead><tbody><% automation.forEach((row,index)=>{ %><tr><td><span class="cell-main"><%= index+1 %></span></td><td><span class="cell-main"><%= row.created_at?new Date(row.created_at).toLocaleDateString('id-ID',{timeZone:'Asia/Jakarta'}):'-' %></span><span class="cell-sub"><%= row.created_at?new Date(row.created_at).toLocaleTimeString('id-ID',{timeZone:'Asia/Jakarta'}):'' %></span></td><td><span class="cell-main"><%= row.job_name||'-' %></span></td><td><span class="status-badge <%= row.status==='success'?'green':'red' %>"><%= statusLabel(row.status).toUpperCase() %></span></td><td class="log-message"><%= row.message||'-' %></td></tr><% }) %><% if(!automation.length){ %><tr><td colspan="5"><div class="empty-state"><i class="bi bi-robot"></i><strong>Log automation tidak ditemukan</strong><small>Belum ada proses atau tidak cocok dengan pencarian.</small></div></td></tr><% } %></tbody></table></div></div>
    <div class="log-panel" data-log-panel="mobile"><div class="table-responsive"><table class="app-table log-table"><thead><tr><th class="app-seq-col">No.</th><th>Waktu</th><th>User</th><th>Perangkat</th><th>Versi</th><th>Error</th><th>Detail</th></tr></thead><tbody><% mobileCrashes.forEach((row,index)=>{ %><tr><td><span class="cell-main"><%= index+1 %></span></td><td><span class="cell-main"><%= row.created_at?new Date(row.created_at).toLocaleDateString('id-ID',{timeZone:'Asia/Jakarta'}):'-' %></span><span class="cell-sub"><%= row.created_at?new Date(row.created_at).toLocaleTimeString('id-ID',{timeZone:'Asia/Jakarta'}):'' %></span></td><td><span class="log-user"><i class="bi bi-person"></i><%= row.user_name||'Tidak diketahui' %></span></td><td><span class="cell-main"><%= row.device_model||'-' %></span><span class="cell-sub">Android <%= row.android_version||'-' %></span></td><td><span class="status-badge purple"><%= row.app_version||'-' %></span></td><td><span class="cell-main"><%= row.exception_class||'-' %></span><span class="cell-sub"><%= row.message||'-' %></span></td><td class="log-message"><details><summary>Lihat stack trace</summary><pre class="mt-2 mb-0"><%= row.stack_trace||'-' %></pre></details></td></tr><% }) %><% if(!mobileCrashes.length){ %><tr><td colspan="7"><div class="empty-state"><i class="bi bi-phone"></i><strong>Tidak ada crash Android</strong><small>INKAMNET GO berjalan normal atau belum mengirim laporan.</small></div></td></tr><% } %></tbody></table></div></div>
  </div>
</section>
<script>(()=>{const tabs=[...document.querySelectorAll('[data-log-tab]')],panels=[...document.querySelectorAll('[data-log-panel]')];tabs.forEach(button=>button.addEventListener('click',()=>{tabs.forEach(x=>x.classList.toggle('active',x===button));panels.forEach(x=>x.classList.toggle('active',x.dataset.logPanel===button.dataset.logTab));}));})();</script>
