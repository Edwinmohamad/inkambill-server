<section>
  <div class="module-head">
    <div><div class="module-kicker">NETWORK INTEGRATION</div><h1>Router MikroTik</h1><p>REST API connector untuk test router, PPPoE, isolir, buka isolir, dan automation.</p></div>
    <div class="module-actions"><% if(isAdmin){ %><button class="btn-tech primary" data-bs-toggle="modal" data-bs-target="#routerModal"><i class="bi bi-router-fill"></i>Tambah Router</button><% } %></div>
  </div>
  <% const online=routers.filter(r=>r.last_status==='online').length; %>
  <div class="metric-grid">
    <article class="metric-card"><div class="metric-top"><span class="metric-label">Total Router</span><span class="metric-icon"><i class="bi bi-router-fill"></i></span></div><strong><%= routers.length %></strong><small>Router terdaftar</small></article>
    <article class="metric-card green"><div class="metric-top"><span class="metric-label">Online</span><span class="metric-icon"><i class="bi bi-wifi"></i></span></div><strong><%= online %></strong><small>Last health check</small></article>
    <article class="metric-card red"><div class="metric-top"><span class="metric-label">Offline</span><span class="metric-icon"><i class="bi bi-wifi-off"></i></span></div><strong><%= routers.filter(r=>r.last_status==='offline').length %></strong><small>Perlu dicek</small></article>
    <article class="metric-card"><div class="metric-top"><span class="metric-label">REST Security</span><span class="metric-icon"><i class="bi bi-shield-lock-fill"></i></span></div><strong>HTTPS</strong><small>Recommended for production</small></article>
  </div>

  <div class="data-card">
    <div class="data-card-head"><div><h3>Router Registry</h3><small>Credentials tersimpan terenkripsi · router yang masih dipakai pelanggan tidak dapat dihapus</small></div></div>
    <div class="table-responsive"><table class="app-table" data-bulk-scope="routersBulkBar"><thead><tr><% if(isAdmin){ %><th class="app-check-col"><input type="checkbox" class="form-check-input" data-select-all aria-label="Pilih semua router"></th><% } %><th class="app-seq-col">No.</th><th>Site</th><th>Router</th><th>REST Endpoint</th><th>TLS</th><th>Status</th><th>Last Seen</th><th>Action</th></tr></thead><tbody>
      <% routers.forEach((r,index)=>{ %><tr>
        <% if(isAdmin){ %><td class="app-check-col"><input type="checkbox" class="form-check-input" data-row-check value="<%= r.id %>" <%= Number(r.linked_customers||0)>0?'disabled title="Masih dipakai pelanggan"':'' %> aria-label="Pilih router <%= r.name %>"></td><% } %>
        <td><span class="cell-main"><%= index+1 %></span></td>
        <td><span class="status-badge purple"><%= r.site_code %></span></td>
        <td><span class="cell-main"><%= r.name %></span><span class="router-linked-count"><i class="bi bi-people"></i> <%= Number(r.linked_customers||0) %> pelanggan terhubung</span></td>
        <td><code class="text-purple"><%= r.base_url %></code></td>
        <td><%= r.verify_tls?'Verify':'Skip' %></td>
        <td><span class="status-badge <%= r.last_status==='online'?'green':r.last_status==='offline'?'red':'gray' %>"><%= statusLabel(r.last_status) %></span><% if(r.last_error){ %><span class="cell-sub text-danger-soft"><%= r.last_error %></span><% } %></td>
        <td><%= r.last_seen_at?new Date(r.last_seen_at).toLocaleString('id-ID',{timeZone:'Asia/Jakarta'}):'-' %></td>
        <td><div class="router-action-group">
          <form method="post" action="/routers/<%= r.id %>/test"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn-tech" title="Test koneksi"><i class="bi bi-activity"></i>Test</button></form>
          <% if(isAdmin){ %><button type="button" class="btn-tech" data-router-edit data-id="<%= r.id %>" data-site="<%= r.site_id %>" data-name="<%= r.name %>" data-url="<%= r.base_url %>" data-username="<%= r.username %>" data-tls="<%= r.verify_tls?1:0 %>" data-bs-toggle="modal" data-bs-target="#routerEditModal"><i class="bi bi-pencil-square"></i>Edit</button>
          <form method="post" action="/routers/<%= r.id %>/delete" onsubmit="return confirm('Hapus router <%= r.name %>? Tindakan ini tidak dapat dibatalkan.')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn-tech danger" <%= Number(r.linked_customers||0)>0?'disabled':'' %> title="<%= Number(r.linked_customers||0)>0?'Pindahkan/unlink pelanggan sebelum menghapus router':'Hapus router' %>"><i class="bi bi-trash3"></i>Hapus</button></form><% } %>
        </div></td>
      </tr><% }) %>
      <% if(!routers.length){ %><tr><td colspan="<%= isAdmin?9:8 %>"><div class="empty-state"><i class="bi bi-router"></i><strong>Belum ada router</strong><small>Tambahkan router MikroTik untuk memulai integrasi NMS.</small></div></td></tr><% } %>
    </tbody></table></div>
  </div>
  <% if(isAdmin){ %><div class="customer-bulk-bar" id="routersBulkBar" hidden><span><b data-bulk-count>0</b> router terpilih</span><div class="customer-bulk-buttons"><button type="button" data-bulk-clear class="ghost"><i class="bi bi-x-lg"></i>Batal</button><button type="button" class="danger" data-simple-delete-bulk data-bulk-scope-id="routersBulkBar" data-bulk-url="/routers/bulk" data-bulk-action-field="action" data-bulk-action-value="delete" data-bulk-id-field="router_ids[]" data-entity-label-plural="router" data-simple-delete-title="Hapus router terpilih?" data-simple-delete-warning="Router yang masih digunakan pelanggan akan otomatis dilewati dan dilaporkan jumlahnya."><i class="bi bi-trash3-fill"></i>Hapus Massal</button></div></div><% } %>
</section>

<% if(isAdmin){ %>
<div class="modal fade" id="routerModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><form class="modal-content" method="post" action="/routers"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="modal-header"><h5 class="modal-title">Tambah Router MikroTik</h5><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="row g-3"><div class="col-12"><label class="form-label">Site</label><select class="form-select" name="site_id" required><% sites.forEach(s=>{ %><option value="<%= s.id %>"><%= s.code %> · <%= s.name %></option><% }) %></select></div><div class="col-12"><label class="form-label">Nama Router</label><input class="form-control" name="name" required placeholder="MikroTik KRW"></div><div class="col-12"><label class="form-label">REST Base URL</label><input class="form-control" name="base_url" required placeholder="https://192.168.77.1:8443/rest"></div><div class="col-6"><label class="form-label">Username</label><input class="form-control" name="username" required></div><div class="col-6"><label class="form-label">Password</label><input class="form-control" type="password" name="password" required autocomplete="new-password"></div><div class="col-12"><div class="form-check form-switch"><input class="form-check-input" type="checkbox" name="verify_tls" id="tls" checked><label class="form-check-label" for="tls">Verifikasi sertifikat TLS</label></div></div></div></div><div class="modal-footer"><button class="btn-tech primary"><i class="bi bi-check2-circle"></i>Simpan Router</button></div></form></div></div>

<div class="modal fade" id="routerEditModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><form class="modal-content" method="post" id="routerEditForm"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="modal-header"><div><div class="module-kicker">ROUTER CONFIGURATION</div><h5 class="modal-title">Edit Router MikroTik</h5></div><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="row g-3"><div class="col-12"><label class="form-label">Site</label><select class="form-select" name="site_id" id="routerEditSite" required><% sites.forEach(s=>{ %><option value="<%= s.id %>"><%= s.code %> · <%= s.name %></option><% }) %></select></div><div class="col-12"><label class="form-label">Nama Router</label><input class="form-control" name="name" id="routerEditName" required></div><div class="col-12"><label class="form-label">REST Base URL</label><input class="form-control" name="base_url" id="routerEditUrl" required></div><div class="col-6"><label class="form-label">Username</label><input class="form-control" name="username" id="routerEditUsername" required></div><div class="col-6"><label class="form-label">Password Baru</label><input class="form-control" type="password" name="password" autocomplete="new-password" placeholder="Kosong = tetap"></div><div class="col-12"><div class="form-check form-switch"><input class="form-check-input" type="checkbox" name="verify_tls" id="routerEditTls"><label class="form-check-label" for="routerEditTls">Verifikasi sertifikat TLS</label></div></div><div class="col-12"><div class="secure-file-note"><i class="bi bi-shield-lock"></i><span>Password lama tidak pernah ditampilkan. Kosongkan Password Baru bila credential tidak berubah.</span></div></div></div></div><div class="modal-footer"><button type="button" class="btn-tech" data-bs-dismiss="modal">Batal</button><button class="btn-tech primary"><i class="bi bi-check2-circle"></i>Simpan Perubahan</button></div></form></div></div>
<script>
(()=>{document.querySelectorAll('[data-router-edit]').forEach(button=>button.addEventListener('click',()=>{const form=document.getElementById('routerEditForm');form.action=`/routers/${button.dataset.id}/update`;document.getElementById('routerEditSite').value=button.dataset.site||'';document.getElementById('routerEditName').value=button.dataset.name||'';document.getElementById('routerEditUrl').value=button.dataset.url||'';document.getElementById('routerEditUsername').value=button.dataset.username||'';document.getElementById('routerEditTls').checked=button.dataset.tls==='1';form.elements.password.value='';}));})();
</script>
<% } %>
