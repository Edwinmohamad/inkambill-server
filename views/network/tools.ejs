<section class="infra-hub-page infra-v119">
  <div class="module-head infra-hub-head"><div><div class="module-kicker">INFRASTRUCTURE WORKSPACE</div><h1>Infrastructure Hub</h1><p>Proxmox, server, TR-069, MikroTik, dan container services dalam satu workspace tanpa membuka tab baru.</p></div><a class="btn-tech" href="/network/monitor"><i class="bi bi-activity"></i>MikroTik NMS</a></div>
  <div class="infra-hub-shell">
    <aside class="infra-catalog"><div class="infra-catalog-title"><i class="bi bi-grid-1x2-fill"></i><span><strong>Operations Portal</strong><small>Pilih tool untuk dibuka</small></span></div><% groups.forEach(group=>{ %><section><h3><i class="bi <%= group.icon %>"></i><%= group.name %></h3><% group.tools.forEach(tool=>{const enabled=!!(tool.url||tool.internal);%><a class="infra-tool-link <%= selected?.key===tool.key?'active':'' %> <%= enabled?'':'disabled' %>" href="<%= enabled?`/network/tools?group=${encodeURIComponent(group.key)}&tool=${encodeURIComponent(tool.key)}`:'#' %>" <%= enabled?'':'aria-disabled="true"' %>><span class="<%= tool.tone %>"><i class="bi <%= tool.icon %>"></i></span><div><strong><%= tool.name %></strong><small><%= enabled?tool.description:'URL belum dikonfigurasi' %></small></div><i class="bi bi-chevron-right"></i></a><% }) %></section><% }) %></aside>
    <main class="infra-workspace" id="infraWorkspace">
      <div class="infra-actionbar"><div class="infra-workspace-identity"><span class="infra-status-dot <%= workspaceUrl?'connected':'offline' %>" id="infraStatusDot"></span><div><small><%= selected?.groupName||'INFRASTRUCTURE' %></small><strong><%= selected?.name||'Pilih Tool' %></strong></div><span class="infra-connected-label" id="infraStatusLabel"><%= workspaceUrl?'Connected':'Not configured' %></span></div><div class="infra-action-buttons"><button type="button" id="infraReload" <%= workspaceUrl?'':'disabled' %> title="Reload workspace"><i class="bi bi-arrow-clockwise"></i><span>Reload</span></button><button type="button" id="infraFullscreen" <%= workspaceUrl?'':'disabled' %> title="Fullscreen"><i class="bi bi-arrows-fullscreen"></i><span>Fullscreen</span></button></div></div>
      <div class="infra-frame-wrap"><% if(workspaceUrl){ %><div class="infra-frame-loader" id="infraLoader"><span class="spinner-border"></span><strong>Connecting <%= selected.name %>…</strong><small>Workspace diamankan melalui INKAMNET reverse proxy.</small></div><iframe id="infraFrame" src="<%= workspaceUrl %>" title="<%= selected.name %> Workspace" allow="clipboard-read; clipboard-write; fullscreen" referrerpolicy="same-origin"></iframe><% }else{ %><div class="infra-frame-empty"><i class="bi bi-plug-fill"></i><strong><%= selected?.name||'Tool' %> belum dikonfigurasi</strong><small>Isi URL layanan pada environment server lalu restart aplikasi.</small></div><% } %></div>
    </main>
  </div>
  <div class="infra-security-note"><i class="bi bi-shield-lock-fill"></i><div><strong>Same-origin Workspace Wrapper</strong><small>Header anti-frame dari upstream dihapus hanya pada route proxy Infrastructure Hub. Target proxy tetap allowlist dari konfigurasi server, bukan URL bebas dari user.</small></div></div>
</section>
<script>
(()=>{const frame=document.getElementById('infraFrame'),loader=document.getElementById('infraLoader'),label=document.getElementById('infraStatusLabel'),dot=document.getElementById('infraStatusDot');if(frame){const ready=()=>{loader?.classList.add('is-hidden');label.textContent='Connected';dot?.classList.add('connected')};frame.addEventListener('load',ready);setTimeout(()=>loader?.classList.add('is-hidden'),12000);}document.getElementById('infraReload')?.addEventListener('click',()=>{if(!frame)return;loader?.classList.remove('is-hidden');label.textContent='Reconnecting';frame.src=frame.src;});document.getElementById('infraFullscreen')?.addEventListener('click',async()=>{const box=document.getElementById('infraWorkspace');if(!box)return;if(document.fullscreenElement)await document.exitFullscreen();else await box.requestFullscreen();});})();
</script>
