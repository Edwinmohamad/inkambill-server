    <div class="ni-card-body">
      <div class="ni-server-flow">
        <article class="ni-device"><header><i class="bi bi-router-fill"></i><div><b>KRW Core</b><small>ether4-LAN</small></div></header><ul><li><span>Gateway</span><code>192.168.77.1/24</code></li><li><span>Server route</span><code>192.168.100.0/24 → 192.168.77.2</code></li></ul></article>
        <div class="ni-arrow"><i class="bi bi-arrow-right"></i></div>
