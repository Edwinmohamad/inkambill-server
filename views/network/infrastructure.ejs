<link rel="stylesheet" href="/css/network-infrastructure.css">
<script id="infraInitial" type="application/json"><%- safeJson(initial) %></script>
<section class="noc-shell" data-wall="<%= wallMode?1:0 %>">
<header class="noc-head"><div><div class="noc-kicker">INKAMNET · NETWORK OPERATIONS CENTER</div><h1><%= wallMode?'NOC Wall':'Network Infrastructure' %></h1><p>Live topology, customer experience, infrastructure health, configuration, dan history.</p></div><div class="noc-actions"><span class="btn-tech"><i class="status-dot online"></i> <span data-updated>LIVE</span></span><% if(!wallMode){ %><a class="btn-tech primary" href="/network/infrastructure/wall" target="_blank"><i class="bi bi-display"></i>NOC Wall</a><% }else{ %><button class="btn-tech" data-fullscreen><i class="bi bi-arrows-fullscreen"></i>Fullscreen</button><% } %></div></header>
<nav class="infra-module-nav wall-hide" aria-label="Network Control Center">
  <a href="/network"><i class="bi bi-speedometer2"></i>Overview</a>
  <a href="/network/subscribers"><i class="bi bi-people-fill"></i>Subscribers</a>
  <a class="active" href="/network/infrastructure"><i class="bi bi-diagram-3-fill"></i>Infrastructure</a>
  <a href="/network/incidents"><i class="bi bi-exclamation-triangle-fill"></i>Incidents</a>
</nav>
<div class="noc-tabs wall-hide"><button class="noc-tab active" data-tab="live">LIVE</button><button class="noc-tab" data-tab="physical">PHYSICAL</button><button class="noc-tab" data-tab="logical">LOGICAL</button><button class="noc-tab" data-tab="experience">EXPERIENCE</button><button class="noc-tab" data-tab="config">CONFIG</button><button class="noc-tab" data-tab="history">HISTORY</button></div>
<section class="noc-panel active" data-panel="live">
<div class="noc-metrics"><article class="noc-metric"><small>NETWORK HEALTH</small><strong data-health><%= initial.health||0 %>%</strong><span>weighted live health</span></article><article class="noc-metric"><small>ROUTERS</small><strong data-metric="routers">-</strong><span>online / total</span></article><article class="noc-metric"><small>OLT</small><strong data-metric="olts">-</strong><span>reachable / registered</span></article><article class="noc-metric"><small>PPPoE ACTIVE</small><strong data-metric="ppp">-</strong><span>customer sessions</span></article><article class="noc-metric"><small>CUSTOMERS</small><strong data-metric="customers">-</strong><span>registered</span></article><article class="noc-metric"><small>TRAFFIC ↓ / ↑</small><strong><span data-metric="rx">-</span> / <span data-metric="tx">-</span></strong><span>aggregate WAN</span></article><article class="noc-metric"><small>CRITICAL</small><strong data-metric="alerts">-</strong><span>active incidents</span></article></div>
<div class="noc-grid"><div class="noc-card"><div class="noc-card-head"><div><h2>Live Network Topology</h2><small>Motion mengikuti state perangkat dan traffic.</small></div><div class="health-ring" style="--health:<%= initial.health||0 %>"><b data-health><%= initial.health||0 %>%</b></div></div><div class="topology">
<svg viewBox="0 0 1000 430" preserveAspectRatio="none">
 <path class="link-base" d="M170 180 L500 165"/><path class="link-flow" data-link="KBG-KRW" d="M170 180 L500 165"/>
 <path class="link-base" d="M500 165 L830 180"/><path class="link-flow" data-link="KRW-CLM" d="M500 165 L830 180"/>
 <path class="link-base" d="M500 185 L500 305"/><path class="link-flow" data-link="KRW-SERVER" d="M500 185 L500 305"/>
 </svg>
<% [['KBG','node-kbg'],['KRW','node-krw'],['CLM','node-clm']].forEach(n=>{ %><article class="topology-node <%= n[1] %>" data-node="<%= n[0] %>"><div class="node-top"><h4><%= n[0] %></h4><span><i class="status-dot"></i> <b data-node-status>...</b></span></div><p data-node-traffic>Loading telemetry</p><div class="node-meta"><span data-node-cpu>- CPU</span><span>POP</span></div></article><% }) %>
<article class="topology-node node-server" data-node="SERVER"><div class="node-top"><h4>SERVER-ADMIN</h4><span><i class="status-dot"></i> <b data-node-status>...</b></span></div><p data-node-traffic>192.168.100.1 · API 8728</p><div class="node-meta"><span data-node-cpu>ROS6</span><span>KRW Infrastructure</span></div></article>
</div></div><div class="noc-card"><div class="noc-card-head"><h3>Event Stream</h3><small>Live operational events</small></div><div class="noc-card-body event-list" data-events></div></div></div>
<div class="site-row" data-sites style="margin-top:9px"></div>
<div class="noc-grid" style="margin-top:9px">
  <div class="noc-card"><div class="noc-card-head"><div><h3>Live Interfaces</h3><small>Per-port router telemetry · RX/TX · link state · error/drop</small></div></div><div class="noc-card-body interface-board" data-interfaces></div></div>
  <div class="noc-card"><div class="noc-card-head"><div><h3>OLT Access Layer</h3><small>Reachability · ONU · PON · optical health</small></div></div><div class="noc-card-body olt-board" data-olts></div></div>
</div>
<div class="noc-card" style="margin-top:9px"><div class="noc-card-head"><h3>User Experience</h3><small>Google · YouTube · social · gaming · DNS</small></div><div class="noc-card-body probe-grid" data-probes></div></div>
</section>
<section class="noc-panel" data-panel="physical">
<div class="noc-card"><div class="noc-card-head"><div><h3>Router Interface Detail</h3><small>Semua interface live dari RouterOS, bukan hanya WAN.</small></div></div><div class="noc-card-body interface-detail-board" data-interface-detail></div></div>
<div class="noc-card" style="margin-top:9px"><div class="noc-card-head"><div><h3>OLT & PON Detail</h3><small>Management reachability, ONU health, PON utilization dan optical RX.</small></div></div><div class="noc-card-body olt-detail-board" data-olt-detail></div></div>
<div class="site-row" style="margin-top:9px"><% (initial.sites||[]).forEach(s=>{ %><article class="noc-card"><div class="noc-card-head"><h3><%= s.code %> Physical Map</h3><small><%= s.provider||'' %></small></div><div class="noc-card-body"><table class="mini-table"><thead><tr><th>PORT</th><th>ROLE</th><th>ADDRESS/L2</th><th>CONNECTED</th></tr></thead><tbody><% (s.ports||[]).forEach(p=>{ %><tr><td><%= p[0] %></td><td><%= p[1] %></td><td><%= p[2] %></td><td><%= p[3] %></td></tr><% }) %></tbody></table></div></article><% }) %></div>
</section>
<section class="noc-panel" data-panel="logical"><div class="site-row"><% (initial.sites||[]).forEach(s=>{ %><article class="noc-card"><div class="noc-card-head"><h3><%= s.code %> Logical</h3><small>VLAN · VPN · subnet</small></div><div class="noc-card-body"><table class="mini-table"><tbody><% (s.logical||[]).forEach(p=>{ %><tr><td><%= p[0] %></td><td><%= p[1] %></td><td><%= p[2] %></td></tr><% }) %></tbody></table></div></article><% }) %></div></section>
<section class="noc-panel" data-panel="experience"><div class="noc-card"><div class="noc-card-head"><div><h3>Internet Experience Matrix</h3><small>Probe dijalankan dari router customer setiap POP.</small></div><button class="btn-tech primary" data-run-probe><i class="bi bi-lightning-charge"></i>Run Probe</button></div><div class="noc-card-body probe-grid" data-probes></div></div></section>
<section class="noc-panel" data-panel="config"><div class="config-grid"><article class="noc-card"><div class="noc-card-head"><h3>SERVER-ADMIN Registration</h3><small>Infrastructure router · no PPPoE sync</small></div><div class="noc-card-body"><form data-register-server class="form-grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="full"><label class="form-label">Site / Role</label><input class="form-control" value="KRW · Infrastructure" disabled></div><div><label class="form-label">Host</label><input class="form-control" value="192.168.100.1" disabled></div><div><label class="form-label">Port</label><input class="form-control" value="8728" disabled></div><div><label class="form-label">Username</label><input class="form-control" value="inkambill-mon" disabled></div><div><label class="form-label">Password API</label><input class="form-control" type="password" name="password" required autocomplete="new-password"></div><div class="full"><button class="btn-tech primary"><i class="bi bi-router"></i>Register SERVER-ADMIN</button></div></form></div></article><article class="noc-card"><div class="noc-card-head"><h3>Safe Configuration Model</h3><small>Observed vs Desired state</small></div><div class="noc-card-body"><p class="text-muted small">Perubahan PPPoE, VLAN, route, VPN, dan interface menggunakan alur Preview → Apply → Verify → Audit. Secret/key tidak pernah ditampilkan plaintext.</p><a class="btn-tech" href="/nms"><i class="bi bi-people"></i>Kelola PPPoE</a> <a class="btn-tech" href="/routers"><i class="bi bi-router"></i>Router Registry</a></div></article></div></section>
<section class="noc-panel" data-panel="history"><div class="noc-card"><div class="noc-card-head"><h3>Operational History</h3><small>Events, alerts, recovery and change trail</small></div><div class="noc-card-body event-list" data-events></div></div></section>
</section><script src="/js/network-infrastructure.js"></script>