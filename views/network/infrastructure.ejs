<style>
.ink-infra{--ni-blue:#0a84ff;--ni-green:#30d158;--ni-orange:#ff9f0a;--ni-purple:#bf5af2;--ni-red:#ff453a;max-width:1680px;margin:0 auto;padding-bottom:44px}
.ink-infra *{box-sizing:border-box}.ni-head{display:flex;align-items:flex-end;justify-content:space-between;gap:18px;margin:2px 0 15px}.ni-kicker{font-size:.62rem;font-weight:800;letter-spacing:.12em;color:var(--muted)}.ni-head h1{margin:3px 0 4px;font-size:1.75rem;letter-spacing:-.035em}.ni-head p{margin:0;color:var(--muted);font-size:.78rem}.ni-head-meta{display:flex;gap:6px;flex-wrap:wrap;justify-content:flex-end}.ni-chip{display:inline-flex;align-items:center;gap:6px;padding:6px 9px;border:1px solid var(--line);border-radius:999px;background:var(--panel);font:600 .65rem var(--mono);white-space:nowrap}.ni-chip i{color:var(--ni-green)}
.ni-summary{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:8px;margin-bottom:10px}.ni-stat{padding:11px 12px;border:1px solid var(--line);border-radius:13px;background:var(--panel)}.ni-stat small,.ni-stat strong,.ni-stat span{display:block}.ni-stat small{font:.57rem var(--mono);letter-spacing:.08em;color:var(--muted)}.ni-stat strong{margin-top:5px;font-size:1.15rem}.ni-stat span{margin-top:2px;color:var(--muted);font-size:.62rem}
.ni-card{border:1px solid var(--line);border-radius:15px;background:var(--panel);overflow:hidden}.ni-card+.ni-card{margin-top:9px}.ni-card-head{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:11px 13px;border-bottom:1px solid var(--line)}.ni-card-head>div{min-width:0}.ni-card-head small{display:block;font:.57rem var(--mono);letter-spacing:.08em;color:var(--muted)}.ni-card-head h2,.ni-card-head h3{margin:2px 0 0;font-size:.9rem}.ni-card-body{padding:12px}
.ni-topology{position:relative;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;padding:12px;background:linear-gradient(180deg,color-mix(in srgb,var(--panel-2) 78%,transparent),var(--panel))}.ni-site-node{position:relative;min-width:0;padding:12px;border:1px solid var(--line);border-radius:14px;background:var(--panel);box-shadow:0 8px 24px rgba(0,0,0,.035)}.ni-site-node::before{content:"";position:absolute;left:14px;right:14px;top:-1px;height:2px;border-radius:99px;background:var(--node-accent,var(--ni-blue))}.ni-provider{display:flex;align-items:center;justify-content:space-between;gap:8px;padding-bottom:9px;margin-bottom:9px;border-bottom:1px solid var(--line)}.ni-provider>span{display:flex;align-items:center;gap:8px}.ni-provider i{width:28px;height:28px;display:grid;place-items:center;border-radius:9px;background:var(--panel-3);color:var(--node-accent)}.ni-provider b,.ni-provider small{display:block}.ni-provider b{font-size:.72rem}.ni-provider small{font:.56rem var(--mono);color:var(--muted)}.ni-provider em{font:.55rem var(--mono);font-style:normal;color:var(--muted)}.ni-router-box{display:grid;grid-template-columns:35px minmax(0,1fr);gap:9px;align-items:center}.ni-router-box>i{width:35px;height:35px;display:grid;place-items:center;border-radius:10px;background:color-mix(in srgb,var(--node-accent) 12%,var(--panel-2));color:var(--node-accent);font-size:1rem}.ni-router-box strong,.ni-router-box small{display:block}.ni-router-box strong{font-size:.76rem}.ni-router-box small{font-size:.6rem;color:var(--muted)}.ni-flow{display:flex;align-items:center;gap:5px;margin-top:10px;padding-top:9px;border-top:1px solid var(--line);color:var(--muted);font-size:.58rem}.ni-flow b{color:var(--text)}.ni-flow i{color:var(--node-accent)}
.ni-backbone{display:grid;grid-template-columns:1fr auto 1fr auto 1fr;align-items:center;gap:8px;padding:10px 12px;border-top:1px solid var(--line);background:var(--panel-2)}.ni-backbone .site{text-align:center;font:700 .62rem var(--mono)}.ni-link{height:2px;min-width:40px;background:linear-gradient(90deg,var(--ni-green),var(--ni-blue));position:relative}.ni-link::after{content:"";position:absolute;right:-1px;top:-3px;border-left:5px solid var(--ni-blue);border-top:4px solid transparent;border-bottom:4px solid transparent}.ni-backbone small{display:block;color:var(--muted);font-weight:500}
.ni-site-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px;margin-top:9px}.ni-site-detail{min-width:0}.ni-site-title{display:flex;align-items:center;gap:9px}.ni-site-title>span{width:34px;height:34px;display:grid;place-items:center;border-radius:10px;background:var(--panel-3);color:var(--accent-text)}.ni-site-title b,.ni-site-title small{display:block}.ni-site-title b{font-size:.82rem}.ni-site-title small{font-size:.58rem;color:var(--muted)}
.ni-section-label{margin:11px 0 5px;font:.58rem var(--mono);font-weight:800;letter-spacing:.08em;color:var(--muted)}.ni-table-wrap{overflow:auto;border:1px solid var(--line);border-radius:10px}.ni-table{width:100%;border-collapse:collapse;min-width:560px}.ni-table th{padding:7px 8px;background:var(--panel-2);color:var(--muted);font:.54rem var(--mono);letter-spacing:.06em;text-align:left}.ni-table td{padding:7px 8px;border-top:1px solid var(--line);font-size:.61rem;vertical-align:top}.ni-table td:first-child{font-family:var(--mono);font-weight:700;color:var(--accent-text)}.ni-table code{font-size:.58rem;color:inherit}.ni-table .muted{color:var(--muted)}.ni-mini-list{display:grid;gap:5px}.ni-mini{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:7px;padding:7px 8px;border:1px solid var(--line);border-radius:9px;background:var(--panel-2)}.ni-mini span,.ni-mini b{font-size:.59rem}.ni-mini span{color:var(--muted)}.ni-mini b{font-family:var(--mono);text-align:right;overflow-wrap:anywhere}
.ni-tunnel-table{min-width:900px}.ni-type{display:inline-flex;align-items:center;gap:5px}.ni-type::before{content:"";width:7px;height:7px;border-radius:50%;background:var(--ni-green)}
.ni-server-flow{display:grid;grid-template-columns:minmax(170px,.75fr) 34px minmax(190px,.9fr) 34px minmax(180px,.8fr) 34px minmax(0,1.65fr);align-items:stretch;gap:7px}.ni-device{padding:11px;border:1px solid var(--line);border-radius:12px;background:var(--panel-2)}.ni-device header{display:flex;align-items:center;gap:8px;margin-bottom:7px}.ni-device header i{width:30px;height:30px;display:grid;place-items:center;border-radius:9px;background:var(--panel-3);color:var(--accent-text)}.ni-device header b,.ni-device header small{display:block}.ni-device header b{font-size:.69rem}.ni-device header small{color:var(--muted);font-size:.55rem}.ni-device ul{list-style:none;padding:0;margin:0;display:grid;gap:4px}.ni-device li{display:flex;justify-content:space-between;gap:7px;font-size:.57rem}.ni-device li span{color:var(--muted)}.ni-device li code{color:var(--text);font-size:.56rem}.ni-arrow{display:grid;place-items:center;color:var(--muted)}.ni-server-services{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:5px}.ni-service{padding:7px 8px;border:1px solid var(--line);border-radius:9px;background:var(--panel)}.ni-service b,.ni-service small{display:block}.ni-service b{font-size:.59rem}.ni-service small{margin-top:2px;color:var(--muted);font:.53rem var(--mono)}
.ni-note-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:7px}.ni-note{padding:10px 11px;border:1px solid var(--line);border-radius:11px;background:var(--panel-2)}.ni-note i{color:var(--ni-orange)}.ni-note b{display:block;margin-top:5px;font-size:.65rem}.ni-note p{margin:3px 0 0;color:var(--muted);font-size:.59rem;line-height:1.45}
@media(max-width:1250px){.ni-site-grid{grid-template-columns:1fr}.ni-server-flow{grid-template-columns:1fr}.ni-arrow{transform:rotate(90deg);min-height:20px}.ni-summary{grid-template-columns:repeat(3,1fr)}}@media(max-width:800px){.ni-head{align-items:flex-start;flex-direction:column}.ni-head-meta{justify-content:flex-start}.ni-topology{grid-template-columns:1fr}.ni-backbone{grid-template-columns:1fr;gap:5px}.ni-link{height:26px;width:2px;justify-self:center}.ni-link::after{right:-3px;top:auto;bottom:-1px;border-left:4px solid transparent;border-right:4px solid transparent;border-top:5px solid var(--ni-blue);border-bottom:0}.ni-summary{grid-template-columns:1fr 1fr}.ni-note-grid{grid-template-columns:1fr}.ni-server-services{grid-template-columns:1fr}}@media(max-width:520px){.ni-summary{grid-template-columns:1fr}.ni-card-body{padding:9px}.ni-topology{padding:9px}.ni-table{min-width:620px}}
</style>

<section class="ink-infra">
  <header class="ni-head">
    <div><div class="ni-kicker">INKAMNET · NETWORK DOCUMENTATION</div><h1>Network Infrastructure</h1><p>Topologi fisik dan logis KRW, KBG, CLM, jalur management antar-site, serta server infrastructure di belakang core KRW.</p></div>
    <div class="ni-head-meta"><span class="ni-chip"><i class="bi bi-check-circle-fill"></i> RouterOS export 18 Oct 2026</span><span class="ni-chip">3 POP</span><span class="ni-chip">2 ISP</span></div>
  </header>

  <div class="ni-summary">
    <article class="ni-stat"><small>CORE SITE</small><strong>KRW</strong><span>Netland · 103.155.167.110/30</span></article>
    <article class="ni-stat"><small>DISTRIBUTION POP</small><strong>KBG</strong><span>Netland main + backup</span></article>
    <article class="ni-stat"><small>DISTRIBUTION POP</small><strong>CLM</strong><span>Moratel · 103.79.155.30/30</span></article>
    <article class="ni-stat"><small>MANAGEMENT BACKBONE</small><strong>10.66.66.0/24</strong><span>WireGuard antar-site</span></article>
    <article class="ni-stat"><small>SERVER LAN</small><strong>192.168.100.0/24</strong><span>via SERVER-ADMIN 192.168.77.2</span></article>
  </div>

  <section class="ni-card">
    <div class="ni-card-head"><div><small>PHYSICAL OVERVIEW</small><h2>Internet → POP → Access Network</h2></div><span class="ni-chip"><i class="bi bi-diagram-3"></i> Multi-site</span></div>
    <div class="ni-topology">
      <% sites.forEach(site=>{ %>
      <article class="ni-site-node" style="--node-accent:var(--ni-<%= site.accent %>)">
        <div class="ni-provider"><span><i class="bi bi-cloud-fill"></i><span><b><%= site.provider %></b><small><%= site.wan %></small></span></span><em>GW <%= site.gateway %></em></div>
        <div class="ni-router-box"><i class="bi bi-router-fill"></i><div><strong>SITE <%= site.code %> · <%= site.role %></strong><small><%= site.router %> · RouterOS <%= site.ros %></small></div></div>
        <div class="ni-flow"><b>Router</b><i class="bi bi-arrow-right"></i><b>OLT / Access</b><i class="bi bi-arrow-right"></i><b>ODP</b><i class="bi bi-arrow-right"></i><b>ONT</b><i class="bi bi-arrow-right"></i><b>Customer</b></div>
      </article>
      <% }) %>
    </div>
    <div class="ni-backbone">
      <div class="site">KBG<small>10.66.66.12</small></div><div class="ni-link"></div><div class="site">KRW · HUB<small>10.66.66.1/24 · WG-MGMT</small></div><div class="ni-link"></div><div class="site">CLM<small>10.66.66.11/24</small></div>
    </div>
  </section>

  <div class="ni-site-grid">
    <% sites.forEach(site=>{ %>
    <section class="ni-card ni-site-detail">
      <div class="ni-card-head"><div class="ni-site-title"><span><i class="bi bi-hdd-rack-fill"></i></span><div><b>SITE <%= site.code %></b><small><%= site.provider %> · <%= site.router %></small></div></div><span class="ni-chip"><%= site.wan %></span></div>
      <div class="ni-card-body">
        <div class="ni-section-label">PHYSICAL PORT MAPPING</div>
        <div class="ni-table-wrap"><table class="ni-table"><thead><tr><th>INTERFACE</th><th>ROLE</th><th>IP / L2</th><th>CONNECTED DEVICE / DETAIL</th></tr></thead><tbody>
          <% site.ports.forEach(p=>{ %><tr><td><%= p[0] %></td><td><%= p[1] %></td><td><%= p[2] %></td><td class="muted"><%= p[3] %></td></tr><% }) %>
        </tbody></table></div>
        <div class="ni-section-label">LOGICAL INTERFACES / VLAN</div>
        <div class="ni-mini-list"><% site.logical.forEach(row=>{ %><div class="ni-mini"><span><%= row[0] %><br><small><%= row[1] %></small></span><b><%= row[2] %></b></div><% }) %></div>
        <div class="ni-section-label">SERVICES / ROUTING</div>
        <div class="ni-mini-list"><% site.services.forEach(row=>{ %><div class="ni-mini"><span><%= row[0] %><br><small><%= row[2] %></small></span><b><%= row[1] %></b></div><% }) %></div>
      </div>
    </section>
    <% }) %>
  </div>

  <section class="ni-card">
    <div class="ni-card-head"><div><small>KRW ACCESS DETAIL</small><h2>OLT & Service Segmentation</h2></div><span class="ni-chip">bridge-OLT</span></div>
