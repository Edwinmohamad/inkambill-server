        <tr><td>OLT Untagged Management</td><td>10.20.30.1/24</td><td>bridge-OLT</td><td>Legacy / untagged OLT management segment</td></tr>
        <tr><td>PPPoE Transport</td><td>10.10.10.1/24</td><td>VLAN 100</td><td>PPPoE server over OLT trunk</td></tr>
        <tr><td>OLT Management</td><td>20.20.20.1/24</td><td>VLAN 200</td><td>Gateway OLT management</td></tr>
        <tr><td>TR-069 Active Interface</td><td>11.11.11.1/24</td><td>VLAN 1011</td><td>DHCP / CPE management transport</td></tr>
      </tbody></table></div>
    </div>
  </section>

  <section class="ni-card">
