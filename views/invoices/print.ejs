<!doctype html>
<html lang="<%= language %>">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title><%= invoice.invoice_number %> · <%= branding.companyName %></title>
<style>
:root{--ink:#0b1020;--purple:#603aea;--red:#ff433e;--green:#18a979;--line:#e4e7ec;--soft:#f8f9fc;--muted:#667085;--text:#101828}*{box-sizing:border-box}html,body{margin:0}body{font-family:Inter,Arial,sans-serif;color:var(--text);background:#eef1f6}.sheet{position:relative;width:210mm;height:297mm;margin:16px auto;background:#fff;box-shadow:0 18px 55px rgba(16,24,40,.14);overflow:hidden}.top{position:relative;height:35mm;padding:8mm 11mm;color:#fff;background:var(--ink);overflow:hidden}.top:after{content:"";position:absolute;left:0;right:0;bottom:0;height:1.2mm;background:linear-gradient(90deg,var(--purple) 0 74%,var(--red) 74%)}.top img{width:45mm;height:14mm;object-fit:contain;object-position:left center}.invoice-title{position:absolute;right:11mm;top:7mm;text-align:right}.invoice-title h1{margin:0;font-size:24px;letter-spacing:.05em}.invoice-title strong{display:block;margin-top:2mm;color:#b5a8ff;font-size:10px}.invoice-title small{display:block;max-width:90mm;margin-top:2mm;color:#c8ceda;font-size:8px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.body{height:262mm;padding:8mm 11mm 12mm;display:flex;flex-direction:column}.actions{display:flex;gap:7px;justify-content:flex-end;margin-bottom:4mm}.actions a,.actions button{border:0;border-radius:8px;padding:7px 11px;cursor:pointer;text-decoration:none;font:inherit;font-size:9px;font-weight:800}.actions button{background:var(--purple);color:#fff}.actions a{background:var(--soft);color:var(--text);border:1px solid var(--line)}.party-grid{display:grid;grid-template-columns:1.2fr .8fr;gap:8mm}.eyebrow{display:block;color:var(--purple);font-size:8px;font-weight:900;letter-spacing:.12em;margin-bottom:2mm}.billto h2{margin:0;max-width:105mm;font-size:17px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.billto p{height:18mm;margin:2mm 0 0;color:var(--muted);font-size:9px;line-height:1.55;overflow:hidden}.meta{border:1px solid var(--line);border-radius:10px;padding:3mm 4mm;background:var(--soft)}.meta div{display:flex;justify-content:space-between;gap:5mm;padding:1.7mm 0;border-bottom:1px solid var(--line);font-size:8px}.meta div:last-child{border-bottom:0}.meta span{color:var(--muted)}.meta strong{max-width:42mm;text-align:right;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.service{width:100%;border-collapse:separate;border-spacing:0;margin-top:6mm;border:1px solid var(--line);border-radius:10px;overflow:hidden}.service th{background:#121a2c;color:#fff;padding:3mm 4mm;font-size:8px;text-align:left}.service th:nth-child(2),.service td:nth-child(2){text-align:center}.service th:last-child,.service td:last-child{text-align:right}.service td{height:18mm;padding:3mm 4mm;font-size:9px}.service td strong,.service td small{display:block}.service td small{margin-top:1.5mm;color:var(--muted)}.lower{display:grid;grid-template-columns:1fr 76mm;gap:8mm;margin-top:6mm}.payment-box,.totals{border:1px solid var(--line);border-radius:10px;padding:4mm}.payment-box{height:36mm;background:var(--soft)}.payment-box h3{margin:0 0 2.5mm;font-size:9px}.payment-box strong{display:block;color:var(--purple);font-size:14px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.payment-box p{margin:1.3mm 0;color:var(--muted);font-size:8px}.totals{height:50mm}.totals div{display:flex;justify-content:space-between;padding:1.8mm .5mm;font-size:9px}.totals .line{border-top:1px solid var(--line);margin-top:1mm;padding-top:2.6mm}.totals .due{border-top:1px solid var(--line);margin-top:1mm;padding-top:3mm;font-weight:900;font-size:12px}.totals .due b{color:<%= Number(invoice.outstanding)>0?'#ff433e':'#18a979' %>}.status{display:inline-flex;margin-top:3mm;padding:2mm 4mm;border-radius:999px;font-size:8px;font-weight:900;background:<%= invoice.status==='paid'?'#eafbf5':invoice.status==='overdue'?'#fff0ef':'#f1edff' %>;color:<%= invoice.status==='paid'?'#18a979':invoice.status==='overdue'?'#ff433e':'#603aea' %>}.history{height:33mm;margin-top:5mm;padding-top:4mm;border-top:1px solid var(--line);overflow:hidden}.history h3{margin:0 0 2mm;font-size:9px}.history-row{display:grid;grid-template-columns:30mm 1fr 35mm;gap:3mm;padding:1.8mm 0;border-bottom:1px solid var(--line);font-size:8px}.history-row span{color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.history-more{margin-top:1.5mm;color:var(--muted);font-size:7px;font-style:italic}.foot{position:absolute;left:11mm;right:11mm;bottom:8mm;padding-top:4mm;border-top:1px solid var(--line);display:flex;justify-content:space-between;gap:8mm;color:var(--muted);font-size:7.5px;line-height:1.45}.foot>div{max-width:52%}.foot strong{display:block;color:var(--text);margin-bottom:1mm}.page-no{position:absolute;right:11mm;bottom:3mm;color:var(--muted);font-size:7px}@page{size:A4;margin:0}@media(max-width:800px){.sheet{width:100%;margin:0;box-shadow:none}.actions{justify-content:flex-start}}@media print{html,body{width:210mm;height:297mm;background:#fff!important;overflow:hidden}.sheet{width:210mm;height:297mm;margin:0;box-shadow:none;overflow:hidden}.actions{display:none!important}.top,.service th{print-color-adjust:exact;-webkit-print-color-adjust:exact}.body{padding-top:7mm}}
</style>
</head>
<body><main class="sheet"><header class="top"><img src="<%= branding.logoPath?'/invoices/branding/logo/'+encodeURIComponent(branding.logoPath):'/img/inkamnet-wordmark-hq.png' %>" alt="<%= branding.companyName %>"><div class="invoice-title"><h1><%= language==='en'?'INVOICE':'FAKTUR' %></h1><strong><%= invoice.invoice_number %></strong><small><%= branding.companyName %></small></div></header><section class="body"><div class="actions"><a href="/invoices/<%= invoice.id %>/pdf?download=1">Unduh PDF</a><button onclick="window.print()">Cetak / Simpan PDF</button></div><div class="party-grid"><div class="billto"><span class="eyebrow">DITAGIHKAN KEPADA</span><h2><%= invoice.customer_name %></h2><p><%= invoice.customer_code %><br><%= invoice.address||'-' %><br><%= invoice.phone||'-' %></p></div><div class="meta"><div><span>Tanggal Faktur</span><strong><%= formatDate(invoice.invoice_date) %></strong></div><div><span>Jatuh Tempo</span><strong><%= formatDate(invoice.due_date) %></strong></div><div><span>Periode</span><strong><%= String(invoice.period_month).padStart(2,'0') %>/<%= invoice.period_year %></strong></div><div><span>Site / Cluster</span><strong><%= invoice.site_code %> / <%= invoice.cluster_name||'-' %></strong></div></div></div><table class="service"><thead><tr><th>DESKRIPSI LAYANAN</th><th>QTY</th><th>NOMINAL</th></tr></thead><tbody><tr><td><strong><%= invoice.package_name %><%= invoice.is_prorata?' · Prorata':'' %></strong><small>Layanan Internet · <%= invoice.site_code %> · Cluster <%= invoice.cluster_name||'-' %></small></td><td>1</td><td><%= formatRupiah(invoice.subtotal) %></td></tr></tbody></table><div class="lower"><div><div class="payment-box"><h3>INFORMASI PEMBAYARAN</h3><% if(bank){ %><strong><%= bank.bank_name %> · <%= bank.account_number %></strong><p>a.n. <%= bank.account_name %></p><p>Cantumkan nomor faktur sebagai referensi.</p><% }else{ %><p>Hubungi admin <%= branding.companyName %> untuk rekening pembayaran.</p><% } %></div><span class="status">STATUS · <%= statusLabel(invoice.status).toUpperCase() %></span></div><div class="totals"><div><span>Subtotal</span><b><%= formatRupiah(invoice.subtotal) %></b></div><div><span>Diskon</span><b>- <%= formatRupiah(invoice.discount) %></b></div><div class="line"><span>Total Faktur</span><b><%= formatRupiah(invoice.total) %></b></div><div><span>Terbayar</span><b><%= formatRupiah(invoice.paid_amount) %></b></div><div class="due"><span>SISA TAGIHAN</span><b><%= formatRupiah(invoice.outstanding) %></b></div></div></div><% if(payments.length){ const compactPayments=payments.slice(0,3); %><div class="history"><h3>RIWAYAT PEMBAYARAN</h3><% compactPayments.forEach(p=>{ %><div class="history-row"><strong><%= formatRupiah(p.amount) %></strong><span><%= statusLabel(p.method) %> · <%= statusLabel(p.status) %><%= p.reference?' · '+p.reference:'' %></span><span><%= new Date(p.paid_at).toLocaleString(language==='en'?'en-GB':'id-ID',{timeZone:'Asia/Jakarta'}) %></span></div><% }) %><% if(payments.length>compactPayments.length){ %><div class="history-more">+ <%= payments.length-compactPayments.length %> transaksi lain tersimpan di sistem.</div><% } %></div><% } %><footer class="foot"><div><strong><%= branding.companyName %></strong><%= branding.address||'' %><% if(branding.phone){ %><br>Tel. <%= branding.phone %><% } %><% if(branding.email){ %> · <%= branding.email %><% } %><% if(branding.website){ %><br><%= branding.website %><% } %><% if(branding.taxId){ %><br>NPWP/ID Pajak: <%= branding.taxId %><% } %></div><div style="text-align:right"><strong><%= branding.tagline %></strong><%= branding.footer %></div></footer><span class="page-no"><%= language==='en'?'Page':'Halaman' %> 1 / 1</span></section></main></body></html>
