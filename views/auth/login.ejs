<!doctype html>
<html lang="id" data-theme="dark">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="theme-color" content="#0c1220">
  <title>Login · INKAMNET GO</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet"><link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <style>
  :root{--bg:#0c1220;--panel:#151d2e;--line:#2b3953;--text:#f0f3fa;--muted:#8e9ab2;--purple:#765fd7;--cyan:#43d8ed}
  *{box-sizing:border-box}html,body{margin:0;min-height:100%;font-family:Inter,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;font-weight:400}
  body{min-height:100vh;min-height:100dvh;display:grid;place-items:center;padding:clamp(20px,4vw,48px);color:var(--text);background:radial-gradient(circle at 85% 4%,rgba(93,70,210,.24),transparent 31%),radial-gradient(circle at 5% 100%,rgba(30,100,190,.18),transparent 30%),var(--bg);overflow-x:hidden}
  body:before,body:after{content:"";position:fixed;pointer-events:none;border:1px solid rgba(118,95,215,.12);border-radius:50%}body:before{width:420px;height:420px;left:-280px;bottom:-250px}body:after{width:300px;height:300px;right:-220px;top:-190px}
  .login-shell{width:100%;max-width:430px;position:relative;z-index:1}.brand{display:flex;flex-direction:column;align-items:center;margin-bottom:22px;text-align:center}.brand-line{display:flex;align-items:center;justify-content:center;gap:8px}.brand-mark{width:66px;height:66px;object-fit:contain}.brand-name{font-size:1.38rem;font-weight:600;letter-spacing:.025em}.brand-name span{background:linear-gradient(100deg,#a78bfa,var(--cyan));-webkit-background-clip:text;background-clip:text;color:transparent}.brand>p{margin:6px 0 0;color:var(--muted);font-size:.75rem}
  .login-card{padding:27px 26px 24px;border:1px solid rgba(142,154,178,.18);border-radius:18px;background:linear-gradient(155deg,rgba(25,35,56,.97),rgba(17,25,41,.97));box-shadow:0 24px 70px rgba(0,0,0,.28)}h1{margin:0;font-size:1.16rem;font-weight:600}.subtitle{margin:7px 0 22px;color:var(--muted);font-size:.77rem;line-height:1.55}
  .error{display:flex;gap:9px;margin-bottom:16px;padding:10px 12px;border:1px solid rgba(255,113,131,.25);border-radius:10px;background:rgba(255,113,131,.08);color:#ff9baa;font-size:.72rem;line-height:1.45}.field{display:block;margin-bottom:14px}.field>span:first-child{display:block;margin-bottom:6px;color:#aeb8ca;font-size:.65rem;font-weight:500}.input-wrap{height:49px;display:flex!important;align-items:center;border:1px solid var(--line);border-radius:11px;background:rgba(9,15,27,.42);transition:.18s}.input-wrap:focus-within{border-color:rgba(139,108,246,.85);box-shadow:0 0 0 3px rgba(118,95,215,.13)}.input-wrap>i{width:44px;text-align:center;color:#75839e}.input-wrap input{min-width:0;flex:1;height:100%;padding:0 12px 0 0;border:0;outline:0;background:transparent;color:var(--text);font:inherit;font-size:.8rem}.input-wrap input::placeholder{color:#65728a}.password-toggle{width:44px;height:100%;border:0;background:transparent;color:#75839e;cursor:pointer}.password-toggle:hover{color:#b6c1d5}
  .login-button{width:100%;height:49px;margin-top:7px;border:0;border-radius:11px;background:linear-gradient(100deg,#684ce0,#8066ee);color:#fff;font:inherit;font-size:.82rem;font-weight:600;cursor:pointer;transition:.18s}.login-button:hover{filter:brightness(1.07);transform:translateY(-1px)}.login-button:disabled{opacity:.72;cursor:wait;transform:none}.card-foot{display:flex;align-items:center;justify-content:center;gap:7px;margin-top:17px;color:var(--muted);font-size:.64rem}.online-dot{width:7px;height:7px;border-radius:50%;background:#2dd4a0;box-shadow:0 0 0 4px rgba(45,212,160,.09)}.legal{text-align:center;margin-top:16px;color:#66738b;font-size:.6rem;line-height:1.7}.legal strong{color:#8794aa;font-weight:500}.loader-line{height:2px;width:0;position:fixed;left:0;top:0;background:linear-gradient(90deg,var(--purple),var(--cyan));z-index:10;transition:.3s}
  @media(max-width:480px){body{place-items:start center;padding:calc(28px + env(safe-area-inset-top)) 16px calc(24px + env(safe-area-inset-bottom))}.login-shell{margin:auto}.login-card{padding:23px 20px}.brand-mark{width:58px;height:58px}.brand-name{font-size:1.2rem}}@media(prefers-reduced-motion:reduce){*{transition:none!important}}
  </style>
</head>
<body><div class="loader-line" id="loginLoader"></div><main class="login-shell">
  <header class="brand"><div class="brand-line"><img class="brand-mark" src="/img/inkamnet-go-tower.svg?v=1" alt=""><div class="brand-name">INKAMNET <span>GO</span></div></div><p>Network workspace untuk operasional INKAMNET</p></header>
  <section class="login-card"><h1>Welcome back</h1><p class="subtitle">Masuk untuk melanjutkan ke INKAMNET GO.</p>
    <% if(typeof error !== 'undefined'){ %><div class="error" role="alert"><i class="bi bi-exclamation-circle"></i><span><%= error %></span></div><% } %>
    <form method="post" action="/login" id="loginForm"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label class="field"><span>Username</span><span class="input-wrap"><i class="bi bi-person"></i><input name="username" placeholder="Masukkan username" autocomplete="username" required autofocus></span></label>
      <label class="field"><span>Password</span><span class="input-wrap"><i class="bi bi-shield-lock"></i><input id="loginPassword" type="password" name="password" placeholder="Masukkan password" autocomplete="current-password" required><button class="password-toggle" id="passwordToggle" type="button" aria-label="Tampilkan password"><i class="bi bi-eye"></i></button></span></label>
      <button class="login-button" id="loginButton" type="submit"><span>Masuk</span> <i class="bi bi-arrow-right"></i></button>
    </form><div class="card-foot"><span class="online-dot"></span><span>Sistem online · akses internal aman</span></div>
  </section><footer class="legal"><strong>PT INKAMNET NEXERA TECHNOLOGY</strong><br>From the Village, Online Everywhere · v1.2.0</footer>
</main><script>
const password=document.getElementById('loginPassword'),toggle=document.getElementById('passwordToggle');toggle?.addEventListener('click',()=>{const visible=password.type==='text';password.type=visible?'password':'text';toggle.innerHTML=`<i class="bi ${visible?'bi-eye':'bi-eye-slash'}"></i>`;toggle.setAttribute('aria-label',visible?'Tampilkan password':'Sembunyikan password')});document.getElementById('loginForm')?.addEventListener('submit',()=>{const line=document.getElementById('loginLoader'),button=document.getElementById('loginButton');line.style.width='78%';button.disabled=true;button.querySelector('span').textContent='Memproses...';setTimeout(()=>line.style.width='100%',430)});
</script></body></html>
