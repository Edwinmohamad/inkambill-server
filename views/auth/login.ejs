<!doctype html>
<html lang="id" data-theme="dark">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="theme-color" content="#0c1220">
  <title>Login · INKAMNET GO</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet"><link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <style>
  :root{--bg:#0c1220;--panel:#151d2e;--line:#2b3953;--text:#f0f3fa;--muted:#8e9ab2;--purple:#765fd7;--cyan:#43d8ed}
  *{box-sizing:border-box}html,body{margin:0;min-height:100%;font-family:Inter,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;font-weight:400}
  body{min-height:100vh;min-height:100dvh;display:grid;place-items:center;padding:14px 0;color:var(--text);background:radial-gradient(circle at 85% 4%,rgba(93,70,210,.3),transparent 31%),var(--bg);overflow:hidden}
  body:before,body:after{content:"";position:fixed;pointer-events:none;border:1px solid rgba(118,95,215,.12);border-radius:50%}body:before{width:420px;height:420px;left:-280px;bottom:-250px}body:after{width:300px;height:300px;right:-220px;top:-190px}
  .login-shell{width:80vw;max-width:620px;min-height:calc(100dvh - 28px);display:flex;flex-direction:column;position:relative;z-index:1}.brand{display:flex;flex-direction:column;align-items:center;margin:auto 0 42px;text-align:center}.brand-line{display:flex;align-items:center;justify-content:center;gap:12px}.brand-mark{width:102px;height:102px;object-fit:contain}.brand-name{font-size:2rem;font-weight:600;letter-spacing:.025em}.brand-name span{background:linear-gradient(100deg,#a78bfa,var(--cyan));-webkit-background-clip:text;background-clip:text;color:transparent}.brand>p{display:none}
  .login-card{padding:0;border:0;background:transparent;box-shadow:none}h1{margin:0;font-size:1.78rem;font-weight:600}.subtitle{margin:10px 0 30px;color:var(--muted);font-size:1rem;line-height:1.55}
  .error{display:flex;gap:9px;margin-bottom:16px;padding:11px 13px;border:1px solid rgba(255,113,131,.25);border-radius:10px;background:rgba(255,113,131,.08);color:#ff9baa;font-size:.8rem;line-height:1.45}.field{display:block;margin-bottom:17px}.field>span:first-child{display:block;margin-bottom:7px;color:#aeb8ca;font-size:.74rem;font-weight:500}.input-wrap{height:57px;display:flex!important;align-items:center;border:1px solid var(--line);border-radius:12px;background:rgba(9,15,27,.42);transition:.18s}.input-wrap:focus-within{border-color:rgba(139,108,246,.85);box-shadow:0 0 0 3px rgba(118,95,215,.13)}.input-wrap>i{width:50px;text-align:center;color:#75839e;font-size:1rem}.input-wrap input{min-width:0;flex:1;height:100%;padding:0 12px 0 0;border:0;outline:0;background:transparent;color:var(--text);font:inherit;font-size:.9rem}.input-wrap input::placeholder{color:#65728a}.password-toggle{width:50px;height:100%;border:0;background:transparent;color:#75839e;cursor:pointer}.password-toggle:hover{color:#b6c1d5}.remember{display:flex;align-items:center;gap:9px;margin:0 0 20px;color:#bdc6d7;font-size:.8rem;cursor:pointer}.remember input{width:17px;height:17px;margin:0;accent-color:#765fd7}
  .login-button{width:100%;height:63px;margin-top:1px;border:0;border-radius:12px;background:linear-gradient(100deg,#684ce0,#8066ee);color:#fff;font:inherit;font-size:1rem;font-weight:600;cursor:pointer;transition:.18s}.login-button:hover{filter:brightness(1.07);transform:translateY(-1px)}.login-button:disabled{opacity:.72;cursor:wait;transform:none}.card-foot{display:flex;align-items:center;justify-content:center;gap:9px;margin-top:30px;color:var(--muted);font-size:.82rem}.online-dot{width:9px;height:9px;border-radius:50%;background:#2dd4a0;box-shadow:0 0 0 5px rgba(45,212,160,.09)}.legal{text-align:center;margin-top:auto;padding-top:24px;color:#71809a;font-size:.75rem;line-height:1.7}.loader-line{height:2px;width:0;position:fixed;left:0;top:0;background:linear-gradient(90deg,var(--purple),var(--cyan));z-index:10;transition:.3s}
  .signal-decor{position:fixed;left:-125px;bottom:-125px;width:320px;height:320px;pointer-events:none;opacity:.24}.signal-decor span{position:absolute;left:0;bottom:0;border:18px solid #5943d0;border-left-color:transparent;border-bottom-color:transparent;border-radius:50%;transform:rotate(-45deg)}.signal-decor span:nth-child(1){width:170px;height:170px}.signal-decor span:nth-child(2){width:245px;height:245px}.signal-decor span:nth-child(3){width:320px;height:320px}
  @media(max-width:480px){.login-shell{width:84vw}.brand{margin-bottom:29px}.brand-mark{width:82px;height:82px}.brand-name{font-size:1.65rem}h1{font-size:1.5rem}.subtitle{font-size:.87rem;margin-bottom:24px}.input-wrap,.login-button{height:56px}.field{margin-bottom:14px}.remember{margin-bottom:17px}.card-foot{margin-top:22px}.legal{font-size:.68rem}}
  @media(max-height:760px){.brand{margin-bottom:18px}.brand-mark{width:70px;height:70px}.brand-name{font-size:1.45rem}.subtitle{margin-bottom:18px}.input-wrap,.login-button{height:51px}.field{margin-bottom:11px}.remember{margin-bottom:13px}.card-foot{margin-top:16px}.legal{padding-top:12px}}
  @media(prefers-reduced-motion:reduce){*{transition:none!important}}
  </style>
</head>
<body><div class="loader-line" id="loginLoader"></div><div class="signal-decor" aria-hidden="true"><span></span><span></span><span></span></div><main class="login-shell">
  <header class="brand"><div class="brand-line"><img class="brand-mark" src="/img/inkamnet-go-tower.svg?v=1" alt=""><div class="brand-name">INKAMNET <span>GO</span></div></div><p>Network workspace untuk operasional INKAMNET</p></header>
  <section class="login-card"><h1>Welcome back</h1><p class="subtitle">Masuk untuk melanjutkan ke INKAMNET GO.</p>
    <% if(typeof error !== 'undefined'){ %><div class="error" role="alert"><i class="bi bi-exclamation-circle"></i><span><%= error %></span></div><% } %>
    <form method="post" action="/login" id="loginForm"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label class="field"><span>Username</span><span class="input-wrap"><i class="bi bi-person"></i><input name="username" placeholder="Masukkan username" autocomplete="username" required autofocus></span></label>
      <label class="field"><span>Password</span><span class="input-wrap"><i class="bi bi-shield-lock"></i><input id="loginPassword" type="password" name="password" placeholder="Masukkan password" autocomplete="current-password" required><button class="password-toggle" id="passwordToggle" type="button" aria-label="Tampilkan password"><i class="bi bi-eye"></i></button></span></label>
      <label class="remember"><input id="rememberDevice" type="checkbox"><span>Ingat perangkat ini</span></label>
      <button class="login-button" id="loginButton" type="submit"><span>Masuk</span> <i class="bi bi-arrow-right"></i></button>
    </form><div class="card-foot"><span class="online-dot"></span><span>Sistem online</span></div>
  </section><footer class="legal">v1.2.1</footer>
</main><script>
const password=document.getElementById('loginPassword'),toggle=document.getElementById('passwordToggle'),username=document.querySelector('input[name="username"]'),remember=document.getElementById('rememberDevice');try{const saved=localStorage.getItem('inkamnet_go_username');if(saved){username.value=saved;remember.checked=true;password.focus()}}catch{}toggle?.addEventListener('click',()=>{const visible=password.type==='text';password.type=visible?'password':'text';toggle.innerHTML=`<i class="bi ${visible?'bi-eye':'bi-eye-slash'}"></i>`;toggle.setAttribute('aria-label',visible?'Tampilkan password':'Sembunyikan password')});document.getElementById('loginForm')?.addEventListener('submit',()=>{try{if(remember.checked)localStorage.setItem('inkamnet_go_username',username.value.trim());else localStorage.removeItem('inkamnet_go_username')}catch{}const line=document.getElementById('loginLoader'),button=document.getElementById('loginButton');line.style.width='78%';button.disabled=true;button.querySelector('span').textContent='Memproses...';setTimeout(()=>line.style.width='100%',430)});
</script></body></html>
