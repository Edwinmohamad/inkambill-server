<!doctype html>
<html lang="id" data-theme="dark">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="theme-color" content="#0a0f1e">
  <title>Login · INKAMNET GO</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"><link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <style>
  :root{--bg:#0a0f1e;--bg2:#0d1427;--panel:rgba(21,29,49,.55);--line:rgba(148,163,196,.16);--text:#f2f5fb;--muted:#8d99b3;--purple:#7a5ff0;--cyan:#39d0f0}
  *{box-sizing:border-box}html,body{margin:0;min-height:100%;font-family:Inter,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;font-weight:400}
  body{min-height:100vh;min-height:100dvh;color:var(--text);background:
      radial-gradient(circle at 88% 6%,rgba(58,110,220,.35),transparent 34%),
      radial-gradient(circle at 8% 92%,rgba(122,95,240,.22),transparent 38%),
      linear-gradient(160deg,var(--bg) 0%,var(--bg2) 55%,#0b1122 100%);
    overflow-x:hidden;position:relative}
  .grid-mesh{position:fixed;inset:0;pointer-events:none;z-index:0;opacity:.35;
    background-image:linear-gradient(rgba(122,144,190,.08) 1px,transparent 1px),linear-gradient(90deg,rgba(122,144,190,.08) 1px,transparent 1px);
    background-size:46px 46px;mask-image:radial-gradient(ellipse 80% 60% at 50% 30%,#000 40%,transparent 85%)}
  .ambient-glow{position:fixed;pointer-events:none;border-radius:50%;filter:blur(70px);z-index:0}
  .ambient-glow.a{width:380px;height:380px;left:-140px;bottom:-120px;background:radial-gradient(circle,rgba(122,95,240,.38),transparent 70%);animation:glowFloat 13s ease-in-out infinite}
  .ambient-glow.b{width:300px;height:300px;right:-100px;top:-90px;background:radial-gradient(circle,rgba(57,208,240,.26),transparent 70%);animation:glowFloat 11s ease-in-out infinite reverse}
  @keyframes glowFloat{0%,100%{transform:translate(0,0) scale(1);opacity:.65}50%{transform:translate(20px,-16px) scale(1.1);opacity:1}}
  @keyframes fadeSlideUp{from{opacity:0;transform:translateY(18px)}to{opacity:1;transform:translateY(0)}}
  @keyframes fadeSlideRight{from{opacity:0;transform:translateX(-18px)}to{opacity:1;transform:translateX(0)}}
  @keyframes heroFloat{0%,100%{transform:translateY(0)}50%{transform:translateY(-10px)}}
  @keyframes dotPing{0%,100%{box-shadow:0 0 0 5px rgba(45,212,160,.09)}50%{box-shadow:0 0 0 8px rgba(45,212,160,.16)}}
  @keyframes chipPulse{0%,100%{opacity:.75}50%{opacity:1}}
  @keyframes scanline{0%{transform:translateY(-100%)}100%{transform:translateY(100%)}}

  .login-page{min-height:100vh;min-height:100dvh;display:grid;grid-template-columns:1.05fr 1fr;position:relative;z-index:1}
  .login-hero{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:56px 48px;position:relative;overflow:hidden}
  .login-hero-inner{max-width:520px;width:100%;text-align:center;animation:fadeSlideRight .7s cubic-bezier(.2,.7,.3,1) both}
  .login-hero-frame{position:relative;border-radius:22px;overflow:hidden;box-shadow:0 30px 70px -20px rgba(0,0,0,.65),0 0 0 1px rgba(148,163,196,.1);animation:heroFloat 6s ease-in-out infinite}
  .login-hero-frame img{display:block;width:100%;height:auto;-webkit-mask-image:radial-gradient(ellipse 92% 88% at 50% 48%,#000 62%,transparent 100%);mask-image:radial-gradient(ellipse 92% 88% at 50% 48%,#000 62%,transparent 100%)}
  .login-hero-frame:before{content:"";position:absolute;inset:0;background:linear-gradient(115deg,transparent 0%,rgba(255,255,255,.08) 45%,transparent 60%);transform:translateX(-120%);animation:heroSheen 5.5s ease-in-out infinite}
  @keyframes heroSheen{0%{transform:translateX(-120%)}55%,100%{transform:translateX(120%)}}
  .login-hero-tag{margin:26px 0 0;color:var(--muted);font-size:.95rem;line-height:1.6;max-width:420px;margin-inline:auto}
  .login-hero-chips{display:flex;flex-wrap:wrap;gap:10px;justify-content:center;margin-top:28px}
  .login-hero-chips span{display:flex;align-items:center;gap:7px;padding:8px 14px;border:1px solid var(--line);border-radius:999px;background:rgba(255,255,255,.03);color:#c3cbdd;font-size:.76rem;font-weight:500;animation:chipPulse 3.6s ease-in-out infinite}
  .login-hero-chips span:nth-child(2){animation-delay:.5s}.login-hero-chips span:nth-child(3){animation-delay:1s}
  .login-hero-chips i{color:var(--cyan);font-size:.85rem}
  .login-hero-status{display:inline-flex;align-items:center;gap:8px;margin-top:34px;color:#8fa3c2;font-size:.78rem}
  .login-hero-status .online-dot{width:8px;height:8px;border-radius:50%;background:#2dd4a0;box-shadow:0 0 0 5px rgba(45,212,160,.09);animation:dotPing 2.4s ease-in-out infinite}

  .login-formside{display:flex;align-items:center;justify-content:center;padding:32px 28px;position:relative}
  .login-card{width:100%;max-width:400px;padding:38px 36px 32px;border-radius:22px;border:1px solid var(--line);background:var(--panel);backdrop-filter:blur(22px) saturate(140%);-webkit-backdrop-filter:blur(22px) saturate(140%);box-shadow:0 30px 60px -25px rgba(0,0,0,.55);animation:fadeSlideUp .7s cubic-bezier(.2,.7,.3,1) .1s both;position:relative;overflow:hidden}
  .login-card:before{content:"";position:absolute;left:0;right:0;top:0;height:1px;background:linear-gradient(90deg,transparent,rgba(122,95,240,.7),rgba(57,208,240,.7),transparent)}
  .login-card h1{margin:0;font-family:'Poppins',sans-serif;font-size:1.5rem;font-weight:700;letter-spacing:-.01em}
  .login-card .subtitle{margin:9px 0 26px;color:var(--muted);font-size:.88rem;line-height:1.55}
  .error{display:flex;gap:9px;margin-bottom:16px;padding:11px 13px;border:1px solid rgba(255,113,131,.25);border-radius:10px;background:rgba(255,113,131,.08);color:#ff9baa;font-size:.8rem;line-height:1.45}
  .field{display:block;margin-bottom:16px}.field>span:first-child{display:block;margin-bottom:7px;color:#aeb8ca;font-size:.73rem;font-weight:500;letter-spacing:.01em}
  .input-wrap{height:53px;display:flex!important;align-items:center;border:1px solid var(--line);border-radius:12px;background:rgba(6,10,20,.4);transition:.18s}
  .input-wrap:focus-within{border-color:rgba(139,108,246,.85);box-shadow:0 0 0 3px rgba(118,95,215,.16)}
  .input-wrap>i{width:46px;text-align:center;color:#75839e;font-size:.98rem}
  .input-wrap input{min-width:0;flex:1;height:100%;padding:0 12px 0 0;border:0;outline:0;background:transparent;color:var(--text);font:inherit;font-size:.88rem}
  .input-wrap input::placeholder{color:#5c6a85}
  .password-toggle{width:46px;height:100%;border:0;background:transparent;color:#75839e;cursor:pointer}.password-toggle:hover{color:#b6c1d5}
  .remember{display:flex;align-items:center;gap:9px;margin:2px 0 20px;color:#bdc6d7;font-size:.79rem;cursor:pointer}.remember input{width:16px;height:16px;margin:0;accent-color:#7a5ff0}
  .login-button{width:100%;height:54px;border:0;border-radius:12px;background:linear-gradient(100deg,#684ce0,#39b8e0);background-size:200% auto;color:#fff;font-family:'Poppins',sans-serif;font-size:.96rem;font-weight:700;cursor:pointer;transition:.18s,background-position .5s;display:flex;align-items:center;justify-content:center;gap:8px}
  .login-button:hover{filter:brightness(1.08);transform:translateY(-1px);background-position:right center}
  .login-button:disabled{opacity:.72;cursor:wait;transform:none}
  .card-foot{display:flex;align-items:center;justify-content:center;gap:8px;margin-top:24px;color:var(--muted);font-size:.78rem}
  .legal{text-align:center;padding:18px 0 26px;color:#66748f;font-size:.72rem;position:relative;z-index:1}
  .loader-line{height:2px;width:0;position:fixed;left:0;top:0;background:linear-gradient(90deg,var(--purple),var(--cyan));z-index:10;transition:.3s}

  @media(max-width:980px){
    .login-page{grid-template-columns:1fr;grid-template-rows:auto 1fr}
    .login-hero{padding:34px 24px 8px}
    .login-hero-inner{max-width:280px}
    .login-hero-frame{border-radius:16px}
    .login-hero-tag,.login-hero-chips,.login-hero-status{display:none}
    .login-formside{padding:20px 20px 28px;align-items:flex-start}
    .login-card{max-width:440px;margin:0 auto;padding:30px 26px 26px}
  }
  @media(max-width:480px){.login-card{padding:26px 20px 22px}.input-wrap,.login-button{height:50px}.field{margin-bottom:13px}}
  @media(prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}
  </style>
</head>
<body>
<div class="loader-line" id="loginLoader"></div>
<div class="grid-mesh" aria-hidden="true"></div>
<div class="ambient-glow a" aria-hidden="true"></div>
<div class="ambient-glow b" aria-hidden="true"></div>
<div class="login-page">
  <section class="login-hero">
    <div class="login-hero-inner">
      <div class="login-hero-frame">
        <picture>
          <source srcset="/img/inkamnet-go-lockup.webp" type="image/webp">
          <img src="/img/inkamnet-go-lockup.jpg" alt="INKAMNET GO — From the Village, Online Everywhere">
        </picture>
      </div>
      <p class="login-hero-tag">Satu pusat kendali untuk pelanggan, jaringan, tagihan, dan operasional lapangan INKAMNET — real-time, di mana saja.</p>
      <div class="login-hero-chips">
        <span><i class="bi bi-broadcast-pin"></i>Network Monitoring</span>
        <span><i class="bi bi-receipt-cutoff"></i>Billing Real-time</span>
        <span><i class="bi bi-diagram-3-fill"></i>Multi-Site Control</span>
      </div>
      <div class="login-hero-status"><span class="online-dot"></span><span>Sistem online · Semua layanan berjalan normal</span></div>
    </div>
  </section>
  <section class="login-formside">
    <div class="login-card">
      <h1>Welcome back</h1>
      <p class="subtitle">Masuk untuk melanjutkan ke INKAMNET GO.</p>
      <% if(typeof error !== 'undefined'){ %><div class="error" role="alert"><i class="bi bi-exclamation-circle"></i><span><%= error %></span></div><% } %>
      <form method="post" action="/login" id="loginForm"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label class="field"><span>Username</span><span class="input-wrap"><i class="bi bi-person"></i><input name="username" placeholder="Masukkan username" autocomplete="username" required autofocus></span></label>
        <label class="field"><span>Password</span><span class="input-wrap"><i class="bi bi-shield-lock"></i><input id="loginPassword" type="password" name="password" placeholder="Masukkan password" autocomplete="current-password" required><button class="password-toggle" id="passwordToggle" type="button" aria-label="Tampilkan password"><i class="bi bi-eye"></i></button></span></label>
        <label class="remember"><input id="rememberDevice" type="checkbox"><span>Ingat perangkat ini</span></label>
        <button class="login-button" id="loginButton" type="submit"><span>Masuk</span> <i class="bi bi-arrow-right"></i></button>
      </form>
      <div class="card-foot"><span class="online-dot" style="width:7px;height:7px"></span><span>Koneksi aman &middot; TLS</span></div>
    </div>
  </section>
</div>
<footer class="legal">INKAMNET GO &middot; v1.3.0</footer>
<script>
const password=document.getElementById('loginPassword'),toggle=document.getElementById('passwordToggle'),username=document.querySelector('input[name="username"]'),remember=document.getElementById('rememberDevice');
try{const saved=localStorage.getItem('inkamnet_go_username');if(saved){username.value=saved;remember.checked=true;password.focus()}}catch{}
toggle?.addEventListener('click',()=>{const visible=password.type==='text';password.type=visible?'password':'text';toggle.innerHTML=`<i class="bi ${visible?'bi-eye':'bi-eye-slash'}"></i>`;toggle.setAttribute('aria-label',visible?'Tampilkan password':'Sembunyikan password')});
document.getElementById('loginForm')?.addEventListener('submit',()=>{try{if(remember.checked)localStorage.setItem('inkamnet_go_username',username.value.trim());else localStorage.removeItem('inkamnet_go_username')}catch{}const line=document.getElementById('loginLoader'),button=document.getElementById('loginButton');line.style.width='78%';button.disabled=true;button.querySelector('span').textContent='Memproses...';setTimeout(()=>line.style.width='100%',430)});
</script>
</body></html>
