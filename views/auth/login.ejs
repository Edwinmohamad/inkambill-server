<!doctype html>
<html lang="id" data-theme="dark">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="theme-color" content="#0a0f1e">
  <title>Login · INKAMNET GO</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"><link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <style>
  :root{--bg:#000000;--panel:#1c1c1e;--line:rgba(255,255,255,.09);--text:#f5f5f7;--muted:#98989d;--accent:#6C4FE0;--accent-2:#8F7AF0;--success:#34c759}
  *{box-sizing:border-box}html,body{margin:0;min-height:100%;font-family:-apple-system,BlinkMacSystemFont,"Geist","SF Pro Text","Segoe UI",Inter,sans-serif;font-weight:400}
  body{min-height:100vh;min-height:100dvh;color:var(--text);background:var(--bg);overflow-x:hidden;position:relative}
  @keyframes fadeSlideUp{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:translateY(0)}}
  @keyframes fadeSlideRight{from{opacity:0;transform:translateX(-14px)}to{opacity:1;transform:translateX(0)}}

  .login-page{min-height:100vh;min-height:100dvh;display:grid;grid-template-columns:1.05fr 1fr;position:relative;z-index:1}
  .login-hero{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:56px 48px;position:relative;overflow:hidden;background:var(--panel);border-right:1px solid var(--line)}
  .login-hero-inner{max-width:460px;width:100%;text-align:center;animation:fadeSlideRight .5s cubic-bezier(.2,.7,.3,1) both}
  .login-hero-frame{position:relative}
  .login-hero-frame img{position:relative;z-index:1;display:block;width:100%;height:auto;max-width:280px;margin:0 auto}
  .login-hero-tag{margin:26px 0 0;color:var(--muted);font-size:.95rem;line-height:1.6;max-width:400px;margin-inline:auto}
  .login-hero-chips{display:flex;flex-wrap:wrap;gap:10px;justify-content:center;margin-top:28px}
  .login-hero-chips span{display:flex;align-items:center;gap:7px;padding:8px 14px;border:1px solid var(--line);border-radius:999px;background:rgba(255,255,255,.04);color:#c3cbdd;font-size:.76rem;font-weight:500}
  .login-hero-chips i{color:var(--accent-2);font-size:.85rem}
  .login-hero-status{display:inline-flex;align-items:center;gap:8px;margin-top:34px;color:var(--muted);font-size:.78rem}
  .login-hero-status .online-dot{width:8px;height:8px;border-radius:50%;background:var(--success)}

  .login-formside{display:flex;align-items:center;justify-content:center;padding:32px 28px;position:relative}
  .login-card{width:100%;max-width:400px;padding:38px 36px 32px;border-radius:22px;border:1px solid var(--line);background:var(--panel);box-shadow:0 24px 60px -25px rgba(0,0,0,.55);animation:fadeSlideUp .5s cubic-bezier(.2,.7,.3,1) .05s both;position:relative}
  .login-card h1{margin:0;font-size:1.5rem;font-weight:700;letter-spacing:-.02em}
  .login-card .subtitle{margin:9px 0 26px;color:var(--muted);font-size:.88rem;line-height:1.55}
  .error{display:flex;gap:9px;margin-bottom:16px;padding:11px 13px;border:1px solid rgba(255,69,58,.25);border-radius:12px;background:rgba(255,69,58,.08);color:#ff8a80;font-size:.8rem;line-height:1.45}
  .field{display:block;margin-bottom:16px}.field>span:first-child{display:block;margin-bottom:7px;color:var(--muted);font-size:.73rem;font-weight:500;letter-spacing:.01em}
  .input-wrap{height:50px;display:flex!important;align-items:center;border:1px solid var(--line);border-radius:12px;background:rgba(255,255,255,.04);transition:.18s}
  .input-wrap:focus-within{border-color:var(--accent);box-shadow:0 0 0 3px rgba(108,79,224,.22)}
  .input-wrap>i{width:46px;text-align:center;color:var(--muted);font-size:.98rem}
  .input-wrap input{min-width:0;flex:1;height:100%;padding:0 12px 0 0;border:0;outline:0;background:transparent;color:var(--text);font:inherit;font-size:.88rem}
  .input-wrap input::placeholder{color:#5c6a85}
  .password-toggle{width:46px;height:100%;border:0;background:transparent;color:var(--muted);cursor:pointer}.password-toggle:hover{color:var(--text)}
  .remember{display:flex;align-items:center;gap:9px;margin:2px 0 20px;color:var(--muted);font-size:.79rem;cursor:pointer}.remember input{width:16px;height:16px;margin:0;accent-color:var(--accent)}
  .login-button{width:100%;height:50px;border:0;border-radius:12px;background:var(--accent);color:#fff;font-size:.92rem;font-weight:600;cursor:pointer;transition:.18s;display:flex;align-items:center;justify-content:center;gap:8px}
  .login-button:hover{filter:brightness(1.08);transform:translateY(-1px)}
  .login-button:disabled{opacity:.6;cursor:wait;transform:none}
  .card-foot{display:flex;align-items:center;justify-content:center;gap:8px;margin-top:24px;color:var(--muted);font-size:.78rem}
  .legal{text-align:center;padding:18px 0 26px;color:var(--muted);font-size:.72rem;position:relative;z-index:1}
  .loader-line{height:2px;width:0;position:fixed;left:0;top:0;background:var(--accent);z-index:10;transition:.3s}

  @media(max-width:980px){
    .login-page{grid-template-columns:1fr;grid-template-rows:auto 1fr}
    .login-hero{padding:34px 24px 8px;border-right:0;border-bottom:1px solid var(--line)}
    .login-hero-inner{max-width:280px}
    .login-hero-tag,.login-hero-chips,.login-hero-status{display:none}
    .login-formside{padding:20px 20px 28px;align-items:flex-start}
    .login-card{max-width:440px;margin:0 auto;padding:30px 26px 26px;box-shadow:none;border:0}
  }
  @media(max-width:480px){.login-card{padding:26px 20px 22px}.input-wrap,.login-button{height:48px}.field{margin-bottom:13px}}
  @media(prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}
  </style>
</head>
<body>
<div class="loader-line" id="loginLoader"></div>
<div class="login-page">
  <section class="login-hero">
    <div class="login-hero-inner">
      <div class="login-hero-frame">
        <picture>
          <source srcset="/img/inkamnet-go-lockup-transparent.webp" type="image/webp">
          <img src="/img/inkamnet-go-lockup-transparent.png" alt="INKAMNET GO — From the Village, Online Everywhere">
        </picture>
      </div>
      <p class="login-hero-tag">Satu pusat kendali untuk pelanggan, jaringan, tagihan, dan operasional lapangan INKAMNET — real-time, di mana saja.</p>
      <div class="login-hero-chips">
        <span><i class="bi bi-broadcast-pin"></i>Network Monitoring</span>
        <span><i class="bi bi-receipt-cutoff"></i>Billing Real-time</span>
        <span><i class="bi bi-diagram-3-fill"></i>Multi-Site Control</span>
      </div>
      <div class="login-hero-status"><span class="online-dot"></span><span>Sistem online · Semua layanan berjalan normal</span></div>
    </div>
  </section>
  <section class="login-formside">
    <div class="login-card">
      <h1>Welcome back</h1>
      <p class="subtitle">Masuk untuk melanjutkan ke INKAMNET GO.</p>
      <% if(typeof error !== 'undefined'){ %><div class="error" role="alert"><i class="bi bi-exclamation-circle"></i><span><%= error %></span></div><% } %>
      <form method="post" action="/login" id="loginForm"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label class="field"><span>Username</span><span class="input-wrap"><i class="bi bi-person"></i><input name="username" placeholder="Masukkan username" autocomplete="username" required autofocus></span></label>
        <label class="field"><span>Password</span><span class="input-wrap"><i class="bi bi-shield-lock"></i><input id="loginPassword" type="password" name="password" placeholder="Masukkan password" autocomplete="current-password" required><button class="password-toggle" id="passwordToggle" type="button" aria-label="Tampilkan password"><i class="bi bi-eye"></i></button></span></label>
        <label class="remember"><input id="rememberDevice" type="checkbox"><span>Ingat perangkat ini</span></label>
        <button class="login-button" id="loginButton" type="submit"><span>Masuk</span> <i class="bi bi-arrow-right"></i></button>
      </form>
      <div class="card-foot"><span class="online-dot" style="width:7px;height:7px"></span><span>Koneksi aman &middot; TLS</span></div>
    </div>
  </section>
</div>
<footer class="legal">INKAMNET GO &middot; v1.3.0</footer>
<script>
const password=document.getElementById('loginPassword'),toggle=document.getElementById('passwordToggle'),username=document.querySelector('input[name="username"]'),remember=document.getElementById('rememberDevice');
try{const saved=localStorage.getItem('inkamnet_go_username');if(saved){username.value=saved;remember.checked=true;password.focus()}}catch{}
toggle?.addEventListener('click',()=>{const visible=password.type==='text';password.type=visible?'password':'text';toggle.innerHTML=`<i class="bi ${visible?'bi-eye':'bi-eye-slash'}"></i>`;toggle.setAttribute('aria-label',visible?'Tampilkan password':'Sembunyikan password')});
document.getElementById('loginForm')?.addEventListener('submit',()=>{try{if(remember.checked)localStorage.setItem('inkamnet_go_username',username.value.trim());else localStorage.removeItem('inkamnet_go_username')}catch{}const line=document.getElementById('loginLoader'),button=document.getElementById('loginButton');line.style.width='78%';button.disabled=true;button.querySelector('span').textContent='Memproses...';setTimeout(()=>line.style.width='100%',430)});
</script>
</body></html>
