<section class="settings-center">
  <div class="module-head"><div><div class="module-kicker">SYSTEM CONFIGURATION</div><h1><%= language==='en'?'Settings':'Pengaturan' %></h1><p><%= language==='en'?'Company, application, employees, payments and access management.':'Perusahaan, aplikasi, karyawan, pembayaran, dan pengelolaan akses.' %></p></div></div>
  <div class="settings-layout">
    <aside class="settings-nav-card">
      <% const menus=[['company','Perusahaan','bi-buildings'],['invoice','Identitas Invoice','bi-receipt-cutoff'],['application','Tampilan & Aplikasi','bi-palette2'],['accounts','Config Akun','bi-person-gear'],['roles','Role & Permission','bi-shield-lock'],['employees','Karyawan','bi-people'],['departments','Departemen','bi-diagram-3'],['positions','Posisi','bi-person-badge'],['banks','Bank','bi-bank'],['gateways','Payment Gateway','bi-credit-card']]; if(isMasterAdmin){ menus.push(['reset','Reset Data Uji Coba','bi-exclamation-diamond']); } %>
      <% menus.forEach(m=>{ %><a class="settings-nav-link <%= tab===m[0]?'active':'' %>" href="/settings?tab=<%= m[0] %>"><i class="bi <%= m[2] %>"></i><span><%= m[1] %></span></a><% }) %>
    </aside>
    <div class="settings-content">
      <% if(tab==='company'){ %>
      <form method="post" action="/settings" class="data-card"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="return_tab" value="company">
        <div class="data-card-head"><div><h3>Perusahaan</h3><small>Identitas yang dipakai pada sistem, laporan, dan faktur.</small></div><span class="status-badge purple">INKAMNET</span></div>
        <div class="data-card-body"><div class="row g-3"><div class="col-md-8"><label class="form-label">Nama Perusahaan</label><input class="form-control" name="company_name" value="<%= settings.company_name %>" required></div><div class="col-md-4"><label class="form-label">Telepon</label><input class="form-control" name="company_phone" value="<%= settings.company_phone||'' %>"></div><div class="col-md-6"><label class="form-label">Email</label><input class="form-control" type="email" name="company_email" value="<%= settings.company_email||'' %>"></div><div class="col-md-6"><label class="form-label">Website</label><input class="form-control" name="company_website" value="<%= settings.company_website||'' %>"></div><div class="col-12"><label class="form-label">Tagline</label><input class="form-control" name="company_tagline" value="<%= settings.company_tagline||'' %>"></div><div class="col-12"><label class="form-label">Alamat</label><textarea class="form-control" name="company_address" rows="4"><%= settings.company_address||'' %></textarea></div></div>
        <input type="hidden" name="default_due_day" value="<%= settings.default_due_day %>"><input type="hidden" name="default_grace_days" value="<%= settings.default_grace_days %>"><input type="hidden" name="invoice_generate_days" value="<%= settings.invoice_generate_days %>"><input type="hidden" name="default_theme" value="<%= settings.default_theme %>"><input type="hidden" name="default_language" value="<%= settings.default_language||'id' %>"><div class="mt-4"><button class="btn-tech primary"><i class="bi bi-check2-circle"></i>Simpan Perusahaan</button></div></div>
      </form>
      <% } %>

      <% if(tab==='invoice'){ %>
      <form method="post" action="/settings/invoice-branding" enctype="multipart/form-data" class="data-card invoice-branding-card">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="data-card-head"><div><h3>Identitas Invoice</h3><small>Satu sumber identitas untuk invoice versi cetak dan PDF.</small></div><span class="status-badge green"><i class="bi bi-arrow-repeat"></i> TERSINKRON</span></div>
        <div class="data-card-body">
          <div class="invoice-branding-layout">
            <div class="invoice-logo-editor">
              <span>LOGO INVOICE</span>
              <div class="invoice-logo-preview"><% if(settings.invoice_logo_path){ %><img src="/invoices/branding/logo/<%= encodeURIComponent(settings.invoice_logo_path) %>" alt="Logo invoice"><% }else{ %><img src="/img/inkamnet-wordmark-hq.png" alt="Logo default"><% } %></div>
              <label class="proof-dropzone"><input type="file" name="invoice_logo" accept="image/png,image/jpeg"><span class="proof-drop-icon"><i class="bi bi-cloud-arrow-up"></i></span><span><strong>Upload Logo</strong><small>PNG/JPG · maks. 3 MB</small></span></label>
              <% if(settings.invoice_logo_path){ %><label class="form-check mt-2"><input class="form-check-input" type="checkbox" name="remove_logo" value="1"><span class="form-check-label">Hapus logo khusus, gunakan logo bawaan</span></label><% } %>
            </div>
            <div class="row g-3">
              <div class="col-md-8"><label class="form-label">Nama PT / Perusahaan *</label><input class="form-control" name="invoice_company_name" value="<%= settings.invoice_company_name||settings.company_name||'' %>" required></div>
              <div class="col-md-4"><label class="form-label">NPWP / Identitas Pajak</label><input class="form-control" name="invoice_tax_id" value="<%= settings.invoice_tax_id||'' %>"></div>
              <div class="col-md-6"><label class="form-label">No. Telepon</label><input class="form-control" name="invoice_phone" value="<%= settings.invoice_phone||settings.company_phone||'' %>"></div>
              <div class="col-md-6"><label class="form-label">Email</label><input class="form-control" type="email" name="invoice_email" value="<%= settings.invoice_email||settings.company_email||'' %>"></div>
              <div class="col-md-6"><label class="form-label">Website</label><input class="form-control" name="invoice_website" value="<%= settings.invoice_website||settings.company_website||'' %>"></div>
              <div class="col-12"><label class="form-label">Alamat Invoice</label><textarea class="form-control" name="invoice_address" rows="3"><%= settings.invoice_address||settings.company_address||'' %></textarea></div>
              <div class="col-12"><label class="form-label">Catatan Footer</label><textarea class="form-control" name="invoice_footer" rows="2" placeholder="Contoh: Dokumen digital resmi..."><%= settings.invoice_footer||'' %></textarea></div>
            </div>
          </div>
          <div class="secure-file-note mt-3"><i class="bi bi-receipt-cutoff"></i><span>Perubahan langsung digunakan saat invoice dibuka, dicetak, atau diunduh. Data invoice lama tidak perlu digenerate ulang.</span></div>
          <button class="btn-tech primary mt-4"><i class="bi bi-check2-circle"></i>Simpan Identitas Invoice</button>
        </div>
      </form>
      <% } %>

      <% if(tab==='application'){ %>
      <form method="post" action="/settings/application" class="data-card mb-3"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="data-card-head"><div><h3>Tampilan & Aplikasi</h3><small>Pilih mode tampilan, bahasa, dan default billing.</small></div><span class="status-badge purple"><i class="bi bi-stars"></i> LIVE PREVIEW</span></div>
        <div class="data-card-body">
          <div class="row g-3"><div class="col-md-4"><label class="form-label">Bahasa Default</label><select class="form-select" name="default_language"><option value="id" <%= (settings.default_language||'id')==='id'?'selected':'' %>>Indonesia</option><option value="en" <%= settings.default_language==='en'?'selected':'' %>>English</option></select></div><div class="col-md-4"><label class="form-label">Mode Cahaya</label><select class="form-select" name="default_theme"><option value="dark" <%= settings.default_theme==='dark'?'selected':'' %>>Dark</option><option value="light" <%= settings.default_theme==='light'?'selected':'' %>>Light</option><option value="system" <%= settings.default_theme==='system'?'selected':'' %>>Ikuti Sistem</option></select></div><div class="col-md-4"><label class="form-label">Jatuh Tempo Default</label><input class="form-control" type="number" min="1" max="28" name="default_due_day" value="<%= settings.default_due_day %>"></div></div>
          <input type="hidden" name="ui_palette" value="<%= settings.ui_palette||'nebula' %>">
          <div class="row g-3 mt-1"><div class="col-md-4"><label class="form-label">Grace Period</label><input class="form-control" type="number" min="0" max="30" name="default_grace_days" value="<%= settings.default_grace_days %>"></div><div class="col-md-4"><label class="form-label">Generate Tagihan H-</label><input class="form-control" type="number" min="0" max="30" name="invoice_generate_days" value="<%= settings.invoice_generate_days %>"></div><div class="col-md-4 d-flex align-items-end"><div class="form-check form-switch mb-2"><input class="form-check-input" type="checkbox" name="auto_isolate" id="autoIsolate" <%= settings.auto_isolate?'checked':'' %>><label class="form-check-label" for="autoIsolate">Auto Isolir</label></div></div></div>
          <!-- v1.25.5 (susulan #10) — Komisi Pemasangan Baru seragam semua paket: Sales selalu dapat nominal
               flat ini, Teknisi dapat sisanya dari harga paket. Menggantikan input komisi manual per-paket
               yang sebelumnya ada di Menu Paket Internet. -->
          <div class="row g-3 mt-1"><div class="col-md-6"><label class="form-label">Komisi Sales Pemasangan Baru (flat)</label><input class="form-control" type="number" min="0" step="1000" name="install_sales_flat_commission" value="<%= Number(settings.install_sales_flat_commission??50000) %>"><div class="form-help">Berlaku sama untuk semua paket. Saat pelanggan baru ditandai "Pemasangan Baru", Sales otomatis dapat nominal ini dan Teknisi dapat sisanya dari harga paket (harga paket harus lebih besar dari nominal ini).</div></div></div>
          <div class="row g-3 mt-1"><div class="col-12"><label class="form-label">Alert Jaringan (WhatsApp)</label><div class="form-help">Kirim notifikasi WA otomatis ke NOC saat Router offline, OLT bermasalah (indikasi gangguan massal di jalur PON), atau jumlah ONT redaman kritis melonjak. Nomor WA harus terhubung dulu di menu WA Gateway.</div></div><div class="col-md-4 d-flex align-items-end"><div class="form-check form-switch mb-2"><input class="form-check-input" type="checkbox" name="network_alert_wa_enabled" id="netAlertWa" <%= settings.network_alert_wa_enabled?'checked':'' %>><label class="form-check-label" for="netAlertWa">Aktifkan Alert WA</label></div></div><div class="col-md-8"><label class="form-label">Nomor WA Tujuan (pisah koma)</label><input class="form-control" name="network_alert_wa_numbers" placeholder="628123456789, 628987654321" value="<%= settings.network_alert_wa_numbers||'' %>"></div><div class="col-md-6 d-flex align-items-end"><div class="form-check form-switch mb-2"><input class="form-check-input" type="checkbox" name="network_alert_auto_ticket_enabled" id="netAlertTicket" <%= settings.network_alert_auto_ticket_enabled?'checked':'' %>><label class="form-check-label" for="netAlertTicket">Auto-buat Tiket untuk Insiden Kritis</label></div></div></div><button class="btn-tech primary mt-4"><i class="bi bi-palette2"></i>Simpan Tampilan & Aplikasi</button>
        </div>
      </form>
      <div class="data-card"><div class="data-card-head"><div><h3>Default per Site / POP</h3><small>Override due date dan grace per site.</small></div></div><div class="data-card-body"><div class="row g-3"><% sites.forEach(s=>{ %><div class="col-lg-4"><form class="form-card p-3" method="post" action="/settings/sites/<%= s.id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><span class="status-badge purple"><%= s.code %></span><label class="form-label mt-3">Nama Site</label><input class="form-control mb-2" name="name" value="<%= s.name %>"><div class="row g-2"><div class="col-4"><label class="form-label">Due</label><input class="form-control" name="default_due_day" value="<%= s.default_due_day??'' %>"></div><div class="col-4"><label class="form-label">Grace</label><input class="form-control" name="default_grace_days" value="<%= s.default_grace_days??'' %>"></div><div class="col-4"><label class="form-label">H-</label><input class="form-control" name="invoice_generate_days" value="<%= s.invoice_generate_days??'' %>"></div></div><button class="btn-tech mt-3 w-100">Update</button></form></div><% }) %></div></div></div>
      <% } %>

      <% if(tab==='employees'){ %>
      <div class="data-card"><div class="data-card-head"><div><h3>Data Karyawan</h3><small>Sales, Technical Support, Admin, Finance, NOC, dan bagian lain.</small></div><button class="btn-tech primary" data-bs-toggle="modal" data-bs-target="#employeeModal"><i class="bi bi-person-plus"></i>Tambah Karyawan</button></div><div class="table-responsive"><table class="app-table"><thead><tr><th class="app-seq-col">No.</th><th>Kode</th><th>Nama</th><th>Departemen</th><th>Posisi</th><th>Kontak</th><th>Akun</th><th>Status</th><th></th></tr></thead><tbody><% employees.forEach((e,index)=>{ %><tr><td><span class="cell-main"><%= index+1 %></span></td><td class="text-purple"><%= e.employee_code %></td><td class="cell-main"><%= e.name %></td><td><%= e.department_name||'-' %></td><td><span class="status-badge purple"><%= e.position_name||'Belum diatur' %></span></td><td><%= e.phone||'-' %><span class="cell-sub"><%= e.email||'' %></span></td><td><%= e.username||'-' %></td><td><span class="status-badge <%= e.is_active?'green':'gray' %>"><%= e.is_active?'Aktif':'Nonaktif' %></span></td><td><div class="d-flex gap-1"><button class="action-menu" type="button" data-bs-toggle="modal" data-bs-target="#editEmployee<%= e.id %>" title="Edit"><i class="bi bi-pencil-square"></i></button><form method="post" action="/settings/employees/<%= e.id %>/toggle"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="action-menu" title="Aktif / Nonaktif"><i class="bi bi-power"></i></button></form></div></td></tr><% }) %></tbody></table></div></div>
      <% } %>

      <% if(tab==='accounts'){ const roleNames=Object.fromEntries(roles.map(r=>[r.role_key,r.role_name])); %>
      <div class="account-command-card mb-3"><div><span><i class="bi bi-shield-check"></i> ACCESS CONTROL CENTER</span><h2>Config Akun</h2><p>Kelola akun, role, status, dan password. Master Admin tetap dilindungi dari perubahan oleh admin lain.</p></div><% if(isAdmin){ %><button class="btn-tech primary" data-bs-toggle="modal" data-bs-target="#accountModal"><i class="bi bi-person-plus-fill"></i>Create Akun</button><% } %></div>
      <div class="data-card mb-3 account-registry"><div class="data-card-head"><div><h3>Daftar Akun</h3><small><%= users.length %> akun terdaftar · role custom dapat langsung dipasangkan ke user.</small></div><span class="status-badge green"><%= users.filter(u=>u.is_active).length %> AKTIF</span></div><div class="table-responsive"><table class="app-table"><thead><tr><th class="app-seq-col">No.</th><th>User</th><th>Username</th><th>Role</th><th>Status</th><th>Dibuat</th><th>Action</th></tr></thead><tbody><% users.forEach((u,index)=>{ const protectedMaster=u.role==='master_admin'&&!isMasterAdmin; const currentUser=Number(u.id)===Number(user?.id); %><tr class="<%= currentUser?'current-account-row':'' %>"><td><span class="cell-main"><%= index+1 %></span></td><td><div class="account-user-cell"><span class="avatar"><% if(u.profile_photo){ %><img src="/profile/photo/<%= encodeURIComponent(u.profile_photo) %>" alt=""><% }else{ %><%= u.name.charAt(0).toUpperCase() %><% } %></span><div><strong><%= u.name %></strong><small><%= currentUser?'Akun yang sedang login':'ID #'+u.id %></small></div></div></td><td><code><%= u.username %></code></td><td><span class="account-role <%= u.role %>"><i class="bi <%= u.role==='master_admin'?'bi-shield-fill-check':u.role==='admin'?'bi-person-fill-gear':'bi-person-fill' %>"></i><%= roleNames[u.role]||u.role %></span></td><td><span class="status-badge <%= u.is_active?'green':'gray' %>"><%= u.is_active?'Aktif':'Nonaktif' %></span></td><td><%= formatDate(u.created_at) %></td><td><% if(isAdmin){ %><div class="account-actions"><button class="action-menu" type="button" data-bs-toggle="modal" data-bs-target="#editAccount<%= u.id %>" title="Edit akun" <%= protectedMaster?'disabled':'' %>><i class="bi bi-pencil-square"></i></button><button class="action-menu" type="button" data-bs-toggle="modal" data-bs-target="#passwordAccount<%= u.id %>" title="Reset password" <%= protectedMaster?'disabled':'' %>><i class="bi bi-key-fill"></i></button><form method="post" action="/settings/users/<%= u.id %>/toggle"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="action-menu <%= u.is_active?'danger':'success' %>" title="<%= u.is_active?'Nonaktifkan':'Aktifkan' %>" <%= currentUser||protectedMaster?'disabled':'' %>><i class="bi bi-power"></i></button></form></div><% }else{ %><span class="cell-sub">Read only</span><% } %></td></tr><% }) %></tbody></table></div></div>
      <% } %>

      <% if(tab==='departments'){ %>
      <div class="data-card"><div class="data-card-head"><div><h3>Departemen</h3><small>Struktur bagian perusahaan.</small></div><button class="btn-tech primary" data-bs-toggle="modal" data-bs-target="#departmentModal"><i class="bi bi-plus-lg"></i>Tambah</button></div><div class="table-responsive"><table class="app-table"><thead><tr><th class="app-seq-col">No.</th><th>Kode</th><th>Departemen</th><th>Deskripsi</th><th>Status</th><th></th></tr></thead><tbody><% departments.forEach((d,index)=>{ %><tr><td><span class="cell-main"><%= index+1 %></span></td><td class="text-purple"><%= d.code %></td><td class="cell-main"><%= d.name %></td><td><%= d.description||'-' %></td><td><span class="status-badge <%= d.is_active?'green':'gray' %>"><%= d.is_active?'Aktif':'Nonaktif' %></span></td><td><div class="d-flex gap-1"><button class="action-menu" type="button" data-bs-toggle="modal" data-bs-target="#editDepartment<%= d.id %>" title="Edit"><i class="bi bi-pencil-square"></i></button><form method="post" action="/settings/departments/<%= d.id %>/toggle"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="action-menu"><i class="bi bi-power"></i></button></form></div></td></tr><% }) %></tbody></table></div></div>
      <% } %>

      <% if(tab==='positions'){ %>
      <div class="data-card"><div class="data-card-head"><div><h3>Posisi</h3><small>Kategori posisi dipakai untuk integrasi sales dan teknisi.</small></div><button class="btn-tech primary" data-bs-toggle="modal" data-bs-target="#positionModal"><i class="bi bi-plus-lg"></i>Tambah</button></div><div class="table-responsive"><table class="app-table"><thead><tr><th class="app-seq-col">No.</th><th>Kode</th><th>Posisi</th><th>Departemen</th><th>Kategori</th><th>Status</th><th></th></tr></thead><tbody><% positions.forEach((p,index)=>{ %><tr><td><span class="cell-main"><%= index+1 %></span></td><td class="text-purple"><%= p.code %></td><td class="cell-main"><%= p.name %></td><td><%= p.department_name||'-' %></td><td><span class="status-badge purple"><%= p.category %></span></td><td><span class="status-badge <%= p.is_active?'green':'gray' %>"><%= p.is_active?'Aktif':'Nonaktif' %></span></td><td><div class="d-flex gap-1"><button class="action-menu" type="button" data-bs-toggle="modal" data-bs-target="#editPosition<%= p.id %>" title="Edit"><i class="bi bi-pencil-square"></i></button><form method="post" action="/settings/positions/<%= p.id %>/toggle"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="action-menu"><i class="bi bi-power"></i></button></form></div></td></tr><% }) %></tbody></table></div></div>
      <% } %>

      <% if(tab==='banks'){ %>
      <div class="data-card"><div class="data-card-head"><div><h3>Bank</h3><small>Rekening perusahaan untuk pembayaran pelanggan dan faktur.</small></div><button class="btn-tech primary" data-bs-toggle="modal" data-bs-target="#bankModal"><i class="bi bi-plus-lg"></i>Tambah Bank</button></div><div class="table-responsive"><table class="app-table"><thead><tr><th class="app-seq-col">No.</th><th>Nama Bank</th><th>Nama Akun</th><th>Nomor Akun</th><th>Jenis</th><th>Status</th><th></th></tr></thead><tbody><% banks.forEach((b,index)=>{ %><tr><td><span class="cell-main"><%= index+1 %></span></td><td class="cell-main"><%= b.bank_name %></td><td><%= b.account_name %></td><td class="text-purple"><%= b.account_number %></td><td><%= b.type %></td><td><span class="status-badge <%= b.is_active?'green':'gray' %>"><%= b.is_active?'Aktif':'Nonaktif' %></span></td><td><div class="d-flex gap-1"><button class="action-menu" type="button" data-bs-toggle="modal" data-bs-target="#editBank<%= b.id %>" title="Edit"><i class="bi bi-pencil-square"></i></button><form method="post" action="/settings/banks/<%= b.id %>/toggle"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="action-menu"><i class="bi bi-power"></i></button></form></div></td></tr><% }) %><% if(!banks.length){ %><tr><td colspan="7"><div class="empty-state"><i class="bi bi-bank"></i><strong>Belum ada rekening bank</strong><small>Klik Tambah Bank untuk menambahkan rekening pertama.</small></div></td></tr><% } %></tbody></table></div></div>
      <% } %>

      <% if(tab==='gateways'){ %>
      <div class="data-card"><div class="data-card-head"><div><h3>Payment Gateway</h3><small>Daftar provider pembayaran. Secret/API key tetap disimpan di environment, bukan di halaman ini.</small></div><button class="btn-tech primary" data-bs-toggle="modal" data-bs-target="#gatewayModal"><i class="bi bi-plus-lg"></i>Tambah</button></div><div class="table-responsive"><table class="app-table"><thead><tr><th class="app-seq-col">No.</th><th>Nama</th><th>Provider</th><th>Channel</th><th>Status</th><th>Catatan</th><th></th></tr></thead><tbody><% gateways.forEach((g,index)=>{ %><tr><td><span class="cell-main"><%= index+1 %></span></td><td class="cell-main"><%= g.name %></td><td><%= g.provider||'-' %></td><td><%= g.channel||'-' %></td><td><span class="status-badge <%= g.status==='active'?'green':g.status==='testing'?'orange':'gray' %>"><%= statusLabel(g.status) %></span></td><td><%= g.notes||'-' %></td><td><div class="d-flex gap-1"><button class="action-menu" type="button" data-bs-toggle="modal" data-bs-target="#editGateway<%= g.id %>" title="Edit"><i class="bi bi-pencil-square"></i></button><form method="post" action="/settings/gateways/<%= g.id %>/toggle"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="action-menu"><i class="bi bi-power"></i></button></form></div></td></tr><% }) %></tbody></table></div></div>
      <% } %>

      <% if(tab==='roles'){ %>
      <div class="data-card"><div class="data-card-head"><div><h3>Role & Permission Manual</h3><small>Master Admin dapat membuat role custom dan menentukan akses setiap menu secara bebas.</small></div><span class="status-badge <%= isMasterAdmin?'green':'gray' %>"><%= isMasterAdmin?'MASTER EDIT MODE':'READ ONLY' %></span></div><div class="data-card-body">
        <% if(isMasterAdmin){ %><form class="custom-role-create" method="post" action="/settings/roles"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div><span>ROLE BARU</span><strong>Buat role custom</strong><small>Contoh: finance, noc_operator, sales_lead</small></div><input class="form-control" name="role_key" pattern="[a-z][a-z0-9_]{2,49}" placeholder="kode_role" required><input class="form-control" name="role_name" maxlength="100" placeholder="Nama tampilan role" required><button class="btn-tech primary"><i class="bi bi-plus-lg"></i>Tambah Role</button></form><% } %>
        <div class="role-grid editable"><% roles.forEach(r=>{ let perms=[];try{perms=typeof r.permissions_json==='string'?JSON.parse(r.permissions_json):(r.permissions_json||[]);}catch(e){} const systemRole=['master_admin','admin','staff'].includes(r.role_key); %>
          <form class="role-card role-editor" method="post" action="/settings/roles/<%= encodeURIComponent(r.role_key) %>">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="role-editor-head"><span class="status-badge <%= systemRole?'purple':'green' %>"><%= r.role_key %></span><input class="form-control" name="role_name" value="<%= r.role_name %>" aria-label="Nama role <%= r.role_key %>" <%= isMasterAdmin?'':'disabled' %>></div>
            <div class="permission-check-grid"><% permissionCatalog.forEach(permission=>{ const master=r.role_key==='master_admin'; const lockedOn=master||permission.key==='dashboard'; %>
              <label class="permission-check <%= perms.includes(permission.key)||lockedOn?'selected':'' %>"><input type="checkbox" name="permissions" value="<%= permission.key %>" <%= perms.includes(permission.key)||lockedOn?'checked':'' %> <%= !isMasterAdmin||lockedOn?'disabled':'' %>><i class="bi bi-check2"></i><span><strong><%= permission.label %></strong><small><%= lockedOn?'selalu aktif':permission.key %></small></span></label>
              <% if(lockedOn&&isMasterAdmin){ %><input type="hidden" name="permissions" value="<%= permission.key %>"><% } %>
            <% }) %></div>
            <% if(isMasterAdmin){ %><div class="role-editor-actions"><button class="btn-tech primary"><i class="bi bi-floppy"></i>Simpan <%= r.role_name %></button><% if(!systemRole){ %><button class="btn-tech danger" type="submit" formaction="/settings/roles/<%= encodeURIComponent(r.role_key) %>/delete" onclick="return confirm('Hapus custom role <%= r.role_name %>?')"><i class="bi bi-trash3"></i>Hapus</button><% } %></div><% } %>
          </form>
        <% }) %></div>
        <div class="secure-file-note mt-3"><i class="bi bi-shield-lock"></i><span>Dashboard selalu aktif sebagai jalur masuk aman. Master Admin selalu memiliki semua akses dan tidak dapat dikurangi permission-nya.</span></div>
      </div></div>
      <% } %>

      <% if(tab==='reset' && isMasterAdmin){ %>
      <div class="data-card mb-3"><div class="data-card-head"><div><h3>Reset Data Uji Coba</h3><small>Untuk instalasi baru yang masih tahap uji coba — bersihkan data contoh sebelum input data pelanggan asli.</small></div><span class="status-badge orange"><i class="bi bi-exclamation-diamond"></i> MASTER ADMIN ONLY</span></div><div class="data-card-body">
        <div class="secure-file-note mb-3"><i class="bi bi-info-circle"></i><span>Tombol ini mengosongkan data <b>Pelanggan, Tagihan, Pembayaran, dan Data Kas</b> (termasuk baris "AUTO BILLING" yang bergembok). Akun login, Pengaturan perusahaan, Paket Internet, Site, Router, Cluster/ODP, Kategori Kas, dan Karyawan <b>TIDAK ikut dihapus</b>.</span></div>
        <div class="alert alert-danger alert-modern mb-3"><i class="bi bi-exclamation-octagon-fill me-2"></i>Tindakan ini permanen dan tidak dapat dibatalkan. Pastikan ini benar instalasi/uji coba, bukan data pelanggan asli yang sedang berjalan. Sebaiknya backup database terlebih dahulu sebelum melanjutkan.</div>
        <button type="button" class="btn-tech danger" data-force-delete="/settings/reset-test-data" data-entity-label="Data Uji Coba (Pelanggan, Tagihan, Pembayaran, Data Kas)" data-force-delete-match="BERSIHKAN DATA UJI COBA" data-force-delete-warning="Semua data Pelanggan, Tagihan, Pembayaran, dan Data Kas (termasuk transaksi AUTO BILLING) akan dihapus permanen. Akun login, Pengaturan, Paket, Site, Router, Cluster/ODP, dan Kategori Kas tidak berubah."><i class="bi bi-trash3-fill"></i>Bersihkan Data Uji Coba</button>
      </div></div>
      <% } %>
    </div>
  </div>
</section>

