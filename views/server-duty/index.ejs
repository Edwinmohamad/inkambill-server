<section>
  <div class="module-head">
    <div><div class="module-kicker">SERVER OPERATIONS</div><h1>Jadwal Piket Server</h1><p>Jadwal penjagaan server/gudang mingguan, site, shift, dan status kehadiran tim.</p></div>
    <div class="module-actions">
      <a class="btn-tech" href="/server-duty?week=<%= prevWeek %>"><i class="bi bi-chevron-left"></i>Minggu Lalu</a>
      <a class="btn-tech" href="/server-duty?week=<%= nextWeek %>">Minggu Depan<i class="bi bi-chevron-right"></i></a>
      <% if(isAdmin){ %><button class="btn-tech" type="button" data-bs-toggle="modal" data-bs-target="#rotationModal"><i class="bi bi-arrow-repeat"></i>Generate Rotasi</button><button class="btn-tech primary" type="button" data-bs-toggle="modal" data-bs-target="#dutyModal"><i class="bi bi-plus-lg"></i>Tambah Piket</button><% } %>
    </div>
  </div>

  <% const weekPic=[...new Set(duties.map(d=>d.staff_name))]; %><div class="duty-week-head"><div><span>PERIODE PIKET</span><strong><%= new Date(weekStart+'T00:00:00').toLocaleDateString('id-ID',{day:'2-digit',month:'long'}) %> — <%= new Date(weekEnd+'T00:00:00').toLocaleDateString('id-ID',{day:'2-digit',month:'long',year:'numeric'}) %></strong><small>PIC Minggu Ini: <b><%= weekPic.length?weekPic.join(', '):'Belum ditentukan' %></b></small></div><span class="status-badge purple"><%= duties.length %> assignment</span></div>
  <div class="duty-board">
    <% days.forEach(day=>{ const rows=duties.filter(d=>d.duty_date_key===day.date); %>
      <article class="duty-day-card">
        <div class="duty-day-title"><span><%= day.label %></span><b><%= rows.length %></b></div>
        <div class="duty-day-list">
          <% rows.forEach(d=>{ %>
            <div class="duty-person">
              <div class="duty-avatar"><%= d.staff_name.charAt(0).toUpperCase() %></div>
              <div class="duty-copy"><strong><%= d.staff_name %></strong><small><%= d.shift_name %> · <%= d.site_code||'ALL SITE' %></small><em><%= d.start_time?String(d.start_time).slice(0,5):'--:--' %><%= d.end_time?' — '+String(d.end_time).slice(0,5):'' %></em><% if(d.proof_path){ %><a class="duty-proof-link" href="/server-duty/<%= d.id %>/proof" target="_blank" rel="noopener"><i class="bi bi-image-fill"></i>Bukti piket terupload</a><% }else{ %><span class="duty-proof-missing"><i class="bi bi-camera"></i>Belum ada bukti</span><% } %></div>
              <span class="status-badge <%= d.status==='present'?'green':d.status==='absent'?'red':d.status==='swapped'?'orange':d.status==='cancelled'?'gray':'purple' %>"><%= statusLabel(d.status) %></span>
              <button class="action-menu" type="button" data-action-popover-target="dutyAction<%= d.id %>" aria-label="Buka tindakan piket <%= d.staff_name %>"><i class="bi bi-three-dots-vertical"></i></button><div class="ink-action-popover" id="dutyAction<%= d.id %>" hidden><div class="ink-action-popover-head"><div><small>PIKET SERVER</small><strong><%= d.staff_name %></strong><span><%= day.label %> · <%= d.site_code||'ALL SITE' %></span></div></div><div class="ink-action-popover-body"><button type="button" class="ink-action-item compact" data-action-close data-bs-toggle="modal" data-bs-target="#editDuty<%= d.id %>"><i class="bi bi-pencil-square"></i><span><b>Edit Jadwal</b><small>Ubah tanggal, shift, atau petugas</small></span></button><% ['scheduled','present','absent','swapped','cancelled'].forEach(st=>{ %><form method="post" action="/server-duty/<%= d.id %>/status"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="week" value="<%= weekStart %>"><input type="hidden" name="status" value="<%= st %>"><button type="submit" class="ink-action-item compact"><i class="bi bi-check2-circle"></i><span><b><%= st %></b><small>Ubah status piket</small></span></button></form><% }) %><% if(d.proof_path){ %><a class="ink-action-item compact" href="/server-duty/<%= d.id %>/proof" target="_blank" rel="noopener"><i class="bi bi-image"></i><span><b>Lihat Bukti</b><small>Lampiran bukti piket</small></span></a><% } %><% if(isAdmin){ %><div class="ink-action-separator"></div><form method="post" action="/server-duty/<%= d.id %>/delete" onsubmit="return confirm('Hapus jadwal piket ini?')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="week" value="<%= weekStart %>"><button type="submit" class="ink-action-item compact danger"><i class="bi bi-trash"></i><span><b>Hapus</b><small>Hapus jadwal piket</small></span></button></form><% } %></div></div>
              <form class="duty-proof-upload" method="post" action="/server-duty/<%= d.id %>/proof" enctype="multipart/form-data"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="week" value="<%= weekStart %>"><label><i class="bi bi-camera-fill"></i><span><%= d.proof_path?'Ganti Bukti':'Upload Bukti Piket' %></span><input type="file" name="duty_proof" accept="image/jpeg,image/png,image/webp" required onchange="this.form.requestSubmit()"></label></form>
            </div>
          <% }) %>
          <% if(!rows.length){ %><div class="duty-empty"><i class="bi bi-shield-check"></i><span>Belum ada piket</span></div><% } %>
        </div>
      </article>
    <% }) %>
  </div>
</section>

<div class="modal fade" id="dutyModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-centered"><form class="modal-content" method="post" action="/server-duty"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="modal-header"><div><div class="module-kicker">NEW DUTY ASSIGNMENT</div><h5 class="modal-title">Tambah Jadwal Piket Server</h5></div><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="row g-3">
<div class="col-md-4"><label class="form-label">Tanggal</label><input class="form-control" type="date" name="duty_date" value="<%= weekStart %>" required></div>
<div class="col-md-4"><label class="form-label">Shift</label><input class="form-control" name="shift_name" value="Piket Server" required></div>
<div class="col-md-4"><label class="form-label">Site</label><select class="form-select" name="site_id"><option value="">Semua Site / Server</option><% sites.forEach(s=>{ %><option value="<%= s.id %>"><%= s.code %> · <%= s.name %></option><% }) %></select></div>
<div class="col-md-6"><label class="form-label">Pilih Karyawan</label><select class="form-select" name="employee_id" id="dutyUser"><option value="">Nama manual / helper</option><% staff.forEach(e=>{ %><option value="<%= e.id %>"><%= e.employee_code %> · <%= e.name %><%= e.position_name?' · '+e.position_name:'' %></option><% }) %></select></div>
<div class="col-md-6"><label class="form-label">Nama Manual <small class="text-secondary">(jika belum punya akun)</small></label><input class="form-control" name="staff_name" placeholder="Contoh: Agung"></div>
<div class="col-md-3"><label class="form-label">Mulai</label><input class="form-control" type="time" name="start_time"></div><div class="col-md-3"><label class="form-label">Selesai</label><input class="form-control" type="time" name="end_time"></div>
<div class="col-md-6"><label class="form-label">Catatan</label><input class="form-control" name="notes" placeholder="Cek server, gudang, kebersihan, alarm..."></div>
</div></div><div class="modal-footer"><button class="btn-tech" type="button" data-bs-dismiss="modal">Batal</button><button class="btn-tech primary">Simpan Piket</button></div></form></div></div>

<% duties.forEach(d=>{ %><div class="modal fade" id="editDuty<%= d.id %>" tabindex="-1"><div class="modal-dialog modal-lg modal-dialog-centered"><form class="modal-content" method="post" action="/server-duty/<%= d.id %>/edit"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="week" value="<%= weekStart %>"><div class="modal-header"><div><div class="module-kicker">EDIT DUTY ASSIGNMENT</div><h5 class="modal-title">Edit Piket · <%= d.staff_name %></h5></div><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="row g-3">
<div class="col-md-4"><label class="form-label">Tanggal</label><input class="form-control" type="date" name="duty_date" value="<%= d.duty_date_key %>" required></div>
<div class="col-md-4"><label class="form-label">Shift</label><input class="form-control" name="shift_name" value="<%= d.shift_name %>" required></div>
<div class="col-md-4"><label class="form-label">Site</label><select class="form-select" name="site_id"><option value="">Semua Site / Server</option><% sites.forEach(s=>{ %><option value="<%= s.id %>" <%= String(d.site_id||'')===String(s.id)?'selected':'' %>><%= s.code %> · <%= s.name %></option><% }) %></select></div>
<div class="col-md-6"><label class="form-label">Pilih Karyawan</label><select class="form-select" name="employee_id"><option value="">Nama manual / helper</option><% staff.forEach(e=>{ %><option value="<%= e.id %>" <%= d.user_id&&String(d.user_id)===String(e.user_id)?'selected':'' %>><%= e.employee_code %> · <%= e.name %><%= e.position_name?' · '+e.position_name:'' %></option><% }) %></select></div>
<div class="col-md-6"><label class="form-label">Nama Manual <small class="text-secondary">(jika belum punya akun)</small></label><input class="form-control" name="staff_name" value="<%= d.staff_name %>" placeholder="Contoh: Agung"></div>
<div class="col-md-3"><label class="form-label">Mulai</label><input class="form-control" type="time" name="start_time" value="<%= d.start_time?String(d.start_time).slice(0,5):'' %>"></div><div class="col-md-3"><label class="form-label">Selesai</label><input class="form-control" type="time" name="end_time" value="<%= d.end_time?String(d.end_time).slice(0,5):'' %>"></div>
<div class="col-md-6"><label class="form-label">Catatan</label><input class="form-control" name="notes" value="<%= d.notes||'' %>" placeholder="Cek server, gudang, kebersihan, alarm..."></div>
</div></div><div class="modal-footer"><button type="button" class="btn-tech" data-bs-dismiss="modal">Batal</button><button class="btn-tech primary">Simpan Perubahan</button></div></form></div></div><% }) %>
<div class="modal fade" id="rotationModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><form class="modal-content" method="post" action="/server-duty/generate-rotation"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="modal-header"><div><div class="module-kicker">WEEKLY ROTATION</div><h5 class="modal-title">Generate Rotasi Piket</h5></div><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="rotation-preview"><span>Urutan:</span><strong>Padilah → Jon → Bopung → Edwin → Agung</strong><small>1 orang bertanggung jawab penuh selama 1 minggu, lalu berganti ke orang berikutnya.</small></div><div class="row g-3 mt-1"><div class="col-7"><label class="form-label">Mulai Minggu</label><input class="form-control" type="date" name="start_week" value="<%= weekStart %>" required></div><div class="col-5"><label class="form-label">Jumlah Minggu</label><input class="form-control" type="number" name="weeks" min="1" max="20" value="5"></div></div></div><div class="modal-footer"><button class="btn-tech" type="button" data-bs-dismiss="modal">Batal</button><button class="btn-tech primary"><i class="bi bi-arrow-repeat"></i>Generate</button></div></form></div></div>
