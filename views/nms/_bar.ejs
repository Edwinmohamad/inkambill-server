<% const q=siteId?'?site='+siteId:''; const titles={secrets:'Sinkronisasi PPPoE',insights:'Rekonsiliasi Pelanggan',history:'Riwayat Sinkronisasi'}; %>
<header class="nx-head">
  <div class="nx-title"><div class="nx-eyebrow"><span id="nmsUpdated">Data diperbarui saat Tarik Data PPPoE</span></div><h1><%= titles[nmsPage]||'Sinkronisasi PPPoE' %></h1></div>
  <div class="nx-head-tools">
    <button type="button" class="nx-search-btn" id="nxOpenPalette" aria-label="Cari pelanggan"><i class="bi bi-search"></i><span>Cari pelanggan atau username</span></button>
    <select id="nmsSiteSelect" class="nx-select" aria-label="Pilih site"><option value="">Semua site</option><% (sites||[]).forEach(site=>{ %><option value="<%= site.id %>" <%= Number(siteId)===Number(site.id)?'selected':'' %>><%= site.code %> · <%= site.name %></option><% }) %></select>
  </div>
</header>
<nav class="nx-nav" aria-label="Sinkronisasi dan rekonsiliasi">
  <div class="nx-seg">
    <a href="/nms/secrets<%= q %>" class="<%= nmsPage==='secrets'||nmsPage==='history'?'active':'' %>"><i class="bi bi-arrow-repeat"></i>Sinkronisasi PPPoE</a>
    <a href="/nms/insights<%= q %>" class="<%= nmsPage==='insights'?'active':'' %>"><i class="bi bi-arrow-left-right"></i>Rekonsiliasi<span class="count" id="nxReconCount" hidden></span></a>
  </div><span class="grow"></span>
  <a href="/nms/sync-history<%= q %>" class="nx-btn ghost sm">Riwayat Sinkronisasi</a>
  <button type="button" class="nx-btn ghost sm icon nx-hide-sm" id="nxShortcuts" aria-label="Pintasan keyboard"><i class="bi bi-keyboard"></i></button>
</nav>
<div class="nx-banner" id="nmsOfflineBadge" role="status">Sebagian router gagal diperbarui. Data sebelumnya tetap ditampilkan.</div>
