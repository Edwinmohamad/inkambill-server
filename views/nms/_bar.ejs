<%
  const q = siteId ? `?site=${siteId}` : '';
  const titles = { dashboard: 'Ringkasan Jaringan', secrets: 'PPP Secrets', insights: 'Rekonsiliasi', automation: 'Otomasi' };
  const siteObj = (sites || []).find(s => Number(s.id) === Number(siteId));
%>
<header class="nx-head">
  <div class="nx-title">
    <div class="nx-eyebrow"><span class="nx-live connecting" id="nmsLive" title="Status koneksi real-time"><i></i><span>Menghubungkan</span></span><span>·</span><span id="nmsUpdated">Memuat…</span></div>
    <h1><%= titles[nmsPage] || 'MikroTik NMS' %><% if (siteObj) { %> <span class="nx-h1-site">· <%= siteObj.code %></span><% } %></h1>
  </div>
  <div class="nx-head-tools">
    <button type="button" class="nx-search-btn" id="nxOpenPalette" aria-label="Cari pelanggan"><i class="bi bi-search"></i><span>Cari pelanggan, username, IP</span><kbd class="nx-kbd-mod">Ctrl K</kbd></button>
    <select id="nmsSiteSelect" class="nx-select" aria-label="Pilih site">
      <option value="">Semua site</option>
      <% (sites || []).forEach(s => { %><option value="<%= s.id %>" <%= Number(siteId) === Number(s.id) ? 'selected' : '' %>><%= s.code %> · <%= s.name %></option><% }) %>
    </select>
  </div>
</header>
<nav class="nx-nav" aria-label="Menu NMS">
  <div class="nx-seg">
    <a href="/nms<%= q %>" class="<%= nmsPage === 'dashboard' ? 'active' : '' %>"><i class="bi bi-speedometer2"></i>Ringkasan</a>
    <a href="/nms/secrets<%= q %>" class="<%= nmsPage === 'secrets' ? 'active' : '' %>"><i class="bi bi-person-lines-fill"></i>PPP Secrets</a>
    <a href="/nms/insights<%= q %>" class="<%= nmsPage === 'insights' ? 'active' : '' %>"><i class="bi bi-arrow-left-right"></i>Rekonsiliasi<span class="count" id="nxReconCount" hidden></span></a>
    <a href="/nms/automation<%= q %>" class="<%= nmsPage === 'automation' ? 'active' : '' %>"><i class="bi bi-clock-history"></i>Otomasi<span class="count" id="nxApprovalCount" hidden></span></a>
  </div>
  <span class="grow"></span>
  <% if (nmsPage === 'dashboard') { %><button type="button" class="nx-btn ghost sm" id="nxCustomize" title="Atur widget dashboard"><i class="bi bi-sliders"></i><span class="nx-hide-sm">Atur</span></button><button type="button" class="nx-btn ghost sm" id="nmsNocMode" title="Layar penuh untuk layar NOC (F)"><i class="bi bi-arrows-fullscreen"></i><span class="nx-hide-sm">Layar penuh</span></button><% } %>
  <button type="button" class="nx-btn ghost sm icon nx-hide-sm" id="nxShortcuts" title="Pintasan keyboard" aria-label="Pintasan keyboard"><i class="bi bi-keyboard"></i></button>
</nav>
<div class="nx-banner" id="nmsOfflineBadge" role="status"><i class="bi bi-exclamation-triangle-fill"></i><span>Sebagian router tidak terjangkau. Data yang tampil berasal dari cache terakhir.</span></div>
