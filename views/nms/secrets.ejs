<link rel="stylesheet" href="/css/nms-noc.css?v=<%= assetVersion %>">
<section class="nms-noc" id="nmsSecrets" data-site="<%= siteId || '' %>" data-csrf="<%= csrfToken %>" data-can-control="<%= canControl?'1':'0' %>" data-tab="<%= tab %>" data-routers-offline="<%= routersOffline %>">
  <%- include('_bar') %>

  <div class="nms-kpis">
    <div class="nms-kpi green"><small>Online</small><strong id="cOnline"><%= counts.online %></strong><em>sesi aktif</em></div>
    <div class="nms-kpi yellow"><small>Offline</small><strong id="cOffline"><%= counts.offline %></strong><em>tanpa sesi</em></div>
    <div class="nms-kpi red"><small>Terisolir</small><strong id="cIsolated"><%= counts.isolated %></strong><em>profile <%= isolirProfile %> · mode <%= isolirMode %></em></div>
    <div class="nms-kpi blue"><small>Synced</small><strong id="cSyncPct"><%= counts.syncedPct %>%</strong><em><span id="cSynced"><%= counts.synced %></span> dari <%= counts.synced + counts.unsynced %> secret billable</em></div>
    <div class="nms-kpi"><small>Exempt</small><strong id="cExempt"><%= counts.exempt %></strong><em>[ADMIN] / [FREE]</em></div>
  </div>

  <article class="nms-card">
    <div class="nms-toolbar">
      <div class="nms-subtabs" role="tablist">
        <button type="button" role="tab" data-tab="synced" class="<%= tab==='synced'?'active':'' %>">Synced PPP Secrets <b id="tabSynced"><%= counts.synced %></b></button>
        <button type="button" role="tab" data-tab="unsynced" class="<%= tab==='unsynced'?'active':'' %>">Unsynced PPP Secrets <b id="tabUnsynced"><%= counts.unsynced %></b></button>
      </div>
      <span class="nms-bar-spacer"></span>
      <input type="search" id="fQ" placeholder="Cari nama / username / IP…" aria-label="Cari" style="width:220px">
      <select id="fStatus" aria-label="Filter status"><option value="">Semua status</option><option value="online">Online</option><option value="offline">Offline</option><option value="isolated">Terisolir</option></select>
      <label class="dim" id="fExemptWrap" style="font-size:11px;display:none"><input type="checkbox" id="fExempt"> tampilkan exempt</label>
      <% if(canControl){ %>
      <button type="button" class="nms-btn" id="btnRefresh" title="Tarik ulang PPP secret dari RouterOS"><i class="bi bi-arrow-repeat"></i>Tarik dari Router</button>
      <button type="button" class="nms-btn primary" id="btnSmartSync"><i class="bi bi-magic"></i>Smart Sync</button>
      <button type="button" class="nms-btn red" id="btnSiteIsolir" title="Isolir masal berdasarkan Site / jatuh tempo"><i class="bi bi-slash-circle"></i>Isolir by Site</button>
      <% } %>
    </div>

    <% if(canControl){ %>
    <div class="nms-bulkbar" id="bulkBar">
      <b><span id="bulkCount">0</span> dipilih</b>
      <button type="button" class="nms-btn xs red" data-bulk="isolate"><i class="bi bi-slash-circle"></i>Bulk Isolir</button>
      <button type="button" class="nms-btn xs green" data-bulk="unisolate"><i class="bi bi-check2-circle"></i>Bulk Un-Isolir</button>
      <button type="button" class="nms-btn xs yellow" data-bulk="kick"><i class="bi bi-plug"></i>Bulk Kick</button>
      <select id="bulkProfile" aria-label="Profile tujuan"><option value="">Ganti profile ke…</option></select>
      <button type="button" class="nms-btn xs" data-bulk="profile"><i class="bi bi-speedometer2"></i>Apply Profile</button>
      <span class="nms-bar-spacer"></span>
      <button type="button" class="nms-btn xs" id="bulkClear">Batal pilih</button>
    </div>
    <% } %>

    <div class="nms-table-wrap" style="max-height:calc(100vh - 360px);min-height:300px">
      <table class="nms-table">
        <thead id="tHead"></thead>
        <tbody id="tBody"><tr><td class="nms-empty" colspan="9">Memuat…</td></tr></tbody>
      </table>
    </div>
    <div class="nms-pager"><span id="pgInfo">—</span><span><button type="button" class="nms-btn xs" id="pgPrev">‹ Prev</button> <button type="button" class="nms-btn xs" id="pgNext">Next ›</button></span></div>
  </article>

  <!-- Smart Sync Preview -->
  <div class="nms-modal" id="mSync" aria-hidden="true"><div class="nms-modal-box" role="dialog" aria-modal="true" aria-labelledby="mSyncTitle">
    <div class="nms-modal-head"><h4 id="mSyncTitle"><i class="bi bi-magic"></i> Smart Sync Preview (Dry-Run)</h4><button type="button" data-close aria-label="Tutup">&times;</button></div>
    <div class="nms-modal-body" id="mSyncBody"><div class="nms-empty">Menganalisis…</div></div>
    <div class="nms-modal-foot"><small class="dim" style="margin-right:auto" id="mSyncExpire"></small><button type="button" class="nms-btn" data-close>Cancel</button><button type="button" class="nms-btn green" id="mSyncCommit" disabled><i class="bi bi-check2-all"></i>Confirm &amp; Commit Sync</button></div>
  </div></div>

  <!-- Manual Mapping -->
  <div class="nms-modal" id="mMap" aria-hidden="true"><div class="nms-modal-box sm" role="dialog" aria-modal="true" aria-labelledby="mMapTitle">
    <div class="nms-modal-head"><h4 id="mMapTitle"><i class="bi bi-link-45deg"></i> Map to Customer</h4><button type="button" data-close aria-label="Tutup">&times;</button></div>
    <div class="nms-modal-body">
      <div class="nms-field"><label>PPP Secret</label><div class="mono" id="mMapSecret">—</div></div>
      <div class="nms-field"><label>Site</label><select id="mMapSite"><% sites.forEach(s=>{ %><option value="<%= s.id %>"><%= s.code %> · <%= s.name %></option><% }) %></select></div>
      <div class="nms-field nms-ac"><label>Pelanggan (ID / nama / HP)</label><input type="text" id="mMapQ" autocomplete="off" placeholder="Ketik min. 2 huruf…" autofocus><div class="nms-ac-list" id="mMapList" hidden></div></div>
      <div class="dim" id="mMapPicked">Belum memilih pelanggan.</div>
    </div>
    <div class="nms-modal-foot"><button type="button" class="nms-btn" data-close>Batal</button><button type="button" class="nms-btn primary" id="mMapSave" disabled>Simpan Mapping</button></div>
  </div></div>

  <!-- Isolir by Site / Jatuh Tempo -->
  <div class="nms-modal" id="mSiteBulk" aria-hidden="true"><div class="nms-modal-box sm" role="dialog" aria-modal="true">
    <div class="nms-modal-head"><h4><i class="bi bi-slash-circle"></i> Aksi Masal per Site</h4><button type="button" data-close aria-label="Tutup">&times;</button></div>
    <div class="nms-modal-body">
      <div class="nms-field"><label>Aksi</label><select id="sbAction"><option value="isolate">Isolir</option><option value="unisolate">Un-Isolir</option><option value="profile">Ganti Profile</option></select></div>
      <div class="nms-field"><label>Site</label><select id="sbSite"><% sites.forEach(s=>{ %><option value="<%= s.id %>" <%= Number(siteId)===Number(s.id)?'selected':'' %>><%= s.code %> · <%= s.name %></option><% }) %></select></div>
      <div class="nms-field" id="sbProfileWrap" hidden><label>Profile tujuan</label><select id="sbProfile"></select></div>
      <label style="display:flex;gap:6px;align-items:center;font-size:12px"><input type="checkbox" id="sbOverdue" checked> Hanya pelanggan lewat jatuh tempo (invoice outstanding)</label>
      <div class="nms-stat" style="margin-top:10px"><small>Target (dry-run)</small><b id="sbCount">—</b></div>
    </div>
    <div class="nms-modal-foot"><button type="button" class="nms-btn" id="sbPreview">Hitung Target</button><button type="button" class="nms-btn red" id="sbRun" disabled>Eksekusi</button></div>
  </div></div>

  <div class="nms-toasts" id="nmsToasts"></div>
</section>
<script src="/js/nms-common.js?v=<%= assetVersion %>" defer></script>
<script src="/js/nms-secrets.js?v=<%= assetVersion %>" defer></script>
