<link rel="stylesheet" href="/css/nms-noc.css?v=<%= assetVersion %>">
<section class="nx" id="nmsSecrets" data-site="<%= siteId || '' %>" data-csrf="<%= csrfToken %>" data-can-control="<%= canControl ? '1' : '0' %>" data-is-admin="<%= isAdmin ? '1' : '0' %>" data-tab="<%= tab %>" data-routers-offline="<%= routersOffline %>" data-focus="<%= focus || '' %>">
  <%- include('_bar') %>

  <div class="nx-stats sync-stats">
    <div class="nx-stat"><small>Terhubung</small><strong id="cSynced"><%= counts.synced %></strong></div>
    <div class="nx-stat"><small>Belum terhubung</small><strong id="cUnsynced"><%= counts.unsynced %></strong></div>
    <div class="nx-stat"><small>Tersinkron</small><strong id="cSyncPct"><%= counts.syncedPct %>%</strong></div>
  </div>

  <article class="nx-card flush">
    <div class="nx-toolbar">
      <div class="nx-seg" role="tablist">
        <button type="button" role="tab" data-tab="synced" class="<%= tab === 'synced' ? 'active' : '' %>">Ter-link <span class="count" id="tabSynced"><%= counts.synced %></span></button>
        <button type="button" role="tab" data-tab="unsynced" class="<%= tab === 'unsynced' ? 'active' : '' %>">Belum ter-link <span class="count" id="tabUnsynced"><%= counts.unsynced %></span></button>
      </div>
      <label class="nx-search"><i class="bi bi-search"></i><input type="search" id="fQ" placeholder="Nama atau username PPPoE" aria-label="Cari"></label>
      <span class="grow"></span>
      <% if (canControl) { %>
      <button type="button" class="nx-btn" id="btnRefresh" title="Tarik ulang PPP secret dari RouterOS"><i class="bi bi-arrow-repeat"></i>Tarik dari router</button>
      <button type="button" class="nx-btn" id="btnExcel" title="Import / Export mapping PPP via Excel"><i class="bi bi-file-earmark-spreadsheet"></i>Excel</button>
      <button type="button" class="nx-btn primary" id="btnSmartSync"><i class="bi bi-magic"></i>Smart Sync</button>
      <% } %>
      <button type="button" class="nx-btn icon" id="btnMore" aria-label="Menu lain"><i class="bi bi-three-dots"></i></button>
    </div>
    <div class="nx-toolbar" style="padding-top:0">
      <div class="nx-chips" id="fViews"></div>
      <span class="grow"></span>
      <label class="nx-check dim" id="fExemptWrap" hidden><input type="checkbox" id="fExempt"> Tampilkan exempt</label>
    </div>
    <div class="nx-table-wrap" style="max-height:calc(100vh - 330px);min-height:320px">
      <table class="nx-table cards" id="nxTable">
        <thead id="tHead"></thead>
        <tbody id="tBody"><tr><td class="nx-empty" colspan="9">Memuat…</td></tr></tbody>
      </table>
    </div>
    <div class="nx-pager"><span id="pgInfo">—</span><span style="display:flex;gap:6px"><button type="button" class="nx-btn sm" id="pgPrev"><i class="bi bi-chevron-left"></i></button><button type="button" class="nx-btn sm" id="pgNext"><i class="bi bi-chevron-right"></i></button></span></div>
  </article>


  <div class="nx-toasts"></div>
</section>
<script src="/js/nms-common.js?v=<%= assetVersion %>" defer></script>
<script src="/js/nms-secrets.js?v=<%= assetVersion %>" defer></script>
