<link rel="stylesheet" href="/css/nms-noc.css?v=<%= assetVersion %>">
<section class="nx" id="nmsSecrets" data-site="<%= siteId || '' %>" data-csrf="<%= csrfToken %>" data-can-control="<%= canControl ? '1' : '0' %>" data-is-admin="<%= isAdmin ? '1' : '0' %>" data-tab="<%= tab %>" data-routers-offline="<%= routersOffline %>" data-focus="<%= focus || '' %>">
  <%- include('_bar') %>

  <div class="nx-stats">
    <div class="nx-stat green"><small><i></i>Online</small><strong id="cOnline"><%= counts.online %></strong><em>sesi aktif</em></div>
    <div class="nx-stat"><small><i></i>Offline</small><strong id="cOffline"><%= counts.offline %></strong><em>tanpa sesi</em></div>
    <div class="nx-stat red"><small><i></i>Diisolir</small><strong id="cIsolated"><%= counts.isolated %></strong><em>profile <%= isolirProfile %> · mode <%= isolirMode %></em></div>
    <div class="nx-stat blue"><small><i></i>Ter-link</small><strong id="cSyncPct"><%= counts.syncedPct %>%</strong><em><span id="cSynced"><%= counts.synced %></span> dari <%= counts.synced + counts.unsynced %> secret</em></div>
    <div class="nx-stat purple"><small><i></i>Fasum</small><strong id="cFasum"><%= counts.fasum || 0 %></strong><em><span id="cFasumOff"><%= counts.fasumOffline || 0 %></span> offline · tidak ditagih</em></div>
    <div class="nx-stat"><small><i></i>Exempt</small><strong id="cExempt"><%= counts.exempt - (counts.fasum || 0) %></strong><em>akun admin / gratis</em></div>
  </div>

  <article class="nx-card flush">
    <div class="nx-toolbar">
      <div class="nx-seg" role="tablist">
        <button type="button" role="tab" data-tab="synced" class="<%= tab === 'synced' ? 'active' : '' %>">Ter-link <span class="count" id="tabSynced"><%= counts.synced %></span></button>
        <button type="button" role="tab" data-tab="unsynced" class="<%= tab === 'unsynced' ? 'active' : '' %>">Belum ter-link <span class="count" id="tabUnsynced"><%= counts.unsynced %></span></button>
      </div>
      <label class="nx-search"><i class="bi bi-search"></i><input type="search" id="fQ" placeholder="Nama, username, IP  ( / )" aria-label="Cari"></label>
      <span class="grow"></span>
      <% if (canControl) { %>
      <button type="button" class="nx-btn" id="btnRefresh" title="Tarik ulang PPP secret dari RouterOS"><i class="bi bi-arrow-repeat"></i>Tarik dari router</button>
      <button type="button" class="nx-btn" id="btnExcel" title="Import / Export mapping PPP via Excel"><i class="bi bi-file-earmark-spreadsheet"></i>Excel</button>
      <button type="button" class="nx-btn primary" id="btnSmartSync"><i class="bi bi-magic"></i>Smart Sync</button>
      <% } %>
      <button type="button" class="nx-btn icon" id="btnMore" aria-label="Menu lain"><i class="bi bi-three-dots"></i></button>
    </div>
    <div class="nx-toolbar" style="padding-top:0">
      <div class="nx-chips" id="fViews"></div>
      <span class="grow"></span>
      <label class="nx-check dim" id="fExemptWrap" hidden><input type="checkbox" id="fExempt"> Tampilkan exempt</label>
    </div>
    <div class="nx-table-wrap" style="max-height:calc(100vh - 330px);min-height:320px">
      <table class="nx-table cards" id="nxTable">
        <thead id="tHead"></thead>
        <tbody id="tBody"><tr><td class="nx-empty" colspan="9">Memuat…</td></tr></tbody>
      </table>
    </div>
    <div class="nx-pager"><span id="pgInfo">—</span><span style="display:flex;gap:6px"><button type="button" class="nx-btn sm" id="pgPrev"><i class="bi bi-chevron-left"></i></button><button type="button" class="nx-btn sm" id="pgNext"><i class="bi bi-chevron-right"></i></button></span></div>
  </article>

  <% if (canControl) { %>
  <div class="nx-bulk" id="bulkBar" role="toolbar" aria-label="Aksi masal">
    <b><span id="bulkCount">0</span> dipilih</b>
    <button type="button" class="nx-btn sm red" data-bulk="isolate"><i class="bi bi-slash-circle"></i>Isolir</button>
    <button type="button" class="nx-btn sm green" data-bulk="unisolate"><i class="bi bi-check2-circle"></i>Buka</button>
    <button type="button" class="nx-btn sm" data-bulk="kick"><i class="bi bi-plug"></i>Kick</button>
    <button type="button" class="nx-btn sm" data-bulk="profile"><i class="bi bi-speedometer"></i>Profile</button>
    <button type="button" class="nx-btn sm" data-bulk="schedule"><i class="bi bi-calendar-event"></i>Jadwalkan</button>
    <button type="button" class="nx-btn sm" data-bulk="fasum" title="Tandai sebagai fasilitas umum"><i class="bi bi-building"></i>Fasum</button>
    <span class="sep"></span>
    <button type="button" class="nx-btn sm icon" id="bulkClear" aria-label="Batal pilih"><i class="bi bi-x-lg"></i></button>
  </div>
  <% } %>
  <div class="nx-toasts"></div>
</section>
<script src="/js/nms-common.js?v=<%= assetVersion %>" defer></script>
<script src="/js/nms-secrets.js?v=<%= assetVersion %>" defer></script>
