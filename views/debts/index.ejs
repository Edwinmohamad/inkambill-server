<div class="debt-page debt-page-v2">
  <header class="page-header debt-head">
    <div><div class="debt-eyebrow">KEUANGAN · MONITORING</div><h1>Hutang & Piutang</h1><p class="text-muted mb-0">Pantau kewajiban, tagihan masuk, jatuh tempo, pembayaran, dan sisa secara terpisah dari Closing.</p></div>
    <details class="debt-create-panel">
      <summary class="btn-tech primary"><i class="bi bi-plus-lg"></i>Catat Baru</summary>
      <form method="post" action="/debts" class="debt-create-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label><span>Jenis</span><select class="form-select form-select-sm" name="record_type" required><option value="DEBT">Hutang INKAMNET</option><option value="RECEIVABLE">Piutang / belum diterima</option></select></label>
        <label><span>Lokasi</span><select class="form-select form-select-sm" name="site_code" required><option value="GLOBAL">Global</option><option value="CDS">CDS</option><option value="KBG">KBG</option></select></label>
        <label class="span-2"><span>Nama pihak</span><input class="form-control form-control-sm" name="party_name" maxlength="160" placeholder="Vendor / pemberi hutang / pemegang cash" required></label>
        <label class="span-2"><span>Keperluan</span><input class="form-control form-control-sm" name="purpose" maxlength="255" placeholder="Contoh: pembelian router" required></label>
        <label><span>Metode</span><select class="form-select form-select-sm" name="payment_method" id="debtPaymentMethod"><option value="ONCE">Sekali bayar</option><option value="INSTALLMENT">Cicilan</option></select></label>
        <label id="debtInstallmentMonths" hidden><span>Durasi cicilan</span><select class="form-select form-select-sm" name="installment_months"><option value="3">3 bulan</option><option value="6">6 bulan</option><option value="12">12 bulan</option><option value="18">18 bulan</option><option value="24">24 bulan</option></select></label>
        <label><span>Tanggal dicatat</span><input class="form-control form-control-sm" type="date" name="issue_date" value="<%= today %>" required></label>
        <label><span>Jatuh tempo pertama</span><input class="form-control form-control-sm" type="date" name="due_date"></label>
        <label class="span-2"><span>Penanggung jawab</span><input class="form-control form-control-sm" name="responsible_name" maxlength="160" placeholder="Edwin / Jon / Bopung / bersama"></label>
        <label class="span-2"><span>Catatan</span><input class="form-control form-control-sm" name="notes" maxlength="2000" placeholder="Opsional"></label>
        <div class="debt-items-editor span-4"><div class="debt-items-head"><span>Rincian pembelian</span><button class="btn btn-outline-primary btn-sm" type="button" id="addDebtItem"><i class="bi bi-plus-lg"></i> Tambah item</button></div><div id="debtItemRows"><div class="debt-item-input"><input class="form-control form-control-sm" name="item_name[]" placeholder="Nama barang / keperluan" required><input class="form-control form-control-sm debt-item-qty" type="number" min="0.01" step="0.01" name="item_quantity[]" value="1" aria-label="Jumlah" required><input class="form-control form-control-sm debt-item-price" type="number" min="1" step="1" name="item_unit_price[]" placeholder="Harga satuan" required><input class="form-control form-control-sm" name="item_notes[]" placeholder="Catatan item"><button class="btn btn-link text-danger debt-remove-item" type="button" title="Hapus"><i class="bi bi-trash"></i></button><strong class="debt-item-subtotal">Rp 0</strong></div></div><div class="debt-items-total"><span>Total otomatis</span><strong id="debtItemsTotal">Rp 0</strong></div></div>
        <div class="debt-form-action span-4"><button class="btn btn-primary btn-sm" type="submit"><i class="bi bi-save2 me-1"></i>Simpan</button></div>
      </form>
    </details>
  </header>

  <% const totalOutstanding=summary.DEBT.remaining+summary.RECEIVABLE.remaining; const totalOverdue=summary.DEBT.overdue+summary.RECEIVABLE.overdue; %>
  <section class="debt-summary" aria-label="Ringkasan hutang dan piutang">
    <article class="debt-summary-card debt"><div class="debt-summary-icon"><i class="bi bi-arrow-down-left"></i></div><div class="debt-summary-copy"><span>Sisa Hutang</span><strong>Rp <%= summary.DEBT.remaining.toLocaleString('id-ID') %></strong><small><b><%= summary.DEBT.total %></b> kewajiban aktif</small></div><a href="/debts?type=DEBT&status=ACTIVE" aria-label="Lihat hutang"><i class="bi bi-arrow-right"></i></a></article>
    <article class="debt-summary-card receivable"><div class="debt-summary-icon"><i class="bi bi-arrow-up-right"></i></div><div class="debt-summary-copy"><span>Sisa Piutang</span><strong>Rp <%= summary.RECEIVABLE.remaining.toLocaleString('id-ID') %></strong><small><b><%= summary.RECEIVABLE.total %></b> tagihan aktif</small></div><a href="/debts?type=RECEIVABLE&status=ACTIVE" aria-label="Lihat piutang"><i class="bi bi-arrow-right"></i></a></article>
    <article class="debt-summary-card is-alert"><div class="debt-summary-icon"><i class="bi bi-exclamation-triangle"></i></div><div class="debt-summary-copy"><span>Lewat Jatuh Tempo</span><strong>Rp <%= totalOverdue.toLocaleString('id-ID') %></strong><small><%= totalOverdue>0?'Perlu segera ditindaklanjuti':'Semua pembayaran terkendali' %></small></div><span class="debt-health-dot <%= totalOverdue>0?'danger':'safe' %>"></span></article>
  </section>

  <form class="debt-filter" method="get" action="/debts" data-auto-filter>
    <div class="debt-filter-search"><i class="bi bi-search"></i><input class="form-control" name="q" value="<%= filters.query %>" maxlength="100" autocomplete="off" placeholder="Cari nama pihak, keperluan, atau penanggung jawab…"></div>
    <label><span>Jenis</span><select class="form-select" name="type" aria-label="Jenis"><option value="">Semua jenis</option><option value="DEBT" <%= filters.type==='DEBT'?'selected':'' %>>Hutang</option><option value="RECEIVABLE" <%= filters.type==='RECEIVABLE'?'selected':'' %>>Piutang</option></select></label>
    <label><span>Lokasi</span><select class="form-select" name="site" aria-label="Lokasi"><option value="">Semua lokasi</option><option value="GLOBAL" <%= filters.site==='GLOBAL'?'selected':'' %>>Global</option><option value="CDS" <%= filters.site==='CDS'?'selected':'' %>>CDS</option><option value="KBG" <%= filters.site==='KBG'?'selected':'' %>>KBG</option></select></label>
    <label><span>Status</span><select class="form-select" name="status" aria-label="Status"><option value="ACTIVE" <%= filters.status==='ACTIVE'?'selected':'' %>>Aktif</option><option value="PAID" <%= filters.status==='PAID'?'selected':'' %>>Lunas</option><option value="ARCHIVED" <%= filters.status==='ARCHIVED'?'selected':'' %>>Arsip</option></select></label>
    <% if(filters.type||filters.site||filters.status!=='ACTIVE'||filters.query){ %><a class="debt-filter-reset" href="/debts" title="Reset filter"><i class="bi bi-arrow-counterclockwise"></i><span>Reset</span></a><% } %>
  </form>

  <section class="debt-list">
    <% if (!records.length) { %><div class="debt-empty"><i class="bi bi-journal-check"></i><strong>Belum ada data</strong><span>Catat hutang atau piutang menggunakan tombol di atas.</span></div><% } %>
    <% records.forEach(row => { const remaining=Number(row.remaining_amount||0); const paid=Number(row.paid_amount||0); const principal=Number(row.principal_amount||0); const progress=principal>0?Math.min(100,Math.round(paid/principal*100)):0; %>
      <article class="debt-item <%= row.is_overdue ? 'is-overdue' : '' %>" data-debt-search="<%= [row.party_name,row.purpose,row.responsible_name,row.site_code].filter(Boolean).join(' ') %>">
        <div class="debt-item-accent <%= row.record_type==='DEBT'?'debt':'receivable' %>"></div>
        <div class="debt-item-main">
          <div class="debt-item-icon"><i class="bi <%= row.record_type==='DEBT'?'bi-arrow-down-left':'bi-arrow-up-right' %>"></i></div>
          <div class="debt-item-copy">
            <div class="debt-item-title"><strong><%= row.party_name %></strong><span class="badge <%= row.record_type==='DEBT'?'text-bg-warning':'text-bg-info' %>"><%= row.record_type==='DEBT'?'HUTANG':'PIUTANG' %></span><span class="debt-site"><%= row.site_code %></span></div>
            <p><%= row.purpose %></p>
            <div class="debt-meta"><span><i class="bi bi-person"></i><%= row.responsible_name || 'Belum ditentukan' %></span><span><i class="bi bi-calendar3"></i><%= row.due_date || 'Tanpa jatuh tempo' %></span><span><i class="bi bi-credit-card"></i><%= row.payment_method==='INSTALLMENT'?'Cicilan':'Sekali bayar' %></span></div>
          </div>
          <div class="debt-money-grid"><div><span>Total</span><strong>Rp <%= principal.toLocaleString('id-ID') %></strong></div><div><span>Terbayar</span><strong class="paid">Rp <%= paid.toLocaleString('id-ID') %></strong></div><div class="remaining"><span>Sisa</span><strong>Rp <%= remaining.toLocaleString('id-ID') %></strong></div></div>
        </div>
        <div class="debt-progress-wrap"><div><span>Progres pembayaran</span><b><%= progress %>%</b></div><div class="debt-progress"><span style="width:<%= progress %>%"></span></div></div>
        <details class="debt-breakdown"><summary><span><i class="bi bi-list-check"></i>Rincian & jadwal cicilan</span><i class="bi bi-chevron-down"></i></summary><div class="debt-breakdown-grid"><div><h4>Rincian nominal</h4><% if(!(row.items||[]).length){ %><small class="text-muted">Data lama belum memiliki rincian item.</small><% } %><% (row.items||[]).forEach(item=>{ %><div class="debt-breakdown-line"><span><%= item.item_name %><small><%= Number(item.quantity).toLocaleString('id-ID') %> × Rp <%= Number(item.unit_price).toLocaleString('id-ID') %></small></span><strong>Rp <%= Math.round(Number(item.quantity)*Number(item.unit_price)).toLocaleString('id-ID') %></strong></div><% }) %></div><div><h4>Jadwal <%= row.payment_method==='INSTALLMENT'?`${row.installment_months} bulan`:'pembayaran' %></h4><% (row.installments||[]).forEach(item=>{ %><div class="debt-installment-line status-<%= item.status.toLowerCase() %>"><span><b><%= item.number %></b><%= item.dueDate %></span><strong>Rp <%= item.target.toLocaleString('id-ID') %><small><%= item.status==='PAID'?'Lunas':item.status==='PARTIAL'?`Sisa Rp ${item.remaining.toLocaleString('id-ID')}`:item.status==='OVERDUE'?'Terlambat':'Akan datang' %></small></strong></div><% }) %></div></div></details>
        <div class="debt-item-foot">
          <span class="debt-due-state <%= row.is_overdue?'danger':'safe' %>"><i class="bi <%= row.is_overdue?'bi-exclamation-circle-fill':'bi-calendar2-check' %>"></i><% if(row.is_overdue){ %>Terlambat<% } else if(row.days_to_due!==null && row.days_to_due>=0){ %><%= row.days_to_due %> hari menuju jatuh tempo<% }else{ %>Tanpa jatuh tempo<% } %></span>
          <div class="debt-actions">
          <% if ((row.payments || []).length) { %><details class="debt-history"><summary class="btn btn-link btn-sm">Riwayat (<%= row.payments.length %>)</summary><div class="debt-history-list"><% row.payments.forEach(payment => { %><div><span><strong>Rp <%= Number(payment.amount).toLocaleString('id-ID') %></strong><small><%= payment.payment_date %><%= payment.notes ? ` · ${payment.notes}` : '' %></small></span><% if(row.status!=='ARCHIVED'){ %><form method="post" action="/debts/<%= row.id %>/payments/<%= payment.id %>/delete" onsubmit="return confirm('Hapus pembayaran ini? Sisa akan dihitung ulang.')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-link btn-sm text-danger" type="submit" title="Hapus pembayaran"><i class="bi bi-trash"></i></button></form><% } %></div><% }) %></div></details><% } %>
          <% if (row.status==='ACTIVE') { %><details class="debt-pay"><summary class="btn btn-outline-primary btn-sm">Catat pembayaran</summary><form method="post" action="/debts/<%= row.id %>/payments"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input class="form-control form-control-sm" type="date" name="payment_date" value="<%= today %>" required><input class="form-control form-control-sm" type="number" min="1" max="<%= Math.floor(remaining) %>" name="amount" placeholder="Nominal" required><input class="form-control form-control-sm" name="notes" maxlength="500" placeholder="Catatan"><button class="btn btn-primary btn-sm" type="submit">Simpan</button></form></details><% } %>
          <% if (row.status!=='ARCHIVED') { %><form method="post" action="/debts/<%= row.id %>/archive" onsubmit="return confirm('Arsipkan data ini? Riwayat pembayaran tetap tersimpan.')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-link btn-sm text-muted" type="submit">Arsipkan</button></form><% } %>
          </div>
        </div>
      </article>
    <% }) %>
  </section>

  <div class="debt-note"><i class="bi bi-info-circle"></i><span>Modul ini tidak otomatis masuk ke Closing. Hanya pembayaran pada periode tersebut yang Anda input sebagai pengeluaran Closing agar tidak dihitung dua kali.</span></div>
</div>

<template id="debtItemTemplate"><div class="debt-item-input"><input class="form-control form-control-sm" name="item_name[]" placeholder="Nama barang / keperluan" required><input class="form-control form-control-sm debt-item-qty" type="number" min="0.01" step="0.01" name="item_quantity[]" value="1" aria-label="Jumlah" required><input class="form-control form-control-sm debt-item-price" type="number" min="1" step="1" name="item_unit_price[]" placeholder="Harga satuan" required><input class="form-control form-control-sm" name="item_notes[]" placeholder="Catatan item"><button class="btn btn-link text-danger debt-remove-item" type="button" title="Hapus"><i class="bi bi-trash"></i></button><strong class="debt-item-subtotal">Rp 0</strong></div></template>
<script>(()=>{const method=document.getElementById('debtPaymentMethod'),months=document.getElementById('debtInstallmentMonths'),rows=document.getElementById('debtItemRows'),template=document.getElementById('debtItemTemplate'),total=document.getElementById('debtItemsTotal');if(!rows)return;const rupiah=value=>`Rp ${Math.round(value||0).toLocaleString('id-ID')}`;const calculate=()=>{let sum=0;rows.querySelectorAll('.debt-item-input').forEach(row=>{const subtotal=(Number(row.querySelector('.debt-item-qty')?.value)||0)*(Number(row.querySelector('.debt-item-price')?.value)||0);row.querySelector('.debt-item-subtotal').textContent=rupiah(subtotal);sum+=subtotal;});total.textContent=rupiah(sum);};const bind=row=>{row.querySelectorAll('input').forEach(input=>input.addEventListener('input',calculate));row.querySelector('.debt-remove-item')?.addEventListener('click',()=>{if(rows.children.length>1)row.remove();else row.querySelectorAll('input').forEach((input,index)=>input.value=index===1?'1':'');calculate();});};rows.querySelectorAll('.debt-item-input').forEach(bind);document.getElementById('addDebtItem')?.addEventListener('click',()=>{const row=template.content.firstElementChild.cloneNode(true);rows.appendChild(row);bind(row);row.querySelector('input')?.focus();});const toggleMethod=()=>{months.hidden=method.value!=='INSTALLMENT';};method?.addEventListener('change',toggleMethod);toggleMethod();calculate();const search=document.querySelector('.debt-filter input[name="q"]'),cards=[...document.querySelectorAll('.debt-item[data-debt-search]')];search?.addEventListener('input',()=>{const words=search.value.toLocaleLowerCase('id-ID').trim().split(/\s+/).filter(Boolean);cards.forEach(card=>{const haystack=card.dataset.debtSearch.toLocaleLowerCase('id-ID');card.hidden=words.length>0&&!words.every(word=>haystack.includes(word));});});})();</script>
