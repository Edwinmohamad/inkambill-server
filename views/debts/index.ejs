<div class="debt-page">
  <header class="page-header debt-head">
    <div><div class="debt-eyebrow">KEUANGAN · MONITORING</div><h1>Hutang & Piutang</h1><p class="text-muted mb-0">Pantau kewajiban, tagihan masuk, jatuh tempo, pembayaran, dan sisa secara terpisah dari Closing.</p></div>
    <details class="debt-create-panel">
      <summary class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>Catat baru</summary>
      <form method="post" action="/debts" class="debt-create-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label><span>Jenis</span><select class="form-select form-select-sm" name="record_type" required><option value="DEBT">Hutang INKAMNET</option><option value="RECEIVABLE">Piutang / belum diterima</option></select></label>
        <label><span>Lokasi</span><select class="form-select form-select-sm" name="site_code" required><option value="GLOBAL">Global</option><option value="CDS">CDS</option><option value="KBG">KBG</option></select></label>
        <label class="span-2"><span>Nama pihak</span><input class="form-control form-control-sm" name="party_name" maxlength="160" placeholder="Vendor / pemberi hutang / pemegang cash" required></label>
        <label class="span-2"><span>Keperluan</span><input class="form-control form-control-sm" name="purpose" maxlength="255" placeholder="Contoh: pembelian router" required></label>
        <label><span>Nominal awal</span><input class="form-control form-control-sm" type="number" min="1" step="1" name="principal_amount" placeholder="5000000" required></label>
        <label><span>Metode</span><select class="form-select form-select-sm" name="payment_method"><option value="ONCE">Sekali bayar</option><option value="INSTALLMENT">Cicilan</option></select></label>
        <label><span>Tanggal dicatat</span><input class="form-control form-control-sm" type="date" name="issue_date" value="<%= today %>" required></label>
        <label><span>Jatuh tempo</span><input class="form-control form-control-sm" type="date" name="due_date"></label>
        <label class="span-2"><span>Penanggung jawab</span><input class="form-control form-control-sm" name="responsible_name" maxlength="160" placeholder="Edwin / Jon / Bopung / bersama"></label>
        <label class="span-2"><span>Catatan</span><input class="form-control form-control-sm" name="notes" maxlength="2000" placeholder="Opsional"></label>
        <div class="debt-form-action span-4"><button class="btn btn-primary btn-sm" type="submit"><i class="bi bi-save2 me-1"></i>Simpan</button></div>
      </form>
    </details>
  </header>

  <section class="debt-summary" aria-label="Ringkasan hutang dan piutang">
    <article><i class="bi bi-arrow-down-left"></i><div><span>Sisa hutang</span><strong>Rp <%= summary.DEBT.remaining.toLocaleString('id-ID') %></strong><small><%= summary.DEBT.total %> data aktif</small></div></article>
    <article><i class="bi bi-arrow-up-right"></i><div><span>Sisa piutang</span><strong>Rp <%= summary.RECEIVABLE.remaining.toLocaleString('id-ID') %></strong><small><%= summary.RECEIVABLE.total %> data aktif</small></div></article>
    <article class="is-alert"><i class="bi bi-exclamation-triangle"></i><div><span>Terlambat</span><strong>Rp <%= (summary.DEBT.overdue + summary.RECEIVABLE.overdue).toLocaleString('id-ID') %></strong><small>Perlu ditindaklanjuti</small></div></article>
  </section>

  <form class="debt-filter" method="get" action="/debts">
    <select class="form-select form-select-sm" name="type" aria-label="Jenis"><option value="">Semua jenis</option><option value="DEBT" <%= filters.type==='DEBT'?'selected':'' %>>Hutang</option><option value="RECEIVABLE" <%= filters.type==='RECEIVABLE'?'selected':'' %>>Piutang</option></select>
    <select class="form-select form-select-sm" name="site" aria-label="Lokasi"><option value="">Semua lokasi</option><option value="GLOBAL" <%= filters.site==='GLOBAL'?'selected':'' %>>Global</option><option value="CDS" <%= filters.site==='CDS'?'selected':'' %>>CDS</option><option value="KBG" <%= filters.site==='KBG'?'selected':'' %>>KBG</option></select>
    <select class="form-select form-select-sm" name="status" aria-label="Status"><option value="ACTIVE" <%= filters.status==='ACTIVE'?'selected':'' %>>Aktif</option><option value="PAID" <%= filters.status==='PAID'?'selected':'' %>>Lunas</option><option value="ARCHIVED" <%= filters.status==='ARCHIVED'?'selected':'' %>>Arsip</option></select>
    <input class="form-control form-control-sm" name="q" value="<%= filters.query %>" maxlength="100" placeholder="Cari pihak atau keperluan">
    <button class="btn btn-outline-primary btn-sm" type="submit"><i class="bi bi-search"></i><span>Tampilkan</span></button>
  </form>

  <section class="debt-list">
    <% if (!records.length) { %><div class="debt-empty"><i class="bi bi-journal-check"></i><strong>Belum ada data</strong><span>Catat hutang atau piutang menggunakan tombol di atas.</span></div><% } %>
    <% records.forEach(row => { const remaining=Number(row.remaining_amount||0); const paid=Number(row.paid_amount||0); const principal=Number(row.principal_amount||0); const progress=principal>0?Math.min(100,Math.round(paid/principal*100)):0; %>
      <article class="debt-item <%= row.is_overdue ? 'is-overdue' : '' %>">
        <div class="debt-item-main">
          <div class="debt-item-icon"><i class="bi <%= row.record_type==='DEBT'?'bi-arrow-down-left':'bi-arrow-up-right' %>"></i></div>
          <div class="debt-item-copy">
            <div class="debt-item-title"><strong><%= row.party_name %></strong><span class="badge <%= row.record_type==='DEBT'?'text-bg-warning':'text-bg-info' %>"><%= row.record_type==='DEBT'?'HUTANG':'PIUTANG' %></span><span class="debt-site"><%= row.site_code %></span></div>
            <p><%= row.purpose %></p>
            <div class="debt-meta"><span><i class="bi bi-person"></i><%= row.responsible_name || 'Belum ditentukan' %></span><span><i class="bi bi-calendar3"></i><%= row.due_date || 'Tanpa jatuh tempo' %></span><span><i class="bi bi-credit-card"></i><%= row.payment_method==='INSTALLMENT'?'Cicilan':'Sekali bayar' %></span></div>
          </div>
          <div class="debt-amount"><span>Sisa</span><strong>Rp <%= remaining.toLocaleString('id-ID') %></strong><small>dari Rp <%= principal.toLocaleString('id-ID') %></small></div>
        </div>
        <div class="debt-progress"><span style="width:<%= progress %>%"></span></div>
        <div class="debt-item-foot">
          <span><%= progress %>% terbayar<% if(row.is_overdue){ %> · <strong class="text-danger">Terlambat</strong><% } else if(row.days_to_due!==null && row.days_to_due>=0){ %> · <%= row.days_to_due %> hari lagi<% } %></span>
          <% if ((row.payments || []).length) { %><details class="debt-history"><summary class="btn btn-link btn-sm">Riwayat (<%= row.payments.length %>)</summary><div class="debt-history-list"><% row.payments.forEach(payment => { %><div><span><strong>Rp <%= Number(payment.amount).toLocaleString('id-ID') %></strong><small><%= payment.payment_date %><%= payment.notes ? ` · ${payment.notes}` : '' %></small></span><% if(row.status!=='ARCHIVED'){ %><form method="post" action="/debts/<%= row.id %>/payments/<%= payment.id %>/delete" onsubmit="return confirm('Hapus pembayaran ini? Sisa akan dihitung ulang.')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-link btn-sm text-danger" type="submit" title="Hapus pembayaran"><i class="bi bi-trash"></i></button></form><% } %></div><% }) %></div></details><% } %>
          <% if (row.status==='ACTIVE') { %><details class="debt-pay"><summary class="btn btn-outline-primary btn-sm">Catat pembayaran</summary><form method="post" action="/debts/<%= row.id %>/payments"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input class="form-control form-control-sm" type="date" name="payment_date" value="<%= today %>" required><input class="form-control form-control-sm" type="number" min="1" max="<%= Math.floor(remaining) %>" name="amount" placeholder="Nominal" required><input class="form-control form-control-sm" name="notes" maxlength="500" placeholder="Catatan"><button class="btn btn-primary btn-sm" type="submit">Simpan</button></form></details><% } %>
          <% if (row.status!=='ARCHIVED') { %><form method="post" action="/debts/<%= row.id %>/archive" onsubmit="return confirm('Arsipkan data ini? Riwayat pembayaran tetap tersimpan.')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-link btn-sm text-muted" type="submit">Arsipkan</button></form><% } %>
        </div>
      </article>
    <% }) %>
  </section>

  <div class="debt-note"><i class="bi bi-info-circle"></i><span>Modul ini tidak otomatis masuk ke Closing. Hanya pembayaran pada periode tersebut yang Anda input sebagai pengeluaran Closing agar tidak dihitung dua kali.</span></div>
</div>
