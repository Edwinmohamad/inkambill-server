<!-- v1.27 -- total redesign: menu ini sekarang memakai komponen desain yang sama dengan modul lain
     (module-head, metric-grid/metric-card, filter-card/filter-grid, data-card, status-badge, app-dropdown,
     btn-tech) alih-alih gaya "v2" tersendiri yang penuh gradasi/glow. Semua id, name, class, dan
     data-attribute yang dipakai script di bagian bawah file ini TIDAK diubah -- hanya tampilan & susunan
     visualnya yang dirapikan supaya konsisten dan terasa lebih profesional dengan modul keuangan lain
     (Rekonsiliasi, Pembayaran, Pelanggan, dst). -->
<div class="debt-page">
  <div class="module-head">
    <div><div class="module-kicker">KEUANGAN · MONITORING</div><h1>Hutang & Piutang</h1><p>Pantau kewajiban, tagihan masuk, jatuh tempo, pembayaran, dan sisa secara terpisah dari Closing.</p></div>
    <div class="module-actions">
      <details class="debt-create-panel">
        <summary class="btn-tech primary"><i class="bi bi-plus-lg"></i>Catat Baru</summary>
        <form method="post" action="/debts" class="debt-create-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="debt-form-section span-4"><i class="bi bi-info-circle"></i>Informasi Umum</div>
          <label><span>Jenis</span><select class="form-select form-select-sm" name="record_type" required><option value="DEBT">Hutang INKAMNET</option><option value="RECEIVABLE">Piutang / belum diterima</option></select></label>
          <label><span>Lokasi</span><select class="form-select form-select-sm" name="site_code" required><option value="GLOBAL">Global</option><option value="CDS">CDS</option><option value="KBG">KBG</option></select></label>
          <label class="span-2"><span>Nama pihak</span><input class="form-control form-control-sm" name="party_name" maxlength="160" placeholder="Vendor / pemberi hutang / pemegang cash" required></label>
          <label class="span-2"><span>Keperluan</span><input class="form-control form-control-sm" name="purpose" maxlength="255" placeholder="Contoh: pembelian router" required></label>
          <label><span>Metode</span><select class="form-select form-select-sm" name="payment_method" id="debtPaymentMethod"><option value="ONCE">Sekali bayar</option><option value="INSTALLMENT">Cicilan</option></select></label>
          <label id="debtInstallmentMonths" hidden><span>Durasi cicilan</span><select class="form-select form-select-sm" name="installment_months"><option value="3">3 bulan</option><option value="6">6 bulan</option><option value="12">12 bulan</option><option value="18">18 bulan</option><option value="24">24 bulan</option></select></label>
          <label><span>Tanggal dicatat</span><input class="form-control form-control-sm" type="date" name="issue_date" value="<%= today %>" required></label>
          <label><span>Jatuh tempo pertama</span><input class="form-control form-control-sm" type="date" name="due_date"></label>
          <label class="span-2"><span>Penanggung jawab</span><input class="form-control form-control-sm" name="responsible_name" maxlength="160" placeholder="Edwin / Jon / Bopung / bersama"></label>
          <label class="span-2"><span>Catatan</span><input class="form-control form-control-sm" name="notes" maxlength="2000" placeholder="Opsional"></label>

          <div class="debt-form-section span-4"><i class="bi bi-receipt"></i>Rincian Pembelian</div>
          <div class="debt-items-editor span-4"><div class="debt-items-head"><span>Rincian pembelian</span><button class="btn-tech compact" type="button" id="addDebtItem"><i class="bi bi-plus-lg"></i> Tambah item</button></div><div id="debtItemRows"><div class="debt-item-input"><input class="form-control form-control-sm" name="item_name[]" placeholder="Nama barang / keperluan" required><input class="form-control form-control-sm debt-item-qty" type="number" min="0.01" step="0.01" name="item_quantity[]" value="1" aria-label="Jumlah" required><input class="form-control form-control-sm debt-item-price" type="number" min="1" step="1" name="item_unit_price[]" placeholder="Harga satuan" required><input class="form-control form-control-sm" name="item_notes[]" placeholder="Catatan item"><button class="btn btn-link text-danger debt-remove-item" type="button" title="Hapus"><i class="bi bi-trash"></i></button><strong class="debt-item-subtotal">Rp 0</strong></div></div><div class="debt-items-total"><span>Total otomatis</span><strong id="debtItemsTotal">Rp 0</strong></div></div>
          <div class="debt-form-action span-4"><button class="btn-tech primary" type="submit"><i class="bi bi-save2"></i>Simpan</button></div>
        </form>
      </details>
    </div>
  </div>

  <% const totalOutstanding=summary.DEBT.remaining+summary.RECEIVABLE.remaining; const totalOverdue=summary.DEBT.overdue+summary.RECEIVABLE.overdue; %>
  <div class="metric-grid debt-metric-grid" aria-label="Ringkasan hutang dan piutang">
    <a class="metric-card metric-card-link" href="/debts?type=DEBT&status=ACTIVE"><div class="metric-top"><span class="metric-label">Sisa Hutang</span><span class="metric-icon"><i class="bi bi-arrow-down-left"></i></span></div><strong>Rp <%= summary.DEBT.remaining.toLocaleString('id-ID') %></strong><small><b><%= summary.DEBT.total %></b> kewajiban aktif</small></a>
    <a class="metric-card green metric-card-link" href="/debts?type=RECEIVABLE&status=ACTIVE"><div class="metric-top"><span class="metric-label">Sisa Piutang</span><span class="metric-icon"><i class="bi bi-arrow-up-right"></i></span></div><strong>Rp <%= summary.RECEIVABLE.remaining.toLocaleString('id-ID') %></strong><small><b><%= summary.RECEIVABLE.total %></b> tagihan aktif</small></a>
    <div class="metric-card <%= totalOverdue>0?'red':'' %>"><div class="metric-top"><span class="metric-label">Lewat Jatuh Tempo</span><span class="metric-icon"><i class="bi bi-exclamation-triangle"></i></span></div><strong>Rp <%= totalOverdue.toLocaleString('id-ID') %></strong><small class="debt-health-line"><span class="debt-health-dot <%= totalOverdue>0?'danger':'safe' %>"></span><%= totalOverdue>0?'Perlu segera ditindaklanjuti':'Semua pembayaran terkendali' %></small></div>
    <div class="metric-card"><div class="metric-top"><span class="metric-label">Total Outstanding</span><span class="metric-icon"><i class="bi bi-wallet2"></i></span></div><strong>Rp <%= totalOutstanding.toLocaleString('id-ID') %></strong><small>Hutang + piutang aktif gabungan</small></div>
  </div>

  <form class="filter-card debt-filter" method="get" action="/debts" data-auto-filter>
    <div class="filter-grid debt-filter-grid">
      <div class="filter-group debt-filter-search-group"><label>CARI</label><div class="search-box"><i class="bi bi-search"></i><input name="q" value="<%= filters.query %>" maxlength="100" autocomplete="off" placeholder="Cari nama pihak, keperluan, atau penanggung jawab…"></div></div>
      <div class="filter-group"><label>JENIS</label><select class="form-select" name="type" aria-label="Jenis"><option value="">Semua jenis</option><option value="DEBT" <%= filters.type==='DEBT'?'selected':'' %>>Hutang</option><option value="RECEIVABLE" <%= filters.type==='RECEIVABLE'?'selected':'' %>>Piutang</option></select></div>
      <div class="filter-group"><label>LOKASI</label><select class="form-select" name="site" aria-label="Lokasi"><option value="">Semua lokasi</option><option value="GLOBAL" <%= filters.site==='GLOBAL'?'selected':'' %>>Global</option><option value="CDS" <%= filters.site==='CDS'?'selected':'' %>>CDS</option><option value="KBG" <%= filters.site==='KBG'?'selected':'' %>>KBG</option></select></div>
      <div class="filter-group"><label>STATUS</label><select class="form-select" name="status" aria-label="Status"><option value="ACTIVE" <%= filters.status==='ACTIVE'?'selected':'' %>>Aktif</option><option value="PAID" <%= filters.status==='PAID'?'selected':'' %>>Lunas</option><option value="ARCHIVED" <%= filters.status==='ARCHIVED'?'selected':'' %>>Arsip</option></select></div>
      <div class="filter-group"><label>PERIODE</label><select class="form-select" name="period" aria-label="Periode"><option value="">Semua waktu</option><option value="today" <%= filters.period==='today'?'selected':'' %>>Hari ini</option><option value="month" <%= filters.period==='month'?'selected':'' %>>Bulan ini</option><option value="custom" <%= filters.period==='custom'?'selected':'' %>>Custom</option></select></div>
      <% if(filters.period==='custom'){ %><div class="filter-group debt-filter-custom-range"><label>RENTANG TANGGAL</label><div class="debt-filter-custom-range-inputs"><input class="form-control" type="date" name="from" value="<%= filters.from %>" aria-label="Dari tanggal"><span>—</span><input class="form-control" type="date" name="to" value="<%= filters.to %>" aria-label="Sampai tanggal"></div></div><% } %>
      <div class="filter-group d-flex align-items-end gap-2"><button class="btn-tech flex-fill"><i class="bi bi-search"></i>Cari</button><% if(filters.type||filters.site||filters.status!=='ACTIVE'||filters.query||filters.period){ %><a class="btn-tech debt-filter-reset" href="/debts" title="Reset filter"><i class="bi bi-x-lg"></i></a><% } %></div>
    </div>
  </form>

  <!-- v1.28 -- daftar dipindah dari kartu bertumpuk ke tabel (app-table, sama seperti Rekonsiliasi/
       Pelanggan) supaya banyak baris lebih gampang dipindai/dimonitor sekaligus. Rincian pembelian,
       jadwal cicilan, dan riwayat transaksi -- yang tadinya dropdown/`<details>` inline -- sekarang
       digabung jadi satu modal "Detail" per baris (data-bs-toggle="modal", sama seperti modal Catat
       Cicilan yang sudah ada) supaya tetap aman dipakai di dalam tabel yang bisa discroll horizontal;
       dropdown biasa berisiko terpotong oleh overflow tabel, modal Bootstrap tidak. -->
  <div class="data-card debt-list-card">
    <div class="data-card-head"><div><h3>Daftar Hutang & Piutang</h3><small><%= records.length %> data ditemukan <% if(filters.status!=='ACTIVE'){ %>&middot; status: <%= filters.status==='PAID'?'Lunas':'Arsip' %><% } %></small></div></div>
    <% if (!records.length) { %><div class="empty-state"><i class="bi bi-journal-check"></i><strong>Belum ada data</strong><small>Catat hutang atau piutang menggunakan tombol "Catat Baru" di atas.</small></div><% } %>
    <% if (records.length) { %>
    <div class="inset-list debt-inset-list">
        <% records.forEach((row,index) => { const remaining=Number(row.remaining_amount||0); const paid=Number(row.paid_amount||0); const principal=Number(row.principal_amount||0); const progress=principal>0?Math.min(100,Math.round(paid/principal*100)):0; const statusKey=row.payment_status.toLowerCase().replace(/\s+/g,'-'); const typeClass=row.record_type==='DEBT'?'type-debt':'type-receivable'; const statusIcon=statusKey==='lunas'?'bi-check-circle-fill':statusKey==='dicicil'?'bi-arrow-repeat':statusKey==='terlambat'?'bi-exclamation-circle-fill':'bi-hourglass-split'; const partyInitial=String(row.party_name||'?').trim().charAt(0).toUpperCase()||'?'; %>
        <div class="inset-row debt-item <%= typeClass %> <%= row.is_overdue ? 'is-overdue' : '' %>" data-debt-search="<%= [row.party_name,row.purpose,row.responsible_name,row.site_code].filter(Boolean).join(' ') %>">
          <span class="inset-row-lead debt-avatar <%= typeClass %>"><%= partyInitial %></span>
          <div class="inset-row-main">
            <span class="inset-row-title"><%= row.party_name %> <span class="debt-site">&middot; <%= row.site_code %></span></span>
            <span class="inset-row-sub"><%= row.purpose %> &middot; <%= row.responsible_name || 'Belum ditentukan' %></span>
            <div class="inset-row-chips">
              <span class="status-badge <%= row.record_type==='DEBT'?'purple':'green' %>"><%= row.record_type==='DEBT'?'Hutang':'Piutang' %></span>
              <span class="debt-status-badge status-<%= statusKey %>"><i class="bi <%= statusIcon %>"></i><%= row.payment_status %></span>
              <span class="debt-due-state <%= row.is_overdue?'danger':'safe' %>"><i class="bi <%= row.is_overdue?'bi-exclamation-circle-fill':'bi-calendar2-check' %>"></i><% if(row.is_overdue){ %>Terlambat<% } else if(row.days_to_due!==null && row.days_to_due>=0){ %><%= row.days_to_due %> hari lagi<% }else{ %>Tanpa jatuh tempo<% } %></span>
            </div>
          </div>
          <div class="inset-row-trail">
            <div class="debt-nominal-cell">
              <span class="inset-row-value money">Rp <%= remaining.toLocaleString('id-ID') %></span>
              <span class="cell-sub">dari Rp <%= principal.toLocaleString('id-ID') %></span>
              <div class="debt-progress <%= progress>=100?'is-complete':'' %>" title="<%= progress %>% terbayar"><span style="width:<%= progress %>%"></span></div>
            </div>
            <button type="button" class="inset-row-chevron" data-bs-toggle="modal" data-bs-target="#debtDetailModal<%= row.id %>" aria-label="Detail <%= row.party_name %>"><i class="bi bi-chevron-right"></i></button>
            <button type="button" class="action-menu" data-action-popover-target="debtAction<%= row.id %>" aria-label="Tindakan <%= row.party_name %>"><i class="bi bi-three-dots"></i></button>
            <div class="ink-action-popover" id="debtAction<%= row.id %>" hidden>
              <div class="ink-action-popover-head"><div><small><%= row.record_type==='DEBT'?'HUTANG':'PIUTANG' %> &middot; <%= row.site_code %></small><strong><%= row.party_name %></strong><span><%= row.purpose %></span></div></div>
              <div class="ink-action-popover-body">
                <button type="button" class="ink-action-item compact" data-action-close data-bs-toggle="modal" data-bs-target="#debtDetailModal<%= row.id %>"><i class="bi bi-clock-history"></i><span><b>Detail</b><small>Rincian, jadwal &amp; riwayat</small></span></button>
                <% if (row.status==='ACTIVE') { %><button type="button" class="ink-action-item compact" data-action-close data-bs-toggle="modal" data-bs-target="#debtPayModal" data-debt-id="<%= row.id %>" data-debt-type-label="<%= row.record_type==='DEBT'?'Hutang':'Piutang' %>" data-debt-party="<%= row.party_name %>" data-debt-purpose="<%= row.purpose %>" data-debt-site="<%= row.site_code %>" data-debt-principal="<%= principal %>" data-debt-paid="<%= paid %>" data-debt-remaining="<%= Math.floor(remaining) %>"><i class="bi bi-cash-coin"></i><span><b>Catat Cicilan</b><small>Catat pembayaran baru</small></span></button><% } %>
                <% if (row.status!=='ARCHIVED') { %><div class="ink-action-separator"></div><form method="post" action="/debts/<%= row.id %>/archive" onsubmit="return confirm('Arsipkan data ini? Riwayat pembayaran tetap tersimpan.')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="ink-action-item compact" type="submit"><i class="bi bi-archive"></i><span><b>Arsipkan</b><small>Pindahkan ke arsip</small></span></button></form><% } %>
              </div>
            </div>
          </div>
        </div>
        <% }) %>
    </div>
    <% } %>
  </div>

  <div class="debt-note"><i class="bi bi-info-circle"></i><span>Modul ini tidak otomatis masuk ke Closing. Hanya pembayaran pada periode tersebut yang Anda input sebagai pengeluaran Closing agar tidak dihitung dua kali.</span></div>
</div>

<!-- v1.28 -- satu modal "Detail" per baris: rincian pembelian, jadwal cicilan, dan riwayat transaksi
     yang dulu tersebar di <details> inline + dropdown Riwayat, sekarang jadi satu tempat. -->
<% records.forEach(row => { const remaining=Number(row.remaining_amount||0); const paid=Number(row.paid_amount||0); const principal=Number(row.principal_amount||0); const progress=principal>0?Math.min(100,Math.round(paid/principal*100)):0; %>
<div class="modal fade" id="debtDetailModal<%= row.id %>" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-scrollable modal-lg">
    <div class="modal-content nms-modal">
      <div class="modal-header">
        <div><div class="module-kicker"><%= row.record_type==='DEBT'?'HUTANG':'PIUTANG' %> · <%= row.site_code %></div><h5 class="modal-title"><%= row.party_name %></h5><small class="text-secondary"><%= row.purpose %></small></div>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body debt-detail-body">
        <div class="debt-money-grid"><div><span>Total</span><strong class="money">Rp <%= principal.toLocaleString('id-ID') %></strong></div><div><span>Terbayar</span><strong class="money paid">Rp <%= paid.toLocaleString('id-ID') %></strong></div><div class="remaining"><span>Sisa</span><strong class="money">Rp <%= remaining.toLocaleString('id-ID') %></strong></div></div>
        <div class="debt-progress-wrap debt-progress-wrap-ring">
          <div class="progress-ring lg <%= progress>=100?'is-complete':'' %>" style="--p:<%= progress %>"><span><%= progress %>%</span></div>
          <div class="debt-progress-wrap-copy"><span>Progres pembayaran</span><small>Rp <%= paid.toLocaleString('id-ID') %> dari Rp <%= principal.toLocaleString('id-ID') %></small></div>
        </div>

        <div class="debt-tab-nav" role="tablist">
          <button class="debt-tab-btn active" type="button" data-bs-toggle="pill" data-bs-target="#debtTabItems<%= row.id %>"><i class="bi bi-receipt"></i>Rincian<% if((row.items||[]).length){ %><b><%= row.items.length %></b><% } %></button>
          <button class="debt-tab-btn" type="button" data-bs-toggle="pill" data-bs-target="#debtTabSchedule<%= row.id %>"><i class="bi bi-list-check"></i>Jadwal<% if((row.installments||[]).length){ %><b><%= row.installments.length %></b><% } %></button>
          <button class="debt-tab-btn" type="button" data-bs-toggle="pill" data-bs-target="#debtTabHistory<%= row.id %>"><i class="bi bi-clock-history"></i>Riwayat<b><%= row.timeline.length %></b></button>
        </div>

        <div class="tab-content debt-tab-content">
          <div class="tab-pane fade show active" id="debtTabItems<%= row.id %>">
          <% if(!(row.items||[]).length){ %><small class="text-muted">Data lama belum memiliki rincian item.</small><% } %>
          <% (row.items||[]).forEach(item=>{ %><div class="debt-breakdown-line"><span><%= item.item_name %><small><%= Number(item.quantity).toLocaleString('id-ID') %> × Rp <%= Number(item.unit_price).toLocaleString('id-ID') %></small></span><strong>Rp <%= Math.round(Number(item.quantity)*Number(item.unit_price)).toLocaleString('id-ID') %></strong></div><% }) %>
          </div>

          <div class="tab-pane fade" id="debtTabSchedule<%= row.id %>">
            <div class="debt-tab-subhead">Jadwal <%= row.payment_method==='INSTALLMENT'?`${row.installment_months} bulan`:'Pembayaran' %></div>
            <% if(!(row.installments||[]).length){ %><small class="text-muted">Tidak ada jadwal cicilan.</small><% } %>
          <% (row.installments||[]).forEach(item=>{ %><div class="debt-installment-line status-<%= item.status.toLowerCase() %>"><span><b><%= item.number %></b><%= item.dueDate %></span><strong>Rp <%= item.target.toLocaleString('id-ID') %><small><%= item.status==='PAID'?'Lunas':item.status==='PARTIAL'?`Sisa Rp ${item.remaining.toLocaleString('id-ID')}`:item.status==='OVERDUE'?'Terlambat':'Akan datang' %></small></strong></div><% }) %>
          </div>

          <div class="tab-pane fade" id="debtTabHistory<%= row.id %>">
          <div class="debt-timeline">
            <% row.timeline.forEach(entry => { const entryKey=entry.entryStatus.toLowerCase(); %>
            <div class="debt-timeline-item status-<%= entryKey %>">
              <span class="debt-timeline-dot"></span>
              <div class="debt-timeline-body">
                <div class="debt-timeline-top">
                  <div class="debt-timeline-when"><strong><%= formatDate(entry.date) %></strong><% if(entry.time){ %><small><%= formatTime(entry.time) %> WIB</small><% } %></div>
                  <span class="debt-timeline-status <%= entryKey %>"><%= entry.kind==='created' ? (row.record_type==='DEBT'?'Hutang Dicatat':'Piutang Dicatat') : (entry.entryStatus==='LUNAS'?'Lunas':'Dicicil') %></span>
                </div>
                <div class="debt-timeline-mid">
                  <strong class="debt-timeline-amount"><%= entry.kind==='created'?'':'+ ' %>Rp <%= entry.amount.toLocaleString('id-ID') %></strong>
                  <% if(entry.method){ %><span class="debt-timeline-method"><i class="bi bi-credit-card-2-front"></i><%= statusLabel(entry.method) %></span><% } %>
                </div>
                <div class="debt-timeline-foot">
                  <span>Sisa saldo: <b>Rp <%= entry.remainingAfter.toLocaleString('id-ID') %></b></span>
                  <% if(entry.notes){ %><span class="debt-timeline-note"><%= entry.notes %></span><% } %>
                </div>
                <div class="debt-timeline-actions">
                  <% if(entry.hasProof){ %><a href="/debts/<%= row.id %>/payments/<%= entry.id %>/proof" target="_blank" rel="noopener"><i class="bi bi-paperclip"></i>Lihat bukti</a><% } %>
                  <% if(entry.kind==='payment' && row.status!=='ARCHIVED'){ %><form method="post" action="/debts/<%= row.id %>/payments/<%= entry.id %>/delete" onsubmit="return confirm('Hapus pembayaran ini? Sisa akan dihitung ulang.')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-link btn-sm text-danger" type="submit" title="Hapus pembayaran"><i class="bi bi-trash"></i> Hapus</button></form><% } %>
                </div>
              </div>
            </div>
            <% }) %>
          </div>
        </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn-tech" data-bs-dismiss="modal">Tutup</button>
      </div>
    </div>
  </div>
</div>
<% }) %>

<template id="debtItemTemplate"><div class="debt-item-input"><input class="form-control form-control-sm" name="item_name[]" placeholder="Nama barang / keperluan" required><input class="form-control form-control-sm debt-item-qty" type="number" min="0.01" step="0.01" name="item_quantity[]" value="1" aria-label="Jumlah" required><input class="form-control form-control-sm debt-item-price" type="number" min="1" step="1" name="item_unit_price[]" placeholder="Harga satuan" required><input class="form-control form-control-sm" name="item_notes[]" placeholder="Catatan item"><button class="btn btn-link text-danger debt-remove-item" type="button" title="Hapus"><i class="bi bi-trash"></i></button><strong class="debt-item-subtotal">Rp 0</strong></div></template>

<!-- v1.26 -- shared "Catat Cicilan / Pembayaran" modal, reused by every debt-item row's "Catat Cicilan"
     button via its [data-debt-*] attributes (same reuse pattern as the shared delete modals in
     views/partials/layout.ejs). Laid out in the 5 logical steps requested: debtor, what is being paid,
     amount (with live remaining-balance feedback), method + date, then an optional proof attachment. -->
<div class="modal fade" id="debtPayModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
    <form class="modal-content nms-modal" method="post" id="debtPayForm" enctype="multipart/form-data" action="/debts">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="modal-header">
        <div><div class="module-kicker">CATAT CICILAN / PEMBAYARAN</div><h5 class="modal-title">Catat Pembayaran</h5><small class="text-secondary">Ikuti langkah berikut agar sisa piutang selalu akurat.</small></div>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body debt-pay-steps">
        <section class="debt-pay-step">
          <div class="debt-pay-step-label"><span>1</span>Pelanggan / Debitur</div>
          <div class="debt-pay-summary">
            <div><small>Nama pihak</small><strong id="debtPaySummaryParty">-</strong></div>
            <div><small>Jenis</small><strong id="debtPaySummaryType">-</strong></div>
            <div><small>Lokasi</small><strong id="debtPaySummarySite">-</strong></div>
          </div>
        </section>
        <section class="debt-pay-step">
          <div class="debt-pay-step-label"><span>2</span>Detail Piutang / Hutang yang Dibayar</div>
          <p class="debt-pay-purpose" id="debtPaySummaryPurpose">-</p>
          <div class="debt-pay-money-row">
            <div><small>Total</small><strong id="debtPaySummaryPrincipal">Rp 0</strong></div>
            <div><small>Terbayar</small><strong class="paid" id="debtPaySummaryPaid">Rp 0</strong></div>
            <div><small>Sisa saat ini</small><strong class="remaining" id="debtPaySummaryRemaining">Rp 0</strong></div>
          </div>
        </section>
        <section class="debt-pay-step">
          <div class="debt-pay-step-label"><span>3</span>Nominal Cicilan</div>
          <input class="form-control" type="number" min="1" step="1" name="amount" id="debtPayAmount" placeholder="Masukkan nominal pembayaran" required>
          <div class="debt-pay-live" id="debtPayLive"><span>Sisa piutang setelah pembayaran</span><strong id="debtPayLiveRemaining">Rp 0</strong></div>
          <div class="debt-pay-warning" id="debtPayWarning" hidden><i class="bi bi-exclamation-triangle-fill"></i>Nominal melebihi sisa. Maksimal <b id="debtPayMaxHint">Rp 0</b>.</div>
        </section>
        <section class="debt-pay-step">
          <div class="debt-pay-step-label"><span>4</span>Metode Pembayaran & Tanggal</div>
          <div class="debt-pay-method-picker">
            <label><input type="radio" name="payment_method" value="cash" checked><span><i class="bi bi-cash-stack"></i>Tunai</span></label>
            <label><input type="radio" name="payment_method" value="transfer"><span><i class="bi bi-bank2"></i>Transfer</span></label>
            <label><input type="radio" name="payment_method" value="qris"><span><i class="bi bi-qr-code"></i>QRIS</span></label>
            <label><input type="radio" name="payment_method" value="other"><span><i class="bi bi-three-dots"></i>Lainnya</span></label>
          </div>
          <input class="form-control mt-2" type="date" name="payment_date" id="debtPayDate" required>
        </section>
        <section class="debt-pay-step">
          <div class="debt-pay-step-label"><span>5</span>Lampiran Bukti <em>(Opsional)</em></div>
          <input class="form-control" type="file" name="proof_file" accept="image/jpeg,image/png,image/webp,application/pdf">
          <small class="text-secondary">JPG, PNG, WEBP, atau PDF · maksimal 6 MB.</small>
        </section>
        <section class="debt-pay-step">
          <label class="form-label">Catatan (opsional)</label>
          <input class="form-control" name="notes" maxlength="500" placeholder="Contoh: cicilan bulan ke-2">
        </section>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn-tech" data-bs-dismiss="modal">Batal</button>
        <button type="submit" class="btn-tech primary" id="debtPaySubmit"><i class="bi bi-save2 me-1"></i>Simpan Pembayaran</button>
      </div>
    </form>
  </div>
</div>

<script>(()=>{const method=document.getElementById('debtPaymentMethod'),months=document.getElementById('debtInstallmentMonths'),rows=document.getElementById('debtItemRows'),template=document.getElementById('debtItemTemplate'),total=document.getElementById('debtItemsTotal');if(!rows)return;const rupiah=value=>`Rp ${Math.round(value||0).toLocaleString('id-ID')}`;const calculate=()=>{let sum=0;rows.querySelectorAll('.debt-item-input').forEach(row=>{const subtotal=(Number(row.querySelector('.debt-item-qty')?.value)||0)*(Number(row.querySelector('.debt-item-price')?.value)||0);row.querySelector('.debt-item-subtotal').textContent=rupiah(subtotal);sum+=subtotal;});total.textContent=rupiah(sum);};const bind=row=>{row.querySelectorAll('input').forEach(input=>input.addEventListener('input',calculate));row.querySelector('.debt-remove-item')?.addEventListener('click',()=>{if(rows.children.length>1)row.remove();else row.querySelectorAll('input').forEach((input,index)=>input.value=index===1?'1':'');calculate();});};rows.querySelectorAll('.debt-item-input').forEach(bind);document.getElementById('addDebtItem')?.addEventListener('click',()=>{const row=template.content.firstElementChild.cloneNode(true);rows.appendChild(row);bind(row);row.querySelector('input')?.focus();});const toggleMethod=()=>{months.hidden=method.value!=='INSTALLMENT';};method?.addEventListener('change',toggleMethod);toggleMethod();calculate();const search=document.querySelector('.debt-filter input[name="q"]'),cards=[...document.querySelectorAll('.debt-item[data-debt-search]')];search?.addEventListener('input',()=>{const words=search.value.toLocaleLowerCase('id-ID').trim().split(/\s+/).filter(Boolean);cards.forEach(card=>{const haystack=card.dataset.debtSearch.toLocaleLowerCase('id-ID');card.hidden=words.length>0&&!words.every(word=>haystack.includes(word));});});

// v1.26 -- Catat Cicilan modal: populate context from the triggering row's [data-debt-*]
// attributes, then keep "sisa piutang setelah pembayaran" live as the user types the nominal,
// blocking submit the moment it would exceed the current remaining balance.
const payModal=document.getElementById('debtPayModal');
if(payModal){
  const form=document.getElementById('debtPayForm');
  const amountInput=document.getElementById('debtPayAmount');
  const dateInput=document.getElementById('debtPayDate');
  const liveBox=document.getElementById('debtPayLive');
  const liveRemaining=document.getElementById('debtPayLiveRemaining');
  const warning=document.getElementById('debtPayWarning');
  const maxHint=document.getElementById('debtPayMaxHint');
  const submitBtn=document.getElementById('debtPaySubmit');
  let currentRemaining=0;
  const money=value=>rupiah(Math.max(0,Math.round(Number(value)||0)));
  const recalc=()=>{
    const value=Number(amountInput.value)||0;
    const after=currentRemaining-value;
    liveRemaining.textContent=money(after);
    const overLimit=value>currentRemaining;
    warning.hidden=!overLimit;
    liveBox.classList.toggle('is-over',after<0);
    submitBtn.disabled=value<=0||overLimit;
  };
  amountInput.addEventListener('input',recalc);
  payModal.addEventListener('show.bs.modal',event=>{
    const btn=event.relatedTarget;if(!btn||!btn.dataset)return;
    const d=btn.dataset;
    form.action=`/debts/${d.debtId}/payments`;
    document.getElementById('debtPaySummaryParty').textContent=d.debtParty||'-';
    document.getElementById('debtPaySummaryType').textContent=d.debtTypeLabel||'-';
    document.getElementById('debtPaySummarySite').textContent=d.debtSite||'-';
    document.getElementById('debtPaySummaryPurpose').textContent=d.debtPurpose||'-';
    document.getElementById('debtPaySummaryPrincipal').textContent=money(d.debtPrincipal);
    document.getElementById('debtPaySummaryPaid').textContent=money(d.debtPaid);
    currentRemaining=Number(d.debtRemaining)||0;
    document.getElementById('debtPaySummaryRemaining').textContent=money(currentRemaining);
    maxHint.textContent=money(currentRemaining);
    amountInput.value='';
    amountInput.max=String(currentRemaining);
    dateInput.value='<%= today %>';
    const notesInput=form.querySelector('input[name="notes"]');if(notesInput)notesInput.value='';
    form.querySelectorAll('input[name="payment_method"]').forEach((radio,index)=>radio.checked=index===0);
    const fileInput=form.querySelector('input[name="proof_file"]');if(fileInput)fileInput.value='';
    recalc();
  });
  form.addEventListener('submit',event=>{
    const value=Number(amountInput.value)||0;
    if(value<=0||value>currentRemaining){event.preventDefault();recalc();}
  });
}
})();</script>
