<section class="report-center">
<div class="module-head"><div><div class="module-kicker">REPORT CENTER</div><h1>Laporan</h1><p>Menu laporan pelanggan, tagihan, arus kas, dan faktur dengan output PDF modern.</p></div></div>
<nav class="report-tabs">
<a class="<%= filters.view==='customers'?'active':'' %>" href="/reports?view=customers"><i class="bi bi-people-fill"></i>Laporan Pelanggan</a>
<a class="<%= filters.view==='billing'?'active':'' %>" href="/reports?view=billing"><i class="bi bi-calendar2-check"></i>Laporan Tagihan</a>
<a class="<%= filters.view==='cash'?'active':'' %>" href="/reports?view=cash"><i class="bi bi-cash-stack"></i>Laporan Arus kas</a>
<a class="<%= filters.view==='invoice'?'active':'' %>" href="/reports?view=invoice"><i class="bi bi-receipt"></i>Faktur</a>
<div class="report-generate-group"><a class="report-generate" href="/reports/pdf?type=<%= filters.view %>&<%= new URLSearchParams(filters).toString() %>"><i class="bi bi-file-earmark-pdf-fill"></i>Download PDF</a><a class="report-generate secondary" href="/reports/txt?type=<%= filters.view %>&<%= new URLSearchParams(filters).toString() %>"><i class="bi bi-file-earmark-text-fill"></i>Download TXT</a></div>
</nav>
<form class="report-filter-card" method="get"><input type="hidden" name="view" value="<%= filters.view %>"><div class="report-filter-title">Filter <%= filters.view==='customers'?'Pelanggan':filters.view==='billing'?'Tagihan':filters.view==='cash'?'Arus kas':'Faktur / Invoice' %> :</div>
<% if(filters.view==='customers'){ %><div class="report-filter-grid"><div class="filter-group"><label>PAKET</label><select class="form-select" name="package"><option value="">Pilih Paket / Semua</option><% packages.forEach(p=>{ %><option value="<%= p.id %>" <%= String(filters.package)===String(p.id)?'selected':'' %>><%= p.site_code?`${p.site_code} · `:'GLOBAL · ' %><%= p.name %></option><% }) %></select></div><div class="filter-group"><label>LOKASI SERVER</label><select class="form-select" name="site"><option value="">Pilih Lokasi Server</option><% sites.forEach(s=>{ %><option value="<%= s.code %>" <%= filters.site===s.code?'selected':'' %>><%= s.code %> · <%= s.name %></option><% }) %></select></div><div class="filter-group"><label>CLUSTER / ODP</label><select class="form-select" name="cluster"><option value="">Semua Cluster</option><% clusters.forEach(c=>{ %><option value="<%= c.id %>" <%= String(filters.cluster)===String(c.id)?'selected':'' %>><%= c.site_code %> · <%= c.name %></option><% }) %></select></div><div class="filter-group"><label>STATUS</label><select class="form-select" name="status"><option value="">Tampilkan Semua</option><% ['active','suspended','terminated'].forEach(s=>{ %><option value="<%= s %>" <%= filters.status===s?'selected':'' %>><%= statusLabel(s) %></option><% }) %></select></div><div class="filter-group"><label>CARI PELANGGAN</label><div class="search-box"><i class="bi bi-search"></i><input name="q" value="<%= filters.q %>" placeholder="Nama, Customer ID, site, cluster..."></div></div></div><% } %>
<% if(filters.view==='billing'||filters.view==='invoice'){ %><div class="report-filter-grid report-filter-grid-5"><div class="filter-group"><label>PAKET INTERNET</label><select class="form-select" name="package"><option value="">Pilih Paket</option><% packages.forEach(p=>{ %><option value="<%= p.id %>" <%= String(filters.package)===String(p.id)?'selected':'' %>><%= p.site_code?`${p.site_code} · `:'GLOBAL · ' %><%= p.name %></option><% }) %></select></div><div class="filter-group"><label>LOKASI SERVER</label><select class="form-select" name="site"><option value="">Pilih Lokasi Server</option><% sites.forEach(s=>{ %><option value="<%= s.code %>" <%= filters.site===s.code?'selected':'' %>><%= s.code %></option><% }) %></select></div><div class="filter-group"><label>CLUSTER / ODP</label><select class="form-select" name="cluster"><option value="">Semua Cluster</option><% clusters.forEach(c=>{ %><option value="<%= c.id %>" <%= String(filters.cluster)===String(c.id)?'selected':'' %>><%= c.site_code %> · <%= c.name %></option><% }) %></select></div><div class="filter-group"><label>STATUS</label><select class="form-select" name="status"><option value="">Tampilkan Semua</option><% ['unpaid','partial','overdue','paid'].forEach(s=>{ %><option value="<%= s %>" <%= filters.status===s?'selected':'' %>><%= statusLabel(s) %></option><% }) %></select></div><div class="filter-group"><label>BULAN</label><select class="form-select" name="month"><% monthNames.forEach((m,i)=>{ %><option value="<%= i+1 %>" <%= filters.month===i+1?'selected':'' %>><%= m %></option><% }) %></select></div><div class="filter-group"><label>TAHUN</label><input class="form-control" type="number" name="year" value="<%= filters.year %>"></div><div class="filter-group"><label>JATUH TEMPO DARI</label><input class="form-control" type="date" name="due_from" value="<%= filters.dueFrom %>"></div><div class="filter-group"><label>JATUH TEMPO SAMPAI</label><input class="form-control" type="date" name="due_to" value="<%= filters.dueTo %>"></div><div class="filter-group report-customer-filter"><label>PELANGGAN</label><select class="form-select" name="customer"><option value="">Tampilkan Semua</option><% customers.forEach(c=>{ %><option value="<%= c.id %>" <%= String(filters.customer)===String(c.id)?'selected':'' %>><%= c.site_code %> · Cluster <%= c.cluster_name||'-' %> · <%= c.customer_code %> · <%= c.name %></option><% }) %></select></div><div class="filter-group"><label>CARI PELANGGAN / FAKTUR</label><div class="search-box"><i class="bi bi-search"></i><input name="q" value="<%= filters.q %>" placeholder="Nama, Customer ID, faktur, site, cluster..."></div></div></div><% } %>
<% if(filters.view==='cash'){ %><div class="report-filter-grid report-filter-grid-4"><div class="filter-group"><label>DARI TANGGAL</label><input class="form-control" type="date" name="from" value="<%= filters.from %>"></div><div class="filter-group"><label>SAMPAI TANGGAL</label><input class="form-control" type="date" name="to" value="<%= filters.to %>"></div><div class="filter-group"><label>KATEGORI KAS</label><select class="form-select" name="category"><option value="">Tampilkan semua</option><% categories.forEach(c=>{ %><option value="<%= c.id %>" <%= String(filters.category)===String(c.id)?'selected':'' %>><%= c.name %></option><% }) %></select></div><div class="filter-group"><label>JENIS</label><select class="form-select" name="flow_type"><option value="">Tampilkan semua</option><option value="income" <%= filters.flow_type==='income'?'selected':'' %>>Pendapatan</option><option value="expense" <%= filters.flow_type==='expense'?'selected':'' %>>Pengeluaran</option></select></div><div class="filter-group"><label>METODE PEMBAYARAN</label><select class="form-select" name="method"><option value="">Tampilkan semua</option><% ['cash','transfer','qris','gateway','other'].forEach(m=>{ %><option value="<%= m %>" <%= filters.method===m?'selected':'' %>><%= m %></option><% }) %></select><div class="form-help">Hanya berlaku untuk arus kas yang berasal dari invoice.</div></div><div class="filter-group"><label>SITE</label><select class="form-select" name="site"><option value="">Semua Site</option><% sites.forEach(s=>{ %><option value="<%= s.code %>" <%= filters.site===s.code?'selected':'' %>><%= s.code %></option><% }) %></select></div></div><% } %>
<div class="report-filter-actions"><button class="btn-tech primary"><i class="bi bi-search"></i>Cari</button><a class="btn-tech danger" href="/reports?view=<%= filters.view %>"><i class="bi bi-arrow-counterclockwise"></i>Segarkan</a><a class="btn-tech report-pdf-btn" href="/reports/pdf?type=<%= filters.view %>&<%= new URLSearchParams(filters).toString() %>"><i class="bi bi-file-earmark-pdf-fill"></i>Download PDF</a><a class="btn-tech" href="/reports/txt?type=<%= filters.view %>&<%= new URLSearchParams(filters).toString() %>"><i class="bi bi-file-earmark-text-fill"></i>Download TXT</a></div></form>
<div class="metric-grid report-summary-grid"><% if(filters.view==='customers'){ %><article class="metric-card"><div class="metric-top"><span class="metric-label">Pelanggan</span><span class="metric-icon"><i class="bi bi-people"></i></span></div><strong><%= summary.customers %></strong><small>Hasil filter</small></article><article class="metric-card green"><div class="metric-top"><span class="metric-label">Aktif</span><span class="metric-icon"><i class="bi bi-check2-circle"></i></span></div><strong><%= summary.active %></strong><small>Subscriber aktif</small></article><% }else if(filters.view==='cash'){ %><article class="metric-card green"><div class="metric-top"><span class="metric-label">Pendapatan</span><span class="metric-icon"><i class="bi bi-arrow-down-left"></i></span></div><strong><%= formatRupiah(summary.income) %></strong></article><article class="metric-card red"><div class="metric-top"><span class="metric-label">Pengeluaran</span><span class="metric-icon"><i class="bi bi-arrow-up-right"></i></span></div><strong><%= formatRupiah(summary.expense) %></strong></article><article class="metric-card"><div class="metric-top"><span class="metric-label">Saldo</span><span class="metric-icon"><i class="bi bi-wallet2"></i></span></div><strong><%= formatRupiah(summary.balance) %></strong></article><% }else{ %><article class="metric-card"><div class="metric-top"><span class="metric-label">Total Tagihan</span><span class="metric-icon"><i class="bi bi-receipt"></i></span></div><strong><%= formatRupiah(summary.billed) %></strong></article><article class="metric-card green"><div class="metric-top"><span class="metric-label">Terbayar</span><span class="metric-icon"><i class="bi bi-check2-circle"></i></span></div><strong><%= formatRupiah(summary.paid) %></strong></article><article class="metric-card red"><div class="metric-top"><span class="metric-label">Outstanding</span><span class="metric-icon"><i class="bi bi-hourglass"></i></span></div><strong><%= formatRupiah(summary.outstanding) %></strong></article><% } %></div>
<div class="data-card"><div class="data-card-head"><div><h3>Preview Report</h3><small>Data yang sama akan digunakan untuk output PDF.</small></div></div><div class="table-responsive"><table class="app-table"><thead><% if(filters.view==='customers'){ %><tr><th>No.</th><th>Customer ID</th><th>Nama</th><th>Site / Cluster</th><th>Paket</th><th>WhatsApp</th><th>Status</th></tr><% }else if(filters.view==='cash'){ %><tr><th>No.</th><th>Tanggal</th><th>Nama</th><th>Kategori</th><th>Site</th><th>Jenis</th><th>Nominal</th></tr><% }else{ %><tr><th>No.</th><th>Invoice</th><th>Pelanggan</th><th>Site / Cluster</th><th>Jatuh Tempo</th><th>Tagihan</th><th>Sisa</th><th>Status</th><% if(filters.view==='invoice'){ %><th>Faktur</th><% } %></tr><% } %></thead><tbody>
<% if(filters.view==='customers'){ customerRows.slice(0,300).forEach((r,rIndex)=>{ %><tr><td><span class="cell-main"><%= rIndex+1 %></span></td><td class="cell-main text-purple"><%= r.customer_code %></td><td><%= r.name %></td><td><span class="cell-main"><%= r.site_code %></span><span class="cell-sub">Cluster <%= r.cluster_name||'-' %></span></td><td><%= r.package_name %></td><td><%= r.phone||'-' %></td><td><span class="status-badge <%= r.customer_status==='active'?'green':'orange' %>"><%= statusLabel(r.customer_status) %></span></td></tr><% }) } %>
<% if(filters.view==='cash'){ cashRows.slice(0,300).forEach((r,rIndex)=>{ %><tr><td><span class="cell-main"><%= rIndex+1 %></span></td><td><%= formatDate(r.transaction_date) %></td><td class="cell-main"><%= r.name %></td><td><%= r.category %></td><td><%= r.site_code||'GLOBAL' %></td><td><span class="status-badge <%= r.type==='income'?'green':'red' %>"><%= statusLabel(r.type) %></span></td><td class="money <%= r.type==='income'?'text-success-soft':'text-danger-soft' %>"><%= formatRupiah(r.amount) %></td></tr><% }) } %>
<% if(filters.view==='billing'||filters.view==='invoice'){ billingRows.slice(0,300).forEach((r,rIndex)=>{ %><tr><td><span class="cell-main"><%= rIndex+1 %></span></td><td class="cell-main text-purple"><%= r.invoice_number %></td><td><%= r.customer_name %><span class="cell-sub"><%= r.customer_code %></span></td><td><span class="cell-main"><%= r.site_code %></span><span class="cell-sub">Cluster <%= r.cluster_name||'-' %></span></td><td><%= formatDate(r.due_date) %></td><td class="money"><%= formatRupiah(r.total) %></td><td class="money text-danger-soft"><%= formatRupiah(r.outstanding) %></td><td><span class="status-badge <%= r.status==='paid'?'green':r.status==='overdue'?'red':'orange' %>"><%= statusLabel(r.status) %></span></td><% if(filters.view==='invoice'){ %><td><a class="btn-tech compact" href="/invoices/<%= r.id %>/pdf" target="_blank"><i class="bi bi-receipt"></i>Buka</a></td><% } %></tr><% }) } %>
</tbody></table></div></div>
</section>
