<section>
  <div class="module-head">
    <div><div class="module-kicker">CASH RECONCILIATION</div><h1>Rekonsiliasi Pembayaran</h1><p>Pisahkan pembayaran pelanggan dari uang yang benar-benar sudah masuk ke kas perusahaan.</p></div>
    <% const isHistory=tab==='history';
       const baseFilter={q,site,cluster};
       const reconciliationExportQuery=new URLSearchParams(isHistory?{...baseFilter,tab:'history',status,date_from:dateFrom,date_to:dateTo}:baseFilter).toString();
       const tabHref=(name)=>'/payments/reconciliation?'+new URLSearchParams(name==='history'?{...baseFilter,tab:'history'}:baseFilter).toString(); %>
    <div class="module-actions"><a class="btn-tech" href="/payments/reconciliation/export.pdf?<%= reconciliationExportQuery %>"><i class="bi bi-filetype-pdf"></i>PDF</a><a class="btn-tech" href="/payments/reconciliation/export.xlsx?<%= reconciliationExportQuery %>"><i class="bi bi-file-earmark-spreadsheet"></i>Excel</a><a href="/payments" class="btn-tech"><i class="bi bi-arrow-left"></i>Kembali ke Pembayaran</a></div>
  </div>
  <% if(justSettled){ %><div class="success-banner mb-3 recon-settled-banner"><i class="bi bi-receipt-cutoff"></i><div><strong>Setoran <%= justSettled.code %> tersimpan</strong><small><%= justSettled.payment_count %> transaksi · <%= formatRupiah(justSettled.total_amount) %><% if(justSettled.handed_amount!=null){ %> · diserahkan <%= formatRupiah(justSettled.handed_amount) %><% if(Number(justSettled.difference_amount)){ %> · selisih lebih <%= formatRupiah(justSettled.difference_amount) %><% } %><% } %></small></div><a class="btn-tech success" href="/payments/settlements/<%= justSettled.id %>/receipt.pdf" target="_blank" rel="noopener"><i class="bi bi-printer"></i>Tanda Terima</a></div><% } %>
  <form class="filter-card" method="get" action="/payments/reconciliation">
  <nav class="recon-switch" role="tablist" aria-label="Tampilan rekonsiliasi">
    <a class="recon-switch-btn is-held <%= !isHistory?'active':'' %>" href="<%= tabHref('held') %>" role="tab" aria-selected="<%= !isHistory %>"><i class="bi bi-hourglass-split"></i><span><b>Belum Disetor</b><small>Konfirmasi &amp; setor per collector</small></span><em><%= held.length %></em></a>
    <a class="recon-switch-btn is-history <%= isHistory?'active':'' %>" href="<%= tabHref('history') %>" role="tab" aria-selected="<%= isHistory %>"><i class="bi bi-clock-history"></i><span><b>Histori &amp; Status</b><small>Riwayat, analisis &amp; tanda terima</small></span><i class="bi bi-chevron-right recon-switch-go"></i></a>
  </nav>
<% if(isHistory){ %><input type="hidden" name="tab" value="history"><% } %><div class="filter-grid payment-filter-grid"><div class="filter-group"><label>CARI</label><div class="search-box"><i class="bi bi-search"></i><input name="q" value="<%= q %>" placeholder="Pelanggan, Customer ID, faktur, collector..."></div></div><div class="filter-group"><label>SITE / POP</label><select class="form-select" name="site"><option value="">Semua Site</option><% sites.forEach(s=>{ %><option value="<%= s.code %>" <%= site===s.code?'selected':'' %>><%= s.code %> · <%= s.name %></option><% }) %></select></div><div class="filter-group"><label>CLUSTER / ODP</label><select class="form-select" name="cluster"><option value="">Semua Cluster</option><% clusters.forEach(c=>{ %><option value="<%= c.id %>" <%= String(cluster)===String(c.id)?'selected':'' %>><%= c.site_code %> · <%= c.name %></option><% }) %></select></div><% if(isHistory){ %><div class="filter-group"><label>STATUS SETORAN</label><select class="form-select" name="status"><option value="all" <%= status==='all'?'selected':'' %>>Semua</option><option value="held" <%= status==='held'?'selected':'' %>>Belum Disetor</option><option value="settled" <%= status==='settled'?'selected':'' %>>Sudah Disetor</option></select></div><div class="filter-group"><label>DIBAYAR DARI</label><input type="date" class="form-control" name="date_from" value="<%= dateFrom %>"></div><div class="filter-group"><label>SAMPAI</label><input type="date" class="form-control" name="date_to" value="<%= dateTo %>"></div><% } %><div class="filter-group d-flex align-items-end gap-2"><button class="btn-tech flex-fill"><i class="bi bi-search"></i>Cari</button><a class="btn-tech" href="/payments/reconciliation<%= isHistory?'?tab=history':'' %>" aria-label="Reset filter"><i class="bi bi-x-lg"></i></a></div></div></form>

  <!-- v1.25.5 (update) — setiap widget di bawah sekarang bisa diklik: kartu ringkasan mengarah ke
       tempat datanya bisa diperiksa lebih lanjut (tabel di halaman ini atau Data Kas terkait), dan kartu
       collector memfilter tabel "Cash Belum Disetor" di bawah untuk collector tersebut. -->
  <% if(!isHistory){ %>
  <div class="metric-grid">
    <a class="metric-card orange metric-card-link" href="#cashHeldTable"><div class="metric-top"><span class="metric-label">Cash Masih di Tim</span><span class="metric-icon"><i class="bi bi-person-vcard"></i></span></div><strong><%= formatRupiah(summary.held_total||0) %></strong><small>Belum masuk kas perusahaan · lihat tabel</small></a>
    <a class="metric-card green metric-card-link" href="/cash?q=<%= encodeURIComponent('Setoran Cash') %>"><div class="metric-top"><span class="metric-label">Setoran Cash Hari Ini</span><span class="metric-icon"><i class="bi bi-safe2-fill"></i></span></div><strong><%= formatRupiah(summary.settled_today||0) %></strong><small>Sudah direkonsiliasi · buka Data Kas</small></a>
    <a class="metric-card metric-card-link" href="/cash?q=<%= encodeURIComponent('Pembayaran') %>"><div class="metric-top"><span class="metric-label">Transfer Hari Ini</span><span class="metric-icon"><i class="bi bi-bank"></i></span></div><strong><%= formatRupiah(summary.transfer_today||0) %></strong><small>Confirmed transfer · buka Data Kas</small></a>
    <a class="metric-card <%= Number(summary.overdue_count||0)?'red':'' %> metric-card-link <%= aging==='overdue'?'active':'' %>" href="/payments/reconciliation?<%= new URLSearchParams(aging==='overdue'?baseFilter:{...baseFilter,aging:'overdue'}).toString() %>#cashHeldTable"><div class="metric-top"><span class="metric-label">Lewat <%= agingDays %> Hari</span><span class="metric-icon"><i class="bi bi-hourglass-bottom"></i></span></div><strong><%= formatRupiah(summary.overdue_total||0) %></strong><small><%= Number(summary.overdue_count||0) %> transaksi · <%= aging==='overdue'?'klik untuk semua':'klik untuk filter' %></small></a>
    <a class="metric-card metric-card-link" href="#collectorGrid"><div class="metric-top"><span class="metric-label">Collector Aktif</span><span class="metric-icon"><i class="bi bi-people-fill"></i></span></div><strong><%= staffBalances.length %></strong><small>Memegang cash pelanggan</small></a>
  </div>

  <% if(held.length){ const hc=heldCharts; %>
  <section class="recon-analytics mb-3" aria-label="Analisis cash tertahan">
    <div class="recon-kpi-strip">
      <div><span>Rata-rata umur</span><b><%= hc.avgAge.toFixed(1) %> hari</b></div>
      <div><span>Umur tertimbang nominal</span><b><%= hc.weightedAge.toFixed(1) %> hari</b></div>
      <div><span>Transaksi tertua</span><b class="<%= hc.oldest>agingDays?'text-danger':'' %>"><%= hc.oldest %> hari</b></div>
      <div><span>Porsi lewat <%= agingDays %> hari</span><b class="<%= hc.overdueTotal?'text-danger':'' %>"><%= hc.total?Math.round(hc.overdueTotal/hc.total*100):0 %>%</b></div>
    </div>
    <div class="recon-chart-grid">
      <article class="data-card recon-chart-card"><div class="data-card-head"><div><h3>Umur Cash</h3><small>Nominal per kelompok umur</small></div><i class="bi bi-pie-chart-fill"></i></div><div class="recon-chart-body"><canvas id="reconAgingChart" aria-label="Grafik umur cash"></canvas></div></article>
      <article class="data-card recon-chart-card wide"><div class="data-card-head"><div><h3>Cash per Collector</h3><small>Normal vs lewat <%= agingDays %> hari</small></div><i class="bi bi-bar-chart-fill"></i></div><div class="recon-chart-body"><canvas id="reconHeldCollectorChart" aria-label="Grafik cash per collector"></canvas></div></article>
      <article class="data-card recon-chart-card"><div class="data-card-head"><div><h3>Sebaran Site</h3><small>Cash tertahan per site</small></div><i class="bi bi-geo-alt-fill"></i></div><div class="recon-chart-body"><canvas id="reconHeldSiteChart" aria-label="Grafik cash per site"></canvas></div></article>
      <article class="data-card recon-chart-card wide"><div class="data-card-head"><div><h3>Prioritas Tagih ke Collector</h3><small>6 transaksi cash paling lama belum disetor</small></div><i class="bi bi-flag-fill"></i></div>
        <ol class="recon-oldest-list">
          <% held.slice().sort((a,b)=>Number(b.age_days||0)-Number(a.age_days||0)||Number(b.amount||0)-Number(a.amount||0)).slice(0,6).forEach(p=>{ const age=Number(p.age_days||0); %>
          <li><span class="cash-age <%= age>agingDays?'late':age>=Math.max(1,agingDays-1)?'warn':'' %>"><%= age===0?'hari ini':`${age} hari` %></span><div><b><%= p.customer_name %></b><small><%= p.collector_name||'Tidak diketahui' %> · <%= p.site_code %> · <%= p.invoice_number %></small></div><strong><%= formatRupiah(p.amount) %></strong></li>
          <% }) %>
        </ol>
      </article>
    </div>
  </section>
  <% } %>

  <div class="collector-grid mb-3" id="collectorGrid">
    <% staffBalances.forEach((s,index)=>{ %>
    <a class="collector-card reveal-item collector-card-link" style="--enter-delay:<%= index*45 %>ms" href="/payments/reconciliation?<%= new URLSearchParams({q:s.collector_name==='Tidak diketahui'?'':s.collector_name,site,cluster}).toString() %>#cashHeldTable" title="Filter tabel di bawah untuk collector ini"><div class="collector-avatar"><%= String(s.collector_name).charAt(0).toUpperCase() %></div><div><span>Cash di <%= s.collector_name %></span><strong><%= formatRupiah(s.amount) %></strong><small><%= s.transactions %> transaksi belum disetor · tertua <span class="cash-age <%= Number(s.oldest_days)>agingDays?'late':Number(s.oldest_days)>=Math.max(1,agingDays-1)?'warn':'' %>"><%= Number(s.oldest_days||0) %> hari</span></small></div><div class="collector-signal"></div></a>
    <% }) %>
    <% if(!staffBalances.length){ %><div class="success-banner"><i class="bi bi-check2-circle"></i><div><strong>Semua cash sudah clear</strong><small>Tidak ada setoran staff yang tertunda.</small></div></div><% } %>
  </div>
  <% if(canCancelSettlement){ %><form class="recon-aging-setting mb-3" method="post" action="/payments/reconciliation/settings"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><i class="bi bi-bell"></i><span>Ingatkan admin &amp; collector bila cash dipegang lebih dari</span><input class="form-control form-control-sm" type="number" name="cash_aging_alert_days" min="1" max="60" value="<%= agingDays %>" aria-label="Batas hari"><span>hari</span><button class="btn-tech btn-sm">Simpan</button></form><% } %>
  <% } %>



  <% if(!isHistory){ %>
  <div class="data-card" id="cashHeldTable">
    <div class="data-card-head"><div><h3>Cash Belum Disetor<% if(aging==='overdue'){ %> · lewat <%= agingDays %> hari<% } %></h3><small>Centang beberapa baris untuk Konfirmasi Setoran Massal, konfirmasi satu per satu lewat kolom Aksi, atau pakai Setor per Collector untuk uang yang diserahkan sebagian.</small></div><div class="d-flex gap-2 flex-wrap"><% if(aging==='overdue'){ %><a class="btn-tech btn-sm" href="/payments/reconciliation?<%= new URLSearchParams(baseFilter).toString() %>#cashHeldTable"><i class="bi bi-x-lg"></i>Semua umur</a><% } %><% if(staffBalances.some(b=>Number(b.user_id)>0)){ %><button type="button" class="btn-tech primary btn-sm" data-bs-toggle="modal" data-bs-target="#partialSettleModal"><i class="bi bi-cash-coin"></i>Setor per Collector</button><% } %></div></div>
    <div class="table-responsive"><table class="app-table" data-bulk-scope="reconciliationBulkBar"><thead><tr><th class="app-check-col"><input type="checkbox" class="form-check-input" data-select-all aria-label="Pilih semua setoran"></th><th class="app-seq-col">No.</th><th>Collector</th><th>Pelanggan</th><th>Site</th><th>Nominal</th><th>Diterima</th><th>Umur</th><th>Status</th><th>Aksi</th></tr></thead><tbody>
      <% held.forEach((p,index)=>{ %><tr><td class="app-check-col"><input type="checkbox" class="form-check-input" data-row-check value="<%= p.id %>" aria-label="Pilih setoran <%= p.customer_name %>"></td><td><span class="cell-main"><%= index+1 %></span></td><td><span class="cell-main"><%= p.collector_name||'Tidak diketahui' %></span><span class="cell-sub">Cash holder</span></td><td><span class="cell-main"><%= p.customer_name %></span><span class="cell-sub"><%= p.customer_code %> · <%= p.invoice_number %></span></td><td><span class="status-badge purple"><%= p.site_code %><%= p.cluster_name?` · Cluster ${p.cluster_name}`:'' %></span></td><td class="money"><%= formatRupiah(p.amount) %></td><td><%= new Date(p.paid_at).toLocaleString('id-ID',{timeZone:'Asia/Jakarta'}) %></td><td><% const age=Number(p.age_days||0); %><span class="cash-age <%= age>agingDays?'late':age>=Math.max(1,agingDays-1)?'warn':'' %>"><%= age===0?'hari ini':`${age} hari` %></span></td><td><span class="status-badge orange">belum disetor</span></td><td><form method="post" action="/payments/<%= p.id %>/settle"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn-tech success btn-sm"><i class="bi bi-check2"></i>Konfirmasi Setoran</button></form></td></tr><% }) %>
      <% if(!held.length){ %><tr><td colspan="10"><div class="empty-state"><i class="bi bi-safe2"></i><strong>Tidak ada cash tertahan</strong><small>Semua uang pelanggan sudah masuk ke kas perusahaan.</small></div></td></tr><% } %>
    </tbody></table></div>
  </div>

  <div class="customer-bulk-bar" id="reconciliationBulkBar" hidden><span><b data-bulk-count>0</b> setoran terpilih</span><div class="customer-bulk-buttons"><button type="button" data-bulk-clear class="ghost"><i class="bi bi-x-lg"></i>Batal</button><button type="button" class="success" data-simple-delete-bulk data-simple-delete-variant="success" data-simple-delete-kicker="KONFIRMASI SETORAN" data-simple-delete-confirm-label="Ya, Konfirmasi" data-simple-delete-confirm-icon="bi-check2-circle" data-bulk-scope-id="reconciliationBulkBar" data-bulk-url="/payments/bulk-settle" data-bulk-action-field="action" data-bulk-action-value="settle" data-bulk-id-field="payment_ids[]" data-entity-label-plural="setoran" data-simple-delete-title="Konfirmasi setoran terpilih?" data-simple-delete-warning="Hanya setoran cash yang masih tertahan di staff (belum disetor) yang akan dikonfirmasi — sisanya otomatis dilewati. Kas perusahaan dan jurnal terkait akan diperbarui otomatis."><i class="bi bi-check2-circle"></i>Konfirmasi Setoran Massal</button></div></div>
  <% const partialCollectors=staffBalances.filter(b=>Number(b.user_id)>0); if(partialCollectors.length){ %>
  <div class="modal fade" id="partialSettleModal" tabindex="-1" aria-labelledby="partialSettleTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><form class="modal-content" method="post" action="/payments/reconciliation/partial-settle" data-loading-message="Mencocokkan setoran ke transaksi tertua...">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="modal-header"><div><small class="text-secondary">SETORAN SEBAGIAN</small><h5 class="modal-title" id="partialSettleTitle">Setor per Collector</h5></div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Tutup"></button></div>
    <div class="modal-body">
      <p class="text-secondary small mb-3">Masukkan uang yang benar-benar diserahkan. Sistem mencocokkan ke transaksi tertua yang muat utuh (transaksi tidak dipecah). Sisanya tetap Belum Disetor; kelebihan uang dicatat sebagai selisih lebih di tanda terima.</p>
      <label class="form-label">Collector</label>
      <select class="form-select mb-3" name="collector_user_id" required data-partial-collector><% partialCollectors.forEach(b=>{ %><option value="<%= b.user_id %>" data-amount="<%= Number(b.amount) %>"><%= b.collector_name %> · <%= formatRupiah(b.amount) %> (<%= b.transactions %> transaksi)</option><% }) %></select>
      <label class="form-label">Uang diserahkan (Rp)</label>
      <input class="form-control mb-1" type="number" name="handed_amount" min="1" step="1" inputmode="numeric" required data-partial-amount>
      <small class="text-secondary d-block mb-3">Total dipegang: <b data-partial-held>-</b> · <button type="button" class="btn btn-link btn-sm p-0 align-baseline" data-partial-fill>isi semua</button></small>
      <div class="row g-2"><div class="col-sm-6"><label class="form-label">Tanggal setoran</label><input class="form-control" type="date" name="settlement_date" value="<%= new Intl.DateTimeFormat('en-CA',{timeZone:'Asia/Jakarta'}).format(new Date()) %>" required></div><div class="col-sm-6"><label class="form-label">Catatan (opsional)</label><input class="form-control" name="notes" maxlength="500" placeholder="mis. setor via kantor"></div></div>
    </div>
    <div class="modal-footer"><button type="button" class="btn-tech" data-bs-dismiss="modal">Batal</button><button class="btn-tech success"><i class="bi bi-check2-circle"></i>Cocokkan &amp; Simpan</button></div>
  </form></div></div>
  <script>(()=>{const sel=document.querySelector('[data-partial-collector]');if(!sel)return;const held=document.querySelector('[data-partial-held]'),amount=document.querySelector('[data-partial-amount]'),fmt=v=>new Intl.NumberFormat('id-ID',{style:'currency',currency:'IDR',maximumFractionDigits:0}).format(v);const sync=()=>{held.textContent=fmt(Number(sel.selectedOptions[0]?.dataset.amount||0));};sel.addEventListener('change',sync);sync();document.querySelector('[data-partial-fill]')?.addEventListener('click',()=>{amount.value=Math.round(Number(sel.selectedOptions[0]?.dataset.amount||0));amount.focus();});})();</script>
  <% } %>
  <% } else { %>
  <% const statusLink=(value)=>'/payments/reconciliation?'+new URLSearchParams({...baseFilter,tab:'history',status:value,date_from:dateFrom,date_to:dateTo}).toString()+'#cashHistoryTable'; %>
  <div class="metric-grid mb-3">
    <a class="metric-card metric-card-link <%= status==='all'?'active':'' %>" href="<%= statusLink('all') %>"><div class="metric-top"><span class="metric-label">Semua Cash</span><span class="metric-icon"><i class="bi bi-collection"></i></span></div><strong><%= formatRupiah(historySummary.amount||0) %></strong><small><%= Number(historySummary.transactions||0) %> transaksi · <%= Number(historySummary.customers||0) %> pelanggan</small></a>
    <a class="metric-card green metric-card-link <%= status==='settled'?'active':'' %>" href="<%= statusLink('settled') %>"><div class="metric-top"><span class="metric-label">Sudah Disetor</span><span class="metric-icon"><i class="bi bi-safe2-fill"></i></span></div><strong><%= formatRupiah(historySummary.settled_amount||0) %></strong><small><%= Number(historySummary.settled_count||0) %> transaksi sudah masuk kas</small></a>
    <a class="metric-card orange metric-card-link <%= status==='held'?'active':'' %>" href="<%= statusLink('held') %>"><div class="metric-top"><span class="metric-label">Belum Disetor</span><span class="metric-icon"><i class="bi bi-hourglass-split"></i></span></div><strong><%= formatRupiah(historySummary.held_amount||0) %></strong><small><%= Number(historySummary.held_count||0) %> transaksi masih di tim</small></a>
  </div>
  <% if(historyCharts){ const hs=historySummary, sp=historyCharts.speed; const totalAmt=Number(hs.amount||0); const ratio=totalAmt?Math.round(Number(hs.settled_amount||0)/totalAmt*100):0; %>
  <section class="recon-analytics mb-3" aria-label="Analisis histori setoran">
    <div class="recon-kpi-strip">
      <div><span>Rasio disetor</span><b class="<%= ratio>=90?'text-success':ratio<70?'text-danger':'' %>"><%= ratio %>%</b></div>
      <div><span>Rata-rata lama setor</span><b><%= sp.count?(sp.avgHours>=48?(sp.avgHours/24).toFixed(1)+' hari':Math.round(sp.avgHours)+' jam'):'-' %></b></div>
      <div><span>Disetor ≤ 24 jam</span><b><%= sp.count?Math.round(sp.withinDay/sp.count*100)+'%':'-' %></b></div>
      <div><span>Disetor &gt; 3 hari</span><b class="<%= sp.overThreeDays?'text-danger':'' %>"><%= sp.overThreeDays %> transaksi</b></div>
    </div>
    <div class="recon-chart-grid">
      <article class="data-card recon-chart-card"><div class="data-card-head"><div><h3>Status Setoran</h3><small>Sudah vs belum disetor (nominal)</small></div><i class="bi bi-pie-chart-fill"></i></div><div class="recon-chart-body"><canvas id="reconStatusChart" aria-label="Grafik status setoran"></canvas></div></article>
      <article class="data-card recon-chart-card wide"><div class="data-card-head"><div><h3>Tren <%= historyCharts.monthly?'Bulanan':'Harian' %></h3><small>Cash diterima tim vs masuk kas perusahaan</small></div><i class="bi bi-graph-up-arrow"></i></div><div class="recon-chart-body"><canvas id="reconTrendChart" aria-label="Grafik tren setoran"></canvas></div></article>
      <article class="data-card recon-chart-card"><div class="data-card-head"><div><h3>Kecepatan Setor</h3><small>Lama dari dibayar sampai masuk kas</small></div><i class="bi bi-speedometer2"></i></div><div class="recon-chart-body"><canvas id="reconSpeedChart" aria-label="Grafik kecepatan setor"></canvas></div></article>
      <article class="data-card recon-chart-card wide"><div class="data-card-head"><div><h3>Per Collector</h3><small>Sudah vs belum disetor</small></div><i class="bi bi-people-fill"></i></div><div class="recon-chart-body"><canvas id="reconHistCollectorChart" aria-label="Grafik per collector"></canvas></div></article>
      <article class="data-card recon-chart-card full"><div class="data-card-head"><div><h3>Per Site</h3><small>Sudah vs belum disetor</small></div><i class="bi bi-geo-alt-fill"></i></div><div class="recon-chart-body"><canvas id="reconHistSiteChart" aria-label="Grafik per site"></canvas></div></article>
    </div>
  </section>
  <% } %>

  <% if(collectorSummary.length){ %>
  <div class="data-card mb-3">
    <div class="data-card-head"><div><h3>Ringkasan per Collector</h3><small>Periode dan filter yang sama dengan tabel histori di bawah.</small></div></div>
    <div class="table-responsive"><table class="app-table"><thead><tr><th>Collector</th><th>Transaksi</th><th>Sudah Disetor</th><th>Belum Disetor</th><th>Progres</th></tr></thead><tbody>
      <% collectorSummary.forEach(c=>{ const tot=Number(c.settled_amount)+Number(c.held_amount); const pct=tot?Math.round(Number(c.settled_amount)/tot*100):0; %><tr><td><span class="cell-main"><%= c.collector_name %></span></td><td><%= c.transactions %></td><td class="money"><%= formatRupiah(c.settled_amount) %><span class="cell-sub"><%= c.settled_count %> transaksi</span></td><td class="money"><%= formatRupiah(c.held_amount) %><span class="cell-sub"><%= c.held_count %> transaksi</span></td><td><div class="recon-progress" title="<%= pct %>% sudah disetor"><span style="width:<%= pct %>%"></span></div><span class="cell-sub"><%= pct %>% disetor</span></td></tr><% }) %>
    </tbody></table></div>
  </div>
  <% } %>

  <div class="data-card mb-3" id="cashSettlementList">
    <div class="data-card-head"><div><h3>Daftar Setoran</h3><small>Nomor setoran per tanggal setor <%= dateFrom %> s.d. <%= dateTo %> — cetak tanda terima atau batalkan satu batch.</small></div></div>
    <div class="table-responsive"><table class="app-table"><thead><tr><th>No. Setoran</th><th>Tanggal</th><th>Collector</th><th>Transaksi</th><th>Total</th><th>Diserahkan</th><th>Status</th><th>Aksi</th></tr></thead><tbody>
      <% settlements.forEach(st=>{ const cancelled=st.status==='cancelled'; %><tr><td><span class="cell-main"><%= st.code %></span><span class="cell-sub"><%= st.mode==='partial'?'Setoran sebagian':'Konfirmasi setoran' %> · <%= st.created_by_name||'-' %></span></td><td><%= new Date(st.settlement_date).toLocaleDateString('id-ID',{day:'2-digit',month:'short',year:'numeric'}) %></td><td><%= st.collector_name %></td><td><%= st.payment_count %></td><td class="money"><%= formatRupiah(st.total_amount) %></td><td class="money"><%= st.handed_amount!=null?formatRupiah(st.handed_amount):'-' %><% if(Number(st.difference_amount)){ %><span class="cell-sub text-danger">selisih <%= formatRupiah(st.difference_amount) %></span><% } %></td><td><span class="status-badge <%= cancelled?'red':'green' %>"><%= cancelled?'dibatalkan':'aktif' %></span></td><td><div class="d-flex gap-1 flex-wrap"><a class="btn-tech btn-sm" href="/payments/settlements/<%= st.id %>/receipt.pdf" target="_blank" rel="noopener"><i class="bi bi-printer"></i>Tanda Terima</a><% if(canCancelSettlement&&!cancelled){ %><button type="button" class="btn-tech danger btn-sm" data-bs-toggle="modal" data-bs-target="#cancelSettlementModal" data-cancel-action="/payments/settlements/<%= st.id %>/cancel" data-cancel-label="seluruh setoran <%= st.code %> (<%= st.payment_count %> transaksi, <%= formatRupiah(st.total_amount) %>)"><i class="bi bi-arrow-counterclockwise"></i>Batalkan</button><% } %></div></td></tr><% }) %>
      <% if(!settlements.length){ %><tr><td colspan="8"><div class="empty-state"><i class="bi bi-receipt"></i><strong>Belum ada nomor setoran pada periode ini</strong><small>Setoran sebelum fitur nomor setoran tetap terlihat di histori di bawah.</small></div></td></tr><% } %>
    </tbody></table></div>
  </div>

  <div class="data-card" id="cashHistoryTable">
    <div class="data-card-head"><div><h3>Histori Cash Pelanggan · <%= ({all:'Semua Status',held:'Belum Disetor',settled:'Sudah Disetor'})[status] %></h3><small>Tanggal bayar <%= new Date(dateFrom+'T00:00:00').toLocaleDateString('id-ID',{day:'2-digit',month:'short',year:'numeric'}) %> – <%= new Date(dateTo+'T00:00:00').toLocaleDateString('id-ID',{day:'2-digit',month:'short',year:'numeric'}) %><% if(history.length>=historyLimit){ %> · menampilkan <%= historyLimit %> transaksi terbaru, persempit filter untuk melihat sisanya<% } %></small></div></div>
    <div class="table-responsive"><table class="app-table"><thead><tr><th class="app-seq-col">No.</th><th>Pelanggan</th><th>Site</th><th>Collector</th><th>Nominal</th><th>Dibayar</th><th>Status</th><th>Diterima Kas</th><th>Aksi</th></tr></thead><tbody>
      <% history.forEach((p,index)=>{ const settled=p.settlement_status==='settled'; %><tr><td><span class="cell-main"><%= index+1 %></span></td><td><span class="cell-main"><%= p.customer_name %></span><span class="cell-sub"><%= p.customer_code %> · <%= p.invoice_number %></span></td><td><span class="status-badge purple"><%= p.site_code %><%= p.cluster_name?` · Cluster ${p.cluster_name}`:'' %></span></td><td><span class="cell-main"><%= p.collector_name %></span></td><td class="money"><%= formatRupiah(p.amount) %></td><td><%= new Date(p.paid_at).toLocaleString('id-ID',{timeZone:'Asia/Jakarta'}) %></td><td><span class="status-badge <%= settled?'green':'orange' %>"><%= settled?'sudah disetor':'belum disetor' %></span></td><td><% if(settled){ %><span class="cell-main"><%= p.settled_at?new Date(p.settled_at).toLocaleString('id-ID',{timeZone:'Asia/Jakarta'}):'-' %></span><span class="cell-sub">oleh <%= p.settled_by_name %><% if(p.settlement_code){ %> · <a href="/payments/settlements/<%= p.settlement_id %>/receipt.pdf" target="_blank" rel="noopener"><%= p.settlement_code %></a><% } %></span><% } else { %><span class="cell-sub">Menunggu setoran · <a href="<%= tabHref('held') %>#cashHeldTable">konfirmasi</a></span><% } %></td><td><% if(settled&&canCancelSettlement){ %><button type="button" class="btn-tech danger btn-sm" data-bs-toggle="modal" data-bs-target="#cancelSettlementModal" data-cancel-action="/payments/<%= p.id %>/cancel-settlement" data-cancel-label="setoran <%= p.customer_name %> (<%= formatRupiah(p.amount) %>)"><i class="bi bi-arrow-counterclockwise"></i>Batalkan</button><% } else { %><span class="cell-sub">-</span><% } %></td></tr><% }) %>
      <% if(!history.length){ %><tr><td colspan="9"><div class="empty-state"><i class="bi bi-clock-history"></i><strong>Belum ada data pada periode ini</strong><small>Ubah rentang tanggal atau filter status untuk melihat histori lain.</small></div></td></tr><% } %>
    </tbody></table></div>
  </div>
  <% if(canCancelSettlement){ %>
  <div class="modal fade" id="cancelSettlementModal" tabindex="-1" aria-labelledby="cancelSettlementTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><form class="modal-content" method="post" action="" data-cancel-form data-loading-message="Membatalkan setoran...">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="return_to" value="<%= '/payments/reconciliation?'+new URLSearchParams({...baseFilter,tab:'history',status,date_from:dateFrom,date_to:dateTo}).toString() %>">
    <div class="modal-header"><div><small class="text-danger">MASTER ADMIN</small><h5 class="modal-title" id="cancelSettlementTitle">Batalkan Setoran</h5></div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Tutup"></button></div>
    <div class="modal-body">
      <p class="mb-2">Anda akan membatalkan <b data-cancel-label>-</b>.</p>
      <p class="text-secondary small">Jurnal "Setoran Cash" di Data Kas dihapus, baris Closing hasil sinkron dikeluarkan, dan pembayaran kembali ke Belum Disetor. Ditolak bila tanggal jurnal berada di periode Closing yang dikunci.</p>
      <label class="form-label">Alasan pembatalan</label>
      <textarea class="form-control" name="reason" rows="3" minlength="5" maxlength="500" required placeholder="mis. salah klik, uang belum diterima"></textarea>
    </div>
    <div class="modal-footer"><button type="button" class="btn-tech" data-bs-dismiss="modal">Kembali</button><button class="btn-tech danger"><i class="bi bi-arrow-counterclockwise"></i>Ya, Batalkan</button></div>
  </form></div></div>
  <script>(()=>{const modal=document.getElementById('cancelSettlementModal');if(!modal)return;modal.addEventListener('show.bs.modal',event=>{const btn=event.relatedTarget;if(!btn)return;modal.querySelector('[data-cancel-form]').action=btn.dataset.cancelAction||'';modal.querySelector('[data-cancel-label]').textContent=btn.dataset.cancelLabel||'setoran ini';modal.querySelector('textarea[name="reason"]').value='';});})();</script>
  <% } %>
  <% } %>
</section>
<% const reconChartData=isHistory?(historyCharts?{mode:'history',summary:{settled:Number(historySummary.settled_amount||0),held:Number(historySummary.held_amount||0)},...historyCharts}:null):(held.length?{mode:'held',agingDays,...heldCharts}:null); %>
<% if(reconChartData){ %>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
<script>
(()=>{
  if(typeof Chart==='undefined')return;
  const data=<%- safeJson(reconChartData) %>;
  const money=v=>'Rp '+new Intl.NumberFormat('id-ID',{maximumFractionDigits:0}).format(v||0);
  const short=v=>{v=Number(v)||0;if(Math.abs(v)>=1e9)return (v/1e9).toFixed(1)+' M';if(Math.abs(v)>=1e6)return (v/1e6).toFixed(1)+' jt';if(Math.abs(v)>=1e3)return Math.round(v/1e3)+' rb';return String(v);};
  const css=getComputedStyle(document.documentElement);const tick=(css.getPropertyValue('--muted')||'#77839a').trim()||'#77839a';const grid='rgba(148,163,184,.14)';
  const GREEN='#22c55e',ORANGE='#f59e0b',RED='#ef4444',PURPLE='#6C4FE0',BLUE='#3b82f6';
  const legend={labels:{color:tick,usePointStyle:true,boxWidth:8,font:{size:10}}};
  const make=(id,cfg)=>{const el=document.getElementById(id);if(el)new Chart(el,cfg);};
  const donut=(id,labels,values,colors)=>{
    const total=values.reduce((a,b)=>a+b,0);
    make(id,{type:'doughnut',data:{labels,datasets:[{data:values,backgroundColor:colors,borderWidth:2,borderColor:(css.getPropertyValue('--panel')||'#fff').trim()||'#fff',hoverOffset:6}]},
      options:{responsive:true,maintainAspectRatio:false,cutout:'62%',plugins:{legend:{position:'bottom',...legend},
        tooltip:{callbacks:{label:c=>`${c.label}: ${money(c.raw)} (${total?Math.round(c.raw/total*100):0}%)`}}}}});
  };
  const stacked=(id,rows,aLabel,aColor,bLabel,bColor,aKey,bKey,horizontal)=>make(id,{type:'bar',data:{labels:rows.map(r=>r.label),datasets:[
      {label:aLabel,data:rows.map(r=>r[aKey]),backgroundColor:aColor,borderRadius:5,maxBarThickness:26},
      {label:bLabel,data:rows.map(r=>r[bKey]),backgroundColor:bColor,borderRadius:5,maxBarThickness:26}]},
    options:{responsive:true,maintainAspectRatio:false,indexAxis:horizontal?'y':'x',interaction:{mode:'index',intersect:false},plugins:{legend,tooltip:{callbacks:{label:c=>`${c.dataset.label}: ${money(c.raw)}`}}},
      // Kunci `callback` hanya dipasang pada sumbu nilai: `callback:undefined` menimpa formatter bawaan
      // sumbu kategori sehingga label berubah jadi 0,1,2.
      scales:(()=>{const value={stacked:true,beginAtZero:true,grid:{color:grid},ticks:{color:tick,callback:v=>short(v)}};const cat={stacked:true,grid:{display:false},ticks:{color:tick,autoSkip:false}};return horizontal?{x:value,y:cat}:{x:cat,y:value};})()}});
  if(data.mode==='held'){
    donut('reconAgingChart',data.aging.map(x=>`${x.label} (${x.count})`),data.aging.map(x=>x.amount),[GREEN,ORANGE,RED,'#991b1b'].slice(0,data.aging.length));
    stacked('reconHeldCollectorChart',data.collectors.map(c=>({label:c.label,normal:c.amount-c.overdue,overdue:c.overdue})),'Normal',PURPLE,`Lewat ${data.agingDays} hari`,RED,'normal','overdue',true);
    donut('reconHeldSiteChart',data.sites.map(x=>x.label),data.sites.map(x=>x.amount),[PURPLE,BLUE,'#14b8a6',ORANGE,'#ec4899','#84cc16','#06b6d4','#a855f7','#f97316','#64748b']);
  }else{
    donut('reconStatusChart',['Sudah disetor','Belum disetor'],[data.summary.settled,data.summary.held],[GREEN,ORANGE]);
    const fmtLabel=k=>data.monthly?new Date(k+'-01T00:00:00').toLocaleDateString('id-ID',{month:'short',year:'2-digit'}):new Date(k+'T00:00:00').toLocaleDateString('id-ID',{day:'2-digit',month:'short'});
    make('reconTrendChart',{type:'line',data:{labels:data.trend.labels.map(fmtLabel),datasets:[
        {label:'Diterima tim (tgl bayar)',data:data.trend.collected,borderColor:ORANGE,backgroundColor:'rgba(245,158,11,.12)',fill:true,tension:.35,pointRadius:1.5},
        {label:'Masuk kas (tgl setor)',data:data.trend.settled,borderColor:GREEN,backgroundColor:'rgba(34,197,94,.12)',fill:true,tension:.35,pointRadius:1.5}]},
      options:{responsive:true,maintainAspectRatio:false,interaction:{mode:'index',intersect:false},plugins:{legend,tooltip:{callbacks:{label:c=>`${c.dataset.label}: ${money(c.raw)}`}}},
        scales:{x:{grid:{display:false},ticks:{color:tick,maxTicksLimit:12}},y:{beginAtZero:true,grid:{color:grid},ticks:{color:tick,callback:v=>short(v)}}}}});
    const sp=data.speed;const mid=Math.max(0,sp.count-sp.withinDay-sp.overThreeDays);
    make('reconSpeedChart',{type:'doughnut',data:{labels:['≤ 24 jam','1–3 hari','> 3 hari'],datasets:[{data:[sp.withinDay,mid,sp.overThreeDays],backgroundColor:[GREEN,ORANGE,RED],borderWidth:2,borderColor:(css.getPropertyValue('--panel')||'#fff').trim()||'#fff'}]},
      options:{responsive:true,maintainAspectRatio:false,cutout:'62%',plugins:{legend:{position:'bottom',...legend},tooltip:{callbacks:{label:c=>`${c.label}: ${c.raw} transaksi`}}}}});
    stacked('reconHistCollectorChart',data.collectors,'Sudah disetor',GREEN,'Belum disetor',ORANGE,'settled','held',true);
    stacked('reconHistSiteChart',data.sites,'Sudah disetor',GREEN,'Belum disetor',ORANGE,'settled','held',false);
  }
})();
</script>
<% } %>
