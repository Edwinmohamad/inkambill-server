<section>
  <div class="module-head">
    <div><div class="module-kicker">CASH RECONCILIATION</div><h1>Rekonsiliasi Pembayaran</h1><p>Pisahkan pembayaran pelanggan dari uang yang benar-benar sudah masuk ke kas perusahaan.</p></div>
    <div class="module-actions"><a href="/payments" class="btn-tech"><i class="bi bi-arrow-left"></i>Kembali ke Pembayaran</a></div>
  </div>
  <!-- v1.25.5 (update) — setiap widget di bawah sekarang bisa diklik: kartu ringkasan mengarah ke
       tempat datanya bisa diperiksa lebih lanjut (tabel di halaman ini atau Data Kas terkait), dan kartu
       collector memfilter tabel "Cash Belum Disetor" di bawah untuk collector tersebut. -->
  <div class="metric-grid">
    <a class="metric-card orange metric-card-link" href="#cashHeldTable"><div class="metric-top"><span class="metric-label">Cash Masih di Tim</span><span class="metric-icon"><i class="bi bi-person-vcard"></i></span></div><strong><%= formatRupiah(summary.held_total||0) %></strong><small>Belum masuk kas perusahaan · lihat tabel</small></a>
    <a class="metric-card green metric-card-link" href="/cash?q=<%= encodeURIComponent('Setoran Cash') %>"><div class="metric-top"><span class="metric-label">Setoran Cash Hari Ini</span><span class="metric-icon"><i class="bi bi-safe2-fill"></i></span></div><strong><%= formatRupiah(summary.settled_today||0) %></strong><small>Sudah direkonsiliasi · buka Data Kas</small></a>
    <a class="metric-card metric-card-link" href="/cash?q=<%= encodeURIComponent('Pembayaran') %>"><div class="metric-top"><span class="metric-label">Transfer Hari Ini</span><span class="metric-icon"><i class="bi bi-bank"></i></span></div><strong><%= formatRupiah(summary.transfer_today||0) %></strong><small>Confirmed transfer · buka Data Kas</small></a>
    <a class="metric-card metric-card-link" href="#collectorGrid"><div class="metric-top"><span class="metric-label">Collector Aktif</span><span class="metric-icon"><i class="bi bi-people-fill"></i></span></div><strong><%= staffBalances.length %></strong><small>Memegang cash pelanggan</small></a>
  </div>

  <div class="collector-grid mb-3" id="collectorGrid">
    <% staffBalances.forEach((s,index)=>{ %>
    <a class="collector-card reveal-item collector-card-link" style="--enter-delay:<%= index*45 %>ms" href="/payments/reconciliation?<%= new URLSearchParams({q:s.collector_name==='Tidak diketahui'?'':s.collector_name,site,cluster}).toString() %>#cashHeldTable" title="Filter tabel di bawah untuk collector ini"><div class="collector-avatar"><%= String(s.collector_name).charAt(0).toUpperCase() %></div><div><span>Cash di <%= s.collector_name %></span><strong><%= formatRupiah(s.amount) %></strong><small><%= s.transactions %> transaksi belum disetor</small></div><div class="collector-signal"></div></a>
    <% }) %>
    <% if(!staffBalances.length){ %><div class="success-banner"><i class="bi bi-check2-circle"></i><div><strong>Semua cash sudah clear</strong><small>Tidak ada setoran staff yang tertunda.</small></div></div><% } %>
  </div>

  <form class="filter-card" method="get" action="/payments/reconciliation"><div class="filter-grid payment-filter-grid"><div class="filter-group"><label>CARI</label><div class="search-box"><i class="bi bi-search"></i><input name="q" value="<%= q %>" placeholder="Pelanggan, Customer ID, faktur, collector..."></div></div><div class="filter-group"><label>SITE / POP</label><select class="form-select" name="site"><option value="">Semua Site</option><% sites.forEach(s=>{ %><option value="<%= s.code %>" <%= site===s.code?'selected':'' %>><%= s.code %> · <%= s.name %></option><% }) %></select></div><div class="filter-group"><label>CLUSTER / ODP</label><select class="form-select" name="cluster"><option value="">Semua Cluster</option><% clusters.forEach(c=>{ %><option value="<%= c.id %>" <%= String(cluster)===String(c.id)?'selected':'' %>><%= c.site_code %> · <%= c.name %></option><% }) %></select></div><div class="filter-group d-flex align-items-end gap-2"><button class="btn-tech primary flex-fill"><i class="bi bi-search"></i>Cari</button><a class="btn-tech" href="/payments/reconciliation"><i class="bi bi-x-lg"></i></a></div></div></form>

  <div class="data-card" id="cashHeldTable">
    <div class="data-card-head"><div><h3>Cash Belum Disetor</h3><small>Centang beberapa baris untuk Konfirmasi Setoran Massal, atau konfirmasi satu per satu lewat kolom Aksi.</small></div></div>
    <div class="table-responsive"><table class="app-table" data-bulk-scope="reconciliationBulkBar"><thead><tr><th class="app-check-col"><input type="checkbox" class="form-check-input" data-select-all aria-label="Pilih semua setoran"></th><th class="app-seq-col">No.</th><th>Collector</th><th>Pelanggan</th><th>Site</th><th>Nominal</th><th>Diterima</th><th>Status</th><th>Aksi</th></tr></thead><tbody>
      <% held.forEach((p,index)=>{ %><tr><td class="app-check-col"><input type="checkbox" class="form-check-input" data-row-check value="<%= p.id %>" aria-label="Pilih setoran <%= p.customer_name %>"></td><td><span class="cell-main"><%= index+1 %></span></td><td><span class="cell-main"><%= p.collector_name||'Tidak diketahui' %></span><span class="cell-sub">Cash holder</span></td><td><span class="cell-main"><%= p.customer_name %></span><span class="cell-sub"><%= p.customer_code %> · <%= p.invoice_number %></span></td><td><span class="status-badge purple"><%= p.site_code %><%= p.cluster_name?` · Cluster ${p.cluster_name}`:'' %></span></td><td class="money"><%= formatRupiah(p.amount) %></td><td><%= new Date(p.paid_at).toLocaleString('id-ID',{timeZone:'Asia/Jakarta'}) %></td><td><span class="status-badge orange">belum disetor</span></td><td><form method="post" action="/payments/<%= p.id %>/settle"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn-tech success btn-sm"><i class="bi bi-check2"></i>Konfirmasi Setoran</button></form></td></tr><% }) %>
      <% if(!held.length){ %><tr><td colspan="9"><div class="empty-state"><i class="bi bi-safe2"></i><strong>Tidak ada cash tertahan</strong><small>Semua uang pelanggan sudah masuk ke kas perusahaan.</small></div></td></tr><% } %>
    </tbody></table></div>
  </div>

  <div class="customer-bulk-bar" id="reconciliationBulkBar" hidden><span><b data-bulk-count>0</b> setoran terpilih</span><div class="customer-bulk-buttons"><button type="button" data-bulk-clear class="ghost"><i class="bi bi-x-lg"></i>Batal</button><button type="button" class="success" data-simple-delete-bulk data-simple-delete-variant="success" data-simple-delete-kicker="KONFIRMASI SETORAN" data-simple-delete-confirm-label="Ya, Konfirmasi" data-simple-delete-confirm-icon="bi-check2-circle" data-bulk-scope-id="reconciliationBulkBar" data-bulk-url="/payments/bulk-settle" data-bulk-action-field="action" data-bulk-action-value="settle" data-bulk-id-field="payment_ids[]" data-entity-label-plural="setoran" data-simple-delete-title="Konfirmasi setoran terpilih?" data-simple-delete-warning="Hanya setoran cash yang masih tertahan di staff (belum disetor) yang akan dikonfirmasi — sisanya otomatis dilewati. Kas perusahaan dan jurnal terkait akan diperbarui otomatis."><i class="bi bi-check2-circle"></i>Konfirmasi Setoran Massal</button></div></div>
</section>
