<section class="recon-page">
  <div class="module-head recon-head">
    <div><div class="recon-eyebrow"><span class="recon-dot"></span>Cash Reconciliation</div><h1>Rekonsiliasi Pembayaran</h1><p>Pembayaran pelanggan dibandingkan dengan uang yang sudah masuk kas perusahaan.</p></div>
    <% const isHistory=tab==='history';
       const baseFilter={q,site,cluster,collector};
       const reconciliationExportQuery=new URLSearchParams(isHistory?{...baseFilter,tab:'history',status,basis,date_from:dateFrom,date_to:dateTo}:baseFilter).toString();
       const tabHref=(name)=>'/payments/reconciliation?'+new URLSearchParams(name==='history'?{...baseFilter,tab:'history'}:baseFilter).toString(); %>
    <div class="module-actions recon-actions"><a class="btn-tech btn-sm" href="/payments/reconciliation/export.pdf?<%= reconciliationExportQuery %>"><i class="bi bi-filetype-pdf"></i>PDF</a><a class="btn-tech btn-sm" href="/payments/reconciliation/export.xlsx?<%= reconciliationExportQuery %>"><i class="bi bi-file-earmark-spreadsheet"></i>Excel</a><a href="/payments" class="btn-tech btn-sm"><i class="bi bi-arrow-left"></i>Pembayaran</a></div>
  </div>
  <% if(justSettled){ %><div class="success-banner mb-3 recon-settled-banner"><i class="bi bi-receipt-cutoff"></i><div><strong>Setoran <%= justSettled.code %> tersimpan</strong><small><%= justSettled.payment_count %> transaksi · <%= formatRupiah(justSettled.total_amount) %><% if(justSettled.handed_amount!=null){ %> · diserahkan <%= formatRupiah(justSettled.handed_amount) %><% if(Number(justSettled.difference_amount)){ %> · selisih lebih <%= formatRupiah(justSettled.difference_amount) %><% } %><% } %></small></div><a class="btn-tech success" href="/payments/settlements/<%= justSettled.id %>/receipt.pdf" target="_blank" rel="noopener"><i class="bi bi-printer"></i>Tanda Terima</a></div><% } %>
  <nav class="recon-seg" role="tablist" aria-label="Tampilan rekonsiliasi">
    <a class="recon-seg-btn <%= !isHistory?'active':'' %>" href="<%= tabHref('held') %>" role="tab" aria-selected="<%= !isHistory %>"><i class="bi bi-hourglass-split"></i>Belum Disetor<em><%= held.length %></em></a>
    <a class="recon-seg-btn <%= isHistory?'active':'' %>" href="<%= tabHref('history') %>" role="tab" aria-selected="<%= isHistory %>"><i class="bi bi-clock-history"></i>Histori &amp; Status</a>
  </nav>
  <% const presetHref=(from,to)=>'/payments/reconciliation?'+new URLSearchParams({...baseFilter,tab:'history',status,basis,date_from:from,date_to:to}).toString();
     const todayJkt=new Intl.DateTimeFormat('en-CA',{timeZone:'Asia/Jakarta'}).format(new Date());
     const shiftDay=(iso,n)=>{const d=new Date(iso+'T00:00:00Z');d.setUTCDate(d.getUTCDate()+n);return d.toISOString().slice(0,10);};
     const monthStart=todayJkt.slice(0,8)+'01';
     const prevMonthEnd=shiftDay(monthStart,-1), prevMonthStart=prevMonthEnd.slice(0,8)+'01';
     const presets=[['Hari ini',todayJkt,todayJkt],['Kemarin',shiftDay(todayJkt,-1),shiftDay(todayJkt,-1)],['7 hari',shiftDay(todayJkt,-6),todayJkt],['Bulan ini',monthStart,todayJkt],['Bulan lalu',prevMonthStart,prevMonthEnd]]; %>
  <form class="filter-card recon-filter" method="get" action="/payments/reconciliation">
    <% if(isHistory){ %><input type="hidden" name="tab" value="history"><% } %>
    <div class="filter-grid payment-filter-grid">
      <div class="filter-group"><label>CARI</label><div class="search-box"><i class="bi bi-search"></i><input name="q" value="<%= q %>" placeholder="Pelanggan, Customer ID, faktur<%= isHistory?', no. setoran':'' %>..."></div></div>
      <div class="filter-group"><label>COLLECTOR</label><select class="form-select" name="collector"><option value="">Semua Collector</option><% (collectors||[]).forEach(u=>{ %><option value="<%= u.id %>" <%= String(collector)===String(u.id)?'selected':'' %>><%= u.name %></option><% }) %></select></div>
      <div class="filter-group"><label>SITE / POP</label><select class="form-select" name="site"><option value="">Semua Site</option><% sites.forEach(s=>{ %><option value="<%= s.code %>" <%= site===s.code?'selected':'' %>><%= s.code %> · <%= s.name %></option><% }) %></select></div>
      <div class="filter-group"><label>CLUSTER / ODP</label><select class="form-select" name="cluster"><option value="">Semua Cluster</option><% clusters.forEach(c=>{ %><option value="<%= c.id %>" <%= String(cluster)===String(c.id)?'selected':'' %>><%= c.site_code %> · <%= c.name %></option><% }) %></select></div>
      <% if(!isHistory){ %>
      <div class="filter-group"><label>UMUR CASH</label><select class="form-select" name="aging"><option value="">Semua umur</option><option value="overdue" <%= aging==='overdue'?'selected':'' %>>Lewat <%= agingDays %> hari</option></select></div>
      <% } else { %>
      <div class="filter-group"><label>STATUS SETORAN</label><select class="form-select" name="status"><option value="all" <%= status==='all'?'selected':'' %>>Semua</option><option value="held" <%= status==='held'?'selected':'' %>>Belum Disetor</option><option value="settled" <%= status==='settled'?'selected':'' %>>Sudah Disetor</option></select></div>
      <div class="filter-group"><label>BERDASARKAN</label><select class="form-select" name="basis"><option value="paid" <%= basis!=='settled'?'selected':'' %>>Tanggal bayar</option><option value="settled" <%= basis==='settled'?'selected':'' %>>Tanggal masuk kas</option></select></div>
      <div class="filter-group"><label>DARI</label><input type="date" class="form-control" name="date_from" value="<%= dateFrom %>"></div>
      <div class="filter-group"><label>SAMPAI</label><input type="date" class="form-control" name="date_to" value="<%= dateTo %>"></div>
      <% } %>
      <div class="filter-group d-flex align-items-end gap-2"><button class="btn-tech primary flex-fill"><i class="bi bi-search"></i>Cari</button><a class="btn-tech" href="/payments/reconciliation<%= isHistory?'?tab=history':'' %>" aria-label="Reset filter"><i class="bi bi-x-lg"></i></a></div>
    </div>
    <% if(isHistory){ %><div class="recon-presets"><span>Periode cepat:</span><% presets.forEach(([label,f,t])=>{ %><a class="<%= dateFrom===f&&dateTo===t?'active':'' %>" href="<%= presetHref(f,t) %>"><%= label %></a><% }) %></div><% } %>
  </form>

  <% if(!isHistory){ const heldTotal=held.reduce((a,p)=>a+Number(p.amount||0),0); const lateRows=held.filter(p=>Number(p.age_days||0)>agingDays); const lateTotal=lateRows.reduce((a,p)=>a+Number(p.amount||0),0); const collectorCount=new Set(held.map(p=>p.collector_name||'-')).size; %>
  <div class="recon-summary-line mb-3">
    <div><span>Belum disetor</span><b><%= formatRupiah(heldTotal) %></b><small><%= held.length %> transaksi</small></div>
    <div><span>Lewat <%= agingDays %> hari</span><b class="<%= lateRows.length?'text-danger':'' %>"><%= formatRupiah(lateTotal) %></b><small><%= lateRows.length %> transaksi</small></div>
    <div><span>Collector</span><b><%= collectorCount %></b><small>memegang cash</small></div>
    <% if(canCancelSettlement){ %><form class="recon-aging-setting ms-auto" method="post" action="/payments/reconciliation/settings"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><i class="bi bi-bell"></i><span>Ingatkan bila cash dipegang &gt;</span><input class="form-control form-control-sm" type="number" name="cash_aging_alert_days" min="1" max="60" value="<%= agingDays %>" aria-label="Batas hari"><span>hari</span><button class="btn-tech btn-sm">Simpan</button></form><% } %>
  </div>
  <% } %>

  <% if(!isHistory){ %>
  <div class="data-card" id="cashHeldTable">
    <div class="data-card-head"><div><h3>Cash Belum Disetor<% if(aging==='overdue'){ %> · lewat <%= agingDays %> hari<% } %></h3><small>Centang baris untuk konfirmasi massal. Pakai Setor per Collector bila uang diserahkan sebagian.</small></div><div class="d-flex gap-2 flex-wrap"><% if(aging==='overdue'){ %><a class="btn-tech btn-sm" href="/payments/reconciliation?<%= new URLSearchParams(baseFilter).toString() %>#cashHeldTable"><i class="bi bi-x-lg"></i>Semua umur</a><% } %><% if(staffBalances.some(b=>Number(b.user_id)>0)){ %><button type="button" class="btn-tech primary btn-sm" data-bs-toggle="modal" data-bs-target="#partialSettleModal"><i class="bi bi-cash-coin"></i>Setor per Collector</button><% } %></div></div>
    <div class="table-responsive"><table class="app-table" data-bulk-scope="reconciliationBulkBar"><thead><tr><th class="app-check-col"><input type="checkbox" class="form-check-input" data-select-all aria-label="Pilih semua setoran"></th><th class="app-seq-col">No.</th><th>Collector</th><th>Pelanggan</th><th>Site</th><th>Nominal</th><th>Diterima</th><th>Umur</th><th class="text-end">Aksi</th></tr></thead><tbody>
      <% held.forEach((p,index)=>{ %><tr><td class="app-check-col"><input type="checkbox" class="form-check-input" data-row-check value="<%= p.id %>" aria-label="Pilih setoran <%= p.customer_name %>"></td><td><span class="cell-main"><%= index+1 %></span></td><td><span class="cell-main"><%= p.collector_name||'Tidak diketahui' %></span></td><td><span class="cell-main"><%= p.customer_name %></span><span class="cell-sub"><%= p.customer_code %> · <%= p.invoice_number %></span></td><td><span class="status-badge purple"><%= p.site_code %><%= p.cluster_name?` · Cluster ${p.cluster_name}`:'' %></span></td><td class="money"><%= formatRupiah(p.amount) %></td><td><%= new Date(p.paid_at).toLocaleString('id-ID',{timeZone:'Asia/Jakarta'}) %></td><td><% const age=Number(p.age_days||0); %><span class="cash-age <%= age>agingDays?'late':age>=Math.max(1,agingDays-1)?'warn':'' %>"><%= age===0?'hari ini':`${age} hari` %></span></td><td class="text-end"><form method="post" action="/payments/<%= p.id %>/settle"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn-tech success btn-sm"><i class="bi bi-check2"></i>Konfirmasi</button></form></td></tr><% }) %>
      <% if(!held.length){ %><tr><td colspan="9"><div class="empty-state"><i class="bi bi-safe2"></i><strong>Tidak ada cash tertahan</strong><small>Semua uang pelanggan sudah masuk ke kas perusahaan.</small></div></td></tr><% } %>
    </tbody></table></div>
  </div>

  <div class="customer-bulk-bar" id="reconciliationBulkBar" hidden><span><b data-bulk-count>0</b> setoran terpilih</span><div class="customer-bulk-buttons"><button type="button" data-bulk-clear class="ghost"><i class="bi bi-x-lg"></i>Batal</button><button type="button" class="success" data-simple-delete-bulk data-simple-delete-variant="success" data-simple-delete-kicker="KONFIRMASI SETORAN" data-simple-delete-confirm-label="Ya, Konfirmasi" data-simple-delete-confirm-icon="bi-check2-circle" data-bulk-scope-id="reconciliationBulkBar" data-bulk-url="/payments/bulk-settle" data-bulk-action-field="action" data-bulk-action-value="settle" data-bulk-id-field="payment_ids[]" data-entity-label-plural="setoran" data-simple-delete-title="Konfirmasi setoran terpilih?" data-simple-delete-warning="Hanya setoran cash yang masih tertahan di staff (belum disetor) yang akan dikonfirmasi — sisanya otomatis dilewati. Kas perusahaan dan jurnal terkait akan diperbarui otomatis."><i class="bi bi-check2-circle"></i>Konfirmasi Setoran Massal</button></div></div>
  <% const partialCollectors=staffBalances.filter(b=>Number(b.user_id)>0); if(partialCollectors.length){ %>
  <div class="modal fade" id="partialSettleModal" tabindex="-1" aria-labelledby="partialSettleTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><form class="modal-content" method="post" action="/payments/reconciliation/partial-settle" data-loading-message="Mencocokkan setoran ke transaksi tertua...">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="modal-header"><div><small class="text-secondary">SETORAN SEBAGIAN</small><h5 class="modal-title" id="partialSettleTitle">Setor per Collector</h5></div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Tutup"></button></div>
    <div class="modal-body">
      <p class="text-secondary small mb-3">Masukkan uang yang benar-benar diserahkan. Sistem mencocokkan ke transaksi tertua yang muat utuh (transaksi tidak dipecah). Sisanya tetap Belum Disetor; kelebihan uang dicatat sebagai selisih lebih di tanda terima.</p>
      <label class="form-label">Collector</label>
      <select class="form-select mb-3" name="collector_user_id" required data-partial-collector><% partialCollectors.forEach(b=>{ %><option value="<%= b.user_id %>" data-amount="<%= Number(b.amount) %>"><%= b.collector_name %> · <%= formatRupiah(b.amount) %> (<%= b.transactions %> transaksi)</option><% }) %></select>
      <label class="form-label">Uang diserahkan (Rp)</label>
      <input class="form-control mb-1" type="number" name="handed_amount" min="1" step="1" inputmode="numeric" required data-partial-amount>
      <small class="text-secondary d-block mb-3">Total dipegang: <b data-partial-held>-</b> · <button type="button" class="btn btn-link btn-sm p-0 align-baseline" data-partial-fill>isi semua</button></small>
      <div class="row g-2"><div class="col-sm-6"><label class="form-label">Tanggal setoran</label><input class="form-control" type="date" name="settlement_date" value="<%= new Intl.DateTimeFormat('en-CA',{timeZone:'Asia/Jakarta'}).format(new Date()) %>" required></div><div class="col-sm-6"><label class="form-label">Catatan (opsional)</label><input class="form-control" name="notes" maxlength="500" placeholder="mis. setor via kantor"></div></div>
    </div>
    <div class="modal-footer"><button type="button" class="btn-tech" data-bs-dismiss="modal">Batal</button><button class="btn-tech success"><i class="bi bi-check2-circle"></i>Cocokkan &amp; Simpan</button></div>
  </form></div></div>
  <script>(()=>{const sel=document.querySelector('[data-partial-collector]');if(!sel)return;const held=document.querySelector('[data-partial-held]'),amount=document.querySelector('[data-partial-amount]'),fmt=v=>new Intl.NumberFormat('id-ID',{style:'currency',currency:'IDR',maximumFractionDigits:0}).format(v);const sync=()=>{held.textContent=fmt(Number(sel.selectedOptions[0]?.dataset.amount||0));};sel.addEventListener('change',sync);sync();document.querySelector('[data-partial-fill]')?.addEventListener('click',()=>{amount.value=Math.round(Number(sel.selectedOptions[0]?.dataset.amount||0));amount.focus();});})();</script>
  <% } %>
  <% } else { %>
  <% const settledHours=h=>{if(h==null||h==='')return '';h=Number(h);if(!Number.isFinite(h)||h<0)return '';return h>=48?`${(h/24).toFixed(1)} hari`:`${h} jam`;}; %>
  <div class="recon-summary-line mb-3">
    <div><span>Total cash</span><b><%= formatRupiah(historySummary.amount||0) %></b><small><%= Number(historySummary.transactions||0) %> transaksi · <%= Number(historySummary.customers||0) %> pelanggan</small></div>
    <div><span>Sudah disetor</span><b class="text-success"><%= formatRupiah(historySummary.settled_amount||0) %></b><small><%= Number(historySummary.settled_count||0) %> transaksi</small></div>
    <div><span>Belum disetor</span><b class="<%= Number(historySummary.held_count||0)?'text-warning':'' %>"><%= formatRupiah(historySummary.held_amount||0) %></b><small><%= Number(historySummary.held_count||0) %> transaksi</small></div>
  </div>

  <div class="data-card" id="cashHistoryTable">
    <div class="data-card-head"><div><h3>Histori Cash Pelanggan · <%= ({all:'Semua Status',held:'Belum Disetor',settled:'Sudah Disetor'})[status] %></h3><small><%= basis==='settled'?'Tanggal masuk kas':'Tanggal bayar' %> <%= new Date(dateFrom+'T00:00:00').toLocaleDateString('id-ID',{day:'2-digit',month:'short',year:'numeric'}) %> – <%= new Date(dateTo+'T00:00:00').toLocaleDateString('id-ID',{day:'2-digit',month:'short',year:'numeric'}) %><% if(history.length>=historyLimit){ %> · menampilkan <%= historyLimit %> transaksi terbaru, persempit filter untuk melihat sisanya<% } %></small></div></div>
    <div class="table-responsive"><table class="app-table"><thead><tr><th class="app-seq-col">No.</th><th>Pelanggan</th><th>Site</th><th>Collector</th><th>Nominal</th><th>Dibayar</th><th>Status</th><th>Diterima Kas</th><th>Aksi</th></tr></thead><tbody>
      <% history.forEach((p,index)=>{ const settled=p.settlement_status==='settled'; %><tr><td><span class="cell-main"><%= index+1 %></span></td><td><span class="cell-main"><%= p.customer_name %></span><span class="cell-sub"><%= p.customer_code %> · <%= p.invoice_number %></span></td><td><span class="status-badge purple"><%= p.site_code %><%= p.cluster_name?` · Cluster ${p.cluster_name}`:'' %></span></td><td><span class="cell-main"><%= p.collector_name %></span></td><td class="money"><%= formatRupiah(p.amount) %></td><td><%= new Date(p.paid_at).toLocaleString('id-ID',{timeZone:'Asia/Jakarta'}) %></td><td><span class="status-badge <%= settled?'green':'orange' %>"><%= settled?'sudah disetor':'belum disetor' %></span></td><td><% if(settled){ %><span class="cell-main"><%= p.settled_at?new Date(p.settled_at).toLocaleString('id-ID',{timeZone:'Asia/Jakarta'}):'-' %></span><span class="cell-sub"><% if(settledHours(p.settle_hours)){ %>setor <%= settledHours(p.settle_hours) %> · <% } %>oleh <%= p.settled_by_name %><% if(p.settlement_code){ %> · <a href="/payments/settlements/<%= p.settlement_id %>/receipt.pdf" target="_blank" rel="noopener"><%= p.settlement_code %></a><% } %></span><% } else { %><span class="cell-sub">Menunggu setoran · <a href="<%= tabHref('held') %>#cashHeldTable">konfirmasi</a></span><% } %></td><td><% if(settled&&canCancelSettlement){ %><button type="button" class="btn-tech danger btn-sm" data-bs-toggle="modal" data-bs-target="#cancelSettlementModal" data-cancel-action="/payments/<%= p.id %>/cancel-settlement" data-cancel-label="setoran <%= p.customer_name %> (<%= formatRupiah(p.amount) %>)"><i class="bi bi-arrow-counterclockwise"></i>Batalkan</button><% } else { %><span class="cell-sub">-</span><% } %></td></tr><% }) %>
      <% if(!history.length){ %><tr><td colspan="9"><div class="empty-state"><i class="bi bi-clock-history"></i><strong>Belum ada data pada periode ini</strong><small><%= basis==='settled'&&status==='held'?'Cash belum disetor tidak punya tanggal masuk kas — pilih "Tanggal bayar".':'Ubah rentang tanggal atau filter status untuk melihat histori lain.' %></small></div></td></tr><% } %>
    </tbody></table></div>
  </div>
  <details class="data-card mt-3 recon-settlement-list" id="cashSettlementList"<%= settlements.length&&q?' open':'' %>>
    <summary class="data-card-head"><div><h3>Daftar Setoran (Batch) <em class="recon-count"><%= settlements.length %></em></h3><small>Tanggal setor <%= dateFrom %> s.d. <%= dateTo %>. Klik untuk buka · cetak tanda terima atau batalkan per batch.</small></div><i class="bi bi-chevron-down"></i></summary>
    <div class="table-responsive"><table class="app-table"><thead><tr><th>No. Setoran</th><th>Tanggal</th><th>Collector</th><th>Transaksi</th><th>Total</th><th>Diserahkan</th><th>Status</th><th>Aksi</th></tr></thead><tbody>
      <% settlements.forEach(st=>{ const cancelled=st.status==='cancelled'; %><tr><td><span class="cell-main"><%= st.code %></span><span class="cell-sub"><%= st.mode==='partial'?'Setoran sebagian':'Konfirmasi setoran' %> · <%= st.created_by_name||'-' %></span></td><td><%= new Date(st.settlement_date).toLocaleDateString('id-ID',{day:'2-digit',month:'short',year:'numeric'}) %></td><td><%= st.collector_name %></td><td><%= st.payment_count %></td><td class="money"><%= formatRupiah(st.total_amount) %></td><td class="money"><%= st.handed_amount!=null?formatRupiah(st.handed_amount):'-' %><% if(Number(st.difference_amount)){ %><span class="cell-sub text-danger">selisih <%= formatRupiah(st.difference_amount) %></span><% } %></td><td><span class="status-badge <%= cancelled?'red':'green' %>"><%= cancelled?'dibatalkan':'aktif' %></span></td><td><div class="d-flex gap-1 flex-wrap"><a class="btn-tech btn-sm" href="/payments/settlements/<%= st.id %>/receipt.pdf" target="_blank" rel="noopener"><i class="bi bi-printer"></i>Tanda Terima</a><% if(canCancelSettlement&&!cancelled){ %><button type="button" class="btn-tech danger btn-sm" data-bs-toggle="modal" data-bs-target="#cancelSettlementModal" data-cancel-action="/payments/settlements/<%= st.id %>/cancel" data-cancel-label="seluruh setoran <%= st.code %> (<%= st.payment_count %> transaksi, <%= formatRupiah(st.total_amount) %>)"><i class="bi bi-arrow-counterclockwise"></i>Batalkan</button><% } %></div></td></tr><% }) %>
      <% if(!settlements.length){ %><tr><td colspan="8"><div class="empty-state"><i class="bi bi-receipt"></i><strong>Belum ada nomor setoran pada periode ini</strong><small>Setoran sebelum fitur nomor setoran tetap terlihat di histori di bawah.</small></div></td></tr><% } %>
    </tbody></table></div>
  </details>
  <% if(canCancelSettlement){ %>
  <div class="modal fade" id="cancelSettlementModal" tabindex="-1" aria-labelledby="cancelSettlementTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><form class="modal-content" method="post" action="" data-cancel-form data-loading-message="Membatalkan setoran...">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="return_to" value="<%= '/payments/reconciliation?'+new URLSearchParams({...baseFilter,tab:'history',status,date_from:dateFrom,date_to:dateTo}).toString() %>">
    <div class="modal-header"><div><small class="text-danger">MASTER ADMIN</small><h5 class="modal-title" id="cancelSettlementTitle">Batalkan Setoran</h5></div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Tutup"></button></div>
    <div class="modal-body">
      <p class="mb-2">Anda akan membatalkan <b data-cancel-label>-</b>.</p>
      <p class="text-secondary small">Jurnal "Setoran Cash" di Data Kas dihapus, baris Closing hasil sinkron dikeluarkan, dan pembayaran kembali ke Belum Disetor. Ditolak bila tanggal jurnal berada di periode Closing yang dikunci.</p>
      <label class="form-label">Alasan pembatalan</label>
      <textarea class="form-control" name="reason" rows="3" minlength="5" maxlength="500" required placeholder="mis. salah klik, uang belum diterima"></textarea>
    </div>
    <div class="modal-footer"><button type="button" class="btn-tech" data-bs-dismiss="modal">Kembali</button><button class="btn-tech danger"><i class="bi bi-arrow-counterclockwise"></i>Ya, Batalkan</button></div>
  </form></div></div>
  <script>(()=>{const modal=document.getElementById('cancelSettlementModal');if(!modal)return;modal.addEventListener('show.bs.modal',event=>{const btn=event.relatedTarget;if(!btn)return;modal.querySelector('[data-cancel-form]').action=btn.dataset.cancelAction||'';modal.querySelector('[data-cancel-label]').textContent=btn.dataset.cancelLabel||'setoran ini';modal.querySelector('textarea[name="reason"]').value='';});})();</script>
  <% } %>
  <% } %>
</section>
