<section><div class="module-head"><div><div class="module-kicker">AD-HOC BILLING</div><h1>Faktur Custom</h1><p>Faktur non-bulanan untuk instalasi, material, jasa, atau transaksi khusus.</p></div><div class="module-actions"><button class="btn-tech primary" data-bs-toggle="modal" data-bs-target="#customModal"><i class="bi bi-file-earmark-plus-fill"></i>Buat Faktur</button></div></div>
<form class="filter-card" method="get"><div class="filter-grid payment-filter-grid"><div class="filter-group"><label>CARI</label><div class="search-box"><i class="bi bi-search"></i><input name="q" value="<%= q %>" placeholder="Pelanggan, Customer ID, faktur..."></div></div><div class="filter-group"><label>SITE / POP</label><select class="form-select" name="site"><option value="">Semua Site</option><% sites.forEach(s=>{ %><option value="<%= s.code %>" <%= site===s.code?'selected':'' %>><%= s.code %> · <%= s.name %></option><% }) %></select></div><div class="filter-group"><label>CLUSTER / ODP</label><select class="form-select" name="cluster"><option value="">Semua Cluster</option><% clusters.forEach(c=>{ %><option value="<%= c.id %>" <%= String(cluster)===String(c.id)?'selected':'' %>><%= c.site_code %> · <%= c.name %></option><% }) %></select></div><div class="filter-group d-flex align-items-end gap-2"><button class="btn-tech flex-fill"><i class="bi bi-search"></i>Cari</button><a class="btn-tech" href="/custom-invoices"><i class="bi bi-x-lg"></i></a></div></div></form>
<div class="data-card"><div class="data-card-head"><div><h3>Daftar Faktur Custom</h3><small>Terpisah dari faktur langganan bulanan</small></div></div><div class="table-responsive"><table class="app-table"><thead><tr><th class="app-seq-col">No.</th><th>Faktur</th><th>Pelanggan</th><th>Site / Cluster</th><th>Tanggal</th><th>Jatuh Tempo</th><th>Total</th><th>Status</th><th>Tindakan</th></tr></thead><tbody><% invoices.forEach((i,index)=>{ %><tr><td><span class="cell-main"><%= index+1 %></span></td><td class="text-purple"><%= i.invoice_number %></td><td><span class="cell-main"><%= i.customer_name %></span><span class="cell-sub"><%= i.customer_code||'CUSTOM' %></span></td><td><span class="cell-main"><%= i.site_code||'-' %></span><span class="cell-sub">Cluster <%= i.cluster_name||'-' %></span></td><td><%= formatDate(i.invoice_date) %></td><td><%= formatDate(i.due_date) %></td><td class="money"><%= formatRupiah(i.total) %></td><td><span class="status-badge <%= i.status==='paid'?'green':i.status==='sent'?'purple':i.status==='cancelled'?'red':'gray' %>"><%= statusLabel(i.status) %></span></td><td><div class="d-flex gap-1"><button type="button" class="btn-tech compact" title="Edit" data-bs-toggle="modal" data-bs-target="#editCustom<%= i.id %>"><i class="bi bi-pencil-square"></i></button><a class="btn-tech compact" href="/custom-invoices/<%= i.id %>/pdf"><i class="bi bi-file-earmark-pdf"></i>PDF</a></div></td></tr><% }) %><% if(!invoices.length){%><tr><td colspan="9"><div class="empty-state"><i class="bi bi-file-earmark-text"></i><strong>Data tidak ditemukan</strong><small>Ubah pencarian atau buat faktur custom.</small></div></td></tr><%}%></tbody></table></div></div></section>
<div class="modal fade" id="customModal" tabindex="-1"><div class="modal-dialog modal-lg modal-dialog-centered"><form class="modal-content" method="post" action="/custom-invoices"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="modal-header"><h5 class="modal-title">Buat Faktur Custom</h5><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="row g-3"><div class="col-md-6"><label class="form-label">Pelanggan Terdaftar</label><input class="form-control mb-2" type="search" id="customCustomerSearch" placeholder="Cari nama / Customer ID / site / cluster..."><select class="form-select" name="customer_id" id="customCustomerSelect"><option value="">Tidak dipilih</option><% customers.forEach(c=>{ %><option value="<%= c.id %>"><%= c.site_code %> · Cluster <%= c.cluster_name||'-' %> · <%= c.customer_code %> · <%= c.name %></option><% }) %></select></div><div class="col-md-6"><label class="form-label">Nama Customer Manual</label><input class="form-control" name="customer_name" placeholder="Jika bukan pelanggan"></div><div class="col-md-4"><label class="form-label">Tanggal</label><input class="form-control" type="date" name="invoice_date" required></div><div class="col-md-4"><label class="form-label">Jatuh Tempo</label><input class="form-control" type="date" name="due_date"></div><div class="col-md-4"><label class="form-label">Total</label><input class="form-control" type="number" name="total" required></div><div class="col-12"><label class="form-label">Deskripsi</label><textarea class="form-control" name="description" rows="3"></textarea></div></div></div><div class="modal-footer"><button class="btn-tech primary">Buat Faktur</button></div></form></div></div>
<% invoices.forEach(i=>{ %><div class="modal fade" id="editCustom<%= i.id %>" tabindex="-1"><div class="modal-dialog modal-lg modal-dialog-centered"><form class="modal-content" method="post" action="/custom-invoices/<%= i.id %>/edit"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="modal-header"><h5 class="modal-title">Edit Faktur · <%= i.invoice_number %></h5><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="row g-3"><div class="col-md-6"><label class="form-label">Pelanggan Terdaftar</label><select class="form-select" name="customer_id"><option value="">Tidak dipilih</option><% customers.forEach(c=>{ %><option value="<%= c.id %>" <%= String(i.customer_id||'')===String(c.id)?'selected':'' %>><%= c.site_code %> · Cluster <%= c.cluster_name||'-' %> · <%= c.customer_code %> · <%= c.name %></option><% }) %></select></div><div class="col-md-6"><label class="form-label">Nama Customer Manual</label><input class="form-control" name="customer_name" value="<%= i.customer_name||'' %>" placeholder="Jika bukan pelanggan"></div><div class="col-md-4"><label class="form-label">Tanggal</label><input class="form-control" type="date" name="invoice_date" value="<%= i.invoice_date?new Date(i.invoice_date).toISOString().slice(0,10):'' %>" required></div><div class="col-md-4"><label class="form-label">Jatuh Tempo</label><input class="form-control" type="date" name="due_date" value="<%= i.due_date?new Date(i.due_date).toISOString().slice(0,10):'' %>"></div><div class="col-md-4"><label class="form-label">Total</label><input class="form-control" type="number" name="total" value="<%= i.total %>" required></div><div class="col-md-6"><label class="form-label">Status</label><select class="form-select" name="status"><% ['draft','sent','paid','cancelled'].forEach(st=>{ %><option value="<%= st %>" <%= i.status===st?'selected':'' %>><%= statusLabel(st) %></option><% }) %></select></div><div class="col-12"><label class="form-label">Deskripsi</label><textarea class="form-control" name="description" rows="3"><%= i.description||'' %></textarea></div></div></div><div class="modal-footer"><button type="button" class="btn-tech" data-bs-dismiss="modal">Batal</button><button class="btn-tech primary">Simpan Perubahan</button></div></form></div></div><% }) %>
<script>(()=>{const input=document.getElementById('customCustomerSearch'),select=document.getElementById('customCustomerSelect');input?.addEventListener('input',()=>{const q=input.value.trim().toLowerCase();[...select.options].forEach((o,i)=>o.hidden=i>0&&!!q&&!o.text.toLowerCase().includes(q));});})();</script>
