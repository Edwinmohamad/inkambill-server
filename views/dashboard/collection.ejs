<% const monthNames=['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember']; const agingTotal=Number(aging.not_due||0)+Number(aging.days_1_7||0)+Number(aging.days_8_30||0)+Number(aging.days_31_plus||0); const agingPct=value=>agingTotal?Math.max(2,Math.round(Number(value||0)/agingTotal*100)):0; %>
<section class="collection-page">
  <div class="module-head"><div><div class="module-kicker">RECEIVABLE INTELLIGENCE</div><h1>Analisa Collection Rate</h1><p>Prioritaskan penagihan berdasarkan sisa piutang, umur tagihan, dan kebiasaan bayar pelanggan.</p></div><a class="btn-tech" href="/?site=<%= selectedSiteCode %>&month=<%= selectedMonth %>&year=<%= selectedYear %>"><i class="bi bi-arrow-left"></i>Dashboard</a></div>

  <form class="collection-filter" method="get" action="/collection-analysis">
    <label><span>Site / POP</span><select name="site"><option value="">Semua Site</option><% siteOptions.forEach(site=>{ %><option value="<%= site.code %>" <%= selectedSiteCode===site.code?'selected':'' %>><%= site.code %> · <%= site.name %></option><% }) %></select></label>
    <label><span>Bulan</span><select name="month"><% monthNames.forEach((month,index)=>{ %><option value="<%= index+1 %>" <%= selectedMonth===index+1?'selected':'' %>><%= month %></option><% }) %></select></label>
    <label><span>Tahun</span><input name="year" type="number" min="2020" max="2100" value="<%= selectedYear %>"></label>
    <label><span>Perilaku Bayar</span><select name="window"><option value="3" <%= windowMonths===3?'selected':'' %>>3 bulan terakhir</option><option value="6" <%= windowMonths===6?'selected':'' %>>6 bulan terakhir</option><option value="12" <%= windowMonths===12?'selected':'' %>>12 bulan terakhir</option></select></label>
    <button class="btn-tech primary"><i class="bi bi-funnel"></i>Terapkan</button>
  </form>

  <div class="collection-summary-grid">
    <article class="collection-rate-card"><div class="collection-rate-ring" style="--rate:<%= collectionRate %>"><span><strong><%= collectionRate %>%</strong><small>TERTAGIH</small></span></div><div><span>COLLECTION RATE</span><h3><%= monthNames[selectedMonth-1] %> <%= selectedYear %></h3><p><%= selectedSiteCode||'Semua Site' %> · Berdasarkan pembayaran yang masuk ke tagihan periode ini.</p></div></article>
    <article><i class="bi bi-receipt"></i><span><small>TOTAL TAGIHAN</small><strong><%= formatRupiah(summary.billed) %></strong><em><%= Number(summary.invoice_count||0) %> invoice</em></span></article>
    <article class="success"><i class="bi bi-check2-circle"></i><span><small>SUDAH TERTAGIH</small><strong><%= formatRupiah(summary.collected) %></strong><em><%= Number(summary.paid_count||0) %> invoice lunas</em></span></article>
    <article class="danger"><i class="bi bi-hourglass-split"></i><span><small>SISA PIUTANG</small><strong><%= formatRupiah(summary.outstanding) %></strong><em><%= Number(summary.open_count||0) %> invoice terbuka</em></span></article>
  </div>

  <article class="command-panel collection-aging-panel"><div class="command-panel-head"><div><span>AGING RECEIVABLE</span><h3>Umur Sisa Tagihan</h3></div><strong><%= formatRupiah(agingTotal) %></strong></div><div class="aging-grid">
    <% [['Belum Jatuh Tempo','not_due','green'],['Terlambat 1–7 Hari','days_1_7','yellow'],['Terlambat 8–30 Hari','days_8_30','orange'],['Lebih dari 30 Hari','days_31_plus','red']].forEach(item=>{ const value=Number(aging[item[1]]||0); %><div class="aging-item <%= item[2] %>"><div><span><%= item[0] %></span><strong><%= formatRupiah(value) %></strong></div><div class="aging-bar"><i style="width:<%= agingPct(value) %>%"></i></div><small><%= agingPct(value) %>% dari sisa piutang</small></div><% }) %>
  </div></article>

  <div class="collection-behavior-grid">
    <article class="command-panel"><div class="command-panel-head"><div><span>PELANGGAN RAJIN BAYAR</span><h3>Ketepatan Pembayaran Terbaik</h3></div><i class="bi bi-award-fill"></i></div><div class="payer-list"><% reliable.forEach((row,index)=>{ %><a href="/customers/<%= row.id %>"><b class="payer-rank"><%= index+1 %></b><div><strong><%= row.name %></strong><small><%= row.customer_code %> · <%= row.site_code %> · <%= row.invoice_count %> invoice</small></div><span class="payer-score green"><%= row.onTimeRate %>%<small>tepat waktu</small></span></a><% }) %><% if(!reliable.length){ %><div class="ink-empty">Belum cukup histori pembayaran.</div><% } %></div></article>
    <article class="command-panel"><div class="command-panel-head"><div><span>PERLU FOLLOW-UP</span><h3>Pelanggan Sering Terlambat</h3></div><i class="bi bi-alarm-fill"></i></div><div class="payer-list"><% frequentLate.forEach((row,index)=>{ %><a href="/customers/<%= row.id %>"><b class="payer-rank"><%= index+1 %></b><div><strong><%= row.name %></strong><small><%= row.customer_code %> · <%= row.site_code %> · rata-rata <%= row.avg_delay_days %> hari</small></div><span class="payer-score red"><%= row.late_count %><small>terlambat</small></span></a><% }) %><% if(!frequentLate.length){ %><div class="ink-empty">Tidak ada pelanggan terlambat pada rentang ini.</div><% } %></div></article>
  </div>

  <article class="command-panel collection-outstanding"><div class="command-panel-head"><div><span>ACTION LIST</span><h3>Sisa Belum Lunas · <%= monthNames[selectedMonth-1] %> <%= selectedYear %></h3></div><a class="ink-text-link" href="/invoices?month=<%= selectedMonth %>&year=<%= selectedYear %>&site=<%= selectedSiteCode %>">Buka Tagihan <i class="bi bi-arrow-right"></i></a></div><div class="table-responsive"><table class="app-table"><thead><tr><th class="app-seq-col">No.</th><th>Pelanggan</th><th>Site / Cluster</th><th>Invoice</th><th>Tertua</th><th>Sisa</th><th>Tindak Lanjut</th></tr></thead><tbody><% outstandingCustomers.forEach((row,index)=>{ const wa=String(row.phone||'').replace(/\D/g,'').replace(/^0/,'62'); const reminder=`Halo ${row.name}, kami mengingatkan sisa tagihan ${monthNames[selectedMonth-1]} ${selectedYear} sebesar ${formatRupiah(row.outstanding)}. Mohon konfirmasi pembayarannya. Terima kasih.`; %><tr><td><span class="cell-main"><%= index+1 %></span></td><td><a class="cell-main ink-text-link" href="/customers/<%= row.id %>"><%= row.name %></a><span class="cell-sub"><%= row.customer_code %></span></td><td><span class="cell-main"><%= row.site_code %></span><span class="cell-sub"><%= row.cluster_name||'-' %></span></td><td><%= row.invoice_count %></td><td><span class="<%= Number(row.max_days_late)>0?'text-danger-soft':'' %>"><%= formatDate(row.oldest_due) %></span><span class="cell-sub"><%= Number(row.max_days_late)>0?row.max_days_late+' hari terlambat':'belum jatuh tempo' %></span></td><td class="money text-danger-soft"><%= formatRupiah(row.outstanding) %></td><td><div class="d-flex gap-1"><a class="action-pill" href="/invoices?month=<%= selectedMonth %>&year=<%= selectedYear %>&customer=<%= row.id %>" title="Buka tagihan"><i class="bi bi-receipt"></i></a><% if(wa){ %><a class="action-pill" target="_blank" rel="noopener" href="https://wa.me/<%= wa %>?text=<%= encodeURIComponent(reminder) %>" title="Kirim pengingat WhatsApp"><i class="bi bi-whatsapp"></i></a><% } %></div></td></tr><% }) %><% if(!outstandingCustomers.length){ %><tr><td colspan="7"><div class="empty-state"><i class="bi bi-check2-circle"></i><strong>Semua tagihan periode ini sudah lunas</strong><small>Tidak ada pelanggan yang perlu ditindaklanjuti.</small></div></td></tr><% } %></tbody></table></div></article>
</section>
