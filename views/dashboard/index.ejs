<% const monthNames=['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember']; const siteQuery=selectedSiteCode?`&site=${encodeURIComponent(selectedSiteCode)}`:''; const customerSiteQuery=selectedSiteCode?`site=${encodeURIComponent(selectedSiteCode)}`:''; const kpiSiteQuery=kpiSiteCode?`&site=${encodeURIComponent(kpiSiteCode)}`:''; const networkTarget=can('network')?'/nms/secrets':`/customers?${customerSiteQuery}${customerSiteQuery?'&':''}status=active&network=problem`; const ticketTarget=can('support')?`/tickets?status=active${siteQuery}`:'/'; const cashTarget=isAdmin?'/payments/reconciliation':(can('billing')?'/payments':'/'); const bm=billingMonitor; const bmTiming=selectedCycle==='all'?bm.timing:bm.timing.cycles[selectedCycle]; const bmMonthlyIncome=(bm.revenueSeries?.income||[]).reduce((a,v)=>a+Number(v||0),0); const bmDueBucket=c=>String(c)==='15'?'due15':'due30'; const bmHLabel=d=>Number(d)>0?`H+${Number(d)}`:Number(d)<0?`H${Number(d)}`:'Hari H'; %>
<section class="command-dashboard dashboard-v19 dashboard-v112 dashboard-v114 dashboard-v115 dashboard-v116 dashboard-v117 dashboard-v119">
  <div class="command-hero">
    <div class="command-hero-copy">
      <div class="command-eyebrow"><span class="command-live-dot"></span> INKAMNET NETWORK & BILLING COMMAND CENTER</div>
      <div class="command-welcome-line">
        <a href="/profile" class="dashboard-user-identity" title="Buka profil <%= user?.name||'Administrator' %>">
          <span class="dashboard-user-photo"><% if(user?.profile_photo){ %><img src="/profile/photo/<%= encodeURIComponent(user.profile_photo) %>" alt="Foto <%= user.name %>"><% }else{ %><b><%= (user?.name||'A').charAt(0).toUpperCase() %></b><i class="bi bi-person-fill"></i><% } %></span>
          <span class="dashboard-user-copy"><small><i></i> SEDANG ONLINE</small><strong><%= statusLabel(actualRole||user?.role||'admin') %></strong><em><i class="bi bi-person-circle"></i> Buka profil</em></span>
        </a>
        <div class="command-welcome-copy"><h1><%= greeting %>, <%= user?.name||'Administrator' %></h1><p>Ringkasan operasional terbaru.</p></div>
      </div>
    </div>
    <div class="command-hero-actions">
      <form class="command-period command-period-v126" method="get" action="/" data-auto-filter aria-label="Filter Dashboard Billing">
        <select name="site" aria-label="Filter site"><option value="">Semua Site</option><% siteOptions.forEach(s=>{ %><option value="<%= s.code %>" <%= selectedSiteCode===s.code?'selected':'' %>><%= s.code %> · <%= s.name %></option><% }) %></select>
        <select name="month" aria-label="Filter bulan"><% monthNames.forEach((m,i)=>{ %><option value="<%= i+1 %>" <%= selectedMonth===i+1?'selected':'' %>><%= m %></option><% }) %></select>
        <select name="year" aria-label="Filter tahun"><% years.forEach(y=>{ %><option value="<%= y %>" <%= selectedYear===y?'selected':'' %>><%= y %></option><% }) %></select>
        <select name="cycle" aria-label="Filter siklus tagihan"><option value="all" <%= selectedCycle==='all'?'selected':'' %>>Siklus 15 + 30</option><option value="15" <%= selectedCycle==='15'?'selected':'' %>>Jatuh Tempo 15</option><option value="30" <%= selectedCycle==='30'?'selected':'' %>>Jatuh Tempo 30</option></select>
        <select name="trend" aria-label="Rentang tren"><option value="3" <%= trendMonths===3?'selected':'' %>>Tren 3 Bulan</option><option value="6" <%= trendMonths===6?'selected':'' %>>Tren 6 Bulan</option><option value="12" <%= trendMonths===12?'selected':'' %>>Tren 12 Bulan</option></select>
      </form>
      <a href="/customers/new" class="command-add"><i class="bi bi-person-plus-fill"></i>Tambah Pelanggan</a>
    </div>
  </div>

  <div class="dashboard-user-ticker" aria-label="Aktivitas user terbaru">
    <div class="dashboard-user-ticker-label"><i class="bi bi-person-workspace"></i><span><b>AKTIVITAS USER</b><small>Frequent & last login</small></span></div>
    <div class="dashboard-user-ticker-viewport"><div class="dashboard-user-ticker-track">
      <% const tickerItems=loginTicker.length?loginTicker:[{kind:'recent',name:user?.name||'Administrator',detail:'Sedang Online',time:new Date()}]; const tickerLoop=[...tickerItems,...tickerItems]; tickerLoop.forEach(item=>{ %><span class="ticker-login-item"><i class="bi <%= item.kind==='frequent'?'bi-fire':'bi-clock-history' %>"></i><b><%= item.name %></b><small><%= item.detail %> · <%= item.time?new Date(item.time).toLocaleString('id-ID',{day:'2-digit',month:'short',hour:'2-digit',minute:'2-digit',timeZone:'Asia/Jakarta'}):'-' %></small></span><% }) %>
    </div></div>
  </div>

  <div class="command-kpis command-kpis-v19">
    <a href="/customers?<%= customerSiteQuery %>" class="command-kpi purple"><span class="command-kpi-icon"><i class="bi bi-people-fill"></i></span><div><small>TOTAL PELANGGAN</small><strong><%= Number(customer.total||0) %></strong><em><%= selectedSiteCode||'SEMUA SITE' %></em></div></a>
    <a href="/customers?<%= customerSiteQuery %><%= customerSiteQuery?'&':'' %>status=active" class="command-kpi green"><span class="command-kpi-icon"><i class="bi bi-person-check-fill"></i></span><div><small>PELANGGAN AKTIF</small><strong><%= Number(customer.active||0) %></strong><em>Service aktif</em></div></a>
    <a href="/customers?<%= customerSiteQuery %><%= customerSiteQuery?'&':'' %>status=inactive" class="command-kpi orange"><span class="command-kpi-icon"><i class="bi bi-person-dash-fill"></i></span><div><small>TIDAK AKTIF</small><strong><%= Number(customer.inactive||0) %></strong><em>Ditangguhkan / berhenti</em></div></a>
    <a href="/customers?<%= customerSiteQuery %><%= customerSiteQuery?'&':'' %>status=active&network=isolated" class="command-kpi red"><span class="command-kpi-icon"><i class="bi bi-wifi-off"></i></span><div><small>TERISOLIR</small><strong><%= Number(customer.isolated||0) %></strong><em>Network isolated</em></div></a>
    <% if(isAdmin){ %>
    <a href="/payments?month=<%= selectedMonth %>&year=<%= selectedYear %><%= siteQuery %>" class="command-kpi green"><span class="command-kpi-icon"><i class="bi bi-cash-coin"></i></span><div><small>KAS MASUK</small><strong><%= formatRupiah(bmMonthlyIncome) %></strong><em>Approved · <%= monthNames[selectedMonth-1] %> <%= selectedYear %></em></div></a>
    <a href="/invoices?month=<%= kpiMonth %>&year=<%= kpiYear %>&status=open<%= kpiSiteQuery %>" class="command-kpi red"><span class="command-kpi-icon"><i class="bi bi-exclamation-diamond-fill"></i></span><div><small>OUTSTANDING</small><strong><%= formatRupiah(unpaid.total||0) %></strong><em><%= Number(unpaid.count||0) %> tagihan · <%= kpiSiteCode||'Semua Site' %></em></div></a>
    <% } %>
  </div>

  <% if(can('billing')){ %>
  <section class="billing-monitor-v126" aria-labelledby="billingMonitorTitle">
    <header class="billing-monitor-head">
      <div>
        <span class="billing-monitor-kicker"><i class="bi bi-graph-up-arrow"></i> BILLING COLLECTION MONITOR</span>
        <h2 id="billingMonitorTitle">Pendapatan & progres tagihan <%= monthNames[selectedMonth-1] %> <%= selectedYear %></h2>
        <p><%= selectedSiteCode||'Semua Site' %> · <%= selectedCycle==='all'?'Siklus 15 & 30':`Siklus ${selectedCycle}` %> · pendapatan dihitung hanya setelah masuk Data Kas.</p>
      </div>
      <div class="billing-monitor-links">
        <a href="/payments?approval=pending<%= selectedSiteCode?`&site=${encodeURIComponent(selectedSiteCode)}`:'' %>"><i class="bi bi-shield-check"></i> Approval</a>
        <a href="/invoices?month=<%= selectedMonth %>&year=<%= selectedYear %><%= siteQuery %>"><i class="bi bi-receipt"></i> Tagihan</a>
        <% if(isAdmin){ %><a href="/cash?month=<%= selectedMonth %>&year=<%= selectedYear %><%= siteQuery %>"><i class="bi bi-wallet2"></i> Data Kas</a><% } %>
      </div>
    </header>

    <div class="billing-monitor-top-grid">
      <article class="bm-card bm-revenue-card">
        <div class="bm-card-top"><span><i class="bi bi-arrow-down-left-circle-fill"></i> PENDAPATAN HARI INI</span><em><i></i> LIVE</em></div>
        <% if(isAdmin){ %><strong class="bm-big-money"><%= formatRupiah(bm.today.amount) %></strong><% }else{ %><strong class="bm-big-money"><%= bm.today.count %> transaksi</strong><% } %>
        <div class="bm-revenue-meta"><span><b><%= bm.today.count %></b> pembayaran masuk kas</span><span class="<%= bm.today.deltaPct!=null&&bm.today.deltaPct>=0?'up':bm.today.deltaPct!=null?'down':'' %>"><% if(bm.today.deltaPct!=null){ %><i class="bi <%= bm.today.deltaPct>=0?'bi-arrow-up-right':'bi-arrow-down-right' %>"></i><%= Math.abs(bm.today.deltaPct) %>% vs kemarin<% }else{ %>Belum ada pembanding kemarin<% } %></span></div>
        <% if(isAdmin){ %><div class="bm-method-grid"><span><small>Transfer</small><b><%= formatRupiah(bm.today.transfer) %></b></span><span><small>QRIS</small><b><%= formatRupiah(bm.today.qris) %></b></span><span><small>Cash disetor</small><b><%= formatRupiah(bm.today.cash) %></b></span></div><% } %>
        <a class="bm-pending-strip" href="/payments?approval=pending<%= selectedSiteCode?`&site=${encodeURIComponent(selectedSiteCode)}`:'' %>"><span><i class="bi bi-hourglass-split"></i><b><%= bm.today.pendingCount %> pending approval</b></span><% if(isAdmin){ %><strong><%= formatRupiah(bm.today.pendingAmount) %></strong><% } %><i class="bi bi-chevron-right"></i></a>
      </article>

      <% ['15','30'].forEach(cycle=>{ const c=bm.cycles[cycle]; const dueBucket=bmDueBucket(cycle); %>
      <article class="bm-card bm-cycle-card <%= selectedCycle===cycle?'is-selected':'' %>">
        <div class="bm-cycle-title"><span><small>JATUH TEMPO</small><strong><%= cycle %></strong></span><% if(selectedCycle===cycle){ %><em>FILTER AKTIF</em><% } %><i class="bi bi-calendar2-check"></i></div>
        <div class="bm-cycle-rate"><strong><%= c.customerRate.toFixed(1) %>%</strong><span><b><%= c.paidCount %> / <%= c.invoiceCount %></b> pelanggan lunas</span></div>
        <div class="bm-progress-track" aria-label="Progress pelanggan lunas <%= c.customerRate %> persen"><i style="--bm-progress:<%= c.customerRate %>%"></i></div>
        <% if(isAdmin){ %><div class="bm-cycle-money"><span><small>Tertagih</small><b><%= formatRupiah(c.collected) %></b></span><span><small>Total</small><b><%= formatRupiah(c.billed) %></b></span></div><% } %>
        <div class="bm-cycle-status">
          <a class="ok" href="/invoices?month=<%= selectedMonth %>&year=<%= selectedYear %>&status=paid&due_bucket=<%= dueBucket %><%= siteQuery %>"><i></i><span><b><%= c.paidCount %> Lunas</b><small><%= c.nominalRate.toFixed(1) %>% nominal</small></span></a>
          <a class="pending" href="/invoices?month=<%= selectedMonth %>&year=<%= selectedYear %>&status=pending_approval&due_bucket=<%= dueBucket %><%= siteQuery %>"><i></i><span><b><%= c.pendingCount %> Pending</b><small>menunggu approval</small></span></a>
          <button class="danger" type="button" data-bs-toggle="modal" data-bs-target="#billingUnpaidModal" data-bm-cycle="<%= cycle %>"><i></i><span><b><%= c.openCount %> Belum bayar</b><small><% if(isAdmin){ %><%= formatRupiah(c.outstanding) %><% }else{ %>perlu follow-up<% } %></small></span><i class="bi bi-chevron-right"></i></button>
        </div>
        <div class="bm-cycle-foot"><span><% if(c.deltaCustomerRate!=null){ %><i class="bi <%= c.deltaCustomerRate>=0?'bi-arrow-up-right':'bi-arrow-down-right' %>"></i><%= Math.abs(c.deltaCustomerRate).toFixed(1) %> pt vs bulan lalu<% }else{ %>Belum ada pembanding bulan lalu<% } %></span><a href="/invoices?month=<%= selectedMonth %>&year=<%= selectedYear %>&due_bucket=<%= dueBucket %><%= siteQuery %>">Detail <i class="bi bi-arrow-right"></i></a></div>
      </article>
      <% }) %>
    </div>

    <div class="billing-monitor-chart-grid">
      <article class="bm-card bm-chart-card bm-collection-chart-card">
        <div class="bm-chart-head"><div><span>PROGRESS COLLECTION</span><h3>Kecepatan pelunasan siklus 15 / 30</h3><small>Progress bergerak saat pembayaran di-approve.</small></div><div class="bm-chart-controls"><div class="bm-segment"><button type="button" class="active" data-bm-progress-view="progress">Harian</button><button type="button" data-bm-progress-view="trend">Tren <%= trendMonths %> bln</button></div><div class="bm-segment"><button type="button" class="active" data-bm-progress-metric="customer">Pelanggan</button><button type="button" data-bm-progress-metric="nominal" <%= !isAdmin?'disabled':'' %>>Nominal</button></div></div></div>
        <div class="bm-chart-canvas"><canvas id="billingCollectionProgressChart"></canvas></div>
        <div class="bm-chart-legend"><span class="cycle15"><i></i>Siklus 15</span><span class="cycle30"><i></i>Siklus 30</span><small><i></i>garis putus = jatuh tempo</small></div>
      </article>

      <article class="bm-card bm-chart-card bm-income-chart-card">
        <div class="bm-chart-head"><div><span>PENDAPATAN HARIAN</span><h3>Kas masuk · <%= monthNames[selectedMonth-1] %></h3><small>Transfer/QRIS saat approval, cash saat setoran masuk kas.</small></div><a href="/cash?month=<%= selectedMonth %>&year=<%= selectedYear %><%= siteQuery %>">Data Kas <i class="bi bi-arrow-right"></i></a></div>
        <div class="bm-chart-canvas"><canvas id="billingDailyIncomeChart"></canvas></div>
      </article>
    </div>

    <div class="billing-monitor-lower-grid">
      <article class="bm-card bm-timing-card">
        <div class="bm-chart-head"><div><span>POLA PEMBAYARAN</span><h3>Kapan pelanggan membayar?</h3><small>Berdasarkan tanggal pembayaran aktual terhadap jatuh tempo.</small></div><b><%= Number(bmTiming?.total||0) %> lunas</b></div>
        <% const timingTotal=Math.max(1,Number(bmTiming?.total||0)); [['early','Lebih awal','bi-fast-forward-circle'],['on_time','Tepat waktu','bi-check2-circle'],['h1_3','H+1 s/d H+3','bi-clock-history'],['late','Lewat H+3','bi-exclamation-circle']].forEach(([key,label,icon])=>{ const count=Number(bmTiming?.[key]||0); const rate=Math.round(count/timingTotal*100); %>
        <div class="bm-timing-row"><i class="bi <%= icon %>"></i><span><b><%= label %></b><small><%= count %> pelanggan</small></span><div><i style="width:<%= rate %>%"></i></div><strong><%= rate %>%</strong></div>
        <% }) %>
      </article>

      <article class="bm-card bm-recent-income-card">
        <div class="bm-chart-head"><div><span>MASUK KAS TERBARU</span><h3>Siapa yang baru masuk?</h3><small>Transaksi billing yang sudah resmi masuk Data Kas.</small></div><a href="/payments<%= selectedSiteCode?`?site=${encodeURIComponent(selectedSiteCode)}`:'' %>">Semua <i class="bi bi-arrow-right"></i></a></div>
        <div class="bm-recent-list">
          <% bm.recent.forEach(row=>{ const recognized=row.recognized_at?new Date(row.recognized_at):null; const methodLabel=row.method==='cash'?'Cash disetor':row.method==='qris'?'QRIS':'Transfer'; %><a href="/customers/<%= row.customer_id %>"><span class="bm-avatar"><%= String(row.customer_name||'?').charAt(0).toUpperCase() %></span><div><b><%= row.customer_name %></b><small><%= row.site_code %> · Siklus <%= row.cycle %> · <%= methodLabel %></small></div><% if(isAdmin){ %><strong>+<%= formatRupiah(row.amount) %></strong><% } %><time><%= recognized?recognized.toLocaleTimeString('id-ID',{hour:'2-digit',minute:'2-digit',timeZone:'Asia/Jakarta'}):'-' %></time></a><% }) %>
          <% if(!bm.recent.length){ %><div class="bm-empty"><i class="bi bi-inbox"></i><span><b>Belum ada kas masuk</b><small>Transaksi approved akan muncul otomatis di sini.</small></span></div><% } %>
        </div>
      </article>
    </div>
  </section>
  <% } %>

  <article class="psb-hero-v119">
    <div class="psb-hero-copy"><span class="psb-hero-icon"><i class="bi bi-person-plus-fill"></i></span><div><small>TRAFFIC PSB · PEMASANGAN BARU</small><h2>Pertumbuhan pelanggan hari ini dan bulan berjalan</h2><p><%= psbSiteCode||'Semua Site' %> · <%= monthNames[psbMonth-1] %> <%= psbYear %></p></div></div>
    <div class="psb-hero-metrics"><button type="button" data-bs-toggle="modal" data-bs-target="#psbCustomerModal"><span>Traffic PSB Hari Ini</span><strong><%= Number(psbToday.total||0) %></strong><small>aktivasi / registrasi hari ini</small></button><button type="button" data-bs-toggle="modal" data-bs-target="#psbCustomerModal"><span>Total PSB Bulan Ini</span><strong><%= Number(newCustomers.total||0) %></strong><small><%= monthNames[psbMonth-1] %> <%= psbYear %></small></button></div>
    <div class="psb-hero-chart"><canvas id="commandPsbChart"></canvas></div>
    <div class="psb-hero-side"><form method="get" class="dashboard-section-filter psb-hero-filter" data-auto-filter><input type="hidden" name="site" value="<%= selectedSiteCode %>"><input type="hidden" name="month" value="<%= selectedMonth %>"><input type="hidden" name="year" value="<%= selectedYear %>"><input type="hidden" name="cycle" value="<%= selectedCycle %>"><input type="hidden" name="trend" value="<%= trendMonths %>"><select name="psb_site"><option value="">Semua Site</option><% siteOptions.forEach(s=>{ %><option value="<%= s.code %>" <%= psbSiteCode===s.code?'selected':'' %>><%= s.code %></option><% }) %></select><select name="psb_month"><% monthNames.forEach((m,i)=>{ %><option value="<%= i+1 %>" <%= psbMonth===i+1?'selected':'' %>><%= m %></option><% }) %></select><select name="psb_year"><% years.forEach(y=>{ %><option value="<%= y %>" <%= psbYear===y?'selected':'' %>><%= y %></option><% }) %></select></form><div class="psb-hero-latest"><span>PSB TERBARU</span><% psbCustomers.slice(0,4).forEach(c=>{ %><a href="/customers/<%= c.id %>"><i><%= c.name.charAt(0).toUpperCase() %></i><div><b><%= c.name %></b><small><%= c.customer_code %> · <%= c.site_code %></small></div><span class="bi bi-chevron-right"></span></a><% }) %><% if(!psbCustomers.length){ %><small class="ink-empty">Belum ada PSB periode ini.</small><% } %></div></div>
  </article>

  <div class="command-pulse-grid dashboard-ops-pulse-v119">
    <% if(can('billing')){ %><a class="command-pulse <%= Number(bm.today.pendingCount||0)>0?'warn':'ok' %>" href="/payments?approval=pending<%= selectedSiteCode?`&site=${encodeURIComponent(selectedSiteCode)}`:'' %>"><div><span>PENDING APPROVAL</span><strong><%= Number(bm.today.pendingCount||0) %></strong><em><% if(isAdmin){ %><%= formatRupiah(bm.today.pendingAmount||0) %> · <% } %>Buka approval →</em></div><i class="bi bi-shield-exclamation"></i></a><% }else{ %><article class="command-pulse"><div><span>BILLING</span><strong><%= collectionRate %>%</strong></div><i class="bi bi-graph-up-arrow"></i></article><% } %>
    <a href="<%= ticketTarget %>" class="command-pulse <%= Number(noc.tickets_open||0)>0?'warn':'ok' %>"><div><span>TICKET AKTIF</span><strong><%= Number(noc.tickets_open||0) %></strong><em>Buka daftar tiket →</em></div><i class="bi bi-life-preserver"></i></a>
  </div>

  <!-- v1.21.0 — Section 1 widgets, placed right under the existing pulse row so the whole "operational
       glance" area of the dashboard stays together before the deeper KPI panels below.
       v1.24.6 — Distribusi Paket, WA Gateway, and Server Monitor widgets removed from the dashboard per
       UI/UX audit (rarely needed daily / duplicated elsewhere). Distribusi Paket now lives on the Paket
       Internet page (views/packages/index.ejs) using data it already had. WA Gateway status is still one
       click away via its own menu; Server Monitor is a NOC/technical concern, not a daily billing-staff one. -->
  <div class="dashboard-widgets-v121 single-widget">
    <article class="command-panel widget-quick-launch">
      <div class="command-panel-head"><div><span>QUICK ACTION</span><h3>Launchpad</h3></div><i class="bi bi-lightning-charge-fill"></i></div>
      <div class="quick-launch-row">
        <a href="/customers/new"><i class="bi bi-person-plus-fill"></i><span>Pelanggan Baru</span></a>
        <% if(can('finance')){ %><a href="/cash"><i class="bi bi-cash-coin"></i><span>Input Kas/Transaksi</span></a><% } %>
        <a href="/invoices?month=<%= selectedMonth %>&year=<%= selectedYear %>&status=open<%= siteQuery %>"><i class="bi bi-whatsapp"></i><span>WA Blast Pengingat</span></a>
        <a href="/clusters<%= selectedSiteCode?`?site=${encodeURIComponent(selectedSiteCode)}`:'' %>"><i class="bi bi-diagram-3-fill"></i><span>Cek ODP Kosong</span><% if(odpAvailableCount>0){ %><b><%= odpAvailableCount %></b><% } %></a>
      </div>
    </article>
  </div>

  <div class="dashboard-dense-core">
  <article class="command-panel invoice-kpi-panel">
    <div class="command-panel-head dashboard-filter-head"><div><span>KPI TAGIHAN PELANGGAN</span><h3>Status Billing <%= monthNames[kpiMonth-1] %> <%= kpiYear %> · <%= kpiSiteCode||'Semua Site' %></h3></div><form method="get" class="dashboard-section-filter" data-auto-filter><input type="hidden" name="site" value="<%= selectedSiteCode %>"><input type="hidden" name="month" value="<%= selectedMonth %>"><input type="hidden" name="year" value="<%= selectedYear %>"><input type="hidden" name="cycle" value="<%= selectedCycle %>"><input type="hidden" name="trend" value="<%= trendMonths %>"><input type="hidden" name="psb_month" value="<%= psbMonth %>"><input type="hidden" name="psb_year" value="<%= psbYear %>"><input type="hidden" name="psb_site" value="<%= psbSiteCode %>"><select name="kpi_site" aria-label="Filter site KPI"><option value="">Semua Site</option><% siteOptions.forEach(s=>{ %><option value="<%= s.code %>" <%= kpiSiteCode===s.code?'selected':'' %>><%= s.code %></option><% }) %></select><select name="kpi_month" aria-label="Filter bulan KPI"><% monthNames.forEach((m,i)=>{ %><option value="<%= i+1 %>" <%= kpiMonth===i+1?'selected':'' %>><%= m %></option><% }) %></select><select name="kpi_year" aria-label="Filter tahun KPI"><% years.forEach(y=>{ %><option value="<%= y %>" <%= kpiYear===y?'selected':'' %>><%= y %></option><% }) %></select><span class="auto-filter-hint"><i class="bi bi-lightning-charge-fill"></i>Auto</span></form><a href="/invoices?month=<%= kpiMonth %>&year=<%= kpiYear %><%= kpiSiteQuery %>" class="ink-text-link">Buka Semua <i class="bi bi-arrow-right"></i></a></div>
    <div class="invoice-kpi-layout">
      <div class="invoice-kpi-chart"><canvas id="invoiceKpiChart"></canvas><div><strong><%= invoiceKpi.total %></strong><small>TOTAL</small></div></div>
      <div class="invoice-kpi-links">
        <a href="/invoices?month=<%= kpiMonth %>&year=<%= kpiYear %>&status=paid<%= kpiSiteQuery %>" class="paid"><i></i><span><small>Lunas</small><strong><%= invoiceKpi.paid %></strong></span><em><%= invoiceKpi.total?Math.round(invoiceKpi.paid/invoiceKpi.total*100):0 %>%</em></a>
        <a href="/invoices?month=<%= kpiMonth %>&year=<%= kpiYear %>&status=unpaid<%= kpiSiteQuery %>" class="unpaid"><i></i><span><small>Belum Lunas</small><strong><%= invoiceKpi.unpaid %></strong></span><em>Tindak lanjut</em></a>
        <a href="/invoices?month=<%= kpiMonth %>&year=<%= kpiYear %>&status=partial<%= kpiSiteQuery %>" class="partial"><i></i><span><small>Bayar Sebagian</small><strong><%= invoiceKpi.partial %></strong></span><em>Masih terbuka</em></a>
        <a href="/invoices?month=<%= kpiMonth %>&year=<%= kpiYear %>&status=overdue<%= kpiSiteQuery %>" class="overdue"><i></i><span><small>Terlambat</small><strong><%= invoiceKpi.overdue %></strong></span><em>Prioritas tinggi</em></a>
      </div>
