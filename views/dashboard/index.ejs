    <% if(Number(noc.due_today||0)>0){ %><a href="/invoices?month=<%= selectedMonth %>&year=<%= selectedYear %>&status=open<%= siteQuery %>"><i class="bi bi-calendar2-x-fill"></i><span><b><%= Number(noc.due_today||0) %> tagihan jatuh tempo hari ini</b><small>Siapkan pengingat pelanggan</small></span></a><% } %>
    <% if(Number(noc.pppoe_unlinked||0)>0){ %><a href="/customers?<%= customerSiteQuery %><%= customerSiteQuery?'&':'' %>network=unlinked"><i class="bi bi-router"></i><span><b><%= Number(noc.pppoe_unlinked||0) %> pelanggan belum sinkron PPPoE</b><small>Gunakan saran sinkronisasi sesuai site</small></span></a><% } %>
    <% if(isAdmin && Number(noc.cash_held||0)>0){ %><a href="<%= cashTarget %>"><i class="bi bi-cash-stack"></i><span><b>Cash di tim <%= formatRupiah(noc.cash_held||0) %></b><small>Perlu disetor dan direkonsiliasi</small></span></a><% } %>
    <% if(Number(noc.critical_tickets||0)>0){ %><a class="hard" href="<%= can('support')?`/tickets?status=active&priority=critical${siteQuery}`:'/' %>"><i class="bi bi-life-preserver"></i><span><b><%= Number(noc.critical_tickets||0) %> tiket kritis</b><small>Prioritaskan respons dan eskalasi teknisi</small></span></a><% } %>
    <% if(Number(noc.tickets_open||0)>0){ %><a href="<%= ticketTarget %>"><i class="bi bi-life-preserver"></i><span><b><%= Number(noc.tickets_open||0) %> tiket aktif</b><small>Buka daftar pekerjaan dukungan</small></span></a><% } %>
  </div>
  <% if(alertCount>3){ %><button type="button" class="dashboard-alert-more" data-important-more><span data-important-more-label>Lihat <%= alertCount-3 %> Lainnya</span></button><% } %>
  <div class="dashboard-alert-progress"><i></i></div>
</aside>
<% } %>

