<% /* v1.24.6 — count how many alert rows actually render below (same conditions, same order), so the popup can show only the top 3 by default plus a "Lihat X Lainnya" toggle instead of dumping up to 11 rows at once. */
   const alertCount=[todayDuty.length>0,(Number(network.offline||0)>0||Number(network.unreachable||0)>0),Number(noc.overdue_customers||0)>0,hardOverdueCustomers.length>0,Number(noc.pending_approvals||0)>0,Number(noc.pending_cash_approvals||0)>0,Number(noc.due_today||0)>0,Number(noc.pppoe_unlinked||0)>0,(isAdmin&&Number(noc.cash_held||0)>0),Number(noc.critical_tickets||0)>0,Number(noc.tickets_open||0)>0].filter(Boolean).length; %>
