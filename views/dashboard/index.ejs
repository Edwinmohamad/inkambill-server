    <% if(Number(noc.overdue_customers||0)>0){ %><a href="/invoices?month=<%= selectedMonth %>&year=<%= selectedYear %>&status=overdue<%= siteQuery %>"><i class="bi bi-exclamation-triangle"></i><span><b><%= Number(noc.overdue_customers||0) %> pelanggan overdue</b><small>Perlu tindak lanjut penagihan</small></span></a><% } %>
    <% if(hardOverdueCustomers.length){ %><a class="hard" href="/invoices?status=open<%= siteQuery %>"><i class="bi bi-exclamation-octagon-fill"></i><span><b>PERINGATAN KERAS · <%= hardOverdueCustomers.length %> tagihan</b><small>Lewat jatuh tempo lebih dari 2 hari</small></span></a><% } %>
