<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
<script>
(()=>{
  const data=<%- safeJson(monthly) %>;
  const invoiceKpi=<%- safeJson(invoiceKpi) %>;
  const siteDistribution=<%- safeJson(siteCustomerRows.map(s=>({code:s.code,name:s.name,total:Number(s.total||0),active:Number(s.active||0),inactive:Number(s.inactive||0),isolated:Number(s.isolated||0),offline:Number(s.offline||0)}))) %>;
  const billingData=<%- safeJson({selectedCycle,progress:bm.progress,trend:bm.trend,revenueSeries:isAdmin?bm.revenueSeries:{labels:bm.revenueSeries.labels,income:bm.revenueSeries.income.map(()=>0),count:bm.revenueSeries.count}}) %>;
  const canSeeBillingMoney=<%= isAdmin?'true':'false' %>;
  const money=v=>'Rp '+new Intl.NumberFormat('id-ID',{maximumFractionDigits:0}).format(v||0);
  const moneyCompact=v=>{const n=Number(v||0);if(n>=1e9)return 'Rp '+(n/1e9).toFixed(n>=1e10?0:1)+' M';if(n>=1e6)return 'Rp '+(n/1e6).toFixed(n>=1e7?0:1)+' jt';if(n>=1e3)return 'Rp '+Math.round(n/1e3)+' rb';return money(n);};
  const popup=document.getElementById('dashboardImportantPopup');
  if(popup){const close=()=>{popup.classList.add('leaving');setTimeout(()=>popup.remove(),280)};popup.querySelector('[data-important-close]')?.addEventListener('click',close);setTimeout(close,9000);
    const moreBtn=popup.querySelector('[data-important-more]'),list=popup.querySelector('.dashboard-alert-list'),label=popup.querySelector('[data-important-more-label]');
    if(moreBtn&&list&&label){const hiddenCount=label.textContent.match(/\d+/)?.[0]||'';moreBtn.addEventListener('click',()=>{const expanded=list.classList.toggle('expanded');label.textContent=expanded?'Sembunyikan':`Lihat ${hiddenCount} Lainnya`;});}
  }
  const billingUnpaidModal=document.getElementById('billingUnpaidModal');
  if(billingUnpaidModal){
    const search=billingUnpaidModal.querySelector('[data-bm-unpaid-search]');
    const count=billingUnpaidModal.querySelector('[data-bm-search-count]');
    const title=billingUnpaidModal.querySelector('[data-bm-modal-title]');
    const invoiceLink=billingUnpaidModal.querySelector('[data-bm-modal-invoice-link]');
    const applySearch=()=>{const panel=billingUnpaidModal.querySelector('[data-bm-cycle-panel]:not([hidden])');if(!panel)return;const q=String(search?.value||'').trim().toLocaleLowerCase('id-ID');let visible=0;panel.querySelectorAll('[data-bm-search-row]').forEach(row=>{const show=!q||String(row.dataset.searchText||'').includes(q);row.hidden=!show;if(show)visible++;});const empty=panel.querySelector('[data-bm-search-empty]');if(empty)empty.hidden=visible!==0;if(count)count.textContent=q?`${visible} hasil`:'';};
    billingUnpaidModal.addEventListener('show.bs.modal',event=>{const cycle=String(event.relatedTarget?.dataset?.bmCycle||'15');billingUnpaidModal.querySelectorAll('[data-bm-cycle-panel]').forEach(panel=>panel.hidden=panel.dataset.bmCyclePanel!==cycle);if(title)title.textContent=`Belum Bayar · Siklus ${cycle}`;if(invoiceLink){const u=new URL(invoiceLink.href,location.origin);u.searchParams.set('due_bucket',cycle==='15'?'due15':'due30');invoiceLink.href=u.pathname+'?'+u.searchParams.toString();}if(search)search.value='';applySearch();setTimeout(()=>search?.focus(),250);});
    search?.addEventListener('input',applySearch);
  }
  if(typeof Chart==='undefined')return;
  const common={responsive:true,maintainAspectRatio:false,interaction:{mode:'index',intersect:false},animation:{duration:850,easing:'easeOutQuart'},plugins:{legend:{display:false},tooltip:{backgroundColor:'#0b1020',borderColor:'rgba(255,255,255,.10)',borderWidth:1,padding:12}},scales:{x:{grid:{display:false},ticks:{color:'#77839a'}},y:{beginAtZero:true,border:{display:false},grid:{color:'rgba(148,163,184,.09)'},ticks:{color:'#77839a'}}}};
  const rootStyle=getComputedStyle(document.documentElement);
  const chartText=rootStyle.getPropertyValue('--muted').trim()||'#8e8e93';
  const chartLine=rootStyle.getPropertyValue('--line').trim()||'rgba(127,127,127,.16)';
  const dueMarkerPlugin={id:'billingDueMarkers',afterDraw(chart,_args,opts){if(!opts?.enabled)return;const x=chart.scales.x,y=chart.scales.y;if(!x||!y)return;const labels=chart.data.labels||[];const days=Array.isArray(opts.days)?opts.days:[];const ctx=chart.ctx;ctx.save();ctx.setLineDash([4,5]);ctx.lineWidth=1;ctx.strokeStyle='rgba(142,142,147,.42)';ctx.fillStyle=chartText;ctx.font='10px -apple-system,BlinkMacSystemFont,Segoe UI,sans-serif';days.forEach(day=>{let index=labels.findIndex(label=>String(label)===String(day));if(index<0&&Number(day)===30){index=labels.findIndex(label=>Number.parseInt(label,10)>=28&&Number.parseInt(label,10)<=31);if(index>=0){for(let i=index;i<labels.length;i++){const n=Number.parseInt(labels[i],10);if(n>=28&&n<=31)index=i;else break;}}}if(index<0)return;const px=x.getPixelForValue(index);ctx.beginPath();ctx.moveTo(px,y.top);ctx.lineTo(px,y.bottom);ctx.stroke();ctx.fillText(`Due ${day}`,Math.min(px+5,x.right-42),y.top+12);});ctx.restore();}};

  const collectionCanvas=document.getElementById('billingCollectionProgressChart');
  let collectionChart=null,progressView='progress',progressMetric='customer';
  const activeCycles=()=>billingData.selectedCycle==='all'?['15','30']:[String(billingData.selectedCycle)];
  const collectionPayload=()=>{const source=progressView==='trend'?billingData.trend:billingData.progress;const colors={'15':'#0a84ff','30':'#af52de'};return {labels:source.labels,datasets:activeCycles().map(cycle=>({label:`Siklus ${cycle}`,data:source.cycles?.[cycle]?.[progressMetric]||[],borderColor:colors[cycle],backgroundColor:cycle==='15'?'rgba(10,132,255,.10)':'rgba(175,82,222,.10)',borderWidth:2.4,tension:.34,pointRadius:progressView==='trend'?3:0,pointHoverRadius:4,fill:false}))};};
  const refreshCollectionChart=()=>{if(!collectionChart)return;const payload=collectionPayload();collectionChart.data.labels=payload.labels;collectionChart.data.datasets=payload.datasets;collectionChart.options.plugins.billingDueMarkers.enabled=progressView==='progress';collectionChart.update();};
  if(collectionCanvas){collectionChart=new Chart(collectionCanvas,{type:'line',data:collectionPayload(),plugins:[dueMarkerPlugin],options:{responsive:true,maintainAspectRatio:false,interaction:{mode:'index',intersect:false},animation:{duration:500},plugins:{legend:{display:false},billingDueMarkers:{enabled:true,days:activeCycles().map(Number)},tooltip:{backgroundColor:'#111113',padding:11,callbacks:{label:c=>`${c.dataset.label}: ${Number(c.raw||0).toFixed(1)}%`}}},scales:{x:{grid:{display:false},ticks:{color:chartText,maxTicksLimit:12}},y:{min:0,max:100,border:{display:false},grid:{color:chartLine},ticks:{color:chartText,callback:v=>v+'%'}}}}});}
  document.querySelectorAll('[data-bm-progress-view]').forEach(btn=>btn.addEventListener('click',()=>{progressView=btn.dataset.bmProgressView;document.querySelectorAll('[data-bm-progress-view]').forEach(x=>x.classList.toggle('active',x===btn));refreshCollectionChart();}));
  document.querySelectorAll('[data-bm-progress-metric]').forEach(btn=>btn.addEventListener('click',()=>{if(btn.disabled)return;progressMetric=btn.dataset.bmProgressMetric;document.querySelectorAll('[data-bm-progress-metric]').forEach(x=>x.classList.toggle('active',x===btn));refreshCollectionChart();}));

  const incomeCanvas=document.getElementById('billingDailyIncomeChart');
  if(incomeCanvas){const source=billingData.revenueSeries;new Chart(incomeCanvas,{type:'bar',data:{labels:source.labels,datasets:[{label:'Kas masuk',data:source.income,backgroundColor:'rgba(52,199,89,.72)',hoverBackgroundColor:'#34c759',borderRadius:6,borderSkipped:false,maxBarThickness:24}]},plugins:[dueMarkerPlugin],options:{responsive:true,maintainAspectRatio:false,interaction:{mode:'index',intersect:false},plugins:{legend:{display:false},billingDueMarkers:{enabled:true,days:activeCycles().map(Number)},tooltip:{backgroundColor:'#111113',padding:11,callbacks:{title:items=>`Tanggal ${items[0]?.label||'-'}`,label:c=>canSeeBillingMoney?`${money(c.raw)} · ${Number(source.count?.[c.dataIndex]||0)} transaksi`:`${Number(source.count?.[c.dataIndex]||0)} transaksi`}}},scales:{x:{grid:{display:false},ticks:{color:chartText,maxTicksLimit:12}},y:{beginAtZero:true,border:{display:false},grid:{color:chartLine},ticks:{color:chartText,callback:v=>canSeeBillingMoney?moneyCompact(v):''}}}}});}

  const billingCanvas=document.getElementById('commandBillingChart');
  if(billingCanvas){
    const ctx=billingCanvas.getContext('2d');const purple=ctx.createLinearGradient(0,0,0,300);purple.addColorStop(0,'rgba(96,58,234,.38)');purple.addColorStop(1,'rgba(96,58,234,0)');const red=ctx.createLinearGradient(0,0,0,300);red.addColorStop(0,'rgba(255,67,62,.20)');red.addColorStop(1,'rgba(255,67,62,0)');
    new Chart(billingCanvas,{type:'line',data:{labels:data.labels,datasets:[{label:'Tagihan',data:data.invoices,borderColor:'#7656ff',backgroundColor:purple,fill:true,tension:.42,borderWidth:2.4,pointRadius:0,pointHoverRadius:4},{label:'Pembayaran',data:data.payments,borderColor:'#ff5a59',backgroundColor:red,fill:true,tension:.42,borderWidth:2.2,pointRadius:0,pointHoverRadius:4}]},options:{...common,onHover:(event,elements)=>event.native.target.style.cursor=elements.length?'pointer':'default',onClick:(_event,elements)=>{if(!elements.length)return;location.href=`/invoices?month=${elements[0].index+1}&year=<%= selectedYear %><%= siteQuery %>`;},plugins:{...common.plugins,tooltip:{...common.plugins.tooltip,callbacks:{label:c=>`${c.dataset.label}: ${money(c.raw)}`}}},scales:{...common.scales,y:{...common.scales.y,ticks:{...common.scales.y.ticks,callback:v=>money(v)}}}}});
  }
  const psbCanvas=document.getElementById('commandPsbChart');
  if(psbCanvas){
    const ctx=psbCanvas.getContext('2d');const fill=ctx.createLinearGradient(0,0,0,260);fill.addColorStop(0,'rgba(46,214,161,.30)');fill.addColorStop(1,'rgba(46,214,161,0)');
    new Chart(psbCanvas,{type:'line',data:{labels:data.psbLabels,datasets:[{label:'PSB',data:data.psb,borderColor:'#2ed6a1',backgroundColor:fill,fill:true,tension:.38,borderWidth:2.4,pointRadius:2,pointHoverRadius:5,pointBackgroundColor:'#2ed6a1'}]},options:{...common,onHover:(event,elements)=>event.native.target.style.cursor=elements.length?'pointer':'default',onClick:()=>location.href='/customers?<%= psbSiteCode?`site=${encodeURIComponent(psbSiteCode)}`:'' %>',plugins:{...common.plugins,tooltip:{...common.plugins.tooltip,callbacks:{label:c=>`PSB: ${Number(c.raw||0)} pelanggan`}}},scales:{...common.scales,x:{...common.scales.x,ticks:{...common.scales.x.ticks,maxTicksLimit:16}},y:{...common.scales.y,ticks:{...common.scales.y.ticks,precision:0}}}}});
  }
  const kpiCanvas=document.getElementById('invoiceKpiChart');
  if(kpiCanvas){const statuses=['paid','unpaid','partial','overdue'];new Chart(kpiCanvas,{type:'doughnut',data:{labels:['Lunas','Belum Lunas','Sebagian','Terlambat'],datasets:[{data:[invoiceKpi.paid,invoiceKpi.unpaid,invoiceKpi.partial,invoiceKpi.overdue],backgroundColor:['#2ed6a1','#65758b','#ffbd5b','#ff6969'],borderColor:'rgba(8,12,25,.9)',borderWidth:4,hoverOffset:6}]},options:{responsive:true,maintainAspectRatio:false,cutout:'72%',onHover:(event,elements)=>event.native.target.style.cursor=elements.length?'pointer':'default',onClick:(_event,elements)=>{if(!elements.length)return;location.href=`/invoices?month=<%= kpiMonth %>&year=<%= kpiYear %>&status=${statuses[elements[0].index]}<%= kpiSiteQuery %>`;},plugins:{legend:{display:false},tooltip:{backgroundColor:'#0b1020',callbacks:{label:c=>`${c.label}: ${Number(c.raw||0)} tagihan`}}}}});}
  const siteBar=document.getElementById('siteCustomerBarChart');
  if(siteBar&&siteDistribution.length){const statusFilters=['active','inactive','active','inactive'];new Chart(siteBar,{type:'bar',data:{labels:siteDistribution.map(s=>s.code),datasets:[{label:'Aktif',data:siteDistribution.map(s=>s.active),backgroundColor:'#2ed6a1',borderRadius:5},{label:'Offline',data:siteDistribution.map(s=>s.offline),backgroundColor:'#ffbd5b',borderRadius:5},{label:'Terisolir',data:siteDistribution.map(s=>s.isolated),backgroundColor:'#ff6969',borderRadius:5},{label:'Tidak Aktif',data:siteDistribution.map(s=>s.inactive),backgroundColor:'#65758b',borderRadius:5}]},options:{responsive:true,maintainAspectRatio:false,interaction:{mode:'nearest',intersect:true},onHover:(event,elements)=>event.native.target.style.cursor=elements.length?'pointer':'default',onClick:(_event,elements)=>{if(!elements.length)return;const point=elements[0],site=siteDistribution[point.index];const params=new URLSearchParams({site:site.code,status:statusFilters[point.datasetIndex]});if(point.datasetIndex===1)params.set('network','problem');if(point.datasetIndex===2)params.set('network','isolated');location.href=`/customers?${params}`;},plugins:{legend:{position:'bottom',labels:{color:'#8893a8',boxWidth:10,boxHeight:10,useBorderRadius:true,borderRadius:3,font:{size:10}}},tooltip:{backgroundColor:'#0b1020',padding:11,callbacks:{label:c=>`${c.dataset.label}: ${Number(c.raw||0)} pelanggan`}}},scales:{x:{grid:{display:false},ticks:{color:'#8893a8'}},y:{beginAtZero:true,grid:{color:'rgba(148,163,184,.09)'},ticks:{color:'#8893a8',precision:0}}}}});}

})();
</script>
