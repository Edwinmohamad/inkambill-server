<section>
<div class="module-head"><div><div class="module-kicker">FIELD OPERATIONS</div><h1>Ticketing</h1><p>No. ticket dapat dibuka untuk melihat detail, lampiran, dan update progress harian.</p></div><div class="module-actions"><a class="btn-tech" href="/team-kpi"><i class="bi bi-bar-chart-steps"></i>KPI Tim</a><button class="btn-tech primary" data-bs-toggle="modal" data-bs-target="#ticketModal"><i class="bi bi-plus-lg"></i>Buat Ticket</button></div></div>
<div class="metric-grid five"><article class="metric-card red"><div class="metric-top"><span class="metric-label"><%= statusLabel("open") %></span><span class="metric-icon"><i class="bi bi-exclamation-diamond-fill"></i></span></div><strong><%= Number(stats.open_count||0) %></strong><small>Perlu ditangani</small></article><article class="metric-card orange"><div class="metric-top"><span class="metric-label"><%= statusLabel("progress") %></span><span class="metric-icon"><i class="bi bi-tools"></i></span></div><strong><%= Number(stats.progress_count||0) %></strong><small>Sedang dikerjakan</small></article><article class="metric-card"><div class="metric-top"><span class="metric-label"><%= statusLabel("pending") %></span><span class="metric-icon"><i class="bi bi-hourglass-split"></i></span></div><strong><%= Number(stats.pending_count||0) %></strong><small>Menunggu follow-up</small></article><article class="metric-card green"><div class="metric-top"><span class="metric-label">Selesai</span><span class="metric-icon"><i class="bi bi-check2-circle"></i></span></div><strong><%= Number(stats.closed_count||0) %></strong><small>Selesai</small></article><article class="metric-card red"><div class="metric-top"><span class="metric-label">Lewat SLA</span><span class="metric-icon"><i class="bi bi-stopwatch-fill"></i></span></div><strong><%= Number(stats.sla_breached_count||0) %></strong><small>Butuh perhatian segera</small></article></div>
<form class="filter-card mt-3" method="get"><div class="filter-grid ticket-filter-grid"><div class="filter-group"><label>CARI PELANGGAN / TICKET</label><div class="search-box"><i class="bi bi-search"></i><input name="q" value="<%= filters.q %>" placeholder="Nama, Customer ID, No Ticket..."></div></div><div class="filter-group"><label>SITE / POP</label><select class="form-select" name="site"><option value="">Semua Site</option><% sites.forEach(s=>{ %><option value="<%= s.code %>" <%= filters.site===s.code?'selected':'' %>><%= s.code %> · <%= s.name %></option><% }) %></select></div><div class="filter-group"><label>CLUSTER / ODP</label><select class="form-select" name="cluster"><option value="">Semua Cluster</option><% clusters.forEach(c=>{ %><option value="<%= c.id %>" <%= String(filters.cluster)===String(c.id)?'selected':'' %>><%= c.site_code %> · <%= c.name %></option><% }) %></select></div><div class="filter-group"><label>STATUS</label><select class="form-select" name="status"><option value="">Semua Status</option><option value="active" <%= filters.status==='active'?'selected':'' %>>AKTIF (SEMUA)</option><% ['open','progress','pending','closed'].forEach(v=>{ %><option value="<%= v %>" <%= filters.status===v?'selected':'' %>><%= statusLabel(v).toUpperCase() %></option><% }) %></select></div><div class="filter-group"><label>PRIORITY</label><select class="form-select" name="priority"><option value="">Semua Prioritas</option><% ['low','medium','high','critical'].forEach(v=>{ %><option value="<%= v %>" <%= filters.priority===v?'selected':'' %>><%= statusLabel(v).toUpperCase() %></option><% }) %></select></div><div class="d-flex align-items-end"><button class="btn-tech">Terapkan Filter</button></div></div></form>
<div class="data-card"><div class="data-card-head"><div><h3>Daftar Ticket Operasional</h3><small>Klik No. Ticket untuk detail & daily progress.</small></div></div><div class="table-responsive"><table class="app-table" data-bulk-scope="ticketsBulkBar"><thead><tr><% if(isAdmin){ %><th class="app-check-col"><input type="checkbox" class="form-check-input" data-select-all aria-label="Pilih semua tiket"></th><% } %><th class="app-seq-col">No.</th><th>No. Ticket</th><th>Subjek</th><th>Pelanggan</th><th>Prioritas</th><th>Status</th><th>SLA</th><th>Progress</th><th>PIC</th><th>Update Terakhir</th><th>Tindakan</th></tr></thead><tbody><% tickets.forEach((t,index)=>{ %><tr><% if(isAdmin){ %><td class="app-check-col"><input type="checkbox" class="form-check-input" data-row-check value="<%= t.id %>" aria-label="Pilih tiket <%= t.ticket_code %>"></td><% } %><td><span class="cell-main"><%= index+1 %></span></td><td><a class="ticket-code-link" href="/tickets/<%= t.id %>"><i class="bi bi-box-arrow-up-right"></i><%= t.ticket_code %></a></td><td><span class="cell-main"><%= t.subject %></span><span class="cell-sub"><%= t.type %></span></td><td><span class="cell-main"><%= t.customer_name||'-' %></span><span class="cell-sub"><%= t.customer_code||'' %><%= t.site_code?` · ${t.site_code} · Cluster ${t.cluster_name||'-'}`:'' %></span></td><td><span class="status-badge <%= t.priority==='critical'||t.priority==='high'?'red':t.priority==='medium'?'orange':'gray' %>"><%= statusLabel(t.priority) %></span></td><td><span class="status-badge <%= t.status==='closed'?'green':t.status==='open'?'red':t.status==='progress'?'purple':'orange' %>"><%= statusLabel(t.status) %></span></td><td><% const slaTone=t.sla.status==='breached'?'red':t.sla.status==='atrisk'?'orange':t.sla.status==='met'?'green':'purple'; %><span class="status-badge <%= slaTone %>" title="Tenggat <%= new Date(t.sla.dueAt).toLocaleString('id-ID',{dateStyle:'medium',timeStyle:'short'}) %>"><%= statusLabel(t.sla.status) %></span><% if(t.sla.status==='breached'||t.sla.status==='atrisk'){ %><span class="cell-sub"><%= t.sla.diffHours %> jam <%= t.sla.status==='breached'?'lewat':'lagi' %></span><% } %></td><td><div class="ticket-progress-mini"><span><%= Number(t.progress_percent||0) %>%</span><i><b style="width:<%= Number(t.progress_percent||0) %>%"></b></i></div></td><td><%= t.assigned_name||'Belum ditugaskan' %></td><td><%= t.last_progress_date?formatDate(t.last_progress_date):formatDate(t.opened_at) %></td><td><div class="d-flex gap-1 align-items-center"><a class="btn-tech compact" href="/tickets/<%= t.id %>"><i class="bi bi-eye"></i>Detail</a><% if(t.attachment_path || Number(t.update_attachment_count||0)>0){ %><span class="status-badge purple" title="Ada lampiran foto"><i class="bi bi-paperclip"></i><%= Number(t.update_attachment_count||0)+(t.attachment_path?1:0) %></span><% } %><% if(isAdmin){ %><button class="action-pill danger" type="button" title="Hapus Tiket" data-simple-delete="/tickets/<%= t.id %>/delete" data-entity-label="Tiket <%= t.ticket_code %> - <%= t.subject %>" data-simple-delete-title="Hapus tiket ini?" data-simple-delete-warning="Tiket beserta seluruh riwayat progress dan lampiran foto akan dihapus permanen."><i class="bi bi-trash3-fill"></i></button><% } %></div></td></tr><% }) %><% if(!tickets.length){%><tr><td colspan="<%= isAdmin?12:11 %>"><div class="empty-state"><i class="bi bi-life-preserver"></i><strong>Belum ada ticket</strong><small>Buat ticket untuk pekerjaan baru.</small></div></td></tr><%}%></tbody></table></div></div>
<% if(isAdmin){ %><div class="customer-bulk-bar" id="ticketsBulkBar" hidden><span><b data-bulk-count>0</b> tiket terpilih</span><div class="customer-bulk-buttons"><button type="button" data-bulk-clear class="ghost"><i class="bi bi-x-lg"></i>Batal</button><button type="button" class="danger" data-simple-delete-bulk data-bulk-scope-id="ticketsBulkBar" data-bulk-url="/tickets/bulk" data-bulk-action-field="action" data-bulk-action-value="delete" data-bulk-id-field="ticket_ids[]" data-entity-label-plural="tiket" data-simple-delete-title="Hapus tiket terpilih?" data-simple-delete-warning="Seluruh riwayat progress dan lampiran foto tiket terpilih akan dihapus permanen."><i class="bi bi-trash3-fill"></i>Hapus Massal</button></div></div><% } %>
</section>
<div class="modal fade" id="ticketModal" tabindex="-1"><div class="modal-dialog modal-lg modal-dialog-centered"><form class="modal-content" method="post" action="/tickets" enctype="multipart/form-data"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="modal-header"><div><div class="module-kicker">NEW OPERATION TICKET</div><h5 class="modal-title">Buat Ticket</h5></div><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="row g-3"><div class="col-md-6"><label class="form-label">Pelanggan</label><input class="form-control mb-2" type="search" data-customer-option-search="ticketCustomerSelect" placeholder="Cari nama pelanggan / ID / site / cluster..."><select class="form-select" name="customer_id" id="ticketCustomerSelect"><option value="">Ticket internal / tanpa pelanggan</option><% customers.forEach(c=>{ %><option value="<%= c.id %>"><%= c.site_code %> · Cluster <%= c.cluster_name||'-' %> · <%= c.customer_code %> · <%= c.name %></option><% }) %></select></div><div class="col-md-6"><label class="form-label">PIC</label><select class="form-select" name="assigned_employee_id"><option value="">Belum ditugaskan</option><% employees.forEach(e=>{ %><option value="<%= e.id %>"><%= e.employee_code %> · <%= e.name %><%= e.position_name?' · '+e.position_name:'' %></option><% }) %></select></div><div class="col-12"><label class="form-label">Subjek</label><input class="form-control" name="subject" required placeholder="Contoh: Migrasi pelanggan / Loss tinggi / Label ODP"></div><div class="col-md-6"><label class="form-label">Tipe Ticket</label><select class="form-select" name="type"><option>Gangguan Internet</option><option>Instalasi Baru</option><option>Migrasi</option><option>Maintenance</option><option>Audit Jaringan</option><option>Upgrade Bandwidth</option><option>Lainnya</option></select></div><div class="col-md-6"><label class="form-label">Prioritas</label><select class="form-select" name="priority"><option value="low"><%= statusLabel("low") %></option><option value="medium" selected><%= statusLabel("medium") %></option><option value="high"><%= statusLabel("high") %></option><option value="critical"><%= statusLabel("critical") %></option></select></div><div class="col-12"><label class="form-label">Deskripsi / Checklist</label><textarea class="form-control" name="description" rows="4"></textarea></div><div class="col-12"><label class="form-label">Lampiran Foto <small class="text-secondary">(opsional)</small></label><input class="form-control" type="file" name="attachment_file" accept="image/jpeg,image/png,image/webp"><div class="form-help">Foto kondisi awal / bukti pekerjaan. JPG, PNG, WEBP maksimal 6 MB.</div></div></div></div><div class="modal-footer"><button type="button" class="btn-tech" data-bs-dismiss="modal">Batal</button><button class="btn-tech primary">Buat Ticket</button></div></form></div></div>

<script id="customer-option-search-script">
(()=>{document.querySelectorAll('[data-customer-option-search]').forEach(input=>{const select=document.getElementById(input.dataset.customerOptionSearch);if(!select)return;input.addEventListener('input',()=>{const q=input.value.trim().toLowerCase();[...select.options].forEach((o,i)=>{if(i===0){o.hidden=false;return;}o.hidden=!!q&&!o.text.toLowerCase().includes(q);});});});})();
</script>
