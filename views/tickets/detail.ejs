<section class="ticket-detail-page">
<div class="module-head"><div><div class="module-kicker">TICKET DETAIL</div><h1><%= ticket.ticket_code %></h1><p><%= ticket.subject %><% if(ticket.source==='whatsapp'){ %> <span class="status-badge green"><i class="bi bi-whatsapp"></i> Dibuat via WhatsApp</span><% } %></p></div><div class="module-actions"><button class="btn-tech" type="button" data-bs-toggle="modal" data-bs-target="#editTicketModal"><i class="bi bi-pencil-square"></i>Edit Detail</button><a class="btn-tech" href="/tickets"><i class="bi bi-arrow-left"></i>Kembali</a></div></div>
<div class="data-card mb-3"><div class="data-card-head"><div><h3>PIC Ticket</h3><small>Terintegrasi dengan data Karyawan.</small></div></div><div class="data-card-body"><form method="post" action="/tickets/<%= ticket.id %>/assign" class="d-flex gap-2"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><select class="form-select" name="assigned_employee_id"><option value="">Belum ditugaskan</option><% employees.forEach(e=>{ %><option value="<%= e.id %>" <%= String(ticket.assigned_employee_id||'')===String(e.id)?'selected':'' %>><%= e.employee_code %> · <%= e.name %><%= e.position_name?' · '+e.position_name:'' %></option><% }) %></select><button class="btn-tech primary">Simpan PIC</button></form></div></div>
<div class="ticket-detail-grid"><article class="data-card"><div class="data-card-head"><div><h3>Informasi Ticket</h3><small>Dibuka <%= formatDate(ticket.opened_at) %></small></div><span class="status-badge <%= ticket.status==='closed'?'green':ticket.status==='open'?'red':ticket.status==='progress'?'purple':'orange' %>"><%= statusLabel(ticket.status) %></span></div><div class="data-card-body"><div class="ticket-info-grid"><div><span>Pelanggan</span><strong><%= ticket.customer_name||'Internal' %></strong><small><%= ticket.customer_code||'-' %><%= ticket.site_code?` · ${ticket.site_code} · Cluster ${ticket.cluster_name||'-'}`:'' %></small></div><div><span>PIC</span><strong><%= ticket.assigned_name||'Belum ditugaskan' %></strong><small><%= ticket.assigned_position||ticket.assigned_code||'' %></small></div><div><span>Priority</span><strong><%= statusLabel(ticket.priority).toUpperCase() %></strong></div><div><span>Type</span><strong><%= ticket.type %></strong></div><div><span>SLA</span><% const slaTone=ticket.sla.status==='breached'?'red':ticket.sla.status==='atrisk'?'orange':ticket.sla.status==='met'?'green':'purple'; %><strong><span class="status-badge <%= slaTone %>"><%= statusLabel(ticket.sla.status) %></span></strong><small>Tenggat <%= new Date(ticket.sla.dueAt).toLocaleString('id-ID',{dateStyle:'medium',timeStyle:'short'}) %><%= ticket.sla.status==='breached'||ticket.sla.status==='atrisk'?` · ${ticket.sla.diffHours} jam ${ticket.sla.status==='breached'?'lewat':'lagi'}`:'' %><%= ticket.first_response_minutes!=null?` · Respons pertama ${ticket.first_response_minutes<60?ticket.first_response_minutes+' menit':Math.round(ticket.first_response_minutes/60)+' jam'}`:'' %></small></div></div><div class="ticket-description"><span>DESKRIPSI</span><p><%= ticket.description||'Tidak ada deskripsi.' %></p></div><% if(ticket.attachment_path){ %><div class="ticket-evidence"><span>LAMPIRAN AWAL</span><a href="/tickets/<%= ticket.id %>/attachment" target="_blank" rel="noopener"><img src="/tickets/<%= ticket.id %>/attachment" alt="Lampiran awal ticket"><b><i class="bi bi-paperclip"></i> Lihat foto penuh</b></a></div><% } %></div></article>
<aside class="data-card"><div class="data-card-head"><div><h3>Update Progress Harian</h3><small>Tambahkan progress pekerjaan setiap hari.</small></div></div><form class="data-card-body" method="post" action="/tickets/<%= ticket.id %>/updates" enctype="multipart/form-data"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="row g-3"><div class="col-6"><label class="form-label">Tanggal</label><input class="form-control" type="date" name="progress_date" value="<%= new Date().toISOString().slice(0,10) %>" required></div><div class="col-6"><label class="form-label">Progress %</label><input class="form-control" type="number" min="0" max="100" name="progress_percent" value="<%= updates[0]?.progress_percent||0 %>" required></div><div class="col-12"><label class="form-label">Status</label><select class="form-select" name="status"><% ['open','progress','pending','closed'].forEach(v=>{ %><option value="<%= v %>" <%= (updates[0]?.status||ticket.status)===v?'selected':'' %>><%= statusLabel(v).toUpperCase() %></option><% }) %></select></div><div class="col-12"><label class="form-label">Daily Progress / Kendala</label><textarea class="form-control" name="note" rows="5" required placeholder="Contoh: Migrasi 2 pelanggan selesai. Kendala 1 pelanggan tidak di rumah, dijadwalkan ulang besok."></textarea></div><div class="col-12"><label class="form-label">Lampiran Foto Progress <small class="text-secondary">(opsional)</small></label><input class="form-control" type="file" name="attachment_file" accept="image/jpeg,image/png,image/webp"><div class="form-help">Upload foto hasil kerja / kendala hari ini. Maksimal 6 MB.</div></div><div class="col-12"><button class="btn-tech primary w-100"><i class="bi bi-plus-circle"></i>Simpan Update</button></div></div></form></aside></div>
<div class="data-card mt-3"><div class="data-card-head"><div><h3>Progress Timeline</h3><small><%= updates.length %> update tersimpan</small></div></div><div class="ticket-progress-timeline"><% updates.forEach(u=>{ %><article><div class="ticket-progress-marker"><b><%= u.progress_percent %>%</b></div><div class="ticket-progress-content"><div><strong><%= formatDate(u.progress_date) %></strong><span class="status-badge <%= u.status==='closed'?'green':u.status==='progress'?'purple':u.status==='pending'?'orange':'red' %>"><%= statusLabel(u.status) %></span></div><p><%= u.note %></p><% if(u.attachment_path){ %><a class="ticket-timeline-photo" href="/tickets/<%= ticket.id %>/updates/<%= u.id %>/attachment" target="_blank" rel="noopener"><img src="/tickets/<%= ticket.id %>/updates/<%= u.id %>/attachment" alt="Lampiran progress"><span><i class="bi bi-image"></i> Bukti progress</span></a><% } %><small>Update oleh <%= u.updated_by_name||'System' %><% if(u.source==='whatsapp'){ %> <span class="status-badge green"><i class="bi bi-whatsapp"></i> via WhatsApp</span><% } %> · <%= new Date(u.created_at).toLocaleString('id-ID') %></small></div></article><% }) %><% if(!updates.length){ %><div class="empty-state"><i class="bi bi-journal-check"></i><strong>Belum ada progress harian</strong><small>Tambahkan update pertama dari panel di atas.</small></div><% } %></div></div>
</section>
<div class="modal fade" id="editTicketModal" tabindex="-1"><div class="modal-dialog modal-lg modal-dialog-centered"><form class="modal-content" method="post" action="/tickets/<%= ticket.id %>/edit"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="modal-header"><div><div class="module-kicker">EDIT TICKET</div><h5 class="modal-title">Edit Detail · <%= ticket.ticket_code %></h5></div><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="row g-3"><div class="col-12"><label class="form-label">Subjek</label><input class="form-control" name="subject" value="<%= ticket.subject %>" required></div><div class="col-md-6"><label class="form-label">Tipe</label><input class="form-control" name="type" value="<%= ticket.type %>"></div><div class="col-md-6"><label class="form-label">Priority</label><select class="form-select" name="priority"><% ['low','medium','high','critical'].forEach(p=>{ %><option value="<%= p %>" <%= ticket.priority===p?'selected':'' %>><%= statusLabel(p).toUpperCase() %></option><% }) %></select></div><div class="col-12"><label class="form-label">Deskripsi</label><textarea class="form-control" name="description" rows="4"><%= ticket.description||'' %></textarea></div></div></div><div class="modal-footer"><button type="button" class="btn-tech" data-bs-dismiss="modal">Batal</button><button class="btn-tech primary">Simpan Perubahan</button></div></form></div></div>
