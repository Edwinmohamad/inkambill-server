<section class="ops-detail-page">
  <div class="module-head"><div><div class="module-kicker">ACTIVITY TIMELINE</div><h1><%= activity.activity_code %></h1><p><%= activity.title %></p></div><div class="module-actions"><a class="btn-tech" href="/operations"><i class="bi bi-arrow-left"></i>Operations Center</a><% if(activity.ticket_id){ %><a class="btn-tech" href="/tickets/<%= activity.ticket_id %>"><i class="bi bi-life-preserver"></i><%= activity.ticket_code %></a><% } %></div></div>
  <div class="ops-detail-summary">
    <article><small>JENIS</small><strong><%= statusLabel(activity.activity_type) %></strong></article><article><small>STATUS</small><strong><%= statusLabel(activity.status) %></strong></article><article><small>SITE</small><strong><%= activity.site_code||'-' %></strong></article><article><small>PIC</small><strong><%= activity.pic_name||'-' %></strong></article><article><small>PELANGGAN</small><strong><%= activity.customer_name||'-' %></strong></article><article><small>SUMBER</small><strong><%= String(activity.source||'web').toUpperCase() %></strong></article>
  </div>
  <div class="ops-grid-two">
    <article class="data-card"><div class="data-card-head"><div><h3>Timeline Aktivitas</h3><small>Semua perubahan tercatat kronologis.</small></div></div><div class="ops-timeline"><% updates.forEach(u=>{ %><div class="ops-timeline-item"><i></i><div><header><strong><%= u.status?statusLabel(u.status):statusLabel(u.event_type) %></strong><time><%= formatDate(u.created_at) %></time></header><p><%= u.note||'-' %></p><small><%= u.actor_name %> · <%= String(u.source||'web').toUpperCase() %></small></div></div><% }) %></div></article>
    <div class="d-flex flex-column gap-3"><article class="data-card"><div class="data-card-head"><div><h3>Update Aktivitas</h3><small>Status dan catatan akan menjadi event KPI.</small></div></div><form class="p-3" method="post" action="/operations/activities/<%= activity.id %>/update"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="mb-3"><label class="form-label">Status</label><select class="form-select" name="status"><% statuses.forEach(x=>{ %><option value="<%= x %>" <%= activity.status===x?'selected':'' %>><%= statusLabel(x) %></option><% }) %></select></div><div class="mb-3"><label class="form-label">Catatan</label><textarea class="form-control" name="note" rows="4" required placeholder="Progress, hasil pekerjaan, kendala..."></textarea></div><div class="mb-3"><label class="form-label">Tambah Anggota Tim</label><select class="form-select" name="employee_id"><option value="">Tidak ada</option><% employees.forEach(e=>{ %><option value="<%= e.id %>"><%= e.employee_code %> · <%= e.name %></option><% }) %></select></div><button class="btn-tech primary w-100">Simpan Update</button></form></article>
    <article class="data-card"><div class="data-card-head"><div><h3>Tim Terlibat</h3><small>PIC/helper yang tercatat pada aktivitas.</small></div></div><div class="ops-members"><% members.forEach(m=>{ %><div><span><%= m.name %></span><small><%= m.employee_code %> · <%= m.role %></small></div><% }) %><% if(!members.length){ %><div class="empty-state"><small>Belum ada anggota tercatat.</small></div><% } %></div></article></div>
  </div>
</section>
