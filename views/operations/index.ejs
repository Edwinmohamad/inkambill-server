<section class="ops-center-page">
  <div class="module-head ops-hero-head">
    <div><div class="module-kicker">SPV OPERATIONS</div><h1>Operations Center</h1><p>Satu tempat untuk memantau tiket, aktivitas lapangan, pekerjaan per site, dan disiplin update tim.</p></div>
    <div class="module-actions"><a class="btn-tech" href="/tickets"><i class="bi bi-life-preserver"></i>Ticketing</a><a class="btn-tech" href="/team-kpi"><i class="bi bi-bar-chart-steps"></i>KPI Tim</a><button class="btn-tech primary" data-bs-toggle="modal" data-bs-target="#activityModal"><i class="bi bi-plus-lg"></i>Aktivitas</button></div>
  </div>

  <nav class="ops-module-nav" aria-label="Modul operasional">
    <a class="active" href="/operations"><i class="bi bi-kanban-fill"></i><span><b>Operation Center</b><small>Ringkasan SPV &amp; aktivitas</small></span></a>
    <a href="/tickets"><i class="bi bi-life-preserver"></i><span><b>Ticketing</b><small>Gangguan &amp; progres</small></span></a>
    <a href="/team-kpi"><i class="bi bi-bar-chart-steps"></i><span><b>KPI Tim</b><small>Performa berbasis data</small></span></a>
    <a href="/schedules"><i class="bi bi-calendar2-check-fill"></i><span><b>Jadwal Teknisi</b><small>Pekerjaan lapangan</small></span></a>
    <a href="/server-duty"><i class="bi bi-shield-check"></i><span><b>Piket Server</b><small>Shift &amp; kehadiran</small></span></a>
  </nav>

  <form class="ops-filter" method="get" data-auto-filter>
    <div><label>PERIODE</label><div class="ops-period-pair"><select class="form-select" name="month"><% ['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember'].forEach((m,i)=>{ %><option value="<%= i+1 %>" <%= Number(filters.month)===i+1?'selected':'' %>><%= m %></option><% }) %></select><input class="form-control" type="number" name="year" min="2020" max="2100" value="<%= filters.year %>"></div></div>
    <div><label>SITE</label><select class="form-select" name="site"><option value="">Semua Site</option><% sites.forEach(s=>{ %><option value="<%= s.code %>" <%= filters.site===s.code?'selected':'' %>><%= s.code %> · <%= s.name %></option><% }) %></select></div>
    <div><label>PIC</label><select class="form-select" name="pic"><option value="">Semua PIC</option><% employees.forEach(e=>{ %><option value="<%= e.id %>" <%= String(filters.pic||'')===String(e.id)?'selected':'' %>><%= e.name %></option><% }) %></select></div>
    <div><label>AKTIVITAS</label><select class="form-select" name="type"><option value="">Semua Jenis</option><% types.forEach(x=>{ %><option value="<%= x %>" <%= filters.type===x?'selected':'' %>><%= statusLabel(x) %></option><% }) %></select></div>
    <div><label>STATUS AKTIVITAS</label><select class="form-select" name="status"><option value="">Semua Status</option><% statuses.forEach(x=>{ %><option value="<%= x %>" <%= filters.status===x?'selected':'' %>><%= statusLabel(x) %></option><% }) %></select></div>
    <div><label>STAGE TIKET</label><select class="form-select" name="stage"><option value="">Semua Stage</option><% stages.forEach(x=>{ %><option value="<%= x %>" <%= filters.stage===x?'selected':'' %>><%= x.replace('_',' ') %></option><% }) %></select></div>
    <div class="ops-search-field"><label>CARI</label><div class="search-box"><i class="bi bi-search"></i><input name="q" value="<%= filters.q %>" placeholder="Aktivitas, pelanggan, PIC..."></div></div>
  </form>

  <div class="ops-summary-grid">
    <article class="ops-summary-card danger"><span><i class="bi bi-ticket-detailed"></i></span><div><small>TIKET BELUM CLOSE</small><strong><%= summary.openTickets %></strong><em><%= summary.overSla %> lewat SLA</em></div></article>
    <article class="ops-summary-card warning"><span><i class="bi bi-clock-history"></i></span><div><small>TANPA UPDATE ≥ 1 JAM</small><strong><%= summary.silent %></strong><em>Perlu perhatian SPV</em></div></article>
    <article class="ops-summary-card"><span><i class="bi bi-activity"></i></span><div><small>SEDANG BERJALAN</small><strong><%= summary.inProgress %></strong><em>Aktivitas periode ini</em></div></article>
    <article class="ops-summary-card success"><span><i class="bi bi-check2-circle"></i></span><div><small>SELESAI</small><strong><%= summary.done %></strong><em>Aktivitas periode ini</em></div></article>
    <article class="ops-summary-card"><span><i class="bi bi-person-plus"></i></span><div><small>PSB</small><strong><%= summary.psb %></strong><em>Periode terpilih</em></div></article>
  </div>

  <div class="ops-site-strip"><% siteRows.forEach(s=>{ %><article><strong><%= s.code %></strong><span><b><%= Number(s.open_tickets||0) %></b> tiket open</span><span><b><%= Number(s.active_activities||0) %></b> aktif</span><span><b><%= Number(s.done_activities||0) %></b> selesai</span></article><% }) %></div>

  <details class="ops-site-rules data-card">
    <summary><span><i class="bi bi-diagram-3"></i><b>PIC Default per Site</b><small>Dipakai bot untuk auto-assign tiket/aktivitas dari grup WA.</small></span><i class="bi bi-chevron-down"></i></summary>
    <div class="ops-site-rule-grid"><% sites.forEach(site=>{ const rule=(siteRules||[]).find(r=>String(r.site_id)===String(site.id))||{}; %><form method="post" action="/operations/site-rules/<%= site.id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><header><strong><%= site.code %></strong><small><%= site.name %></small></header><label>PIC Utama<select class="form-select" name="primary_employee_id"><option value="">Reporter / belum diatur</option><% employees.forEach(e=>{ %><option value="<%= e.id %>" <%= String(rule.primary_employee_id||'')===String(e.id)?'selected':'' %>><%= e.name %></option><% }) %></select></label><label>Backup<select class="form-select" name="backup_employee_id"><option value="">Tidak ada</option><% employees.forEach(e=>{ %><option value="<%= e.id %>" <%= String(rule.backup_employee_id||'')===String(e.id)?'selected':'' %>><%= e.name %></option><% }) %></select></label><button class="btn-tech compact">Simpan</button></form><% }) %></div>
  </details>

  <div class="ops-grid-two">
    <article class="data-card ops-card"><div class="data-card-head"><div><h3>Supervisor Queue</h3><small>Tiket yang belum CLOSED, diurutkan dari yang paling membutuhkan perhatian.</small></div><span class="status-badge red"><%= tickets.length %> aktif</span></div>
      <div class="ops-ticket-list"><% tickets.forEach(t=>{ %><div class="ops-ticket <%= t.over_sla?'overdue':'' %>"><div class="ops-ticket-main"><div class="ops-ticket-title"><a href="/tickets/<%= t.id %>"><%= t.ticket_code %></a><span class="status-badge <%= t.priority==='critical'||t.priority==='high'?'red':t.priority==='medium'?'orange':'gray' %>"><%= statusLabel(t.priority) %></span><% if(t.over_sla){ %><span class="status-badge red">OVER SLA</span><% } %></div><strong><%= t.subject %></strong><small><%= t.customer_name||'Internal' %><%= t.site_code?' · '+t.site_code:'' %> · PIC <%= t.pic_name||'Belum assign' %></small></div><div class="ops-ticket-meta"><b><%= t.stage.replace('_',' ') %></b><small><%= Math.floor(Number(t.idle_minutes||0)/60) %>j <%= Number(t.idle_minutes||0)%60 %>m tanpa update</small></div></div><% }) %><% if(!tickets.length){ %><div class="empty-state"><i class="bi bi-shield-check"></i><strong>Tidak ada tiket aktif</strong><small>Semua tiket sudah CLOSED.</small></div><% } %></div>
    </article>

    <article class="data-card ops-card"><div class="data-card-head"><div><h3>Aktivitas Operasional</h3><small>PSB, instalasi, maintenance, migrasi, survey, follow-up, dan aktivitas lain.</small></div><span class="status-badge purple"><%= activities.length %> record</span></div>
      <div class="ops-activity-list"><% activities.slice(0,80).forEach(a=>{ %><div class="ops-activity"><span class="ops-activity-icon"><i class="bi <%= a.activity_type==='incident'?'bi-exclamation-triangle':a.activity_type==='psb'?'bi-person-plus':a.activity_type==='maintenance'?'bi-tools':'bi-activity' %>"></i></span><div><div><a class="ops-activity-link" href="/operations/activities/<%= a.id %>"><strong><%= a.title %></strong></a><span class="status-badge <%= a.status==='done'?'green':a.status==='in_progress'?'purple':a.status==='cancelled'?'gray':'orange' %>"><%= statusLabel(a.status) %></span></div><small><%= a.activity_code %> · <%= statusLabel(a.activity_type) %><%= a.site_code?' · '+a.site_code:'' %><%= a.pic_name?' · '+a.pic_name:'' %></small><% if(a.description){ %><p><%= a.description %></p><% } %></div><time><%= formatDate(a.updated_at) %></time></div><% }) %><% if(!activities.length){ %><div class="empty-state"><i class="bi bi-activity"></i><strong>Belum ada aktivitas</strong><small>Aktivitas dari web dan WhatsApp akan muncul di sini.</small></div><% } %></div>
    </article>
  </div>
</section>

<div class="modal fade" id="activityModal" tabindex="-1"><div class="modal-dialog modal-lg modal-dialog-centered"><form class="modal-content" method="post" action="/operations/activities"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="modal-header"><div><div class="module-kicker">NEW ACTIVITY</div><h5 class="modal-title">Catat Aktivitas Operasional</h5></div><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="row g-3">
<div class="col-md-4"><label class="form-label">Jenis</label><select class="form-select" name="activity_type"><% types.forEach(x=>{ %><option value="<%= x %>"><%= statusLabel(x) %></option><% }) %></select></div>
<div class="col-md-4"><label class="form-label">Status</label><select class="form-select" name="status"><% statuses.forEach(x=>{ %><option value="<%= x %>"><%= statusLabel(x) %></option><% }) %></select></div>
<div class="col-md-4"><label class="form-label">Prioritas</label><select class="form-select" name="priority"><option value="low">Rendah</option><option value="medium" selected>Normal</option><option value="high">Tinggi</option><option value="critical">Kritis</option></select></div>
<div class="col-md-6"><label class="form-label">Site</label><select class="form-select" name="site_id"><option value="">-</option><% sites.forEach(s=>{ %><option value="<%= s.id %>"><%= s.code %> · <%= s.name %></option><% }) %></select></div>
<div class="col-md-6"><label class="form-label">PIC</label><select class="form-select" name="primary_employee_id"><option value="">Belum ditentukan</option><% employees.forEach(e=>{ %><option value="<%= e.id %>"><%= e.employee_code %> · <%= e.name %></option><% }) %></select></div>
<div class="col-12"><label class="form-label">Judul</label><input class="form-control" name="title" required placeholder="Contoh: Penarikan dropcore ODP KBG-04"></div>
<div class="col-12"><label class="form-label">Keterangan</label><textarea class="form-control" name="description" rows="3" placeholder="Catatan pekerjaan, kendala, target..."></textarea></div>
</div></div><div class="modal-footer"><button class="btn-tech" type="button" data-bs-dismiss="modal">Batal</button><button class="btn-tech primary">Simpan Aktivitas</button></div></form></div></div>
