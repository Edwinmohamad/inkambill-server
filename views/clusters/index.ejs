<section>
<div class="module-head"><div><div class="module-kicker">ACCESS NETWORK</div><h1>Clustering / ODP</h1><p>Kelompokkan pelanggan per ODP/cluster untuk kapasitas port, mapping area, dan ekspansi jaringan.</p></div><div class="module-actions"><a class="btn-tech" href="/clusters/template.xlsx"><i class="bi bi-file-earmark-arrow-down"></i>Template XLSX</a><a class="btn-tech" href="/clusters/export.xlsx<%= site?'?site='+encodeURIComponent(site):'' %>"><i class="bi bi-file-earmark-spreadsheet"></i>Export XLSX</a><button class="btn-tech" type="button" data-bs-toggle="modal" data-bs-target="#clusterImportModal"><i class="bi bi-upload"></i>Import XLSX</button><button class="btn-tech primary" data-bs-toggle="modal" data-bs-target="#clusterModal"><i class="bi bi-plus-lg"></i>Tambah Cluster</button></div></div>
<div class="metric-grid"><article class="metric-card"><div class="metric-top"><span class="metric-label">Total Cluster</span><span class="metric-icon"><i class="bi bi-diagram-3-fill"></i></span></div><strong><%= clusters.length %></strong><small>ODP / distribution point</small></article><article class="metric-card green"><div class="metric-top"><span class="metric-label">Total Pelanggan</span><span class="metric-icon"><i class="bi bi-people-fill"></i></span></div><strong><%= clusters.reduce((a,c)=>a+Number(c.customers||0),0) %></strong><small>Terhubung ke cluster</small></article><article class="metric-card orange"><div class="metric-top"><span class="metric-label">Port Terpakai</span><span class="metric-icon"><i class="bi bi-plug-fill"></i></span></div><strong><%= clusters.reduce((a,c)=>a+Number(c.used_ports||0),0) %></strong><small>Data manual / audit</small></article><article class="metric-card"><div class="metric-top"><span class="metric-label">Site Aktif</span><span class="metric-icon"><i class="bi bi-hdd-rack-fill"></i></span></div><strong><%= new Set(clusters.map(c=>c.site_code)).size %></strong><small>POP dengan cluster</small></article></div>
<form class="filter-card" method="get"><div class="filter-grid" style="grid-template-columns:1fr auto"><div class="filter-group"><label>SITE / POP</label><select class="form-select" name="site"><option value="">Semua Site</option><% sites.forEach(s=>{ %><option value="<%= s.code %>" <%= site===s.code?'selected':'' %>><%= s.code %> · <%= s.name %></option><% }) %></select></div><div class="d-flex align-items-end"><button class="btn-tech primary">Filter</button></div></div></form>
<div class="data-card"><div class="data-card-head"><div><h3>Topology Cluster</h3><small>Capacity awareness untuk ODP / area distribusi</small></div></div><div class="table-responsive"><table class="app-table"><thead><tr><th class="app-seq-col">No.</th><th>Cluster</th><th>Site</th><th>Jenis</th><th>Port</th><th>Pelanggan</th><th>Utilization</th><th>Alamat</th><th>Status</th><% if(isAdmin){ %><th class="text-end">Aksi</th><% } %></tr></thead><tbody><% clusters.forEach((c,index)=>{const cap=Number(c.capacity_ports||0),used=Number(c.used_ports||0),pct=cap?Math.min(100,Math.round((used/cap)*100)):0;%><tr><td><span class="cell-main"><%= index+1 %></span></td><td><span class="cell-main"><%= c.name %></span></td><td><span class="status-badge purple"><%= c.site_code %></span></td><td><%= c.type %></td><td><%= cap?`${used}/${cap}`:'-' %></td><td><%= c.customers %></td><td><span class="cell-main"><%= pct %>%</span><span class="cell-sub"><%= cap-used>0?`${cap-used} port tersedia`:'Kapasitas belum diisi' %></span></td><td><%= c.address||'-' %></td><td><span class="status-badge <%= c.status==='active'?'green':c.status==='maintenance'?'orange':'gray' %>"><%= statusLabel(c.status) %></span></td><% if(isAdmin){ %><td class="text-end"><div class="d-flex gap-1 justify-content-end"><button type="button" class="btn-tech compact" title="Edit" data-bs-toggle="modal" data-bs-target="#editCluster<%= c.id %>"><i class="bi bi-pencil-square"></i></button><% if(Number(c.customers||0)>0){ %><span class="cash-locked" title="Masih ada <%= c.customers %> pelanggan terpasang"><i class="bi bi-lock"></i></span><% }else{ %><form method="post" action="/clusters/<%= c.id %>/delete" onsubmit="return confirm('Hapus cluster/ODP <%= c.name %>? Tindakan ini tidak dapat dibatalkan.')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="btn-tech compact danger" title="Hapus"><i class="bi bi-trash3"></i></button></form><% } %></div></td><% } %></tr><% }) %><% if(!clusters.length){%><tr><td colspan="<%= isAdmin?10:9 %>"><div class="empty-state"><i class="bi bi-diagram-3"></i><strong>Belum ada cluster</strong><small>Tambahkan ODP/cluster pertama untuk mapping pelanggan.</small></div></td></tr><%}%></tbody></table></div></div>
</section>
<div class="modal fade" id="clusterModal" tabindex="-1"><div class="modal-dialog modal-lg modal-dialog-centered"><form class="modal-content" method="post" action="/clusters"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="modal-header"><div><div class="module-kicker">NEW DISTRIBUTION POINT</div><h5 class="modal-title">Tambah Cluster / ODP</h5></div><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="row g-3"><div class="col-md-6"><label class="form-label">Nama Cluster</label><input class="form-control" name="name" required placeholder="ODP-RT02"></div><div class="col-md-3"><label class="form-label">Site</label><select class="form-select" name="site_id" required><% sites.forEach(s=>{ %><option value="<%= s.id %>"><%= s.code %></option><% }) %></select></div><div class="col-md-3"><label class="form-label">Jenis</label><select class="form-select" name="type"><option>FTTH</option><option>WIRELESS</option><option>OTHER</option></select></div><div class="col-md-3"><label class="form-label">Kapasitas Port</label><input class="form-control" type="number" name="capacity_ports"></div><div class="col-md-3"><label class="form-label">Port Terpakai</label><input class="form-control" type="number" name="used_ports" value="0"></div><div class="col-md-3"><label class="form-label">Latitude</label><input class="form-control" name="latitude"></div><div class="col-md-3"><label class="form-label">Longitude</label><input class="form-control" name="longitude"></div><div class="col-12"><label class="form-label">Alamat</label><textarea class="form-control" name="address"></textarea></div></div></div><div class="modal-footer"><button type="button" class="btn-tech" data-bs-dismiss="modal">Batal</button><button class="btn-tech primary">Simpan Cluster</button></div></form></div></div>

<% clusters.forEach(c=>{ %><div class="modal fade" id="editCluster<%= c.id %>" tabindex="-1"><div class="modal-dialog modal-lg modal-dialog-centered"><form class="modal-content" method="post" action="/clusters/<%= c.id %>/edit"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="modal-header"><div><div class="module-kicker">EDIT DISTRIBUTION POINT</div><h5 class="modal-title">Edit Cluster · <%= c.name %></h5></div><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="row g-3"><div class="col-md-6"><label class="form-label">Nama Cluster</label><input class="form-control" name="name" value="<%= c.name %>" required></div><div class="col-md-3"><label class="form-label">Site</label><select class="form-select" name="site_id" required><% sites.forEach(s=>{ %><option value="<%= s.id %>" <%= String(c.site_id)===String(s.id)?'selected':'' %>><%= s.code %></option><% }) %></select></div><div class="col-md-3"><label class="form-label">Jenis</label><select class="form-select" name="type"><% ['FTTH','WIRELESS','OTHER'].forEach(t=>{ %><option <%= c.type===t?'selected':'' %>><%= t %></option><% }) %></select></div><div class="col-md-3"><label class="form-label">Kapasitas Port</label><input class="form-control" type="number" name="capacity_ports" value="<%= c.capacity_ports||'' %>"></div><div class="col-md-3"><label class="form-label">Port Terpakai</label><input class="form-control" type="number" name="used_ports" value="<%= c.used_ports||0 %>"></div><div class="col-md-3"><label class="form-label">Latitude</label><input class="form-control" name="latitude" value="<%= c.latitude||'' %>"></div><div class="col-md-3"><label class="form-label">Longitude</label><input class="form-control" name="longitude" value="<%= c.longitude||'' %>"></div><div class="col-md-6"><label class="form-label">Status</label><select class="form-select" name="status"><% ['active','maintenance','inactive'].forEach(st=>{ %><option value="<%= st %>" <%= c.status===st?'selected':'' %>><%= statusLabel(st) %></option><% }) %></select></div><div class="col-12"><label class="form-label">Alamat</label><textarea class="form-control" name="address"><%= c.address||'' %></textarea></div></div></div><div class="modal-footer"><button type="button" class="btn-tech" data-bs-dismiss="modal">Batal</button><button class="btn-tech primary">Simpan Perubahan</button></div></form></div></div><% }) %>
<div class="modal fade" id="clusterImportModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><form class="modal-content" method="post" action="/clusters/import" enctype="multipart/form-data"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="modal-header"><div><div class="module-kicker">XLSX BULK DATA</div><h5 class="modal-title">Import Cluster / ODP</h5></div><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><label class="form-label">File XLSX</label><input class="form-control" type="file" name="cluster_file" accept=".xlsx" required><div class="form-help mt-2">Gunakan template INKAMNET. Data dengan Site + Nama ODP yang sama akan diperbarui.</div></div><div class="modal-footer"><button class="btn-tech" type="button" data-bs-dismiss="modal">Batal</button><button class="btn-tech primary"><i class="bi bi-upload"></i>Import</button></div></form></div></div>
