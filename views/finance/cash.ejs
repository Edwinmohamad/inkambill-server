<% const monthNames=['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember']; %>
<section class="cash-page">
  <div class="module-head cash-page-head">
    <div><div class="module-kicker">FINANCIAL OPERATIONS</div><h1>Data Kas</h1><p>Kelola pemasukan, pengeluaran, bukti transaksi, dan approval. Ringkasan saldo hanya menghitung transaksi APPROVED.</p></div>
    <div class="module-actions"><a class="btn-tech" href="/cash/categories"><i class="bi bi-tags"></i>Kategori Kas</a><a class="btn-tech" href="/payments/reconciliation"><i class="bi bi-arrow-left-right"></i>Rekonsiliasi</a></div>
  </div>

  <form class="cash-period-panel" method="get" action="/cash" data-auto-filter>
    <div class="cash-period-copy"><strong>Periode Kas</strong><small>Filter transaksi berdasarkan bulan, tahun, site, kategori, dan tipe.</small></div>
    <div class="cash-period-controls">
      <select class="form-select" name="month"><% monthNames.forEach((m,i)=>{ %><option value="<%= i+1 %>" <%= filters.month===i+1?'selected':'' %>><%= m %></option><% }) %></select>
      <input class="form-control" type="number" name="year" min="2020" max="2100" value="<%= filters.year %>">
      <select class="form-select" name="site"><option value="">Semua Site</option><% sites.forEach(s=>{ %><option value="<%= s.code %>" <%= filters.site===s.code?'selected':'' %>><%= s.code %> · <%= s.name %></option><% }) %></select>
      <!-- v1.25.5 (susulan #13) — Kategori & Tipe ditambahkan sebagai filter berdiri sendiri (sebelumnya
           kategori cuma bisa dicari lewat kotak cari teks bebas di bawah). Auto-submit lewat mekanisme
           yang sama seperti Bulan/Tahun/Site (lihat public/js/app.js — semua <select> di form GET ini
           otomatis submit saat berubah, tidak perlu JS baru). -->
      <select class="form-select" name="category"><option value="">Semua Kategori</option><% categories.forEach(c=>{ %><option value="<%= c.id %>" <%= String(filters.category)===String(c.id)?'selected':'' %>><%= c.type==='income'?'[+]':'[-]' %> <%= c.code %> · <%= c.name %></option><% }) %></select>
      <select class="form-select" name="type"><option value="">Semua Tipe</option><option value="income" <%= filters.type==='income'?'selected':'' %>>Pemasukan</option><option value="expense" <%= filters.type==='expense'?'selected':'' %>>Pengeluaran</option></select>
      <span class="auto-filter-hint"><i class="bi bi-lightning-charge-fill"></i>Otomatis</span>
    </div>
  </form>

  <div class="cash-summary-grid">
    <article class="cash-summary-card income"><div><span>Pendapatan</span><strong><%= formatRupiah(summary.income) %></strong></div><i class="bi bi-graph-up-arrow"></i></article>
    <article class="cash-summary-card balance"><div><span>Saldo</span><strong><%= formatRupiah(summary.balance) %></strong></div><i class="bi bi-wallet2"></i></article>
    <article class="cash-summary-card expense"><div><span>Pengeluaran</span><strong><%= formatRupiah(summary.expense) %></strong></div><i class="bi bi-graph-down-arrow"></i></article>
    <article class="cash-summary-card pending"><div><span>Menunggu Approval</span><strong><%= Number(approvalSummary.pending_count||0) %></strong><small><%= formatRupiah(approvalSummary.pending_total||0) %></small></div><i class="bi bi-hourglass-split"></i></article>
  </div>

  <!-- v1.25.6 — fixes reported bug: transaksi kas yang baru disubmit (PENDING_APPROVAL) tidak pernah
       terlihat di widget Pendapatan/Pengeluaran/Saldo maupun chart di atas (memang sengaja, ringkasan
       hanya menghitung APPROVED), TAPI halaman ini sebelumnya tidak punya penanda apa pun yang menjelaskan
       ke user bahwa transaksinya sebenarnya sudah tersimpan dan sedang menunggu approval — sehingga
       terlihat seperti data hilang/bug. `approvalSummary` (pending_count/pending_total) sudah dihitung di
       routes/finance.js sejak lama tapi tidak pernah dirender di sini, dan CSS `.cash-pending-note` di
       public/css/app.css juga sudah lama ada tapi tidak dipakai di mana pun — keduanya disatukan di sini. -->
  <% if(createdTransaction){ %>
  <div class="cash-created-note" id="cash-created-<%= createdTransaction.id %>">
    <i class="bi bi-check-circle-fill"></i>
    <span><strong>Data kas baru berhasil disimpan</strong><small><%= createdTransaction.transaction_code||('#'+createdTransaction.id) %> · <%= createdTransaction.name %> · <%= formatRupiah(createdTransaction.amount) %> · status PENDING APPROVAL.</small></span>
    <a href="#cash-row-<%= createdTransaction.id %>">Lihat baris <i class="bi bi-arrow-down"></i></a>
  </div>
  <% } %>

  <% if(Number(approvalSummary.pending_count||0)>0){ %>
  <div class="cash-pending-note">
    <i class="bi bi-hourglass-split"></i>
    <span>
      <strong><%= Number(approvalSummary.pending_count||0) %> transaksi kas (<%= formatRupiah(approvalSummary.pending_total||0) %>) sedang menunggu approval</strong>
      <small>Transaksi PENDING_APPROVAL sudah tersimpan di tabel Data Kas di bawah, tapi belum dihitung pada Pendapatan/Pengeluaran/Saldo maupun chart di atas sampai disetujui Master Admin.</small>
    </span>
    <a href="/payments#cash-approval">Buka Approval &amp; Transaksi <i class="bi bi-arrow-right"></i></a>
  </div>
  <% } %>

  <div class="cash-chart-grid">
    <article class="data-card cash-chart-card"><div class="data-card-head"><div><h3>Komposisi Pengeluaran</h3><small>Distribusi biaya per kategori pada periode terpilih</small></div><i class="bi bi-pie-chart-fill"></i></div><div class="cash-chart-body"><canvas id="cashExpenseChart"></canvas><div class="cash-chart-empty" id="cashExpenseEmpty" hidden>Belum ada pengeluaran.</div></div></article>
    <article class="data-card cash-chart-card"><div class="data-card-head"><div><h3>Arus Kas Harian</h3><small>Pemasukan dibanding pengeluaran setiap hari</small></div><i class="bi bi-graph-up-arrow"></i></div><div class="cash-chart-body"><canvas id="cashDailyChart"></canvas></div></article>
  </div>

  <div class="cash-custody-strip"><div><span><i class="bi bi-person-vcard"></i> Cash masih di staff</span><strong><%= formatRupiah(collection.cash_held||0) %></strong><small><%= Number(collection.held_count||0) %> pembayaran belum disetor</small></div><a href="/payments/reconciliation">Buka Rekonsiliasi <i class="bi bi-arrow-right"></i></a></div>

  <div class="cash-action-bar">
    <button class="btn-tech primary" type="button" data-bs-toggle="modal" data-bs-target="#cashModal"><i class="bi bi-plus-lg"></i>Data Kas</button>
    <div class="cash-action-right">
      <form method="get" action="/cash" class="cash-search-form cash-trace-filter" data-instant-prefix-form data-instant-target="cashLedgerBody"><input type="hidden" name="month" value="<%= filters.month %>"><input type="hidden" name="year" value="<%= filters.year %>"><label class="cash-inline-filter"><i class="bi bi-geo-alt-fill"></i><select class="form-select" name="site" aria-label="Filter site" onchange="this.form.submit()"><option value="">Semua Site</option><% sites.forEach(s=>{ %><option value="<%= s.code %>" <%= filters.site===s.code?'selected':'' %>><%= s.code %> · <%= s.name %></option><% }) %></select></label><label class="cash-inline-filter"><i class="bi bi-tags-fill"></i><select class="form-select" name="category" aria-label="Filter kategori kas" onchange="this.form.submit()"><option value="">Semua Kategori</option><% categories.forEach(c=>{ %><option value="<%= c.id %>" <%= String(filters.category)===String(c.id)?'selected':'' %>><%= c.type==='income'?'[+]':'[-]' %> <%= c.name %></option><% }) %></select></label><label class="cash-inline-filter compact"><i class="bi bi-arrow-down-up"></i><select class="form-select" name="type" aria-label="Filter tipe transaksi" onchange="this.form.submit()"><option value="">Semua Tipe</option><option value="income" <%= filters.type==='income'?'selected':'' %>>Pemasukan</option><option value="expense" <%= filters.type==='expense'?'selected':'' %>>Pengeluaran</option></select></label><div class="search-box"><i class="bi bi-search"></i><input name="q" type="search" value="<%= filters.q %>" autocomplete="off" data-instant-prefix-input placeholder="Ketik untuk mencari langsung..."></div><span class="cash-live-search-hint"><i class="bi bi-lightning-charge-fill"></i>Tanpa tombol</span><% if(filters.q||filters.category||filters.site||filters.type){ %><a class="btn-tech cash-filter-reset" href="/cash?month=<%= filters.month %>&year=<%= filters.year %>" title="Hapus seluruh filter transaksi"><i class="bi bi-x-lg"></i>Reset</a><% } %></form>
      <% if(isAdmin){ %><form method="post" action="/cash/delete-all" onsubmit="return confirm('Hapus SEMUA transaksi kas MANUAL pada <%= monthNames[filters.month-1] %> <%= filters.year %>? Transaksi otomatis pembayaran tetap aman.')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="month" value="<%= filters.month %>"><input type="hidden" name="year" value="<%= filters.year %>"><input type="hidden" name="site" value="<%= filters.site %>"><input type="hidden" name="category" value="<%= filters.category %>"><input type="hidden" name="type" value="<%= filters.type %>"><button class="btn-tech danger"><i class="bi bi-trash3"></i>Hapus Semua</button></form><% } %>
    </div>
  </div>

  <div class="data-card cash-ledger-card">
    <div class="data-card-head"><div><h3>Data Kas · <%= monthNames[filters.month-1] %> <%= filters.year %></h3><small data-instant-result-count data-total="<%= transactions.length %>"><%= transactions.length %> transaksi<%= filters.site?` · ${filters.site}`:'' %></small></div><div class="legend-inline"><span><i class="dot success"></i>Pemasukan</span><span><i class="dot warning"></i>Bukti tersedia</span></div></div>
    <div class="table-responsive">
      <table class="app-table cash-ledger-table" data-bulk-scope="cashBulkBar">
        <thead><tr><% if(isAdmin){ %><th class="app-check-col"><input type="checkbox" class="form-check-input" data-select-all aria-label="Pilih semua transaksi kas"></th><% } %><th class="app-seq-col">No.</th><th>Nama</th><th>Tanggal</th><th>Kategori</th><th>Site</th><th>Keterangan</th><th>Bukti</th><th>Status Approval</th><th>Nominal</th><th class="text-end">Aksi</th></tr></thead>
        <tbody id="cashLedgerBody">
          <% transactions.forEach((t,index)=>{ const editable=true;const td=new Date(t.transaction_date);const txDate=`${td.getFullYear()}-${String(td.getMonth()+1).padStart(2,'0')}-${String(td.getDate()).padStart(2,'0')}`;const inheritedPaymentProof=!t.proof_path&&t.source_payment_id&&t.source_payment_proof_path;const effectiveProof=!!(t.proof_path||inheritedPaymentProof);const effectiveProofHref=t.proof_path?`/cash/${t.id}/proof`:`/payments/${t.source_payment_id}/proof`;const effectiveProofMime=t.proof_path?t.proof_mime:t.source_payment_proof_mime; %>
          <tr id="cash-row-<%= t.id %>" class="<%= Number(createdId||0)===Number(t.id)?'cash-row-created':'' %>" data-instant-filter-row data-instant-search-value="<%= [t.transaction_code,t.name,t.notes,t.category_name,t.category_code,t.site_code,t.purchase_shop_name,t.purchase_channel,t.vendor_name].filter(Boolean).join(' ') %>">
            <% if(isAdmin){ %><td class="app-check-col"><% if(editable){ %><input type="checkbox" class="form-check-input" data-row-check value="<%= t.id %>" aria-label="Pilih transaksi <%= t.transaction_code||t.id %>"><% } %></td><% } %>
            <td><span class="cell-main" data-instant-number><%= index+1 %></span></td>
            <td><span class="cell-main"><%= t.name %></span><span class="cell-sub"><%= t.source_type==='payment'?'AUTO BILLING':'MANUAL' %></span></td>
            <td><%= formatDate(t.transaction_date) %></td>
            <td><span class="status-badge <%= t.category_type==='income'?'green':'red' %>"><%= t.category_name %></span></td>
            <td><span class="status-badge purple"><%= t.site_code||'GLOBAL' %></span></td>
            <td><span class="cash-note"><%= t.notes||'-' %></span><% if(t.vendor_name){ %><span class="cell-sub"><i class="bi bi-person-workspace"></i> <%= t.vendor_name %> · <%= Number(t.vendor_duration||0).toLocaleString('id-ID') %> <%= t.vendor_duration_unit==='day'?'hari':'jam' %></span><% }else if(t.purchase_channel){ %><span class="cell-sub"><i class="bi <%= t.purchase_channel==='online'?'bi-bag-check-fill':'bi-shop' %>"></i> <%= t.purchase_channel==='online'?'Online Shop':'Offline Shop' %><%= t.purchase_shop_name?' · '+t.purchase_shop_name:'' %></span><% } %></td>
            <td>
              <% if(effectiveProof){ %><a class="proof-chip compact-proof" href="<%= effectiveProofHref %>" target="_blank" rel="noopener"><span class="proof-chip-icon"><i class="bi <%= effectiveProofMime==='application/pdf'?'bi-file-earmark-pdf-fill':'bi-image-fill' %>"></i></span><span><strong><%= inheritedPaymentProof?'Bukti transfer':'Sudah upload' %></strong><small><%= inheritedPaymentProof?'Dari approval':'Lihat bukti' %></small></span></a>
              <% } else if(t.category_type==='expense'){ %><span class="proof-missing proof-missing-strong"><i class="bi bi-exclamation-triangle-fill"></i>Belum ada bukti</span>
              <% } else { %><span class="proof-not-required" title="Bukti fisik tidak diwajibkan untuk transaksi pemasukan"><i class="bi bi-dash-circle"></i>Tidak wajib (pemasukan)</span><% } %>
            </td>
            <td><% const cashApproval=t.approval_status||'APPROVED'; %><span class="status-badge <%= cashApproval==='APPROVED'?'green':cashApproval==='REJECTED'?'red':'orange' %>"><i class="bi <%= cashApproval==='APPROVED'?'bi-check2-circle':cashApproval==='REJECTED'?'bi-x-circle':'bi-hourglass-split' %>"></i> <%= cashApproval==='APPROVED'?'Approved':cashApproval==='REJECTED'?'Rejected':'Pending Approval' %></span><% if(t.approval_reason){ %><span class="cell-sub"><%= t.approval_reason %></span><% } %></td>
            <td class="money <%= t.category_type==='income'?'text-success-soft':'text-danger-soft' %>"><%= t.category_type==='income'?'+ ':'- ' %><%= formatRupiah(t.amount) %></td>
            <td class="text-end"><% if(isAdmin&&editable){ %><button class="action-menu action-menu-labeled" type="button" data-action-popover-target="cashAction<%= t.id %>" aria-label="Buka tindakan transaksi <%= t.transaction_code||t.id %>"><i class="bi bi-three-dots-vertical"></i><span>Aksi</span></button><div class="ink-action-popover" id="cashAction<%= t.id %>" hidden><div class="ink-action-popover-head"><div><small><%= t.source_invoice_id?'DATA KAS · AUTO BILLING':'DATA KAS' %></small><strong><%= t.name %></strong><span><%= t.transaction_code||'-' %> · <%= formatRupiah(t.amount) %></span></div></div><div class="ink-action-popover-body">
              <% if(t.source_invoice_id){ %><div class="cash-popover-note"><i class="bi bi-info-circle-fill"></i><span>Baris ini dibuat otomatis dari pembayaran Faktur <b><%= t.source_invoice_number||('#'+t.source_invoice_id) %></b>. Boleh diedit/dihapus manual seperti transaksi kas biasa — kalau Anda justru ingin membatalkan pembayarannya (tagihan kembali belum lunas), gunakan "Batalkan Pembayaran" di bawah.</span></div><% } %>
              <button type="button" class="ink-action-item compact success" data-action-close data-bs-toggle="modal" data-bs-target="#cashEditModal" data-id="<%= t.id %>" data-date="<%= txDate %>" data-name="<%= t.name %>" data-category="<%= t.category_id %>" data-site="<%= t.site_id||'' %>" data-amount="<%= Number(t.amount) %>" data-notes="<%= t.notes||'' %>" data-purchase-channel="<%= t.purchase_channel||'' %>" data-purchase-shop="<%= t.purchase_shop_name||'' %>" data-vendor-name="<%= t.vendor_name||'' %>" data-vendor-duration="<%= t.vendor_duration||'' %>" data-vendor-unit="<%= t.vendor_duration_unit||'' %>" data-source-type="<%= t.source_type||'manual' %>"><i class="bi bi-pencil-square"></i><span><b>Perbarui Data</b><small>Edit transaksi atau upload bukti</small></span></button><% if(effectiveProof){ %><a class="ink-action-item compact" href="<%= effectiveProofHref %>" target="_blank" rel="noopener"><i class="bi bi-file-earmark-image"></i><span><b>Lihat Bukti</b><small><%= inheritedPaymentProof?'Bukti transfer dari approval':'Buka lampiran transaksi' %></small></span></a><% } %><% if(t.source_invoice_id){ %><a class="ink-action-item compact" href="/invoices?q=<%= encodeURIComponent(t.source_invoice_number||'') %>"><i class="bi bi-receipt"></i><span><b>Lihat Faktur Asal</b><small>Faktur <%= t.source_invoice_number||('#'+t.source_invoice_id) %></small></span></a><form method="post" action="/invoices/<%= t.source_invoice_id %>/reset-unpaid" onsubmit="return confirm('Batalkan pembayaran untuk tagihan <%= t.source_invoice_number||'' %>? Tagihan akan kembali BELUM LUNAS, pembayaran terkait dibatalkan, dan transaksi kas ini (<%= t.transaction_code||'' %>) otomatis ikut terhapus dari jurnal. Tindakan ini tidak dapat dibatalkan begitu-begitu saja — pelanggan perlu membayar ulang.')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="return_to" value="/cash?month=<%= filters.month %>&year=<%= filters.year %>&site=<%= encodeURIComponent(filters.site) %>&q=<%= encodeURIComponent(filters.q) %>&category=<%= encodeURIComponent(filters.category) %>&type=<%= encodeURIComponent(filters.type) %>"><button type="submit" class="ink-action-item compact"><i class="bi bi-arrow-counterclockwise"></i><span><b>Batalkan Pembayaran</b><small>Reversal penuh: tagihan jadi belum lunas</small></span></button></form><% } %><div class="ink-action-separator"></div><% if(cashApproval!=='APPROVED'){ %><form method="post" action="/cash/<%= t.id %>/delete" onsubmit="return confirm('Hapus transaksi kas <%= t.transaction_code||'' %>?')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="return_month" value="<%= filters.month %>"><input type="hidden" name="return_year" value="<%= filters.year %>"><input type="hidden" name="return_site" value="<%= filters.site %>"><input type="hidden" name="return_q" value="<%= filters.q %>"><input type="hidden" name="return_category" value="<%= filters.category %>"><input type="hidden" name="return_type" value="<%= filters.type %>"><button type="submit" class="ink-action-item compact danger"><i class="bi bi-trash3"></i><span><b>Hapus</b><small>Hapus transaksi ini</small></span></button></form><% } else if(isMasterAdmin){ %><button type="button" class="ink-action-item compact danger" data-force-delete="/cash/<%= t.id %>/force-delete?return_month=<%= filters.month %>&return_year=<%= filters.year %>&return_site=<%= encodeURIComponent(filters.site) %>&return_q=<%= encodeURIComponent(filters.q) %>&return_category=<%= encodeURIComponent(filters.category) %>&return_type=<%= encodeURIComponent(filters.type) %>" data-entity-label="Transaksi Kas <%= t.transaction_code||('#'+t.id) %> - <%= t.name %>" data-force-delete-match="<%= t.transaction_code||('#'+t.id) %>" data-force-delete-warning="Transaksi ini sudah APPROVED dan menjadi bagian dari jurnal kas resmi. Hapus Paksa akan menghapusnya secara permanen dari jurnal, dan TIDAK dapat dibatalkan."><i class="bi bi-exclamation-octagon-fill"></i><span><b>Hapus Paksa</b><small>Master Admin · transaksi sudah APPROVED</small></span></button><% } else { %><div class="cash-popover-note locked"><i class="bi bi-shield-lock-fill"></i><span>Transaksi ini sudah APPROVED dan menjadi jurnal kas resmi. Hanya Master Admin yang dapat menghapusnya (Hapus Paksa).</span></div><% } %></div></div><% } else { %><span class="text-secondary small">—</span><% } %></td>
          </tr>
          <% }) %>
          <% if(transactions.length){ %><tr data-instant-empty hidden><td colspan="<%= isAdmin?11:10 %>"><div class="empty-state"><i class="bi bi-search"></i><strong>Data tidak ditemukan</strong><small>Coba ketik awalan nama, kode, kategori, site, atau keterangan lain.</small></div></td></tr><% } %>
          <% if(!transactions.length){ %><tr><td colspan="<%= isAdmin?11:10 %>"><div class="empty-state"><i class="bi bi-cash-stack"></i><strong>Belum ada data kas</strong><small>Tambahkan pemasukan/pengeluaran atau ubah filter periode.</small></div></td></tr><% } %>
        </tbody>
      </table>
    </div>
    <!-- v1.22 — checkbox-based bulk delete for Data Kas. Only manual, non-auto rows get a checkbox
         (APPROVED manual rows are still checkable — the server-side guard skips/reports them, same as
         the per-row "Hapus" button behaviour above). Master Admin additionally gets "Hapus Paksa Massal"
         which bypasses the APPROVED guard, mirroring /cash/:id/force-delete. -->
    <% if(isAdmin){ %><div class="customer-bulk-bar" id="cashBulkBar" hidden><span><b data-bulk-count>0</b> transaksi kas terpilih</span><div class="customer-bulk-buttons"><button type="button" data-bulk-clear class="ghost"><i class="bi bi-x-lg"></i>Batal</button><button type="button" class="danger" data-simple-delete-bulk data-bulk-scope-id="cashBulkBar" data-bulk-url="/cash/bulk?return_month=<%= filters.month %>&return_year=<%= filters.year %>&return_site=<%= encodeURIComponent(filters.site) %>&return_q=<%= encodeURIComponent(filters.q) %>&return_category=<%= encodeURIComponent(filters.category) %>&return_type=<%= encodeURIComponent(filters.type) %>" data-bulk-action-field="action" data-bulk-action-value="delete" data-bulk-id-field="cash_ids[]" data-entity-label-plural="transaksi kas" data-simple-delete-title="Hapus transaksi kas terpilih?" data-simple-delete-warning="Transaksi yang sudah APPROVED akan otomatis dilewati (gunakan Hapus Paksa Massal untuk itu)."><i class="bi bi-trash3-fill"></i>Hapus Massal</button><% if(isMasterAdmin){ %><button type="button" class="danger" data-force-delete-bulk data-bulk-scope-id="cashBulkBar" data-bulk-url="/cash/bulk?return_month=<%= filters.month %>&return_year=<%= filters.year %>&return_site=<%= encodeURIComponent(filters.site) %>&return_q=<%= encodeURIComponent(filters.q) %>&return_category=<%= encodeURIComponent(filters.category) %>&return_type=<%= encodeURIComponent(filters.type) %>" data-bulk-action-field="action" data-bulk-action-value="force_delete" data-bulk-id-field="cash_ids[]" data-entity-label-plural="transaksi kas" data-force-delete-match="HAPUS PAKSA" data-force-delete-warning="Hapus Paksa akan menghapus SEMUA transaksi kas terpilih secara permanen, termasuk yang sudah APPROVED dan menjadi jurnal resmi — dan TIDAK dapat dibatalkan."><i class="bi bi-exclamation-octagon-fill"></i>Hapus Paksa Massal</button><% } %></div></div><% } %>
  </div>

</section>

<div class="modal fade" id="cashModal" tabindex="-1"><div class="modal-dialog modal-lg modal-dialog-centered"><form class="modal-content" method="post" action="/cash" enctype="multipart/form-data"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="modal-header"><div><div class="module-kicker">CASH LEDGER</div><h5 class="modal-title">Tambah Data Kas</h5></div><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="cash-code-hint"><i class="bi bi-shield-check"></i><div><strong>Transaksi baru masuk PENDING_APPROVAL</strong><small>Kode dibuat otomatis. Saldo real baru berubah setelah Master Admin menekan Approve di menu Approval & Transaksi.</small></div></div><div class="row g-3 mt-1"><div class="col-md-4"><label class="form-label">Tanggal</label><% const cashNow=new Date();const cashDefaultDay=(filters.year===cashNow.getFullYear()&&filters.month===cashNow.getMonth()+1)?cashNow.getDate():1;const cashDefaultDate=`${filters.year}-${String(filters.month).padStart(2,'0')}-${String(cashDefaultDay).padStart(2,'0')}`; %><input class="form-control" type="date" name="transaction_date" value="<%= cashDefaultDate %>" required></div><div class="col-md-4"><label class="form-label">Site</label><select class="form-select" name="site_id"><option value="">Global</option><% sites.forEach(s=>{ %><option value="<%= s.id %>"><%= s.code %></option><% }) %></select></div><div class="col-md-4"><label class="form-label">Nominal</label><input class="form-control" type="number" name="amount" min="1" required></div><div class="col-md-6"><label class="form-label">Nama Transaksi <small class="text-secondary">(otomatis dirapikan)</small></label><input class="form-control" name="name" required placeholder="Pembelian router 6pcs"><small class="form-text text-secondary">Contoh hasil: PTC_Pembelian Router 6Pcs_WisnuPandawa</small></div><div class="col-md-6"><label class="form-label">Kategori</label><select class="form-select" name="category_id" required><% categories.filter(c=>!Number(c.is_system||0)).forEach(c=>{ const isVendor=isVendorCashCategory(c); %><option value="<%= c.id %>" data-type="<%= c.type %>" data-vendor="<%= isVendor?'1':'0' %>"><%= c.type==='income'?'[+]':'[-]' %> <%= c.code %> · <%= c.name %></option><% }) %></select></div><div class="col-md-6" data-purchase-field><label class="form-label">Pembelian Dari</label><select class="form-select" name="purchase_channel" data-purchase-channel><option value="">Tidak terkait pembelian</option><option value="online">Online Shop / Marketplace</option><option value="offline">Offline Shop / Toko Fisik</option></select></div><div class="col-md-6" data-purchase-field><label class="form-label">Nama Toko / Marketplace <span class="text-secondary">(opsional)</span></label><input class="form-control" name="purchase_shop_name" data-purchase-shop placeholder="Contoh: Shopee / Tokopedia / Toko Sumber Jaya"></div><div class="col-md-6 d-none" data-vendor-field><label class="form-label">Nama Vendor</label><input class="form-control" name="vendor_name" placeholder="Nama vendor / teknisi eksternal" disabled></div><div class="col-md-3 d-none" data-vendor-field><label class="form-label">Durasi Kerja</label><input class="form-control" type="number" name="vendor_duration" min="0.5" step="0.5" placeholder="8" disabled></div><div class="col-md-3 d-none" data-vendor-field><label class="form-label">Satuan</label><select class="form-select" name="vendor_duration_unit" disabled><option value="hour">Jam</option><option value="day">Hari</option></select></div><div class="col-12"><label class="form-label">Keterangan</label><textarea class="form-control" name="notes" rows="3" placeholder="Jelaskan pekerjaan, hasil, atau lokasi pengerjaan"></textarea></div><div class="col-12"><label class="form-label">Foto / Bukti Pengeluaran <span class="text-secondary">(opsional)</span></label><label class="proof-dropzone large"><input type="file" name="proof_file" accept="image/jpeg,image/png,image/webp,application/pdf" data-cash-proof><span class="proof-drop-icon"><i class="bi bi-camera-fill"></i></span><span><strong>Upload foto / dokumen bukti</strong><small>JPG, PNG, WEBP, PDF · Maks. 6 MB</small><em data-cash-proof-name>Belum ada file dipilih</em></span></label></div></div></div><div class="modal-footer"><button type="button" class="btn-tech" data-bs-dismiss="modal">Batal</button><button class="btn-tech primary"><i class="bi bi-check2"></i>Simpan Data Kas</button></div></form></div></div>

<div class="modal fade" id="cashEditModal" tabindex="-1"><div class="modal-dialog modal-lg modal-dialog-centered"><form class="modal-content" method="post" id="cashEditForm" enctype="multipart/form-data"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="return_month" value="<%= filters.month %>"><input type="hidden" name="return_year" value="<%= filters.year %>"><input type="hidden" name="return_site" value="<%= filters.site %>"><input type="hidden" name="return_q" value="<%= filters.q %>"><input type="hidden" name="return_category" value="<%= filters.category %>"><input type="hidden" name="return_type" value="<%= filters.type %>"><div class="modal-header"><div><div class="module-kicker">EDIT CASH LEDGER</div><h5 class="modal-title">Perbarui Data Kas</h5><small class="text-secondary">Perubahan transaksi manual akan meminta approval ulang.</small></div><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="cash-code-hint d-none" data-edit-autobilling-note><i class="bi bi-shield-lock"></i><div><strong>Baris AUTO BILLING</strong><small>Kategori dan nominal terhubung ke pembayaran/invoice asli sehingga dikunci. Gunakan "Batalkan Pembayaran" bila memang perlu dikoreksi.</small></div></div><div class="row g-3"><div class="col-md-4"><label class="form-label">Tanggal</label><input class="form-control" type="date" name="transaction_date" id="cashEditDate" required></div><div class="col-md-4"><label class="form-label">Site</label><select class="form-select" name="site_id" id="cashEditSite"><option value="">Global</option><% sites.forEach(s=>{ %><option value="<%= s.id %>"><%= s.code %></option><% }) %></select></div><div class="col-md-4"><label class="form-label">Nominal</label><input class="form-control" type="number" name="amount" id="cashEditAmount" min="1" required></div><div class="col-md-6"><label class="form-label">Nama Transaksi</label><input class="form-control" name="name" id="cashEditName" required></div><div class="col-md-6"><label class="form-label">Kategori</label><select class="form-select" name="category_id" id="cashEditCategory" required><% categories.forEach(c=>{ const isVendor=isVendorCashCategory(c); %><option value="<%= c.id %>" data-vendor="<%= isVendor?'1':'0' %>" <%= Number(c.is_system||0)?'disabled':'' %>><%= c.type==='income'?'[+]':'[-]' %> <%= c.code %> · <%= c.name %><%= Number(c.is_system||0)?' · OTOMATIS':'' %></option><% }) %></select></div><div class="col-md-6" data-edit-purchase-field><label class="form-label">Pembelian Dari</label><select class="form-select" name="purchase_channel" id="cashEditPurchaseChannel"><option value="">Tidak terkait pembelian</option><option value="online">Online Shop / Marketplace</option><option value="offline">Offline Shop / Toko Fisik</option></select></div><div class="col-md-6" data-edit-purchase-field><label class="form-label">Nama Toko / Marketplace <span class="text-secondary">(opsional)</span></label><input class="form-control" name="purchase_shop_name" id="cashEditPurchaseShop" placeholder="Nama toko / marketplace"></div><div class="col-md-6 d-none" data-edit-vendor-field><label class="form-label">Nama Vendor</label><input class="form-control" name="vendor_name" id="cashEditVendorName" disabled></div><div class="col-md-3 d-none" data-edit-vendor-field><label class="form-label">Durasi Kerja</label><input class="form-control" type="number" name="vendor_duration" id="cashEditVendorDuration" min="0.5" step="0.5" disabled></div><div class="col-md-3 d-none" data-edit-vendor-field><label class="form-label">Satuan</label><select class="form-select" name="vendor_duration_unit" id="cashEditVendorUnit" disabled><option value="hour">Jam</option><option value="day">Hari</option></select></div><div class="col-12"><label class="form-label">Keterangan</label><textarea class="form-control" name="notes" id="cashEditNotes" rows="3"></textarea></div><div class="col-12"><label class="form-label">Upload / Ganti Bukti <span class="text-secondary">(opsional)</span></label><label class="proof-dropzone"><input type="file" name="proof_file" accept="image/jpeg,image/png,image/webp,application/pdf" data-cash-proof><span class="proof-drop-icon"><i class="bi bi-cloud-arrow-up-fill"></i></span><span><strong>Pilih bukti baru</strong><small>Jika kosong, bukti lama tetap digunakan.</small><em data-cash-proof-name>Belum ada file baru</em></span></label></div></div></div><div class="modal-footer"><button type="button" class="btn-tech" data-bs-dismiss="modal">Batal</button><button class="btn-tech primary"><i class="bi bi-check2"></i>Simpan Perubahan</button></div></form></div></div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
<script>
(()=>{
  const addForm=document.querySelector('#cashModal form');
  const toggleFields=(form,isVendor,vendorSelector,purchaseSelector)=>{
    form.querySelectorAll(vendorSelector).forEach(field=>{field.classList.toggle('d-none',!isVendor);field.querySelectorAll('input,select,textarea').forEach(input=>{input.disabled=!isVendor;input.required=isVendor;});});
    form.querySelectorAll(purchaseSelector).forEach(field=>{field.classList.toggle('d-none',isVendor);field.querySelectorAll('input,select,textarea').forEach(input=>input.disabled=isVendor);});
  };
  if(addForm){
    // Browser constraint validation on a Bootstrap modal can look like a no-op when a required
    // field (most commonly Nominal) is empty. Validate on the button click as well and show the
    // missing field inside the modal so the user knows why the request was not sent.
    const submitError=document.createElement('div');
    submitError.className='cash-form-error';
    submitError.setAttribute('role','alert');
    submitError.hidden=true;
    addForm.querySelector('.modal-body')?.prepend(submitError);
    const showSubmitError=(message,field)=>{
      submitError.innerHTML=`<i class="bi bi-exclamation-triangle-fill"></i><span>${message}</span>`;
      submitError.hidden=false;
      field?.classList.add('is-invalid');
      field?.focus({preventScroll:true});
      field?.scrollIntoView({block:'center',behavior:'smooth'});
    };
    const clearSubmitError=field=>{field?.classList.remove('is-invalid');if(!addForm.querySelector('.is-invalid'))submitError.hidden=true;};
    addForm.querySelectorAll('[required]').forEach(field=>field.addEventListener('input',()=>clearSubmitError(field)));
    addForm.querySelectorAll('select[required]').forEach(field=>field.addEventListener('change',()=>clearSubmitError(field)));
    addForm.querySelector('.modal-footer .btn-tech.primary')?.addEventListener('click',event=>{
      const date=addForm.querySelector('[name="transaction_date"]');
      const amount=addForm.querySelector('[name="amount"]');
      const name=addForm.querySelector('[name="name"]');
      const category=addForm.querySelector('[name="category_id"]');
      const checks=[
        [date,!String(date?.value||'').trim(),'Tanggal transaksi wajib diisi.'],
        [amount,!Number.isFinite(Number(amount?.value))||Number(amount?.value)<=0,'Nominal pengeluaran wajib diisi dan harus lebih dari 0.'],
        [name,!String(name?.value||'').trim(),'Nama transaksi wajib diisi.'],
        [category,!String(category?.value||'').trim()||category?.disabled,'Pilih kategori pengeluaran terlebih dahulu.']
      ];
      const failed=checks.find(([,invalid])=>invalid);
      if(failed){event.preventDefault();showSubmitError(failed[2],failed[0]);}
      else submitError.hidden=true;
    });
    const hint=addForm.querySelector('.cash-code-hint');
    hint?.insertAdjacentHTML('beforebegin','<div class="cash-entry-type"><label><input type="radio" name="entry_type" value="expense" checked><span><i class="bi bi-graph-down-arrow"></i><strong>Pengeluaran</strong><small>Belanja, vendor, atau biaya operasional</small></span></label><label><input type="radio" name="entry_type" value="income"><span><i class="bi bi-graph-up-arrow"></i><strong>Pemasukan</strong><small>Pendapatan kas manual</small></span></label></div>');
    const category=addForm.querySelector('select[name="category_id"]'),proof=addForm.querySelector('[name="proof_file"]'),submit=addForm.querySelector('.modal-footer .btn-tech.primary');
    // Keep a stable in-memory copy of every category. Rebuilding the select is more reliable than
    // toggling <option hidden disabled> (browser behavior differs and could leave a disabled Vendor
    // option selected after the user changed transaction type/category).
    const categoryCatalog=[...category.options].map(option=>({value:option.value,label:option.textContent,type:option.dataset.type||'expense',vendor:option.dataset.vendor==='1'}));
    const renderCategories=(type,preferredValue='')=>{
      const matches=categoryCatalog.filter(item=>item.type===type);
      category.replaceChildren(...matches.map(item=>{const option=document.createElement('option');option.value=item.value;option.textContent=item.label;option.dataset.type=item.type;option.dataset.vendor=item.vendor?'1':'0';return option;}));
      const preferred=matches.find(item=>String(item.value)===String(preferredValue));
      category.value=preferred?String(preferred.value):(matches[0]?String(matches[0].value):'');
      category.disabled=matches.length===0;
      category.setCustomValidity(matches.length?'':'Belum ada kategori aktif untuk tipe transaksi ini.');
    };
    const syncType=(preferredValue='')=>{
      const type=addForm.querySelector('input[name="entry_type"]:checked')?.value||'expense';
      const currentValue=preferredValue||category.value;
      const currentOption=categoryCatalog.find(item=>String(item.value)===String(currentValue));
      if(!category.options.length||!currentOption||currentOption.type!==type)renderCategories(type,currentValue);
      const selected=categoryCatalog.find(item=>String(item.value)===String(category.value));
      proof.closest('.col-12')?.classList.toggle('d-none',type!=='expense');proof.disabled=type!=='expense';
      const isVendor=!!selected?.vendor&&type==='expense';
      toggleFields(addForm,isVendor,'[data-vendor-field]','[data-purchase-field]');
      if(submit){submit.disabled=category.disabled;submit.innerHTML=`<i class="bi bi-check2"></i>Simpan ${type==='expense'?'Pengeluaran':'Pemasukan'}`;}
    };
    addForm.querySelectorAll('input[name="entry_type"]').forEach(input=>input.addEventListener('change',()=>{renderCategories(input.value);syncType();}));
    category.addEventListener('change',()=>syncType(category.value));
    renderCategories('expense');syncType();
    // Reset state every time the modal is closed, preventing stale Vendor required-fields/category state
    // from leaking into the next Data Kas entry.
    const addModal=document.getElementById('cashModal');
    addModal?.addEventListener('hidden.bs.modal',()=>{
      addForm.reset();
      submitError.hidden=true;
      addForm.querySelectorAll('.is-invalid').forEach(field=>field.classList.remove('is-invalid'));
      const expenseRadio=addForm.querySelector('input[name="entry_type"][value="expense"]');if(expenseRadio)expenseRadio.checked=true;
      renderCategories('expense');syncType();
      addForm.querySelectorAll('[data-cash-proof-name]').forEach(x=>x.textContent='Belum ada file dipilih');
    });
    // "Catat Sekarang" from mandatory checklist pre-fills category + site deterministically.
    addModal?.addEventListener('show.bs.modal',event=>{
      const b=event.relatedTarget;const catId=b?.dataset.prefillCategory,siteId=b?.dataset.prefillSite;
      if(!catId)return;
      const item=categoryCatalog.find(o=>String(o.value)===String(catId));if(!item)return;
      const radio=addForm.querySelector(`input[name="entry_type"][value="${item.type}"]`);if(radio)radio.checked=true;
      renderCategories(item.type,catId);syncType(catId);
      const siteSelect=addForm.querySelector('select[name="site_id"]');if(siteSelect&&siteId)siteSelect.value=siteId;
    });
  }
  const editForm=document.getElementById('cashEditForm'),editCategory=document.getElementById('cashEditCategory');
  const syncEditVendor=()=>toggleFields(editForm,editCategory?.selectedOptions[0]?.dataset.vendor==='1','[data-edit-vendor-field]','[data-edit-purchase-field]');
  editCategory?.addEventListener('change',syncEditVendor);
  const modal=document.getElementById('cashEditModal');if(modal)modal.addEventListener('show.bs.modal',event=>{const b=event.relatedTarget;if(!b)return;editForm.action=`/cash/${b.dataset.id}/update`;document.getElementById('cashEditDate').value=b.dataset.date||'';document.getElementById('cashEditName').value=b.dataset.name||'';editCategory.value=b.dataset.category||'';document.getElementById('cashEditSite').value=b.dataset.site||'';document.getElementById('cashEditAmount').value=b.dataset.amount||'';document.getElementById('cashEditPurchaseChannel').value=b.dataset.purchaseChannel||'';document.getElementById('cashEditPurchaseShop').value=b.dataset.purchaseShop||'';document.getElementById('cashEditVendorName').value=b.dataset.vendorName||'';document.getElementById('cashEditVendorDuration').value=b.dataset.vendorDuration||'';document.getElementById('cashEditVendorUnit').value=b.dataset.vendorUnit||'hour';document.getElementById('cashEditNotes').value=b.dataset.notes||'';syncEditVendor();
    // v1.25 audit: AUTO BILLING (source_type='payment') rows keep category+amount locked in the UI too,
    // matching the server-side guard in routes/finance.js POST /cash/:id/update. Deliberately NOT using
    // the `disabled` attribute here — a disabled field is excluded from form submission entirely, which
    // would send an empty category_id/amount instead of the real (unchanged) value. `readonly` on the
    // number input blocks typing while still submitting its value; the select has no native readonly, so
    // it's locked via pointer-events/tabindex instead — the server-side guard is the real enforcement.
    const isAutoBilling=b.dataset.sourceType==='payment';
    const amountField=document.getElementById('cashEditAmount');
    amountField.readOnly=isAutoBilling;
    editCategory.style.pointerEvents=isAutoBilling?'none':'';
    editCategory.tabIndex=isAutoBilling?-1:0;
    editCategory.classList.toggle('field-locked',isAutoBilling);
    amountField.classList.toggle('field-locked',isAutoBilling);
    modal.querySelector('[data-edit-autobilling-note]')?.classList.toggle('d-none',!isAutoBilling);
  });
  document.querySelectorAll('[data-cash-proof]').forEach(input=>input.addEventListener('change',()=>{const label=input.closest('.proof-dropzone')?.querySelector('[data-cash-proof-name]');if(label)label.textContent=input.files?.[0]?.name||'Belum ada file dipilih';}));

  if(typeof Chart==='undefined')return;
  const charts=<%- safeJson(cashCharts) %>,money=value=>'Rp '+new Intl.NumberFormat('id-ID',{maximumFractionDigits:0}).format(value||0),grid='rgba(148,163,184,.09)',tick='#77839a';
  const expense=document.getElementById('cashExpenseChart');
  if(expense&&charts.categories.length)new Chart(expense,{type:'doughnut',data:{labels:charts.categories.map(x=>x.label),datasets:[{data:charts.categories.map(x=>x.amount),backgroundColor:['#ff6969','#ffbd5b','#7656ff','#55a8ff','#2ed6a1','#d946ef','#22d3ee'],borderWidth:3,borderColor:'rgba(8,12,25,.86)',hoverOffset:8}]},options:{responsive:true,maintainAspectRatio:false,cutout:'64%',plugins:{legend:{position:'right',labels:{color:tick,usePointStyle:true,boxWidth:8,font:{size:10}}},tooltip:{callbacks:{label:c=>`${c.label}: ${money(c.raw)}`}}}}});else document.getElementById('cashExpenseEmpty').hidden=false;
  const daily=document.getElementById('cashDailyChart');
  if(daily)new Chart(daily,{type:'line',data:{labels:charts.daily.labels,datasets:[{label:'Pemasukan',data:charts.daily.income,borderColor:'#2ed6a1',backgroundColor:'rgba(46,214,161,.12)',fill:true,tension:.38,pointRadius:1.5},{label:'Pengeluaran',data:charts.daily.expense,borderColor:'#ff6969',backgroundColor:'rgba(255,105,105,.10)',fill:true,tension:.38,pointRadius:1.5}]},options:{responsive:true,maintainAspectRatio:false,interaction:{mode:'index',intersect:false},plugins:{legend:{labels:{color:tick,usePointStyle:true,boxWidth:8,font:{size:10}}},tooltip:{callbacks:{label:c=>`${c.dataset.label}: ${money(c.raw)}`}}},scales:{x:{grid:{display:false},ticks:{color:tick,maxTicksLimit:16}},y:{beginAtZero:true,grid:{color:grid},ticks:{color:tick,callback:v=>money(v)}}}}});
})();
</script>
