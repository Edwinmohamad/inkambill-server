<section><div class="module-head"><div><div class="module-kicker">BILLING ADD-ONS</div><h1>Biaya Tambahan</h1><p>Template biaya instalasi, material, maintenance, atau biaya non-paket.</p></div><div class="module-actions"><button class="btn-tech primary" data-bs-toggle="modal" data-bs-target="#chargeModal"><i class="bi bi-plus-lg"></i>Tambah Biaya</button></div></div>
<div class="data-card"><div class="data-card-head"><div><h3>Additional Charges</h3><small>Reusable billing add-ons</small></div></div><div class="table-responsive"><table class="app-table"><thead><tr><th class="app-seq-col">No.</th><th>Nama</th><th>Jumlah</th><th>Deskripsi</th><th>Status</th><th></th></tr></thead><tbody><% charges.forEach((c,index)=>{ %><tr><td><span class="cell-main"><%= index+1 %></span></td><td class="cell-main"><%= c.name %></td><td class="money"><%= formatRupiah(c.amount) %></td><td><%= c.description||'-' %></td><td><span class="status-badge <%= c.is_active?'green':'gray' %>"><%= c.is_active?'aktif':'nonaktif' %></span></td><td><div class="d-flex gap-1"><button class="action-menu" type="button" title="Edit" data-bs-toggle="modal" data-bs-target="#editCharge<%= c.id %>"><i class="bi bi-pencil-square"></i></button><form method="post" action="/charges/<%= c.id %>/toggle"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="action-menu"><i class="bi bi-power"></i></button></form></div></td></tr><% }) %></tbody></table></div></div></section>
<div class="modal fade" id="chargeModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><form class="modal-content" method="post" action="/charges"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="modal-header"><h5 class="modal-title">Tambah Biaya</h5><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="row g-3"><div class="col-12"><label class="form-label">Nama</label><input class="form-control" name="name" required></div><div class="col-12"><label class="form-label">Nominal</label><input class="form-control" type="number" name="amount" required></div><div class="col-12"><label class="form-label">Deskripsi</label><textarea class="form-control" name="description"></textarea></div></div></div><div class="modal-footer"><button class="btn-tech primary">Simpan</button></div></form></div></div>
<% charges.forEach(c=>{ %><div class="modal fade" id="editCharge<%= c.id %>" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><form class="modal-content" method="post" action="/charges/<%= c.id %>/edit"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="modal-header"><h5 class="modal-title">Edit Biaya · <%= c.name %></h5><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="row g-3"><div class="col-12"><label class="form-label">Nama</label><input class="form-control" name="name" value="<%= c.name %>" required></div><div class="col-12"><label class="form-label">Nominal</label><input class="form-control" type="number" name="amount" value="<%= c.amount %>" required></div><div class="col-12"><label class="form-label">Deskripsi</label><textarea class="form-control" name="description"><%= c.description||'' %></textarea></div></div></div><div class="modal-footer"><button type="button" class="btn-tech" data-bs-dismiss="modal">Batal</button><button class="btn-tech primary">Simpan Perubahan</button></div></form></div></div><% }) %>
