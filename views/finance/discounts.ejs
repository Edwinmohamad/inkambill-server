<section><div class="module-head"><div><div class="module-kicker">PRICING RULES</div><h1>Diskon</h1><p>Buat potongan flat atau persentase untuk kebutuhan billing khusus.</p></div><div class="module-actions"><button class="btn-tech primary" data-bs-toggle="modal" data-bs-target="#discountModal"><i class="bi bi-plus-lg"></i>Tambah Diskon</button></div></div>
<div class="data-card"><div class="data-card-head"><div><h3>Discount Rules</h3><small>Template diskon yang dapat dipakai pada billing</small></div></div><div class="table-responsive"><table class="app-table"><thead><tr><th class="app-seq-col">No.</th><th>Nama</th><th>Tipe</th><th>Jumlah</th><th>Deskripsi</th><th>Status</th><th></th></tr></thead><tbody><% discounts.forEach((d,index)=>{ %><tr><td><span class="cell-main"><%= index+1 %></span></td><td class="cell-main"><%= d.name %></td><td><span class="status-badge purple"><%= d.type %></span></td><td class="money"><%= d.type==='percent'?`${d.amount}%`:formatRupiah(d.amount) %></td><td><%= d.description||'-' %></td><td><span class="status-badge <%= d.is_active?'green':'gray' %>"><%= d.is_active?'aktif':'nonaktif' %></span></td><td><div class="d-flex gap-1"><button class="action-menu" type="button" title="Edit" data-bs-toggle="modal" data-bs-target="#editDiscount<%= d.id %>"><i class="bi bi-pencil-square"></i></button><form method="post" action="/discounts/<%= d.id %>/toggle"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="action-menu"><i class="bi bi-power"></i></button></form><button class="action-menu danger" type="button" title="Hapus Diskon" data-simple-delete="/discounts/<%= d.id %>/delete" data-entity-label="Diskon <%= d.name %>" data-simple-delete-title="Hapus diskon ini?" data-simple-delete-warning="Diskon akan dihapus permanen. Jika masih dipakai pelanggan, sistem akan menolak dan menyarankan Aktif/Nonaktif."><i class="bi bi-trash3-fill"></i></button></div></td></tr><% }) %></tbody></table></div></div></section>
<div class="modal fade" id="discountModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><form class="modal-content" method="post" action="/discounts"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="modal-header"><h5 class="modal-title">Tambah Diskon</h5><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="row g-3"><div class="col-12"><label class="form-label">Nama</label><input class="form-control" name="name" required></div><div class="col-6"><label class="form-label">Tipe</label><select class="form-select" name="type"><option value="flat">Flat</option><option value="percent">Percent</option></select></div><div class="col-6"><label class="form-label">Jumlah</label><input class="form-control" type="number" step="0.01" name="amount" required></div><div class="col-12"><label class="form-label">Deskripsi</label><textarea class="form-control" name="description"></textarea></div></div></div><div class="modal-footer"><button class="btn-tech primary">Simpan Diskon</button></div></form></div></div>
<% discounts.forEach(d=>{ %><div class="modal fade" id="editDiscount<%= d.id %>" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><form class="modal-content" method="post" action="/discounts/<%= d.id %>/edit"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="modal-header"><h5 class="modal-title">Edit Diskon · <%= d.name %></h5><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="row g-3"><div class="col-12"><label class="form-label">Nama</label><input class="form-control" name="name" value="<%= d.name %>" required></div><div class="col-6"><label class="form-label">Tipe</label><select class="form-select" name="type"><option value="flat" <%= d.type==='flat'?'selected':'' %>>Flat</option><option value="percent" <%= d.type==='percent'?'selected':'' %>>Percent</option></select></div><div class="col-6"><label class="form-label">Jumlah</label><input class="form-control" type="number" step="0.01" name="amount" value="<%= d.amount %>" required></div><div class="col-12"><label class="form-label">Deskripsi</label><textarea class="form-control" name="description"><%= d.description||'' %></textarea></div></div></div><div class="modal-footer"><button type="button" class="btn-tech" data-bs-dismiss="modal">Batal</button><button class="btn-tech primary">Simpan Perubahan</button></div></form></div></div><% }) %>
