<section class="noc-page" id="nocApp" data-can-support="<%= can('support')?'1':'0' %>">
  <div class="module-head"><div><div class="module-kicker">LIVE MONITORING · NETWORK OPERATIONS CENTER</div><h1>NOC Terpadu</h1><p>Satu dashboard untuk ONT pelanggan dan perangkat jaringan inti (router, OLT), plus tiket aktif.</p></div><div class="module-actions">
    <button type="button" class="btn-tech" id="nocNotifyToggle" title="Notifikasi browser saat ada alarm kritis baru"><i class="bi bi-bell"></i><span id="nocNotifyLabel">Notifikasi</span></button>
    <button type="button" class="btn-tech" id="nocWallboardToggle" title="Mode Wallboard/TV"><i class="bi bi-tv"></i>Wallboard</button>
    <a class="btn-tech" href="/monitoring"><i class="bi bi-grid-1x2-fill"></i>Kelola Perangkat</a><a class="btn-tech" href="/acs"><i class="bi bi-bezier2"></i>Monitoring ONT</a><a class="btn-tech primary" href="/acs/map"><i class="bi bi-map-fill"></i>Network Map</a>
  </div></div>
  <div class="noc-health-strip"><span class="pulse-dot"></span><div><strong>Monitoring aktif</strong><small id="nocLastSync">ACS terakhir: <%= lastSync?.finished_at?new Date(lastSync.finished_at).toLocaleString('id-ID',{timeZone:'Asia/Jakarta'}):'belum pernah sinkron' %></small></div><a class="noc-alert-chip <%= alertSettings.waEnabled?'is-on':'is-off' %>" href="/settings" title="Atur Alert Jaringan WhatsApp"><i class="bi bi-whatsapp"></i><%= alertSettings.waEnabled?`WA Alert aktif · ${alertSettings.numbers.length} nomor`:'WA Alert nonaktif' %></a><small class="noc-refresh-indicator" id="nocRefreshIndicator">live</small><time data-live-clock>--:--:-- WIB</time></div>

  <div class="noc-block">
    <div class="noc-block-head"><div><h2>ONT Pelanggan</h2><small>Status perangkat ONT pelanggan dari GenieACS.</small></div></div>
    <div class="noc-kpi-grid">
      <a href="/acs?status=online" id="kpi-ont" class="noc-kpi <%= Number(onts.offline||0)?'danger':'success' %>"><i class="bi bi-broadcast-pin"></i><span><small>ONT ONLINE</small><strong><%= Number(onts.online||0) %>/<%= Number(onts.total||0) %></strong><em><%= Number(onts.offline||0) %> offline</em></span></a>
      <a href="/acs?signal=critical" id="kpi-critical" class="noc-kpi <%= Number(onts.critical||0)?'danger':'warning' %>"><i class="bi bi-reception-2"></i><span><small>REDAMAN KRITIS</small><strong><%= Number(onts.critical||0) %></strong><em><%= Number(onts.warning||0) %> warning</em></span></a>
      <a href="/network/monitor" id="kpi-customers" class="noc-kpi <%= Number(customers.unreachable||0)?'danger':'success' %>"><i class="bi bi-people-fill"></i><span><small>PELANGGAN ONLINE</small><strong><%= Number(customers.online||0) %>/<%= Number(customers.total||0) %></strong><em><%= Number(customers.isolated||0) %> isolir</em></span></a>
    </div>
  </div>

  <div class="noc-block">
    <div class="noc-block-head"><div><h2>Perangkat Jaringan</h2><small>Router MikroTik, OLT, dan tiket yang perlu ditindak.</small></div><div class="noc-block-actions"><a href="/routers" class="btn-tech sm"><i class="bi bi-plus-lg"></i>Tambah Router</a><a href="/olt" class="btn-tech sm"><i class="bi bi-plus-lg"></i>Tambah OLT</a></div></div>
    <div class="noc-kpi-grid">
      <a href="/network/monitor" id="kpi-router" class="noc-kpi <%= Number(routers.offline||0)?'danger':'success' %>"><i class="bi bi-router-fill"></i><span><small>ROUTER ONLINE</small><strong><%= Number(routers.online||0) %>/<%= Number(routers.total||0) %></strong><em><%= Number(routers.offline||0) %> offline</em></span></a>
      <a href="/olt" id="kpi-olt" class="noc-kpi <%= (Number(olts.onuOffline||0)+Number(olts.onuCritical||0)+Number(olts.unreachable||0))?'danger':'success' %>"><i class="bi bi-hdd-network-fill"></i><span><small>OLT / ONU ONLINE</small><strong><%= Number(olts.onuOnline||0) %>/<%= Number(olts.onuTotal||0) %></strong><em><%= Number(olts.total||0) %> OLT<% if(Number(olts.unreachable||0)){ %> · <%= Number(olts.unreachable) %> tidak terjangkau<% } %> · <%= Number(olts.onuCritical||0) %> kritis</em></span></a>
      <a href="/tickets?status=active" id="kpi-tickets" class="noc-kpi <%= Number(tickets.critical||0)?'danger':'warning' %>"><i class="bi bi-ticket-detailed-fill"></i><span><small>TIKET AKTIF</small><strong><%= Number(tickets.total||0) %></strong><em><%= Number(tickets.critical||0) %> critical</em></span></a>
    </div>
  </div>

  <div class="noc-grid">
    <article class="data-card"><div class="data-card-head"><div><h3>Kesehatan Per Site</h3><small>Prioritas berdasarkan router dan ONT. Klik baris untuk memfilter Alarm Prioritas ke site tersebut.</small></div></div><div class="table-responsive"><table class="app-table"><thead><tr><th>Site</th><th>Pelanggan</th><th>Router</th><th>ONT Offline</th><th>Redaman Kritis</th><th>Kondisi</th></tr></thead><tbody id="nocSiteTableBody"><% sites.forEach(s=>{ const bad=Number(s.routers_offline)+Number(s.ont_offline)+Number(s.ont_critical); %><tr class="noc-site-row" data-site="<%= s.code %>" role="button" tabindex="0"><td><strong><%= s.code %></strong><small><%= s.name %></small></td><td><%= s.customers %></td><td><%= s.routers %></td><td><%= s.ont_offline %></td><td><%= s.ont_critical %></td><td><span class="status-badge <%= bad?'red':'green' %>"><%= bad?'PERLU CEK':'NORMAL' %></span></td></tr><% }) %></tbody></table></div></article>
    <article class="data-card"><div class="data-card-head"><div><h3>Alarm Prioritas</h3><small id="nocAlarmFilterHint">Router offline, ONT offline, dan redaman bermasalah.</small></div><a href="/acs">Lihat ONT</a></div><div class="noc-alarm-list" id="nocAlarmList"><% alarms.forEach(a=>{ %><div class="noc-alarm <%= a.tone %>" data-site="<%= a.site_code||'' %>"><a class="noc-alarm-link" href="<%= a.kind==='router'?'/network/monitor':'/acs?q='+encodeURIComponent(a.title) %>"><i class="bi <%= a.kind==='router'?'bi-router-fill':'bi-broadcast-pin' %>"></i><span><strong><%= a.title %></strong><small><%= a.detail %></small></span><time><%= a.event_at?new Date(a.event_at).toLocaleString('id-ID',{timeZone:'Asia/Jakarta'}):'-' %></time></a><% if(can('support')){ %><form method="post" action="/tickets" class="noc-alarm-ticket-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="subject" value="[NOC] <%= a.title %>"><input type="hidden" name="type" value="Gangguan Jaringan"><input type="hidden" name="priority" value="<%= a.tone==='danger'?'critical':'high' %>"><input type="hidden" name="description" value="<%= a.detail %> — dibuat manual dari Alarm Prioritas NOC."><button type="submit" class="btn-tech sm" title="Buat tiket dari alarm ini"><i class="bi bi-ticket-perforated"></i>Tiket</button></form><% } %></div><% }) %><% if(!alarms.length){ %><div class="empty-state"><i class="bi bi-shield-check"></i><strong>Semua jaringan normal</strong><small>Tidak ada alarm aktif.</small></div><% } %></div></article>
  </div>
</section>
<script src="/js/noc.js?v=<%= assetVersion %>"></script>
