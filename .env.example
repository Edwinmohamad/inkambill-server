COMPOSE_PROJECT_NAME=inkamnet-final-v1-staging
NODE_ENV=production
PORT=3200
APP_NAME=INKAMNET Control Center
APP_URL=http://localhost:3200
SESSION_SECRET=GANTI_DENGAN_RANDOM_STRING_PANJANG_MINIMAL_32_KARAKTER
ROUTER_CREDENTIAL_KEY=GANTI_DENGAN_RANDOM_STRING_LAIN_UNTUK_ENKRIPSI_ROUTER
COOKIE_SECURE=true
DB_HOST=db
DB_PORT=3306
DB_NAME=inkamnet
DB_USER=inkamnet
DB_PASSWORD=GANTI_PASSWORD_DATABASE
DB_ROOT_PASSWORD=GANTI_ROOT_PASSWORD_DATABASE
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=GantiPasswordAdmin123!
DEFAULT_ADMIN_NAME=Edwin
# Closing PIN is verified as SHA-256. Bootstrap PIN for this release: 121224.
# Replace the hash below with your own SHA-256 value before production use.
CLOSING_PIN_SHA256=cc819c3e680dd46370437a0224ea316438d27b869e090347a4b9af058d75886c
CLOSING_PIN_TTL_MINUTES=30
N8N_API_TOKEN=GANTI_TOKEN_RANDOM_MINIMAL_32_KARAKTER
N8N_BASE_URL=https://domain-inkambilling.example/api/n8n
NMS_BACKUP_DIR=storage/nms-backups
NMS_TRAFFIC_SAMPLE_MINUTES=5
# INKAMNET GO Android update and verified App Links.
MOBILE_ANDROID_VERSION_CODE=2
MOBILE_ANDROID_VERSION_NAME=1.1.0
MOBILE_ANDROID_APK_URL=
MOBILE_ANDROID_APK_PATH=storage/mobile-releases/INKAMNET-GO.apk
MOBILE_ANDROID_FORCE_UPDATE=false
MOBILE_ANDROID_CERT_SHA256=
# Optional Firebase Cloud Messaging. Keep the service-account JSON only on the server.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
TZ=Asia/Jakarta
# GenieACS NBI (server-to-server, jangan arahkan URL ini ke browser publik)
GENIEACS_NBI_URL=http://192.168.100.66:7557
GENIEACS_NBI_USERNAME=
GENIEACS_NBI_PASSWORD=
ACS_ONLINE_MINUTES=10
ACS_RX_WARNING=-25
ACS_RX_CRITICAL=-28
ACS_TIMEOUT_MS=12000
ACS_RX_PATH=VirtualParameters.RXPower
ACS_PPPOE_PATH=VirtualParameters.pppoeUsername
ACS_TEMPERATURE_PATH=VirtualParameters.gettemp
ACS_CLIENTS_PATH=VirtualParameters.activedevices
