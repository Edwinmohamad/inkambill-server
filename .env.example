SESSION_SECRET=GANTI_DENGAN_RANDOM_STRING_PANJANG_MINIMAL_32_KARAKTER
ROUTER_CREDENTIAL_KEY=GANTI_DENGAN_RANDOM_STRING_LAIN_UNTUK_ENKRIPSI_ROUTER
COOKIE_SECURE=true
DB_HOST=db
DB_PORT=3306
DB_NAME=inkamnet
DB_USER=inkamnet
DB_PASSWORD=GANTI_PASSWORD_DATABASE
DB_ROOT_PASSWORD=GANTI_ROOT_PASSWORD_DATABASE
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=GantiPasswordAdmin123!
DEFAULT_ADMIN_NAME=Edwin
# Closing PIN is verified as SHA-256. Bootstrap PIN for this release: 121224.
# Replace the hash below with your own SHA-256 value before production use.
CLOSING_PIN_SHA256=cc819c3e680dd46370437a0224ea316438d27b869e090347a4b9af058d75886c
CLOSING_PIN_TTL_MINUTES=30
N8N_API_TOKEN=GANTI_TOKEN_RANDOM_MINIMAL_32_KARAKTER
N8N_BASE_URL=https://domain-inkambilling.example/api/n8n
NMS_BACKUP_DIR=storage/nms-backups
NMS_TRAFFIC_SAMPLE_MINUTES=5
# INKAMNET GO Android update and verified App Links.
MOBILE_ANDROID_VERSION_CODE=2
MOBILE_ANDROID_VERSION_NAME=1.1.0
MOBILE_ANDROID_APK_URL=
MOBILE_ANDROID_APK_PATH=storage/mobile-releases/INKAMNET-GO.apk
MOBILE_ANDROID_FORCE_UPDATE=false
MOBILE_ANDROID_CERT_SHA256=
# Optional Firebase Cloud Messaging. Keep the service-account JSON only on the server.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
TZ=Asia/Jakarta
# GenieACS NBI (server-to-server, jangan arahkan URL ini ke browser publik)
GENIEACS_NBI_URL=http://192.168.100.66:7557
GENIEACS_NBI_USERNAME=
GENIEACS_NBI_PASSWORD=
ACS_ONLINE_MINUTES=10
ACS_RX_WARNING=-25
ACS_RX_CRITICAL=-28
ACS_TIMEOUT_MS=12000
ACS_RX_PATH=VirtualParameters.RXPower
ACS_PPPOE_PATH=VirtualParameters.pppoeUsername
ACS_TEMPERATURE_PATH=VirtualParameters.gettemp
ACS_CLIENTS_PATH=VirtualParameters.activedevices

# --- WA Gateway via WAHA (WhatsApp HTTP API), https://waha.devlike.pro -----------------------
# WAHA runs as its own service on THIS server, already tunneled through Cloudflare for your own
# access to its dashboard — but the app should talk to it over the LOCAL address below, not the
# public tunnel URL, since app and WAHA share this server (faster, and doesn't depend on the
# tunnel/internet being up for billing reminders to send).
#   - Both app and WAHA running directly on the host (pm2/systemd, no Docker): http://localhost:3000
#   - App runs via `docker compose` (this repo's docker-compose.yml) and WAHA runs directly on the
#     host, outside that compose project: http://host.docker.internal:3000
#     (docker-compose.yml already adds the extra_hosts entry this needs to resolve)
#   - Both app and WAHA are containers on the SAME docker-compose project/network: use WAHA's
#     service/container name instead, e.g. http://waha:3000
WAHA_BASE_URL=http://host.docker.internal:3000
# API key configured on WAHA's own side (WAHA_API_KEY / WHATSAPP_API_KEY env there, or its
# dashboard) — required so the tunnel isn't just "anyone who finds the URL can send WA messages".
# Never commit the real value.
WAHA_API_KEY=
WAHA_SESSION_NAME=default
# Random shared secret this app expects on incoming WAHA webhook calls (?token=...). Generate
# with e.g. `openssl rand -hex 24`. Required for WAHA to be able to push status/QR updates back
# instead of the app only finding out via polling.
WAHA_WEBHOOK_TOKEN=
# Only needed if WAHA cannot reach this app at APP_URL above (e.g. WAHA is NOT on this same
# server after all, or is itself sandboxed from it) — otherwise leave blank and it's derived from
# APP_URL automatically (APP_URL + /api/waha/webhook).
WAHA_WEBHOOK_CALLBACK_URL=

# --- Bot Tiket WhatsApp (WAHA -> n8n -> /api/n8n/wa/command), lihat docs/WA-TICKET-BOT.md --------
# ID grup WA teknisi (format 1203...@g.us), pisahkan koma bila lebih dari satu. Perintah dari grup
# lain diabaikan; notifikasi tiket (baru/assign/close/pending) dikirim ke grup ini. Cara dapat ID:
# kirim "#idgrup" di grup tersebut dari nomor karyawan terdaftar.
WA_TICKET_GROUP_IDS=
# false = matikan notifikasi otomatis ke grup/teknisi (bot perintah tetap jalan).
WA_TICKET_NOTIFY=true
# Awalan perintah bot.
WA_TICKET_PREFIX=#
# Webhook tambahan yang ikut didaftarkan ke sesi WAHA saat app menyalakan sesi (koma untuk >1).
# WAJIB diisi URL webhook n8n bot tiket, karena app menimpa daftar webhook sesi WAHA saat restart.
# Contoh: https://n8n.domainanda.id/webhook/inkambilling/wa-ticket-bot?token=<webhookToken di node Config n8n>
WAHA_EXTRA_WEBHOOK_URLS=

